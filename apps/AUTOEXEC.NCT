// zedBSD graphical startup menu.  The VM returns after placing exactly one
// command in BOOT_ACTION; Stage 2 validates and executes that command only
// after BeUI and the Noct arena have been torn down.

func make_rgb(red, green, blue) {
    return ((red & 0xff) << 16) | ((green & 0xff) << 8) | (blue & 0xff);
}

func drawRow(y, text, active) {
    var accent = make_rgb(0x2b, 0x9a, 0xf3);
    var activeBackground = make_rgb(0x0b, 0x3d, 0x5a);
    var inactiveBackground = make_rgb(0x1c, 0x1f, 0x23);
    if (active == 1) {
        BeUI.fill(190, y - 8, 414, 36, activeBackground);
        BeUI.line(190, y - 8, 603, y - 8, accent);
        BeUI.line(190, y + 27, 603, y + 27, accent);
        BeUI.line(190, y - 8, 190, y + 27, accent);
        BeUI.line(603, y - 8, 603, y + 27, accent);
        BeUI.drawText(">", 204, y, accent, activeBackground);
        BeUI.drawText(text, 228, y, 0xffffff, activeBackground);
    } else {
        BeUI.fill(190, y - 8, 414, 36, inactiveBackground);
        BeUI.drawText(" ", 204, y, 0x99a4ad, inactiveBackground);
        BeUI.drawText(text, 228, y, 0xc1c1c1, inactiveBackground);
    }
}

func drawMenu(selected) {
    var height = BeUI.getHeight();
    var background = make_rgb(0x10, 0x12, 0x14);
    var header = make_rgb(0x15, 0x19, 0x18);
    var sidebar = make_rgb(0x48, 0x48, 0x55);
    var accent = make_rgb(0x2b, 0x9a, 0xf3);
    var primaryText = 0xffffff;
    var secondaryText = 0x99a4ad;
    var mutedText = 0x5f6766;
    BeUI.fill(0, 0, 640, height, background);

    BeUI.fill(0, 0, 640, 42, header);
    BeUI.fill(0, 40, 640, 2, 0x00b7d6);
    BeUI.drawText("zedBSD/98", 18, 12, primaryText, header);
    BeUI.drawText("Boot loader and pre-boot environment", 190, 12,
                  secondaryText, header);

    BeUI.fill(0, 42, 164, height - 42, sidebar);
    BeUI.drawText("SYSTEM", 16, 68, mutedText, sidebar);
    BeUI.drawText("Overview", 24, 100, secondaryText, sidebar);
    BeUI.drawText("Storage", 24, 132, secondaryText, sidebar);
    BeUI.drawText("Networking", 24, 164, secondaryText, sidebar);
    BeUI.fill(0, 194, 164, 34, background);
    BeUI.fill(0, 194, 3, 34, accent);
    BeUI.drawText("Boot menu", 24, 203, primaryText, background);
    BeUI.drawText("TOOLS", 16, 246, mutedText, sidebar);
    BeUI.drawText("Emacs", 24, 274, secondaryText, sidebar);
    BeUI.drawText("Noct shell", 24, 306, secondaryText, sidebar);
    BeUI.drawText("Terminal", 24, 338, secondaryText, sidebar);

    BeUI.drawText("ブートストラップ環境", 190, 66,
                  primaryText, background);
    BeUI.drawText("起動する項目を選択してください", 190, 94,
                  secondaryText, background);
    BeUI.line(190, 118, 603, 118, 0x31353d);
    drawRow(142, "Linux を起動", selected == 0);
    drawRow(186, "Emacs", selected == 1);
    drawRow(230, "Holoris", selected == 2);
    drawRow(274, "シェルに戻る", selected == 3);

    BeUI.fill(164, height - 42, 476, 42, header);
    BeUI.drawText("↑ ↓", 190, height - 29, accent, header);
    BeUI.drawText(": 選択", 230, height - 29, secondaryText, header);
    BeUI.drawText("Enter", 338, height - 29, accent, header);
    BeUI.drawText(": 決定", 386, height - 29, secondaryText, header);
    BeUI.flush();
}

func rowText(index) {
    if (index == 0) { return "Linux を起動"; }
    if (index == 1) { return "Emacs"; }
    if (index == 2) { return "Holoris"; }
    return "シェルに戻る";
}

func main() {
    if (BeUI.init() != 1) { return 1; }
    var selected = 0;
    drawMenu(selected);
    while (1) {
        var key = Keyboard.read();
        var previous = selected;
        if (key == Key.Down && selected < 3) { selected = selected + 1; }
        if (key == Key.Up && selected > 0) { selected = selected - 1; }
        if (selected != previous) {
            drawRow(142 + previous * 44, rowText(previous), 0);
            drawRow(142 + selected * 44, rowText(selected), 1);
            BeUI.flush();
        }
        if (key == 27) {
            BeUI.close();
            System.setEnv("BOOT_ACTION", "echo Entering shell.");
            return 0;
        }
        if (key == Key.Enter) {
            BeUI.close();
            if (selected == 0) {
                System.setEnv("BOOT_ACTION", "source ZEDBSD.CFG");
            }
            if (selected == 1) {
                System.setEnv("BOOT_ACTION", "emacs EDIT.TXT");
            }
            if (selected == 2) {
                System.setEnv("BOOT_ACTION", "holoris");
            }
            if (selected == 3) {
                System.setEnv("BOOT_ACTION", "echo Entering shell.");
            }
            return 0;
        }
    }
}
