func entryName(entry) {
    if (entry.directory) { return entry.name + "/"; }
    return entry.name;
}

func spaces(count) {
    var result = "";
    for (index in 0..count) { result = result + " "; }
    return result;
}

func attributeText(entry) {
    var result = "-";
    if (entry.directory) { result = "d"; }
    if ((entry.attributes & 0x01) != 0) { result = result + "r"; }
    else { result = result + "-"; }
    if ((entry.attributes & 0x02) != 0) { result = result + "h"; }
    else { result = result + "-"; }
    if ((entry.attributes & 0x04) != 0) { result = result + "s"; }
    else { result = result + "-"; }
    if ((entry.attributes & 0x20) != 0) { result = result + "a"; }
    else { result = result + "-"; }
    return result;
}

func printLong(entries) {
    for (entry in entries) {
        var size = String.from(entry.size);
        var padding = 10 - String.charCount(size);
        if (padding < 1) { padding = 1; }
        Console.print(attributeText(entry) + spaces(padding) + size +
                      " " + entryName(entry));
    }
}

func printColumns(entries) {
    var count = Array.size(entries);
    if (count == 0) { return; }

    var names = Array.make(count);
    var maximumWidth = 0;
    for (index in 0..count) {
        names[index] = entryName(entries[index]);
        var width = String.charCount(names[index]);
        if (width > maximumWidth) { maximumWidth = width; }
    }

    var terminal = Term.size();
    var columnWidth = maximumWidth + 2;
    var columns = terminal.cols / columnWidth;
    if (columns < 1) { columns = 1; }
    if (columns > count) { columns = count; }
    var rows = (count + columns - 1) / columns;

    // Like BSD ls -C, fill each column from top to bottom.  This keeps
    // neighboring names visually close while using the full terminal width.
    for (row in 0..rows) {
        var line = "";
        for (column in 0..columns) {
            var index = row + column * rows;
            if (index < count) {
                line = line + names[index];
                var next = index + rows;
                if (column + 1 < columns && next < count) {
                    line = line + spaces(columnWidth -
                        String.charCount(names[index]));
                }
            }
        }
        Console.print(line);
    }
}

func main(args) {
    // Relative lookup is resolved against the cwd inherited from the shell.
    var path = ".";
    var pathSet = 0;
    var longFormat = 0;

    if (Array.size(args) > 2) {
        Console.print("usage: ls [-l] [PATH]");
        return 2;
    }
    for (arg in args) {
        if (arg == "-l")
            longFormat = 1;
        else if (pathSet == 0) {
            path = arg;
            pathSet = 1;
        }
        else {
            Console.print("usage: ls [-l] [PATH]");
            return 2;
        }
    }

    var entries = Directory.list(path);
    if (longFormat == 1)
        printLong(entries);
    else
        printColumns(entries);
    return 0;
}
