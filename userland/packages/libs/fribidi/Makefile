# zedBSD userland package: GNU FriBidi (external release tarball).
# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
#
# FriBidi is LGPL-2.1-or-later and stays outside the source tree: only this
# Makefile and the recorded archive identity live here.  It implements the
# Unicode bidirectional algorithm Pango lays out right-to-left text with, for
# the GTK port (WS115).  Provenance is in plan/ws034/package-inventory.md and
# plan/ws115/port-contract.md.
ZEDBSD_FRIBIDI_MAKEFILE := $(lastword $(MAKEFILE_LIST))
ZEDBSD_FRIBIDI_DIR := $(patsubst %/,%,$(dir $(ZEDBSD_FRIBIDI_MAKEFILE)))
include $(ZEDBSD_FRIBIDI_DIR)/../../../base/package.mk
include $(ZEDBSD_FRIBIDI_DIR)/../../external.mk

# 1.0.17 was the latest release when recorded.  Size and digest are the
# upstream bytes as measured; they match the digest GitHub gives the release
# asset (WS034 p001).
ZEDBSD_EXT_fribidi_VERSION := 1.0.17
ZEDBSD_EXT_fribidi_ROOT := fribidi-1.0.17
ZEDBSD_EXT_fribidi_ARCHIVE := fribidi-1.0.17.tar.xz
ZEDBSD_EXT_fribidi_URL := https://github.com/fribidi/fribidi/releases/download/v1.0.17/fribidi-1.0.17.tar.xz
ZEDBSD_EXT_fribidi_SIZE := 1203284
ZEDBSD_EXT_fribidi_SHA256 := 6949dcde27d41cebad1fd741fcafc36d55a1020d2d872d4a6eb3914caabbada2
ZEDBSD_EXT_fribidi_PATCH_LEVEL := zedbsd0
ZEDBSD_EXT_fribidi_PATCHES :=

$(eval $(call ZEDBSD_EXTERNAL_SOURCE,fribidi))

# ---------------------------------------------------------------- build

# Meson, through the common rule.  The Unicode tables are generated by small
# programs Meson builds for the build machine.  The deprecated interfaces,
# the fribidi command, the documentation and the tests are off.
ZEDBSD_EXT_fribidi_MAKEFILE := $(ZEDBSD_FRIBIDI_MAKEFILE)
ZEDBSD_EXT_fribidi_DEPENDS :=
ZEDBSD_EXT_fribidi_HOST_TOOLS :=
ZEDBSD_EXT_fribidi_MESON_OPTIONS := -Ddeprecated=false -Ddocs=false -Dbin=false -Dtests=false

$(eval $(call ZEDBSD_EXTERNAL_MESON,fribidi))

ZEDBSD_FRIBIDI_STAGED := $(ZEDBSD_EXT_fribidi_STAGEDIR)/.zedbsd-staged
ZEDBSD_FRIBIDI_CHECKED := $(ZEDBSD_EXT_fribidi_STAGEDIR)/.zedbsd-checked
ZEDBSD_FRIBIDI_SONAME := libfribidi.so.0
ZEDBSD_FRIBIDI_LIBRARY := $(ZEDBSD_EXT_fribidi_STAGEDIR)/usr/lib/libfribidi.so.0.4.0
ZEDBSD_FRIBIDI_LICENSE := $(ZEDBSD_EXT_fribidi_SRCDIR)/COPYING

# Checks the library against its dependency contract once the stage exists.
$(ZEDBSD_FRIBIDI_CHECKED): $(ZEDBSD_FRIBIDI_STAGED)
	@$(PYTHON) '$(ZEDBSD_EXTERNAL_ROOT)/tools/build/check-dynamic-elf.py' \
		--machine $(ZEDBSD_ARCHITECTURE) --role shared-library \
		--soname $(ZEDBSD_FRIBIDI_SONAME) --needed libc.so \
		'$(ZEDBSD_FRIBIDI_LIBRARY)'
	@touch '$@'

$(ZEDBSD_FRIBIDI_LICENSE): $(ZEDBSD_EXT_fribidi_SRCSTAMP)
	@test -f '$@'

.PHONY: fribidi
fribidi: $(ZEDBSD_FRIBIDI_CHECKED)
	@:

# ---------------------------------------------------------------- packaging

# The library goes in under its SONAME.  The headers and the .pc file are the
# development files below.
$(eval $(call ZEDBSD_USERLAND_PACKAGE,fribidi,Unicode bidirectional algorithm,*,n,package,,y,\
	packages/libs,libs/fribidi,))

ZEDBSD_PACKAGE_INPUTS += $(if $(filter fribidi,$(ZEDBSD_USER_PROGRAMS)),\
	$(ZEDBSD_FRIBIDI_CHECKED) $(ZEDBSD_FRIBIDI_LICENSE))
ZEDBSD_PACKAGE_FILES += $(if $(filter fribidi,$(ZEDBSD_USER_PROGRAMS)),\
	--file /usr/lib/$(ZEDBSD_FRIBIDI_SONAME)=$(ZEDBSD_FRIBIDI_LIBRARY) \
	--file /usr/share/licenses/fribidi/COPYING=$(ZEDBSD_FRIBIDI_LICENSE))

# The development files: the headers, the .pc files and the unversioned names
# of the libraries (external.mk).
$(eval $(call ZEDBSD_EXTERNAL_DEVELOPMENT,fribidi,$(ZEDBSD_EXT_fribidi_STAGEDIR),\
	lib/pkgconfig/fribidi.pc,\
	include/fribidi,\
	$(ZEDBSD_FRIBIDI_SONAME)))
