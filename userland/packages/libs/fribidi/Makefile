# zedBSD userland package: GNU FriBidi (external release tarball).
# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
#
# FriBidi is LGPL-2.1-or-later and stays outside the source tree: only this
# Makefile and the recorded archive identity live here.  It implements the
# Unicode bidirectional algorithm Pango lays out right-to-left text with, for
# the GTK port (WS115).  Provenance is in plan/ws034/package-inventory.md and
# plan/ws115/port-contract.md.
FRIBIDI_MAKEFILE := $(lastword $(MAKEFILE_LIST))
FRIBIDI_DIR := $(patsubst %/,%,$(dir $(FRIBIDI_MAKEFILE)))
include $(FRIBIDI_DIR)/../../../base/package.mk
include $(FRIBIDI_DIR)/../../external.mk

# 1.0.17 was the latest release when recorded.  Size and digest are the
# upstream bytes as measured; they match the digest GitHub gives the release
# asset (WS034 p001).
EXT_fribidi_VERSION := 1.0.17
EXT_fribidi_ROOT := fribidi-1.0.17
EXT_fribidi_ARCHIVE := fribidi-1.0.17.tar.xz
EXT_fribidi_URL := https://github.com/fribidi/fribidi/releases/download/v1.0.17/fribidi-1.0.17.tar.xz
EXT_fribidi_SIZE := 1203284
EXT_fribidi_SHA256 := 6949dcde27d41cebad1fd741fcafc36d55a1020d2d872d4a6eb3914caabbada2
EXT_fribidi_PATCH_LEVEL := zedbsd0
EXT_fribidi_PATCHES :=

$(eval $(call EXTERNAL_SOURCE,fribidi))

# ---------------------------------------------------------------- build

# Meson, through the common rule.  The Unicode tables are generated by small
# programs Meson builds for the build machine.  The deprecated interfaces,
# the fribidi command, the documentation and the tests are off.
EXT_fribidi_MAKEFILE := $(FRIBIDI_MAKEFILE)
EXT_fribidi_DEPENDS :=
EXT_fribidi_HOST_TOOLS :=
EXT_fribidi_MESON_OPTIONS := -Ddeprecated=false -Ddocs=false -Dbin=false -Dtests=false

$(eval $(call EXTERNAL_MESON,fribidi))

FRIBIDI_STAGED := $(EXT_fribidi_STAGEDIR)/.zedbsd-staged
FRIBIDI_CHECKED := $(EXT_fribidi_STAGEDIR)/.zedbsd-checked
FRIBIDI_SONAME := libfribidi.so.0
FRIBIDI_LIBRARY := $(EXT_fribidi_STAGEDIR)/usr/lib/libfribidi.so.0.4.0
FRIBIDI_LICENSE := $(EXT_fribidi_SRCDIR)/COPYING

# Checks the library against its dependency contract once the stage exists.
$(FRIBIDI_CHECKED): $(FRIBIDI_STAGED)
	@$(PYTHON) '$(EXTERNAL_ROOT)/tools/build/check-dynamic-elf.py' \
		--machine $(ARCHITECTURE) --role shared-library \
		--soname $(FRIBIDI_SONAME) --needed libc.so \
		'$(FRIBIDI_LIBRARY)'
	@touch '$@'

$(FRIBIDI_LICENSE): $(EXT_fribidi_SRCSTAMP)
	@test -f '$@'

.PHONY: fribidi
fribidi: $(FRIBIDI_CHECKED)
	@:

# ---------------------------------------------------------------- packaging

# The library goes in under its SONAME.  The headers and the .pc file are the
# development files below.
$(eval $(call USERLAND_PACKAGE,fribidi,Unicode bidirectional algorithm,*,n,package,,y,\
	packages/libs,libs/fribidi,))

PACKAGE_INPUTS += $(if $(filter fribidi,$(USER_PROGRAMS)),\
	$(FRIBIDI_CHECKED) $(FRIBIDI_LICENSE))
PACKAGE_FILES += $(if $(filter fribidi,$(USER_PROGRAMS)),\
	--file /usr/lib/$(FRIBIDI_SONAME)=$(FRIBIDI_LIBRARY) \
	--file /usr/share/licenses/fribidi/COPYING=$(FRIBIDI_LICENSE))

# The development files: the headers, the .pc files and the unversioned names
# of the libraries (external.mk).
$(eval $(call EXTERNAL_DEVELOPMENT,fribidi,$(EXT_fribidi_STAGEDIR),\
	lib/pkgconfig/fribidi.pc,\
	include/fribidi,\
	$(FRIBIDI_SONAME)))
