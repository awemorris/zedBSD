+ProcessId GetParentProcessId(ProcessHandle process) {
+  if (process == getpid()) {
+    return getppid();
+  }
+
+  // KERN_SYSTEM_GET_PROCESS answers the first process above the pid asked.
+  ScopedFD system(HANDLE_EINTR(open("/dev/system", O_RDONLY | O_CLOEXEC)));
+  if (!system.is_valid() || process <= 0) {
+    return -1;
+  }
+  struct process_info info;
+  memset(&info, 0, sizeof(info));
+  info.pid = process - 1;
+  info.version = KERN_SYSTEM_PROCESS_INFO_VERSION;
+  info.struct_size = sizeof(info);
+  if (ioctl(system.get(), KERN_SYSTEM_GET_PROCESS, &info) != 0 ||
+      info.pid != process) {
+    return -1;
+  }
+  return info.ppid;
+}
+
+FilePath GetProcessExecutablePath(ProcessHandle process) {
+  // zedBSD tells no process's executable path.
+  return FilePath();
+}
