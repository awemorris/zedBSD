+// Copyright 2026 The Chromium Authors and zedBSD Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/process/process_iterator.h"
+
+#include <fcntl.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <uapi/system.h>
+#include <unistd.h>
+
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_split.h"
+
+namespace base {
+
+// zedBSD lists the processes through /dev/system: KERN_SYSTEM_GET_PROCESS
+// answers the first process whose pid is above the one asked for, and
+// KERN_SYSTEM_GET_PROCESS_ARGUMENTS a process's arguments after argv[0].
+ProcessIterator::ProcessIterator(const ProcessFilter* filter)
+    : filter_(filter) {
+  system_fd_ = HANDLE_EINTR(open("/dev/system", O_RDONLY | O_CLOEXEC));
+}
+
+ProcessIterator::~ProcessIterator() {
+  if (system_fd_ >= 0) {
+    close(system_fd_);
+  }
+}
+
+bool ProcessIterator::CheckForNextProcess() {
+  if (system_fd_ < 0) {
+    return false;
+  }
+
+  struct process_info info;
+  memset(&info, 0, sizeof(info));
+  info.pid = cursor_pid_;
+  info.version = KERN_SYSTEM_PROCESS_INFO_VERSION;
+  info.struct_size = sizeof(info);
+  if (ioctl(system_fd_, KERN_SYSTEM_GET_PROCESS, &info) != 0 ||
+      info.pid <= cursor_pid_) {
+    return false;
+  }
+  cursor_pid_ = info.pid;
+
+  entry_.pid_ = info.pid;
+  entry_.ppid_ = info.ppid;
+  entry_.gid_ = info.process_group;
+  entry_.exe_file_.assign(info.command,
+                          strnlen(info.command, sizeof(info.command)));
+
+  // The command line: the command, then the arguments after argv[0].
+  entry_.cmd_line_args_.clear();
+  entry_.cmd_line_args_.push_back(entry_.exe_file_);
+  struct system_process_arguments arguments;
+  memset(&arguments, 0, sizeof(arguments));
+  arguments.pid = info.pid;
+  arguments.version = KERN_SYSTEM_PROCESS_ARGUMENTS_VERSION;
+  arguments.struct_size = sizeof(arguments);
+  if (ioctl(system_fd_, KERN_SYSTEM_GET_PROCESS_ARGUMENTS, &arguments) == 0) {
+    const std::string line(
+        arguments.arguments,
+        strnlen(arguments.arguments, sizeof(arguments.arguments)));
+    for (const std::string& argument :
+         SplitString(line, " ", KEEP_WHITESPACE, SPLIT_WANT_NONEMPTY)) {
+      entry_.cmd_line_args_.push_back(argument);
+    }
+  }
+  return true;
+}
+
+bool NamedProcessIterator::IncludeEntry() {
+  if (executable_name_ != entry().exe_file()) {
+    return false;
+  }
+  return ProcessIterator::IncludeEntry();
+}
