+    return info.total;
+  }
+  return ByteSize(0);
+}
+
+// static
+ByteSize SysInfo::AmountOfAvailablePhysicalMemoryImpl() {
+  SystemMemoryInfo info;
+  if (GetSystemMemoryInfo(&info)) {
+    return info.GetAvailablePhysicalMemory();
+  }
+  return ByteSize(0);
+}
