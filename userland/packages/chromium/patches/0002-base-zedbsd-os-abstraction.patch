+// static
+int SysInfo::NumberOfProcessors() {
+  int mib[2] = {CTL_HW, HW_NCPU};
+  int ncpu = 1;
+  size_t len = sizeof(ncpu);
+  if (sysctl(mib, 2, &ncpu, &len, nullptr, 0) == 0 && ncpu > 0) {
+    return ncpu;
+  }
+  return 1;
+}
