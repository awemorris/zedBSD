+bool GetSystemMemoryInfo(SystemMemoryInfo* meminfo) {
+  if (!meminfo) {
+    return false;
+  }
+  *meminfo = SystemMemoryInfo{};
+
+  ScopedFD fd(open("/dev/system", O_RDONLY | O_CLOEXEC));
+  if (!fd.is_valid()) {
+    return false;
+  }
+
+  struct vm_statistics vmstat = {};
+  if (ioctl(fd.get(), KERN_SYSTEM_GET_VMSTAT, &vmstat) != 0) {
+    return false;
+  }
+
+  meminfo->total = ByteSize(vmstat.physical_total);
+  meminfo->free = ByteSize(vmstat.physical_free);
+  meminfo->available = ByteSize(vmstat.physical_free + vmstat.vm_clean);
+  meminfo->swap_total = ByteSize(vmstat.swap_total);
+  meminfo->swap_free = ByteSize(vmstat.swap_free);
+  meminfo->cached = ByteSize(vmstat.vm_clean);
+  meminfo->dirty = ByteSize(vmstat.vm_dirty);
+  return true;
+}
+
+ByteSize SystemMemoryInfo::GetAvailablePhysicalMemory() const {
+  return available.is_zero() ? free : available;
+}
+
+size_t GetSystemCommitChargeFromMeminfo(const SystemMemoryInfo& meminfo) {
+  if (meminfo.total.InBytes() <= meminfo.free.InBytes()) {
+    return 0;
+  }
+  return static_cast<size_t>((meminfo.total - meminfo.free).InKiB());
+}
