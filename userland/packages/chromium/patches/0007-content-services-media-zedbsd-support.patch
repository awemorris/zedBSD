+namespace {
+
+int CollectSharedLibraryPhdr(struct dl_phdr_info* info, size_t size,
+                             void* data) {
+  auto* result = static_cast<std::vector<OS::SharedLibraryAddress>*>(data);
+  if (info->dlpi_name == nullptr || info->dlpi_name[0] == '\0') {
+    return 0;
+  }
+  const char* sep = strrchr(info->dlpi_name, '/');
+  std::string lib_name(sep != nullptr ? sep + 1 : info->dlpi_name);
+  for (ElfW_Half i = 0; i < info->dlpi_phnum; ++i) {
+    const ElfW_Phdr& phdr = info->dlpi_phdr[i];
+    if (phdr.p_type == PT_LOAD && (phdr.p_flags & PF_X) != 0) {
+      uintptr_t start = static_cast<uintptr_t>(info->dlpi_addr + phdr.p_vaddr);
+      uintptr_t end = start + static_cast<uintptr_t>(phdr.p_memsz);
+      result->emplace_back(lib_name, start, end);
+    }
+  }
+  return 0;
+}
+
+}  // namespace
+
+std::vector<OS::SharedLibraryAddress> OS::GetSharedLibraryAddresses() {
+  std::vector<SharedLibraryAddress> result;
+  dl_iterate_phdr(CollectSharedLibraryPhdr, &result);
+  return result;
+}
