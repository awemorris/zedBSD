+void ZedBsdSetCodePermissions(Address addr, size_t size, int prot) {
+  if (size == 0) return;
+  constexpr size_t kPage = 4096;
+  Address start = addr & ~(kPage - 1);
+  Address end = (addr + size + kPage - 1) & ~(kPage - 1);
+  if (start <= 0x10b88a000ULL && end > 0x10b88a000ULL) {
+    fprintf(stderr, "ZEDBSD_MPROT pid=%d tid=%d start=%p len=%zu prot=%d\n",
+            getpid(), v8::base::OS::GetCurrentThreadId(),
+            reinterpret_cast<void*>(start), end - start, prot);
