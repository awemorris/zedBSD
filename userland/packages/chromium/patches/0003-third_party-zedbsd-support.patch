+// wait status helpers
+safe_f! {
+    pub safe fn WIFEXITED(status: c_int) -> bool {
+        (status & 0x7f) == 0
+    }
+    pub safe fn WEXITSTATUS(status: c_int) -> c_int {
+        (status >> 8) & 0xff
+    }
+    pub safe fn WIFSIGNALED(status: c_int) -> bool {
+        ((status & 0x7f) != 0) && ((status & 0x7f) != 0x7f)
+    }
+    pub safe fn WTERMSIG(status: c_int) -> c_int {
+        status & 0x7f
+    }
+    pub safe fn WIFSTOPPED(status: c_int) -> bool {
+        (status & 0xff) == 0x7f
+    }
+    pub safe fn WSTOPSIG(status: c_int) -> c_int {
+        (status >> 8) & 0xff
+    }
+    pub safe fn WIFCONTINUED(status: c_int) -> bool {
+        status == 0xffff
+    }
+    pub safe fn WCOREDUMP(status: c_int) -> bool {
+        (status & 0x80) != 0
+    }
+    pub const safe fn CMSG_ALIGN(len: usize) -> usize {
+        (len + size_of::<usize>() - 1) & !(size_of::<usize>() - 1)
+    }
+    pub const safe fn CMSG_SPACE(length: c_uint) -> c_uint {
+        (CMSG_ALIGN(size_of::<cmsghdr>()) + CMSG_ALIGN(length as usize)) as c_uint
+    }
+    pub const safe fn CMSG_LEN(length: c_uint) -> c_uint {
+        (CMSG_ALIGN(size_of::<cmsghdr>()) + length as usize) as c_uint
+    }
+}
