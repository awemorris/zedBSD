+
+#ifndef RTC_BASE_IFADDRS_ZEDBSD_H_
+#define RTC_BASE_IFADDRS_ZEDBSD_H_
+
+#include <sys/socket.h>  // no-presubmit-check
+
+// Implementation of getifaddrs for zedBSD, whose C library has none: the
+// interfaces come from SIOCGIFCONF and their addresses from SIOCGIFADDR,
+// SIOCGIFNETMASK and SIOCGIFADDRS_IN6.  The list holds the members that
+// WebRTC reads.
+struct ifaddrs {
+  struct ifaddrs* ifa_next;
+  char* ifa_name;
+  unsigned int ifa_flags;
+  struct sockaddr* ifa_addr;
+  struct sockaddr* ifa_netmask;
+};
+
+namespace webrtc {
+
+int getifaddrs(struct ifaddrs** result);
+void freeifaddrs(struct ifaddrs* addrs);
+
+}  // namespace webrtc
+
+#endif  // RTC_BASE_IFADDRS_ZEDBSD_H_
