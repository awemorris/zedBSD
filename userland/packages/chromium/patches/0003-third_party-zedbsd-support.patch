+
+#include "rtc_base/ifaddrs_zedbsd.h"
+
+#include <errno.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <array>
+#include <cstdint>
+
+namespace webrtc {
+
+namespace {
+
+// As many interfaces as one SIOCGIFCONF lists here.
+constexpr size_t kMaxInterfaces = 32;
+
+// One entry with its own copies of the name and the two addresses, or null.
+struct ifaddrs* NewEntry(const char* name,
+                         unsigned int flags,
+                         const struct sockaddr* address,
+                         const struct sockaddr* netmask,
+                         socklen_t length) {
+  struct ifaddrs* entry =
+      static_cast<struct ifaddrs*>(calloc(1, sizeof(struct ifaddrs)));
+  if (entry == nullptr) {
+    return nullptr;
+  }
+  entry->ifa_flags = flags;
+  entry->ifa_name = strdup(name);
+  entry->ifa_addr = static_cast<struct sockaddr*>(malloc(length));
+  entry->ifa_netmask = static_cast<struct sockaddr*>(malloc(length));
+  if (entry->ifa_name == nullptr || entry->ifa_addr == nullptr ||
+      entry->ifa_netmask == nullptr) {
+    freeifaddrs(entry);
+    return nullptr;
+  }
+  memcpy(entry->ifa_addr, address, length);
+  memcpy(entry->ifa_netmask, netmask, length);
+  return entry;
+}
+
+// The IPv6 netmask of a prefix length.
+void PrefixToMask(uint32_t prefix_length, struct sockaddr_in6* mask) {
+  memset(mask, 0, sizeof(*mask));
+  mask->sin6_family = AF_INET6;
+  for (uint32_t i = 0; i < 16; i++) {
+    uint32_t bits = prefix_length > i * 8 ? prefix_length - i * 8 : 0;
+    mask->sin6_addr.s6_addr[i] =
+        bits >= 8 ? 0xff : static_cast<uint8_t>(0xff00 >> bits);
+  }
+}
+
+}  // namespace
+
+int getifaddrs(struct ifaddrs** result) {
+  *result = nullptr;
+  int fd = socket(AF_INET, SOCK_DGRAM, 0);
+  if (fd < 0) {
+    return -1;
+  }
+
+  std::array<struct ifreq, kMaxInterfaces> names = {};
+  struct ifconf list = {};
+  list.ifc_len = sizeof(names);
+  list.ifc_buf = reinterpret_cast<uintptr_t>(names.data());
+  if (ioctl(fd, SIOCGIFCONF, &list) != 0) {
+    int error = errno;
+    close(fd);
+    errno = error;
+    return -1;
+  }
+  size_t count = list.ifc_len / sizeof(names[0]);
+
+  struct ifaddrs** tail = result;
+  for (size_t i = 0; i < count && i < names.size(); i++) {
+    char name[IFNAMSIZ + 1] = {};
+    memcpy(name, names[i].ifr_name, IFNAMSIZ);
+
+    struct ifreq request = {};
+    memcpy(request.ifr_name, name, IFNAMSIZ);
+    if (ioctl(fd, SIOCGIFFLAGS, &request) != 0) {
+      continue;
+    }
+    unsigned int flags = static_cast<unsigned int>(request.ifr_flags);
+
+    // The IPv4 address, if the interface has one.
+    if (ioctl(fd, SIOCGIFADDR, &request) == 0) {
+      struct sockaddr_in address;
+      memcpy(&address, &request.ifr_addr, sizeof(address));
+      struct sockaddr_in netmask = {};
+      netmask.sin_family = AF_INET;
+      if (ioctl(fd, SIOCGIFNETMASK, &request) == 0) {
+        memcpy(&netmask, &request.ifr_addr, sizeof(netmask));
+      }
+      struct ifaddrs* entry = NewEntry(
+          name, flags, reinterpret_cast<const struct sockaddr*>(&address),
+          reinterpret_cast<const struct sockaddr*>(&netmask), sizeof(address));
+      if (entry != nullptr) {
+        *tail = entry;
+        tail = &entry->ifa_next;
+      }
+    }
+
+    // The IPv6 addresses.
+    struct in6_ifaddrs addresses = {};
+    memcpy(addresses.ifa_name, name, IFNAMSIZ);
+    if (ioctl(fd, SIOCGIFADDRS_IN6, &addresses) != 0) {
+      continue;
+    }
+    for (uint32_t j = 0; j < addresses.ifa_count && j < IN6_IFADDRS_MAX; j++) {
+      struct sockaddr_in6 address = {};
+      address.sin6_family = AF_INET6;
+      address.sin6_addr = addresses.ifa_list[j].ife_addr;
+      struct sockaddr_in6 netmask;
+      PrefixToMask(addresses.ifa_list[j].ife_prefixlen, &netmask);
+      struct ifaddrs* entry = NewEntry(
+          name, flags, reinterpret_cast<const struct sockaddr*>(&address),
+          reinterpret_cast<const struct sockaddr*>(&netmask), sizeof(address));
+      if (entry != nullptr) {
+        *tail = entry;
+        tail = &entry->ifa_next;
+      }
+    }
+  }
+  close(fd);
+  return 0;
+}
+
+void freeifaddrs(struct ifaddrs* addrs) {
+  while (addrs != nullptr) {
+    struct ifaddrs* next = addrs->ifa_next;
+    free(addrs->ifa_name);
+    free(addrs->ifa_addr);
+    free(addrs->ifa_netmask);
+    free(addrs);
+    addrs = next;
+  }
+}
+
+}  // namespace webrtc
