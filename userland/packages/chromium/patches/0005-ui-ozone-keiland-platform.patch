+// Copyright 2026 The Chromium Authors and zedBSD Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/keiland/keiland_event_reader.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+
+#include <wayland-client.h>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/posix/eintr_wrapper.h"
+
+namespace ui {
+
+KeilandEventReader::KeilandEventReader(
+    wl_display* display,
+    scoped_refptr<base::SingleThreadTaskRunner> task_runner,
+    base::RepeatingClosure dispatch,
+    base::OnceClosure broken)
+    : display_(display),
+      task_runner_(std::move(task_runner)),
+      dispatch_(std::move(dispatch)),
+      broken_(std::move(broken)),
+      done_(base::WaitableEvent::ResetPolicy::AUTOMATIC,
+            base::WaitableEvent::InitialState::NOT_SIGNALED),
+      thread_("KeilandEventReader") {}
+
+KeilandEventReader::~KeilandEventReader() {
+  StopReading();
+}
+
+bool KeilandEventReader::StartReading() {
+  if (pipe(wake_) != 0) {
+    PLOG(ERROR) << "pipe";
+    return false;
+  }
+  for (int fd : wake_) {
+    fcntl(fd, F_SETFD, FD_CLOEXEC);
+    fcntl(fd, F_SETFL, O_NONBLOCK);
+  }
+  if (!thread_.Start()) {
+    StopReading();
+    return false;
+  }
+  // The thread's one task: the loop runs until StopReading wakes it.
+  thread_.task_runner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&KeilandEventReader::Read, base::Unretained(this)));
+  return true;
+}
+
+void KeilandEventReader::DispatchDone() {
+  done_.Signal();
+}
+
+void KeilandEventReader::StopReading() {
+  stopping_ = true;
+  if (wake_[1] >= 0) {
+    char byte = 0;
+    (void)HANDLE_EINTR(write(wake_[1], &byte, 1));
+  }
+  done_.Signal();
+  // base::Thread may be joined on the window's thread.
+  thread_.Stop();
+  for (int& fd : wake_) {
+    if (fd >= 0) {
+      close(fd);
+      fd = -1;
+    }
+  }
+}
+
+bool KeilandEventReader::RequestDispatch() {
+  if (stopping_) {
+    return false;
+  }
+  task_runner_->PostTask(FROM_HERE, dispatch_);
+  done_.Wait();
+  return !stopping_;
+}
+
+bool KeilandEventReader::Flush(int fd) {
+  while (wl_display_flush(display_) < 0) {
+    if (errno != EAGAIN) {
+      return false;
+    }
+    struct pollfd fds[2] = {{fd, POLLOUT, 0}, {wake_[0], POLLIN, 0}};
+    if (HANDLE_EINTR(poll(fds, 2, -1)) < 0 || fds[1].revents) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void KeilandEventReader::Read() {
+  const int fd = wl_display_get_fd(display_);
+  bool failed = false;
+
+  while (!stopping_) {
+    // Events already queued for the window: let the window take them first.
+    if (wl_display_prepare_read(display_) != 0) {
+      if (!RequestDispatch()) {
+        break;
+      }
+      continue;
+    }
+
+    if (!Flush(fd)) {
+      wl_display_cancel_read(display_);
+      failed = !stopping_;
+      break;
+    }
+
+    struct pollfd fds[2] = {{fd, POLLIN, 0}, {wake_[0], POLLIN, 0}};
+    if (HANDLE_EINTR(poll(fds, 2, -1)) < 0) {
+      wl_display_cancel_read(display_);
+      failed = true;
+      break;
+    }
+    if (fds[1].revents) {
+      wl_display_cancel_read(display_);
+      break;
+    }
+    if (fds[0].revents & POLLIN) {
+      if (wl_display_read_events(display_) < 0) {
+        failed = true;
+        break;
+      }
+    } else {
+      wl_display_cancel_read(display_);
+      if (fds[0].revents & (POLLERR | POLLHUP | POLLNVAL)) {
+        failed = true;
+        break;
+      }
+    }
+
+    if (!RequestDispatch()) {
+      break;
+    }
+  }
+
+  if (failed && !stopping_ && broken_) {
+    LOG(ERROR) << "The connection to the Keiland compositor broke.";
+    task_runner_->PostTask(FROM_HERE, std::move(broken_));
+  }
+}
+
+}  // namespace ui
