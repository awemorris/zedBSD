+std::unique_ptr<gfx::GpuFence>
+VulkanImplementationKeiland::ExportVkFenceToGpuFence(VkDevice vk_device,
+                                                     VkFence vk_fence) {
+  NOTIMPLEMENTED_LOG_ONCE();
+  return nullptr;
+}
+
+VkExternalSemaphoreHandleTypeFlagBits
+VulkanImplementationKeiland::GetExternalSemaphoreHandleType() {
+  return VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT;
+}
+
+bool VulkanImplementationKeiland::CanImportGpuMemoryBuffer(
+    gpu::VulkanDeviceQueue* device_queue,
+    gfx::GpuMemoryBufferType memory_buffer_type) {
+  return false;
+}
