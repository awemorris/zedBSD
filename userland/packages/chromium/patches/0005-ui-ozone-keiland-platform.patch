+#ifndef UI_OZONE_PLATFORM_KEILAND_KEILAND_WINDOW_MANAGER_H_
+#define UI_OZONE_PLATFORM_KEILAND_KEILAND_WINDOW_MANAGER_H_
+
+#include <map>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/synchronization/lock.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/thread_annotations.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/native_ui_types.h"
+
+struct wl_display;
+struct wl_surface;
+
+namespace ui {
+
+class KeilandWindow;
+
+// The windows of the process, by widget.  The window's thread adds and
+// removes them; the GPU's threads (in the same process) look up the
+// window's Wayland objects for its Vulkan surface, and hand CPU frames to
+// the window's thread to be shown.
+class KeilandWindowManager {
+ public:
+  explicit KeilandWindowManager(
+      scoped_refptr<base::SingleThreadTaskRunner> task_runner);
+
+  KeilandWindowManager(const KeilandWindowManager&) = delete;
+  KeilandWindowManager& operator=(const KeilandWindowManager&) = delete;
+
+  ~KeilandWindowManager();
+
+  // On the window's thread.
+  gfx::AcceleratedWidget AddWindow(KeilandWindow* window,
+                                   wl_display* display,
+                                   wl_surface* surface);
+  void RemoveWindow(gfx::AcceleratedWidget widget);
+  KeilandWindow* GetWindow(gfx::AcceleratedWidget widget);
+
+  // On any thread: the window's connection and surface, false when the
+  // widget is not a window of this process.
+  bool GetSurface(gfx::AcceleratedWidget widget,
+                  wl_display** display,
+                  wl_surface** surface);
+
+  // On any thread: shows a CPU frame (premultiplied 0xAARRGGBB words, as
+  // many a row as the size is wide) in the widget's window, on the window's
+  // thread.
+  void PresentFrame(gfx::AcceleratedWidget widget,
+                    const gfx::Size& size,
+                    std::vector<uint32_t> pixels);
+
+ private:
+  struct Entry {
+    raw_ptr<KeilandWindow> window;
+    raw_ptr<wl_display> display;
+    raw_ptr<wl_surface> surface;
+  };
+
+  void PresentOnWindowThread(gfx::AcceleratedWidget widget,
+                             const gfx::Size& size,
+                             std::vector<uint32_t> pixels);
+
+  scoped_refptr<base::SingleThreadTaskRunner> task_runner_;
+  base::Lock lock_;
+  std::map<gfx::AcceleratedWidget, Entry> windows_ GUARDED_BY(lock_);
+  gfx::AcceleratedWidget next_widget_ = 1;
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_KEILAND_KEILAND_WINDOW_MANAGER_H_
