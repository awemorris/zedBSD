+constexpr char kApplicationId[] = "org.chromium.Chromium";
+constexpr uint32_t kDefaultWidth = 1024;
+constexpr uint32_t kDefaultHeight = 768;
+
+// The software compositor's frames are shown by libkeiland's shared memory
+// presenter; the GPU's by its own swapchain on the window's surface.
+bool UsesSoftwareFrames() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  return command_line->HasSwitch("disable-gpu") ||
+         command_line->HasSwitch("disable-gpu-compositing");
+}
+
+int ModifierFlags(unsigned modifiers) {
+  int flags = 0;
+  if (modifiers & KL_MOD_SHIFT) {
+    flags |= EF_SHIFT_DOWN;
+  }
+  if (modifiers & KL_MOD_CTRL) {
+    flags |= EF_CONTROL_DOWN;
+  }
+  if (modifiers & KL_MOD_ALT) {
+    flags |= EF_ALT_DOWN;
+  }
+  if (modifiers & KL_MOD_SUPER) {
+    flags |= EF_COMMAND_DOWN;
+  }
+  return flags;
+}
+
+int ButtonFlag(uint32_t code) {
+  switch (code) {
+    case KL_BUTTON_LEFT:
+      return EF_LEFT_MOUSE_BUTTON;
+    case KL_BUTTON_RIGHT:
+      return EF_RIGHT_MOUSE_BUTTON;
+    case KL_BUTTON_MIDDLE:
+      return EF_MIDDLE_MOUSE_BUTTON;
+    default:
+      return 0;
+  }
+}
+
+base::TimeTicks EventTime(const kl_window_event& input) {
+  // libkeiland's times are CLOCK_MONOTONIC microseconds, base::TimeTicks'
+  // clock.
+  if (input.time_us == 0) {
+    return EventTimeForNow();
+  }
+  return base::TimeTicks() +
+         base::Microseconds(static_cast<int64_t>(input.time_us));
+}
+
+// The first character of a key's UTF-8 text, or 0.
+base_icu::UChar32 FirstCharacter(const char* text) {
+  const size_t length = strnlen(text, KL_WINDOW_TEXT_MAX);
+  if (length == 0) {
+    return 0;
+  }
+  size_t index = 0;
+  base_icu::UChar32 character;
+  CBU8_NEXT(reinterpret_cast<const uint8_t*>(text), index, length, character);
+  return character < 0 ? 0 : character;
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<KeilandWindow> KeilandWindow::Create(
+    PlatformWindowDelegate* delegate,
+    KeilandWindowManager* manager,
+    const PlatformWindowInitProperties& properties) {
+  const bool presents_frames = UsesSoftwareFrames();
+
+  kl_window_options options;
+  memset(&options, 0, sizeof(options));
+  options.title = "Chromium";
+  options.application = kApplicationId;
+  options.width = properties.bounds.width() > 0
+                      ? static_cast<uint32_t>(properties.bounds.width())
+                      : kDefaultWidth;
+  options.height = properties.bounds.height() > 0
+                       ? static_cast<uint32_t>(properties.bounds.height())
+                       : kDefaultHeight;
+  options.present = presents_frames ? KL_PRESENT_SHM : KL_PRESENT_NONE;
+  options.role = KL_WINDOW_ROLE_TOPLEVEL;
+
+  kl_window* window = kl_window_open(&options);
+  if (!window) {
+    PLOG(ERROR) << "kl_window_open";
+    return nullptr;
+  }
+
+  auto result = base::WrapUnique(
+      new KeilandWindow(delegate, manager, window, presents_frames));
+  if (!result->Initialize()) {
+    return nullptr;
+  }
+  return result;
+}
+
+KeilandWindow::KeilandWindow(PlatformWindowDelegate* delegate,
+                             KeilandWindowManager* manager,
+                             kl_window* window,
+                             bool presents_frames)
+    : delegate_(delegate),
+      manager_(manager),
+      window_(window),
+      display_(kl_window_display(window)),
+      presents_frames_(presents_frames) {
+  uint32_t width = 0;
+  uint32_t height = 0;
+  kl_window_size(window_, &width, &height);
+  bounds_ = gfx::Rect(0, 0, static_cast<int>(width), static_cast<int>(height));
+}
+
+KeilandWindow::~KeilandWindow() {
+  repeat_timer_.Stop();
+  if (reader_) {
+    reader_->StopReading();
+    reader_.reset();
+  }
+  if (widget_ != gfx::kNullAcceleratedWidget) {
+    manager_->RemoveWindow(widget_);
+  }
+  kl_window_close(window_);
+}
+
+bool KeilandWindow::Initialize() {
+  widget_ = manager_->AddWindow(this, display_, kl_window_surface(window_));
+
+  reader_ = std::make_unique<KeilandEventReader>(
+      display_, base::SingleThreadTaskRunner::GetCurrentDefault(),
+      base::BindRepeating(&KeilandWindow::Dispatch,
+                          weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(&KeilandWindow::OnConnectionBroken,
+                     weak_ptr_factory_.GetWeakPtr()));
+  if (!reader_->StartReading()) {
+    reader_.reset();
+    return false;
+  }
+
+  delegate_->OnAcceleratedWidgetAvailable(widget_);
+  return true;
+}
+
+void KeilandWindow::Dispatch() {
+  KeilandEventReader* reader = reader_.get();
+  if (kl_window_dispatch(window_, 0) != 0) {
+    reader->DispatchDone();
+    OnConnectionBroken();
+    return;
+  }
+  kl_window_repeat(window_, kl_clock_us());
+
+  // The reader may read on while the input is handed on: the delegate's
+  // callbacks may even destroy the window.
+  reader->DispatchDone();
+  if (!DeliverQueued()) {
+    return;
+  }
+  ScheduleRepeat();
+  Flush();
+}
+
+void KeilandWindow::OnRepeat() {
+  if (kl_window_dispatch(window_, 0) != 0) {
+    OnConnectionBroken();
+    return;
+  }
+  kl_window_repeat(window_, kl_clock_us());
+  if (!DeliverQueued()) {
+    return;
+  }
+  ScheduleRepeat();
+  Flush();
+}
+
+void KeilandWindow::OnConnectionBroken() {
+  repeat_timer_.Stop();
+  delegate_->OnCloseRequest();
+}
+
+bool KeilandWindow::DeliverQueued() {
+  std::vector<kl_window_event> queued;
+  kl_window_event input;
+  while (kl_window_take(window_, &input) > 0) {
+    queued.push_back(input);
+  }
+
+  base::WeakPtr<KeilandWindow> alive = weak_ptr_factory_.GetWeakPtr();
+  for (const kl_window_event& event : queued) {
+    HandleEvent(event);
+    if (!alive) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void KeilandWindow::ScheduleRepeat() {
+  const int wait_ms = kl_window_repeat_wait(window_, kl_clock_us());
+  if (wait_ms < 0) {
+    repeat_timer_.Stop();
+    return;
+  }
+  repeat_timer_.Start(FROM_HERE, base::Milliseconds(wait_ms),
+                      base::BindOnce(&KeilandWindow::OnRepeat,
+                                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void KeilandWindow::Flush() {
+  wl_display_flush(display_);
+}
+
+void KeilandWindow::HandleEvent(const kl_window_event& input) {
+  switch (input.kind) {
+    case KL_WINDOW_MOTION:
+      HandleMotion(input);
+      break;
+    case KL_WINDOW_LEAVE: {
+      MouseEvent event(EventType::kMouseExited, pointer_, pointer_,
+                       EventTime(input),
+                       ModifierFlags(input.modifiers) | button_flags_, 0);
+      delegate_->DispatchEvent(&event);
+      break;
+    }
+    case KL_WINDOW_BUTTON:
+      HandleButton(input);
+      break;
+    case KL_WINDOW_AXIS:
+      HandleAxis(input);
+      break;
+    case KL_WINDOW_KEY:
+      HandleKey(input);
+      break;
+    case KL_WINDOW_FOCUS:
+      active_ = input.pressed != 0;
+      delegate_->OnActivationChanged(active_);
+      break;
+    case KL_WINDOW_RESIZE:
+      HandleResize();
+      break;
+    case KL_WINDOW_CLOSE:
+      delegate_->OnCloseRequest();
+      break;
+    default:
+      // The fingers, the pen, the input method's text, the menus and the
+      // window's own posts are not taken yet.
+      break;
+  }
+}
+
+void KeilandWindow::HandleMotion(const kl_window_event& input) {
+  pointer_ = gfx::PointF(static_cast<float>(input.x),
+                         static_cast<float>(input.y));
+  const EventType type = button_flags_ ? EventType::kMouseDragged
+                                       : EventType::kMouseMoved;
+  MouseEvent event(type, pointer_, pointer_, EventTime(input),
+                   ModifierFlags(input.modifiers) | button_flags_, 0);
+  delegate_->DispatchEvent(&event);
+}
+
+void KeilandWindow::HandleButton(const kl_window_event& input) {
+  const int changed = ButtonFlag(input.code);
+  if (!changed) {
+    return;
+  }
+  pointer_ = gfx::PointF(static_cast<float>(input.x),
+                         static_cast<float>(input.y));
+  EventType type;
+  if (input.pressed) {
+    button_flags_ |= changed;
+    type = EventType::kMousePressed;
+  } else {
+    type = EventType::kMouseReleased;
+  }
+  // A press carries the button it pressed; a release the buttons held before.
+  const int flags = ModifierFlags(input.modifiers) | button_flags_;
+  if (!input.pressed) {
+    button_flags_ &= ~changed;
+  }
+  // A press's and a release's click count are counted by MouseEvent.
+  MouseEvent event(type, pointer_, pointer_, EventTime(input), flags, changed);
+  delegate_->DispatchEvent(&event);
+}
+
+void KeilandWindow::HandleAxis(const kl_window_event& input) {
+  // libkeiland's distances are the surface's pixels, down and right
+  // positive; a wheel's offset is up and left positive.
+  const gfx::Vector2d offset(static_cast<int>(-input.dx),
+                             static_cast<int>(-input.dy));
+  if (offset.IsZero()) {
+    return;
+  }
+  MouseWheelEvent event(offset, pointer_, pointer_, EventTime(input),
+                        ModifierFlags(input.modifiers) | button_flags_, 0);
+  delegate_->DispatchEvent(&event);
+}
+
+void KeilandWindow::HandleKey(const kl_window_event& input) {
+  int flags = ModifierFlags(input.modifiers);
+  if (input.repeated) {
+    flags |= EF_IS_REPEAT;
+  }
+
+  const DomCode dom_code =
+      KeycodeConverter::EvdevCodeToDomCode(static_cast<int>(input.code));
+  KeyboardCode key_code = DomCodeToUsLayoutKeyboardCode(dom_code);
+  DomKey dom_key = DomKey::NONE;
+
+  // The character the backend says the key types, under its own layout;
+  // otherwise the US layout's meaning of the key.
+  const base_icu::UChar32 character =
+      input.pressed ? FirstCharacter(input.text) : 0;
+  if (character >= 0x20 && character != 0x7f) {
+    dom_key = DomKey::FromCharacter(character);
+  } else if (!DomCodeToUsLayoutDomKey(dom_code, flags, &dom_key, &key_code)) {
+    dom_key = DomKey::UNIDENTIFIED;
+  }
+
+  KeyEvent event(input.pressed ? EventType::kKeyPressed
+                               : EventType::kKeyReleased,
+                 key_code, dom_code, flags, dom_key, EventTime(input));
+  delegate_->DispatchEvent(&event);
+}
+
+void KeilandWindow::HandleResize() {
+  uint32_t width = 0;
+  uint32_t height = 0;
+  kl_window_size(window_, &width, &height);
+  const gfx::Rect bounds(0, 0, static_cast<int>(width),
+                         static_cast<int>(height));
+
+  const bool fullscreen = kl_window_fullscreen(window_) != 0;
+  if (fullscreen != fullscreen_) {
+    fullscreen_ = fullscreen;
+    base::WeakPtr<KeilandWindow> alive = weak_ptr_factory_.GetWeakPtr();
+    UpdateWindowState(fullscreen ? PlatformWindowState::kFullScreen
+                                 : PlatformWindowState::kNormal);
+    if (!alive) {
+      return;
+    }
+  }
+
+  if (bounds == bounds_) {
+    return;
+  }
+  bounds_ = bounds;
+  delegate_->OnBoundsChanged({/*origin changed=*/false});
+}
+
+void KeilandWindow::PresentFrame(const gfx::Size& size,
+                                 const std::vector<uint32_t>& pixels) {
+  if (!presents_frames_) {
+    return;
+  }
+  uint32_t width = 0;
+  uint32_t height = 0;
+  if (kl_window_present_resize(window_, &width, &height) != 0) {
+    return;
+  }
+  if (static_cast<int>(width) != size.width() ||
+      static_cast<int>(height) != size.height() ||
+      pixels.size() < static_cast<size_t>(size.GetArea())) {
+    // The compositor resized the window since: the next frame fits it.
+    return;
+  }
+  kl_window_present(window_, pixels.data(),
+                    static_cast<size_t>(size.width()));
+  Flush();
+}
+
+void KeilandWindow::UpdateWindowState(PlatformWindowState state) {
+  if (state == window_state_) {
+    return;
+  }
+  const PlatformWindowState old_state = window_state_;
+  window_state_ = state;
+  delegate_->OnWindowStateChanged(old_state, state);
+}
+
+void KeilandWindow::Show(bool inactive) {
+  visible_ = true;
+}
+
+void KeilandWindow::Hide() {
+  visible_ = false;
+}
+
+void KeilandWindow::Close() {
+  delegate_->OnClosed();
+}
+
+bool KeilandWindow::IsVisible() const {
+  return visible_;
+}
+
+void KeilandWindow::PrepareForShutdown() {}
+
+void KeilandWindow::SetBoundsInPixels(const gfx::Rect& bounds) {
+  // The compositor chooses the window's place and size; a size asked for
+  // here is not passed on yet.
+  if (bounds.size() == bounds_.size()) {
+    return;
+  }
+  NOTIMPLEMENTED_LOG_ONCE();
+}
+
+gfx::Rect KeilandWindow::GetBoundsInPixels() const {
+  return bounds_;
+}
+
+void KeilandWindow::SetBoundsInDIP(const gfx::Rect& bounds) {
+  SetBoundsInPixels(delegate_->ConvertRectToPixels(bounds));
+}
+
+gfx::Rect KeilandWindow::GetBoundsInDIP() const {
+  return delegate_->ConvertRectToDIP(bounds_);
+}
+
+void KeilandWindow::SetTitle(const std::u16string& title) {
+  kl_window_set_title(window_, base::UTF16ToUTF8(title).c_str());
+  Flush();
+}
+
+void KeilandWindow::SetCapture() {}
+
+void KeilandWindow::ReleaseCapture() {}
+
+bool KeilandWindow::HasCapture() const {
+  return false;
+}
+
+void KeilandWindow::SetFullscreen(bool fullscreen, int64_t target_display_id) {
+  kl_window_set_fullscreen(window_, fullscreen ? 1 : 0);
+  Flush();
+}
+
+void KeilandWindow::Maximize() {
+  NOTIMPLEMENTED_LOG_ONCE();
+}
+
+void KeilandWindow::Minimize() {
+  NOTIMPLEMENTED_LOG_ONCE();
+}
+
+void KeilandWindow::Restore() {
+  if (fullscreen_) {
+    SetFullscreen(false, display::kInvalidDisplayId);
+  }
+}
+
+PlatformWindowState KeilandWindow::GetPlatformWindowState() const {
+  return window_state_;
+}
+
+void KeilandWindow::Activate() {}
+
+void KeilandWindow::Deactivate() {}
+
+void KeilandWindow::SetUseNativeFrame(bool use_native_frame) {}
+
+bool KeilandWindow::ShouldUseNativeFrame() const {
+  // The compositor draws the titlebar of a libkeiland window.
+  return true;
+}
+
+void KeilandWindow::SetCursor(scoped_refptr<PlatformCursor> cursor) {}
+
+void KeilandWindow::MoveCursorTo(const gfx::Point& location) {}
+
+void KeilandWindow::ConfineCursorToBounds(const gfx::Rect& bounds) {}
+
+void KeilandWindow::SetRestoredBoundsInDIP(const gfx::Rect& bounds) {
+  restored_bounds_ = delegate_->ConvertRectToPixels(bounds);
+}
+
+gfx::Rect KeilandWindow::GetRestoredBoundsInDIP() const {
+  return delegate_->ConvertRectToDIP(restored_bounds_.value_or(bounds_));
+}
