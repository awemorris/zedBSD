+// Copyright 2026 The Chromium Authors and zedBSD Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_OZONE_PLATFORM_KEILAND_KEILAND_EVENT_READER_H_
+#define UI_OZONE_PLATFORM_KEILAND_KEILAND_EVENT_READER_H_
+
+#include <atomic>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/synchronization/waitable_event.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/threading/thread.h"
+
+struct wl_display;
+
+namespace ui {
+
+// Reads a window's Wayland connection on a thread of its own and asks the
+// window's thread to dispatch what came.
+//
+// The window's connection is shared with the GPU's Vulkan swapchain, which
+// reads it on its own event queue; libwayland lets several threads read one
+// connection when each announces its read (wl_display_prepare_read).  This
+// thread announces the reads of the default queue, the window's: when events
+// wait in it, or once the connection has been read, it posts `dispatch` to
+// the window's thread and waits until the window calls DispatchDone(), so
+// that the window's own dispatch (kl_window_dispatch) never runs alongside
+// this thread's read.  `broken` is posted once the connection fails.
+class KeilandEventReader {
+ public:
+  KeilandEventReader(wl_display* display,
+                     scoped_refptr<base::SingleThreadTaskRunner> task_runner,
+                     base::RepeatingClosure dispatch,
+                     base::OnceClosure broken);
+
+  KeilandEventReader(const KeilandEventReader&) = delete;
+  KeilandEventReader& operator=(const KeilandEventReader&) = delete;
+
+  ~KeilandEventReader();
+
+  // Opens the wake pipe and starts the thread.  Returns false when either
+  // cannot be made.
+  bool StartReading();
+
+  // Called on the window's thread once a posted dispatch is done.
+  void DispatchDone();
+
+  // Stops the thread and waits for it; called on the window's thread.
+  void StopReading();
+
+ private:
+  // The reader's loop, run as the thread's one task.
+  void Read();
+
+  // Posts the dispatch and waits for it; false when stopping.
+  bool RequestDispatch();
+
+  // Writes what is queued to the compositor; false when the connection broke
+  // or the reader stops.
+  bool Flush(int fd);
+
+  raw_ptr<wl_display> display_;
+  scoped_refptr<base::SingleThreadTaskRunner> task_runner_;
+  base::RepeatingClosure dispatch_;
+  base::OnceClosure broken_;
+  base::WaitableEvent done_;
+  std::atomic<bool> stopping_{false};
+  int wake_[2] = {-1, -1};
+  base::Thread thread_;
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_KEILAND_KEILAND_EVENT_READER_H_
