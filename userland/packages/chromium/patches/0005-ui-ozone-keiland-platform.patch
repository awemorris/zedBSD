+gfx::AcceleratedWidget KeilandWindowManager::AddWindow(KeilandWindow* window,
+                                                       wl_display* display,
+                                                       wl_surface* surface) {
+  DCHECK(task_runner_->BelongsToCurrentThread());
+  base::AutoLock hold(lock_);
+  const gfx::AcceleratedWidget widget = next_widget_++;
+  windows_[widget] = Entry{window, display, surface};
+  return widget;
+}
+
+void KeilandWindowManager::RemoveWindow(gfx::AcceleratedWidget widget) {
+  DCHECK(task_runner_->BelongsToCurrentThread());
+  base::AutoLock hold(lock_);
+  windows_.erase(widget);
+}
+
+KeilandWindow* KeilandWindowManager::GetWindow(gfx::AcceleratedWidget widget) {
+  DCHECK(task_runner_->BelongsToCurrentThread());
+  base::AutoLock hold(lock_);
+  auto it = windows_.find(widget);
+  return it == windows_.end() ? nullptr : it->second.window.get();
+}
+
+bool KeilandWindowManager::GetSurface(gfx::AcceleratedWidget widget,
+                                      wl_display** display,
+                                      wl_surface** surface) {
+  base::AutoLock hold(lock_);
+  auto it = windows_.find(widget);
+  if (it == windows_.end()) {
+    return false;
+  }
+  *display = it->second.display;
+  *surface = it->second.surface;
+  return true;
+}
+
+void KeilandWindowManager::PresentFrame(gfx::AcceleratedWidget widget,
+                                        const gfx::Size& size,
+                                        std::vector<uint32_t> pixels) {
+  // The manager lives as long as the platform, which outlives the threads
+  // that present.
+  task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&KeilandWindowManager::PresentOnWindowThread,
+                     base::Unretained(this), widget, size, std::move(pixels)));
+}
+
+void KeilandWindowManager::PresentOnWindowThread(gfx::AcceleratedWidget widget,
+                                                 const gfx::Size& size,
+                                                 std::vector<uint32_t> pixels) {
+  KeilandWindow* window = GetWindow(widget);
+  if (window) {
+    window->PresentFrame(size, pixels);
+  }
+}
+
