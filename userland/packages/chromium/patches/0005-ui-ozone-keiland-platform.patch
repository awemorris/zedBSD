+#include "ui/ozone/platform/keiland/vulkan_implementation_keiland.h"
+#endif
+
+namespace ui {
+
+namespace {
+
+// The software compositor's canvas: each frame is copied and shown by the
+// window's thread through libkeiland's shared memory presenter.
+class KeilandCanvasSurface : public SurfaceOzoneCanvas {
+ public:
+  KeilandCanvasSurface(KeilandWindowManager* manager,
+                       gfx::AcceleratedWidget widget)
+      : manager_(manager), widget_(widget) {}
+
+  KeilandCanvasSurface(const KeilandCanvasSurface&) = delete;
+  KeilandCanvasSurface& operator=(const KeilandCanvasSurface&) = delete;
+
+  ~KeilandCanvasSurface() override = default;
+
+  // SurfaceOzoneCanvas:
+  void ResizeCanvas(const gfx::Size& viewport_size, float scale) override {
+    size_ = viewport_size;
+    SkSurfaceProps props = skia::LegacyDisplayGlobals::GetSkSurfaceProps();
+    // libkeiland's frames are premultiplied 0xAARRGGBB words: BGRA in
+    // memory on a little-endian machine.
+    surface_ = SkSurfaces::Raster(
+        SkImageInfo::Make(viewport_size.width(), viewport_size.height(),
+                          kBGRA_8888_SkColorType, kPremul_SkAlphaType),
+        &props);
+  }
+
+  SkCanvas* GetCanvas() override { return surface_->getCanvas(); }
+
+  void PresentCanvas(const gfx::Rect& damage) override {
+    SkPixmap pixmap;
+    if (!surface_ || !surface_->peekPixels(&pixmap)) {
+      return;
+    }
+    const size_t width = static_cast<size_t>(size_.width());
+    const size_t height = static_cast<size_t>(size_.height());
+    std::vector<uint32_t> pixels(width * height);
+    for (size_t row = 0; row < height; row++) {
+      memcpy(&pixels[row * width], pixmap.addr32(0, static_cast<int>(row)),
+             width * sizeof(uint32_t));
+    }
+    manager_->PresentFrame(widget_, size_, std::move(pixels));
+  }
+
+  std::unique_ptr<gfx::VSyncProvider> CreateVSyncProvider() override {
+    return nullptr;
+  }
+
+ private:
+  raw_ptr<KeilandWindowManager> manager_;
+  gfx::AcceleratedWidget widget_;
+  gfx::Size size_;
+  sk_sp<SkSurface> surface_;
+};
+
+}  // namespace
+
+KeilandSurfaceFactory::KeilandSurfaceFactory(KeilandWindowManager* manager)
+    : manager_(manager) {}
+
+KeilandSurfaceFactory::~KeilandSurfaceFactory() = default;
+
+std::vector<gl::GLImplementationParts>
+KeilandSurfaceFactory::GetAllowedGLImplementations() {
+  // No GL: the GPU draws with Vulkan.
+  return {};
+}
+
+GLOzone* KeilandSurfaceFactory::GetGLOzone(
+    const gl::GLImplementationParts& implementation) {
+  return nullptr;
+}
+
+#if BUILDFLAG(ENABLE_VULKAN)
+std::unique_ptr<gpu::VulkanImplementation>
+KeilandSurfaceFactory::CreateVulkanImplementation(bool use_swiftshader,
+                                                  bool allow_protected_memory) {
+  return std::make_unique<VulkanImplementationKeiland>(manager_,
+                                                       use_swiftshader);
+}
+#endif  // BUILDFLAG(ENABLE_VULKAN)
+
+std::unique_ptr<SurfaceOzoneCanvas>
+KeilandSurfaceFactory::CreateCanvasForWidget(gfx::AcceleratedWidget widget) {
+  wl_display* display = nullptr;
+  wl_surface* surface = nullptr;
+  if (!manager_->GetSurface(widget, &display, &surface)) {
+    LOG(ERROR) << "No Keiland window " << widget
+               << " in this process: run with --in-process-gpu.";
+    return nullptr;
+  }
+  return std::make_unique<KeilandCanvasSurface>(manager_, widget);
+}
+
+}  // namespace ui
