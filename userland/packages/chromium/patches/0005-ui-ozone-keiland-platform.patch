+ public:
+  VulkanSurfaceKeiland(VkInstance vk_instance,
+                       VkSurfaceKHR vk_surface,
+                       gfx::AcceleratedWidget widget)
+      : gpu::VulkanSurface(vk_instance, widget, vk_surface) {}
+
+  VulkanSurfaceKeiland(const VulkanSurfaceKeiland&) = delete;
+  VulkanSurfaceKeiland& operator=(const VulkanSurfaceKeiland&) = delete;
+
+  ~VulkanSurfaceKeiland() override = default;
+};
+
+}  // namespace
+
+VulkanImplementationKeiland::VulkanImplementationKeiland(
+    KeilandWindowManager* manager,
+    bool use_swiftshader)
+    : gpu::VulkanImplementation(use_swiftshader), manager_(manager) {}
+
+VulkanImplementationKeiland::~VulkanImplementationKeiland() = default;
+
+bool VulkanImplementationKeiland::InitializeVulkanInstance(bool using_surface) {
+  using_surface_ = using_surface;
+  std::vector<const char*> required_extensions;
+  if (using_surface_) {
+    required_extensions.push_back(VK_KHR_SURFACE_EXTENSION_NAME);
+    required_extensions.push_back(VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME);
+  }
+  return vulkan_instance_.Initialize(base::FilePath("libvulkan.so"),
+                                     required_extensions, {});
+}
+
+gpu::VulkanInstance* VulkanImplementationKeiland::GetVulkanInstance() {
+  return &vulkan_instance_;
+}
+
+std::unique_ptr<gpu::VulkanSurface>
+VulkanImplementationKeiland::CreateViewSurface(gfx::AcceleratedWidget window) {
+  if (!using_surface_) {
+    return nullptr;
+  }
+
+  wl_display* display = nullptr;
+  wl_surface* surface = nullptr;
+  if (!manager_->GetSurface(window, &display, &surface)) {
+    LOG(ERROR) << "No Keiland window " << window
+               << " in this process: run with --in-process-gpu.";
+    return nullptr;
+  }
+
+  const VkInstance instance = vulkan_instance_.vk_instance();
+  auto create = reinterpret_cast<PFN_vkCreateWaylandSurfaceKHR>(
+      gpu::GetVulkanFunctionPointers()->vkGetInstanceProcAddr(
+          instance, "vkCreateWaylandSurfaceKHR"));
+  if (!create) {
+    LOG(ERROR) << "vkCreateWaylandSurfaceKHR is missing.";
+    return nullptr;
+  }
+
+  VkWaylandSurfaceCreateInfoKHR info = {};
+  info.sType = VK_STRUCTURE_TYPE_WAYLAND_SURFACE_CREATE_INFO_KHR;
+  info.display = display;
+  info.surface = surface;
+  VkSurfaceKHR vk_surface = VK_NULL_HANDLE;
+  const VkResult result = create(instance, &info, nullptr, &vk_surface);
+  if (result != VK_SUCCESS) {
+    LOG(ERROR) << "vkCreateWaylandSurfaceKHR() failed: " << result;
+    return nullptr;
+  }
+  return std::make_unique<VulkanSurfaceKeiland>(instance, vk_surface, window);
+}
+
+bool VulkanImplementationKeiland::GetPhysicalDevicePresentationSupport(
+    VkPhysicalDevice device,
+    const std::vector<VkQueueFamilyProperties>& queue_family_properties,
+    uint32_t queue_family_index) {
+  // Every window has a connection of its own, and none may exist yet: the
+  // swapchain's creation finds out whether the queue presents to it.
+  return true;
+}
+
+std::vector<const char*>
+VulkanImplementationKeiland::GetRequiredDeviceExtensions() {
+  std::vector<const char*> extensions;
+  if (using_surface_) {
+    extensions.push_back(VK_KHR_SWAPCHAIN_EXTENSION_NAME);
+  }
+  return extensions;
+}
+
+std::vector<const char*>
+VulkanImplementationKeiland::GetOptionalDeviceExtensions() {
+  return {
+      VK_KHR_EXTERNAL_MEMORY_EXTENSION_NAME,
+      VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME,
+      VK_KHR_EXTERNAL_SEMAPHORE_EXTENSION_NAME,
+      VK_KHR_EXTERNAL_SEMAPHORE_FD_EXTENSION_NAME,
+      VK_KHR_INCREMENTAL_PRESENT_EXTENSION_NAME,
+  };
+}
+
+VkFence VulkanImplementationKeiland::CreateVkFenceForGpuFence(
+    VkDevice vk_device) {
+  NOTIMPLEMENTED_LOG_ONCE();
+  return VK_NULL_HANDLE;
+}
