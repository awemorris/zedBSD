#version 450
// Stage 1: gl_NumWorkGroups and gl_WorkGroupSize of a 3 x 2 x 2 dispatch, six words per invocation.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 2, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) writeonly buffer Out { uint o[]; };
void main()
{
	uvec3 g = gl_GlobalInvocationID;
	uint slot = (g.z * 2u + g.y) * 6u + g.x;
	o[slot * 6u + 0u] = gl_NumWorkGroups.x;
	o[slot * 6u + 1u] = gl_NumWorkGroups.y;
	o[slot * 6u + 2u] = gl_NumWorkGroups.z;
	o[slot * 6u + 3u] = gl_WorkGroupSize.x;
	o[slot * 6u + 4u] = gl_WorkGroupSize.y;
	o[slot * 6u + 5u] = gl_WorkGroupSize.z;
}
