#version 450
// Stage 1: buffers in two descriptor sets with a gap in the bindings of the second (o = 2a + b).
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer A { uint a[]; };
layout(std430, set = 1, binding = 0) readonly buffer B { uint b[]; };
layout(std430, set = 1, binding = 2) writeonly buffer Out { uint o[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	o[i] = a[i] * 2u + b[i];
}
