#version 450
// Stage 3: unsigned and signed atomicMin and atomicMax on a storage buffer.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, set = 0, binding = 1) buffer U { uint umin[4]; uint umax[4]; };
layout(std430, set = 0, binding = 2) buffer S { int smin[4]; int smax[4]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint v = src[i];
	uint k = i & 3u;
	atomicMin(umin[k], v);
	atomicMax(umax[k], v);
	atomicMin(smin[k], int(v));
	atomicMax(smax[k], int(v));
}
