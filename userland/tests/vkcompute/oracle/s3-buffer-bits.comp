#version 450
// Stage 3: atomicAnd, atomicOr and atomicXor on a storage buffer.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, set = 0, binding = 1) buffer Bits { uint ands[4]; uint ors[4]; uint xors[4]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint v = src[i];
	uint k = i & 3u;
	atomicAnd(ands[k], v | (1u << ((i >> 2) & 31u)));
	atomicOr(ors[k], v & (1u << ((i >> 2) & 31u)));
	atomicXor(xors[k], v);
}
