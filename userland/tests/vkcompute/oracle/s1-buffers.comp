#version 450
// Stage 1: four storage buffers in one set, three read and one written (o = a + b * c).
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer A { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer B { uint b[]; };
layout(std430, set = 0, binding = 2) readonly buffer C { uint c[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Out { uint o[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	o[i] = a[i] + b[i] * c[i];
}
