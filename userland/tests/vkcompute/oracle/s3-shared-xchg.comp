#version 450
// Stage 3: atomicExchange and atomicCompSwap on shared memory, checked per workgroup.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) writeonly buffer Old { uint old[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Final { uint final_value[]; };
shared uint x;
shared uint w;
void main()
{
	uint l = gl_LocalInvocationID.x;
	uint i = gl_GlobalInvocationID.x;
	if (l == 0u) {
		x = 0u;
		w = 0u;
	}
	barrier();
	old[i * 2u + 0u] = atomicExchange(x, l + 1u);
	old[i * 2u + 1u] = atomicCompSwap(w, 0u, l + 1u);
	barrier();
	if (l == 0u) {
		final_value[gl_WorkGroupID.x * 2u + 0u] = x;
		final_value[gl_WorkGroupID.x * 2u + 1u] = w;
	}
}
