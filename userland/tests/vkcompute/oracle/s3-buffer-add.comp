#version 450
// Stage 3: atomicAdd on a storage buffer; the old values one counter returns must be 0 to N-1 once each.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Counters { uint counter; uint sums[8]; };
layout(std430, set = 0, binding = 1) writeonly buffer Old { uint old[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	old[i] = atomicAdd(counter, 1u);
	atomicAdd(sums[i & 7u], i);
}
