#version 450
// Stage 1: three dispatches that each read what the one before wrote (a barrier between them).
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(push_constant, std430) uniform Push { uint src; uint dst; uint pass; } pc;
layout(std430, set = 0, binding = 0) buffer Data { uint d[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint next = (i + 1u) & 4095u;
	d[pc.dst + i] = d[pc.src + i] * 2u + d[pc.src + next] + pc.pass;
}
