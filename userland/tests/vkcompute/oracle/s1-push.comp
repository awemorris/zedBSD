#version 450
// Stage 1: four push constants (two integers, a float and a mask) read by every invocation.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(push_constant, std430) uniform Push { uint mul; uint add; float scale; uint mask; } pc;
layout(std430, set = 0, binding = 0) writeonly buffer Out { uint o[]; };
layout(std430, set = 0, binding = 1) writeonly buffer FOut { float f[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	o[i] = (i * pc.mul + pc.add) ^ pc.mask;
	f[i] = float(i) * pc.scale;
}
