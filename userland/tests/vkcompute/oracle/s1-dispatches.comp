#version 450
// Stage 1: three dispatches in one command buffer, each writing its own range named by push constants.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(push_constant, std430) uniform Push { uint base; uint mul; } pc;
layout(std430, set = 0, binding = 0) writeonly buffer Out { uint o[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	o[pc.base + i] = i * pc.mul + pc.base;
}
