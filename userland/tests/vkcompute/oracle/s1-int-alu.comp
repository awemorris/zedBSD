#version 450
// Stage 1: 32-bit integer add, subtract, multiply, bitwise and shifts (ten words per invocation).
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer A { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer B { uint b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Out { uint o[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint x = a[i];
	uint y = b[i];
	uint s = y & 31u;
	o[i * 10u + 0u] = x + y;
	o[i * 10u + 1u] = x - y;
	o[i * 10u + 2u] = x * y;
	o[i * 10u + 3u] = x & y;
	o[i * 10u + 4u] = x | y;
	o[i * 10u + 5u] = x ^ y;
	o[i * 10u + 6u] = x << s;
	o[i * 10u + 7u] = x >> s;
	o[i * 10u + 8u] = uint(int(x) >> int(s));
	o[i * 10u + 9u] = ~x + uint(-int(y));
}
