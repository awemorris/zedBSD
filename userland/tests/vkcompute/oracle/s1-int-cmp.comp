#version 450
// Stage 1: unsigned and signed comparisons, selection, min, max and clamp (eight words per invocation).
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer A { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer B { uint b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Out { uint o[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint x = a[i];
	uint y = b[i];
	o[i * 8u + 0u] = x < y ? 1u : 0u;
	o[i * 8u + 1u] = int(x) < int(y) ? 1u : 0u;
	o[i * 8u + 2u] = x == y ? 7u : 9u;
	o[i * 8u + 3u] = min(x, y);
	o[i * 8u + 4u] = max(x, y);
	o[i * 8u + 5u] = uint(min(int(x), int(y)));
	o[i * 8u + 6u] = uint(max(int(x), int(y)));
	o[i * 8u + 7u] = uint(clamp(int(x), -1000, 1000));
}
