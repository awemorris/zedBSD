#version 450
// Stage 1: a workgroup of 64 invocations; each word names its global and local index.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) writeonly buffer Out { uint o[]; };
void main()
{
	uint i = gl_GlobalInvocationID.x;
	o[i] = (i * 0x9e3779b1u) ^ (gl_LocalInvocationID.x << 20) ^ (gl_WorkGroupID.x << 8);
}
