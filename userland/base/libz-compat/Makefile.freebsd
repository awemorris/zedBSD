KEILAND_FREEBSD_Z_COMPAT_SOURCES := $(LIBZ_COMPAT_SOURCES)
$(eval $(call KEILAND_FREEBSD_LIBRARY,z-compat,libz-compat.so,$(KEILAND_FREEBSD_Z_COMPAT_SOURCES),,,userland/base/libz-compat/exports.map))
