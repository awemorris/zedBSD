# zedBSD sshd configuration.
# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib

Port 22
AddressFamily inet
ListenAddress 0.0.0.0

# The one kind of host key the server offers; sshd-start makes it the first time.
HostKey /etc/ssh/ssh_host_ed25519_key

PermitRootLogin yes
PasswordAuthentication yes
PermitEmptyPasswords no
PubkeyAuthentication yes

# The system has no name service of its own to consult about its clients.
UseDNS no

# Port forwarding (ssh -L, -R) is allowed by default, as in OpenSSH; a
# forwarded port of -R listens on the loopback address only.  To turn it
# off or narrow it:
#AllowTcpForwarding yes
#GatewayPorts no
#PermitOpen any
#PermitListen any
#DisableForwarding no

Subsystem sftp /usr/libexec/sftp-server
