// Frontend notifications carry no installation decisions.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
func instNotifyStage(context, title) {
    if (context == 0 || !Dict.hasKey(context, "ui")) { return; }
    if (context.ui == 0) { print("Install zedBSD: " + title); }
    else { context.ui.stage(context.ui, title); }
}
