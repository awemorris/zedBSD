KEILAND_FREEBSD_GIF_COMPAT_SOURCES := $(LIBGIF_COMPAT_SOURCES)
$(eval $(call KEILAND_FREEBSD_LIBRARY,gif-compat,libgif-compat.so,$(KEILAND_FREEBSD_GIF_COMPAT_SOURCES),,-lm,userland/desktop/libgif-compat/exports.map))
