include $(dir $(lastword $(MAKEFILE_LIST)))sources.mk
# The Linux build of libjpeg-compat.so; the zedBSD build remains in Makefile.
# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
KEILAND_LINUX_JPEG_COMPAT_SOURCES := $(LIBJPEG_COMPAT_SOURCES)
$(eval $(call KEILAND_LINUX_LIBRARY,jpeg-compat,libjpeg-compat.so,$(KEILAND_LINUX_JPEG_COMPAT_SOURCES),,-lm,userland/desktop/libjpeg-compat/exports.map))
