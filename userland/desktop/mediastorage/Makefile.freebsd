KEILAND_FREEBSD_MEDIASTORAGE_SOURCES := \
	userland/desktop/mediastorage/main.c \
	userland/desktop/mediastorage/notify.c \
	userland/desktop/mediastorage/database.c \
	userland/desktop/mediastorage/json.c \
	userland/desktop/photos/cache-folders.c \
	userland/desktop/photos/import.c \
	userland/desktop/photos/exif.c \
	userland/desktop/photos/library.c \
	userland/desktop/photos/snapshot.c \
	userland/desktop/picture/picture.c \
	userland/desktop/preview/client.c \
	userland/desktop/preview/freebsd/spawn.c \
	userland/desktop/preview/make.c \
	userland/desktop/preview/decode.c \
	userland/desktop/preview/scale.c \
	userland/desktop/preview/info.c

$(eval $(call KEILAND_FREEBSD_PROGRAM,mediastorage,bin,$(KEILAND_FREEBSD_MEDIASTORAGE_SOURCES),libkeiland-compat.a libkeiland.so libwayland-client.so libpdf.so libtruetype.so libpng-compat.so libjpeg-compat.so libgif-compat.so libz-compat.so,-lm))
