# zedBSD's Wayland EGL window library (userland/desktop/libwayland-egl).
# The headers are in the sysroot's usr/include, so there are no Cflags.
# The version is the one upstream gives its wayland-egl.

prefix=/usr
libdir=${prefix}/lib
includedir=${prefix}/include

Name: wayland-egl
Description: zedBSD Wayland EGL window library
Version: 18.1.0
Requires: wayland-client
Libs: -L${libdir} -lwayland-egl
Cflags:
