KEILAND_LINUX_KEILAND_SOURCES := $(LIBKEILAND_SOURCES)
$(eval $(call KEILAND_LINUX_LIBRARY,keiland,libkeiland.so,$(KEILAND_LINUX_KEILAND_SOURCES),libwayland-client.so libtruetype.so libpng-compat.so libvulkan.so.1,-lm,userland/desktop/libkeiland/exports.map))
