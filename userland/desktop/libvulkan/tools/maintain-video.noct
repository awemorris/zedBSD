func starts(text, prefix) { return String.substring(text, 0, String.charCount(prefix)) == prefix; }
func lines(text) {
    var result = []; var start = 0;
    for (i in 0..String.charCount(text)) {
        if (String.charAt(text, i) == "\n") {
            Array.push(result, String.substring(text, start, i - start)); start = i + 1;
        }
    }
    return result;
}
func guardName(line) {
    // "// VK_KHR_video_queue is a preprocessor guard. Do not pass it to API calls."
    var end = String.indexOf(line, " is a preprocessor guard.");
    if (!starts(line, "// VK_") || end < 0) { return ""; }
    return String.substring(line, 3, end - 3);
}
func main(args) {
    if (Array.size(args) != 2) { System.error("usage: maintain-video.noct VULKAN_CORE_1_4_309_H OUTPUT_HEADER"); }
    var input = FileUtil.readText(args[0]);
    if (String.indexOf(input, "#define VK_HEADER_VERSION 309\n") < 0) { System.error("expected the Vulkan-Headers 1.4.309 declaration data"); }
    var source = lines(input);
    var extensions = ["VK_KHR_video_queue", "VK_KHR_video_decode_queue", "VK_KHR_video_decode_h264", "VK_KHR_video_decode_h265", "VK_KHR_synchronization2"];
    var structs = ["VkMemoryBarrier2", "VkBufferMemoryBarrier2", "VkImageMemoryBarrier2", "VkDependencyInfo", "VkSemaphoreSubmitInfo", "VkCommandBufferSubmitInfo", "VkSubmitInfo2", "VkPhysicalDeviceSynchronization2Features"];
    var singles = ["typedef uint64_t VkFlags64;", "typedef VkFlags64 VkPipelineStageFlags2;", "typedef VkFlags64 VkPipelineStageFlagBits2;", "typedef VkFlags64 VkAccessFlags2;", "typedef VkFlags64 VkAccessFlagBits2;", "typedef VkFlags VkSubmitFlags;"];
    var core = ""; var body = ""; var section = ""; var active = false; var selected = false;
    var structCount = 0; var singleCount = 0; var constants = 0; var commands = 0; var blocks = 0;
    for (i in 0..Array.size(source)) {
        var line = source[i];
        var guard = guardName(line);
        if (guard != "") {
            section = guard; selected = false;
            for (n in 0..Array.size(extensions)) {
                if (guard == extensions[n]) { selected = true; blocks = blocks + 1; }
            }
        }
        if (selected) {
            if (starts(line, "VKAPI_ATTR ")) { commands = commands + 1; }
            body = body + line + "\n";
            continue;
        }
        if (section != "VK_VERSION_1_3") { continue; }
        if (!active) {
            for (n in 0..Array.size(singles)) {
                if (line == singles[n]) { core = core + line + "\n"; singleCount = singleCount + 1; }
            }
            if (starts(line, "static const VkPipelineStageFlagBits2 ") || starts(line, "static const VkAccessFlagBits2 ")) {
                core = core + line + "\n"; constants = constants + 1;
            }
            if (line == "typedef enum VkSubmitFlagBits {") {
                active = true; core = core + "\n/* Preserves the registry ABI of VkSubmitFlagBits. */\n";
            }
            for (n in 0..Array.size(structs)) {
                if (line == "typedef struct " + structs[n] + " {") {
                    active = true; structCount = structCount + 1;
                    core = core + "\n/* Preserves the registry ABI of " + structs[n] + ". */\n";
                }
            }
        }
        if (active) {
            core = core + line + "\n";
            if (starts(line, "}")) { active = false; }
        }
    }
    if (blocks != 5 || structCount != 8 || singleCount != 6 || constants < 80 || commands != 19) {
        System.error("unexpected selected declarations: " + blocks + " extensions, " + structCount + " structures, " + singleCount + " typedefs, " + constants + " constants, " + commands + " commands");
    }
    var preamble = "/*\n * zedBSD\n * Copyright (C) 2026 Awe Morris\n *\n * The zedBSD selection, formatting and additions in this file are Zlib.\n */\n\n/*\n * This file is a derived work of the Khronos Vulkan-Headers\n * (Vulkan Video H.264 and H.265 decode and synchronization2).\n * The Vulkan API declarations it contains are:\n * Copyright 2015-2025 The Khronos Group Inc.\n *\n * SPDX-License-Identifier: Apache-2.0\n *\n * See API-PROVENANCE.md and LICENSE-API for the pinned declaration source.\n */\n\n#ifndef VULKAN_VIDEO_H_\n#define VULKAN_VIDEO_H_ 1\n\n#include \"vulkan_core.h\"\n#include \"vk_video/vulkan_video_codec_h264std_decode.h\"\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n/* The Vulkan 1.3 types synchronization2's names alias. */\n";
    FileUtil.writeText(args[1], preamble + core + "\n" + body + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n");
    print("maintained " + commands + " video and synchronization2 commands, " + structCount + " Vulkan 1.3 structures, " + constants + " stage and access constants");
}
