func starts(text, prefix) { return String.substring(text, 0, String.charCount(prefix)) == prefix; }
func lines(text) {
    var result = []; var start = 0;
    for (i in 0..String.charCount(text)) {
        if (String.charAt(text, i) == "\n") {
            Array.push(result, String.substring(text, start, i - start)); start = i + 1;
        }
    }
    return result;
}
func includes(names, name) {
    for (i in 0..Array.size(names)) { if (names[i] == name) { return true; } }
    return false;
}
func main(args) {
    if (Array.size(args) != 2) { System.error("usage: maintain-external.noct PINNED_HEADER OUTPUT_HEADER"); }
    var input = FileUtil.readText(args[0]);
    if (String.indexOf(input, "#define VK_HEADER_VERSION 269\n") < 0) { System.error("expected pinned 1.3.269 declarations"); }
    var source = lines(input);
    var types = ["VkExternalMemoryHandleTypeFlagBits", "VkExternalMemoryFeatureFlagBits", "VkExternalFenceHandleTypeFlagBits", "VkExternalFenceFeatureFlagBits", "VkFenceImportFlagBits", "VkPhysicalDeviceFeatures2", "VkPhysicalDeviceProperties2", "VkFormatProperties2", "VkImageFormatProperties2", "VkPhysicalDeviceImageFormatInfo2", "VkQueueFamilyProperties2", "VkPhysicalDeviceMemoryProperties2", "VkSparseImageFormatProperties2", "VkPhysicalDeviceSparseImageFormatInfo2", "VkExternalMemoryProperties", "VkPhysicalDeviceExternalImageFormatInfo", "VkExternalImageFormatProperties", "VkPhysicalDeviceExternalBufferInfo", "VkExternalBufferProperties", "VkPhysicalDeviceIDProperties", "VkExternalMemoryImageCreateInfo", "VkExternalMemoryBufferCreateInfo", "VkExportMemoryAllocateInfo", "VkPhysicalDeviceExternalFenceInfo", "VkExternalFenceProperties", "VkExportFenceCreateInfo", "VkBufferMemoryRequirementsInfo2", "VkImageMemoryRequirementsInfo2", "VkImageSparseMemoryRequirementsInfo2", "VkMemoryRequirements2", "VkSparseImageMemoryRequirements2", "VkMemoryDedicatedRequirements", "VkMemoryDedicatedAllocateInfo"];
    var flags = ["VkExternalMemoryHandleTypeFlags", "VkExternalMemoryFeatureFlags", "VkExternalFenceHandleTypeFlags", "VkExternalFenceFeatureFlags", "VkFenceImportFlags"];
    var extensions = ["VK_KHR_get_physical_device_properties2", "VK_KHR_external_memory_capabilities", "VK_KHR_external_memory", "VK_KHR_external_memory_fd", "VK_KHR_external_fence_capabilities", "VK_KHR_external_fence", "VK_KHR_external_fence_fd", "VK_KHR_get_memory_requirements2", "VK_KHR_dedicated_allocation", "VK_KHR_get_surface_capabilities2", "VK_EXT_surface_maintenance1", "VK_EXT_swapchain_maintenance1"];
    var body = ""; var active = false; var selected = false; var count = 0; var commands = 0;
    for (i in 0..Array.size(source)) {
        var line = source[i];
        if (starts(line, "// VK_")) { selected = false; }
        if (starts(line, "#define VK_KHR_") || starts(line, "#define VK_EXT_")) {
            for (n in 0..Array.size(extensions)) {
                if (line == "#define " + extensions[n] + " 1") { selected = true; }
            }
        }
        if (selected) {
            if (starts(line, "VKAPI_ATTR ")) { commands = commands + 1; }
            if (!starts(line, "//")) { body = body + line + "\n"; }
            continue;
        }
        if (!active) {
            for (n in 0..Array.size(types)) {
                if (line == "typedef struct " + types[n] + " {" || line == "typedef enum " + types[n] + " {") {
                    active = true; count = count + 1;
                    body = body + "\n/* Preserves the registry ABI of " + types[n] + ". */\n";
                }
            }
            for (n in 0..Array.size(flags)) {
                if (line == "typedef VkFlags " + flags[n] + ";") { body = body + line + "\n"; }
            }
        }
        if (active) {
            body = body + line + "\n";
            if (starts(line, "}")) { active = false; }
        }
    }
    if (count != Array.size(types) || commands != 19) { System.error("unexpected selected declarations: " + count + " types and " + commands + " commands"); }
    var preamble = "/*\n * zedBSD\n * Copyright (C) 2026 Awe Morris\n *\n * The zedBSD selection, formatting and additions in this file are Zlib.\n */\n\n/*\n * This file is a derived work of the Khronos Vulkan-Headers\n * (external memory and fence, capability queries, memory requirements,\n * surface capability queries, surface and swapchain maintenance).\n * The Vulkan API declarations it contains are:\n * Copyright 2015-2023 The Khronos Group Inc.\n *\n * SPDX-License-Identifier: Apache-2.0\n *\n * See API-PROVENANCE.md and LICENSE-API for the pinned declaration source.\n */\n\n#ifndef VULKAN_EXTERNAL_H_\n#define VULKAN_EXTERNAL_H_ 1\n\n#include \"vulkan_core.h\"\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n#define VK_LUID_SIZE 8U\n";
    FileUtil.writeText(args[1], preamble + body + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n");
    print("maintained 19 external-memory/fence, properties2, memory-requirements2, surface-capabilities2 and swapchain-maintenance1 commands");
}
