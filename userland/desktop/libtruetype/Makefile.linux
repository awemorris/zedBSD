KEILAND_LINUX_TRUETYPE_SOURCES := $(LIBTRUETYPE_SOURCES)
$(eval $(call KEILAND_LINUX_LIBRARY,truetype,libtruetype.so,$(KEILAND_LINUX_TRUETYPE_SOURCES),,-lm,userland/desktop/libtruetype/exports.map))
