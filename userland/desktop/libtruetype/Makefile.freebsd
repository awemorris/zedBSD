include $(dir $(lastword $(MAKEFILE_LIST)))sources.mk
# The native FreeBSD build of libtruetype.so; the zedBSD build remains in Makefile.
# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
KEILAND_FREEBSD_TRUETYPE_SOURCES := $(LIBTRUETYPE_SOURCES)
$(eval $(call KEILAND_FREEBSD_LIBRARY,truetype,libtruetype.so,$(KEILAND_FREEBSD_TRUETYPE_SOURCES),,-lm,userland/desktop/libtruetype/exports.map))
