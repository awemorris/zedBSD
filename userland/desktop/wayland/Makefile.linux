$(eval $(call KEILAND_LINUX_DATA,share/licenses/keiland-fonts/Apache-2.0.txt,userland/desktop/fonts/Apache-2.0.txt))

# Reuses the pinned, independently hash-verified external font without importing target build rules.
KEILAND_LINUX_EMOJI := build/distfiles/NotoColorEmoji-2.047.ttf
$(KEILAND_LINUX_EMOJI):
	@mkdir -p $(dir $@)
	curl -fL --max-time 180 -o $@.tmp https://github.com/googlefonts/noto-emoji/raw/v2.047/fonts/NotoColorEmoji.ttf
	@printf '%s  %s\n' 39ee3c587e10e89669b9ff32703261d10d5f9c4dd5ad147b6b5a1c5200591817 $@.tmp | sha256sum -c -
	mv $@.tmp $@
$(KEILAND_LINUX_BUILD)/share/fonts/keiland-emoji.ttf: $(KEILAND_LINUX_EMOJI)
	@printf '%s  %s\n' 39ee3c587e10e89669b9ff32703261d10d5f9c4dd5ad147b6b5a1c5200591817 $< | sha256sum -c -
	@mkdir -p $(dir $@)
	cp $< $@
KEILAND_LINUX_ALL += $(KEILAND_LINUX_BUILD)/share/fonts/keiland-emoji.ttf
KEILAND_LINUX_INSTALL += share/fonts/keiland-emoji.ttf
$(eval $(call KEILAND_LINUX_DATA,share/licenses/noto-color-emoji/OFL-1.1.txt,userland/packages/fonts/noto-color-emoji/OFL-1.1.txt))
