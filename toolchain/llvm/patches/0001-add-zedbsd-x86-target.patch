+TEST(TripleTest, ZedBSD) {
+  Triple X86_64("x86_64-unknown-zedbsd");
+  EXPECT_EQ(Triple::x86_64, X86_64.getArch());
+  EXPECT_EQ(Triple::UnknownVendor, X86_64.getVendor());
+  EXPECT_EQ(Triple::ZedBSD, X86_64.getOS());
+  EXPECT_EQ(Triple::UnknownEnvironment, X86_64.getEnvironment());
+  EXPECT_EQ(Triple::ELF, X86_64.getObjectFormat());
+  EXPECT_TRUE(X86_64.isOSZedBSD());
+
+  Triple I386("i386-unknown-zedbsd");
+  EXPECT_EQ(Triple::x86, I386.getArch());
+  EXPECT_EQ(Triple::UnknownVendor, I386.getVendor());
+  EXPECT_EQ(Triple::ZedBSD, I386.getOS());
+  EXPECT_EQ(Triple::UnknownEnvironment, I386.getEnvironment());
+  EXPECT_EQ(Triple::ELF, I386.getObjectFormat());
+
+  EXPECT_EQ("x86_64-unknown-zedbsd",
+            Triple::normalize("x86_64-zedbsd"));
+  EXPECT_EQ("i386-unknown-zedbsd", Triple::normalize("i386-zedbsd"));
+}
