+// zedBSD Target
+template <typename Target>
+class LLVM_LIBRARY_VISIBILITY ZedBSDTargetInfo : public OSTargetInfo<Target> {
+protected:
+  void getOSDefines(const LangOptions &Opts, const llvm::Triple &Triple,
+                    MacroBuilder &Builder) const override {
+    Builder.defineMacro("__ZEDBSD__", "1");
+    DefineStd(Builder, "unix", Opts);
+  }
+
+public:
+  ZedBSDTargetInfo(const llvm::Triple &Triple, const TargetOptions &Opts)
+      : OSTargetInfo<Target>(Triple, Opts) {
+    // zedBSD's i386 soft-float ABI follows GCC -mlong-double-64: long double
+    // is IEEE binary64 and is returned through the ordinary soft-float
+    // integer-register path when x87 is disabled.
+    if (Triple.getArch() == llvm::Triple::x86) {
+      this->LongDoubleWidth = 64;
+      this->LongDoubleAlign = this->DoubleAlign;
+      this->LongDoubleFormat = &llvm::APFloat::IEEEdouble();
+      this->resetDataLayout();
+    }
+  }
+};
