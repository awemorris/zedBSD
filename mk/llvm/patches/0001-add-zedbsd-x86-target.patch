+
+#include "ZedBSD.h"
+#include "clang/Driver/CommonArgs.h"
+#include "clang/Driver/Compilation.h"
+#include "clang/Driver/Driver.h"
+#include "clang/Options/Options.h"
+#include "llvm/Option/ArgList.h"
+#include "llvm/Support/Path.h"
+
+using namespace clang::driver;
+using namespace clang::driver::toolchains;
+using namespace llvm::opt;
+
+ZedBSD::ZedBSD(const Driver &D, const llvm::Triple &Triple,
+               const ArgList &Args)
+    : Generic_ELF(D, Triple, Args) {
+  getFilePaths().push_back(concat(getDriver().SysRoot, "/usr/lib"));
+}
+
+void ZedBSD::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
+                                       ArgStringList &CC1Args) const {
+  const Driver &D = getDriver();
+
+  if (DriverArgs.hasArg(options::OPT_nostdinc))
+    return;
+  if (!DriverArgs.hasArg(options::OPT_nobuiltininc))
+    addSystemInclude(DriverArgs, CC1Args, concat(D.ResourceDir, "/include"));
+  if (!DriverArgs.hasArg(options::OPT_nostdlibinc))
+    addSystemInclude(DriverArgs, CC1Args, concat(D.SysRoot, "/usr/include"));
+}
+
+Tool *ZedBSD::buildLinker() const {
+  return new tools::zedbsd::Linker(*this);
+}
+
+/*
+ * zedBSD's link line is not the usual ELF one: the loader is /lib/ld.so, its
+ * symbol lookup is by SysV hash, it binds everything at load time, and it has
+ * no copy relocations, so executables are position independent.  The shared
+ * C library also leaves the loader's own entry points undefined, which the
+ * link has to permit.  Describing all of that here is what lets an ordinary
+ * `clang foo.c -o foo` produce a program this system can run.
+ */
+void tools::zedbsd::Linker::ConstructJob(Compilation &C, const JobAction &JA,
+                                         const InputInfo &Output,
+                                         const InputInfoList &Inputs,
+                                         const ArgList &Args,
+                                         const char *LinkingOutput) const {
+  const ToolChain &TC = getToolChain();
+  const Driver &D = TC.getDriver();
+  ArgStringList CmdArgs;
+
+  const bool IsShared = Args.hasArg(options::OPT_shared);
+  const bool IsStatic = Args.hasArg(options::OPT_static);
+  const bool NoStdLib = Args.hasArg(options::OPT_nostdlib);
+  const bool IsPIE = !IsShared && !IsStatic &&
+                     Args.hasFlag(options::OPT_pie, options::OPT_no_pie, true);
+
+  if (!D.SysRoot.empty())
+    CmdArgs.push_back(Args.MakeArgString("--sysroot=" + D.SysRoot));
+
+  // The emulation is named rather than inferred, so a link whose first input
+  // is an archive or a script still resolves to the configured target.
+  const llvm::Triple::ArchType Arch = TC.getTriple().getArch();
+  CmdArgs.push_back("-m");
+  if (Arch == llvm::Triple::x86_64)
+    CmdArgs.push_back("elf_x86_64");
+  else if (Arch == llvm::Triple::aarch64)
+    CmdArgs.push_back("aarch64elf");
+  else if (Arch == llvm::Triple::riscv64)
+    CmdArgs.push_back("elf64lriscv");
+  else if (Arch == llvm::Triple::arm || Arch == llvm::Triple::thumb)
+    CmdArgs.push_back("armelf_linux_eabi");
+  else
+    CmdArgs.push_back("elf_i386");
+
+  if (IsShared)
+    CmdArgs.push_back("-shared");
+  if (IsStatic)
+    CmdArgs.push_back("-static");
+  if (IsPIE)
+    CmdArgs.push_back("-pie");
+
+  // A shared object is also looked up by name from an executable built
+  // elsewhere, so it carries both hash tables; the loader reads the SysV one.
+  CmdArgs.push_back(IsShared ? "--hash-style=both" : "--hash-style=sysv");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("now");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("relro");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("separate-code");
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("stack-size=0x100000");
+  // zedBSD maps 4 KiB pages on AArch64 and ARM too, and lays its programs
+  // out on that boundary rather than on the 64 KiB one ld.lld assumes there.
+  if (Arch == llvm::Triple::aarch64 || Arch == llvm::Triple::arm ||
+      Arch == llvm::Triple::thumb) {
+    CmdArgs.push_back("-z");
+    CmdArgs.push_back("max-page-size=4096");
+  }
+  CmdArgs.push_back("--no-relax");
+
+  // An unwinder reaches a frame's tables through PT_GNU_EH_FRAME, so the
+  // index it searches has to be built: without it a throw finds no handler
+  // and terminates.
+  CmdArgs.push_back("--eh-frame-hdr");
+
+  // The shared C library takes __rtld_exports from the loader, which is not
+  // one of the link's inputs.
+  CmdArgs.push_back("--allow-shlib-undefined");
+
+  // A version script may name a symbol the link does not define, as GNU ld
+  // allows; ld.lld refuses that by default since LLVM 16, which makes a
+  // configure script (zlib's) decide that shared libraries cannot be built.
+  // -Wl,--no-undefined-version, which comes after this, turns it back on.
+  CmdArgs.push_back("--undefined-version");
+
+  if (!IsShared && !IsStatic) {
+    CmdArgs.push_back("-dynamic-linker");
+    CmdArgs.push_back("/lib/ld.so");
+  }
+
+  CmdArgs.push_back("-o");
+  CmdArgs.push_back(Output.getFilename());
+
+  if (!NoStdLib && !Args.hasArg(options::OPT_nostartfiles) && !IsShared)
+    CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath("crt1.o")));
+
+  Args.AddAllArgs(CmdArgs, options::OPT_L);
+  Args.AddAllArgs(CmdArgs, options::OPT_u);
+  TC.AddFilePathLibArgs(Args, CmdArgs);
+  Args.addAllArgs(CmdArgs, {options::OPT_T_Group, options::OPT_s,
+                            options::OPT_t, options::OPT_r});
+
+  AddLinkerInputs(TC, Inputs, Args, CmdArgs, JA);
+
+  // The C library comes last so that it answers the inputs' references, and
+  // the compiler runtime after it for the helpers the code generator emits.
+  if (!NoStdLib && !Args.hasArg(options::OPT_nodefaultlibs)) {
+    CmdArgs.push_back("-lc");
+    CmdArgs.push_back(
+        Args.MakeArgString(TC.GetFilePath("libclang_rt.builtins.a")));
+  }
+
+  const char *Exec = Args.MakeArgString(TC.GetLinkerPath());
+  C.addCommand(std::make_unique<Command>(JA, *this,
+                                         ResponseFileSupport::AtFileCurCP(),
+                                         Exec, CmdArgs, Inputs, Output));
+}
