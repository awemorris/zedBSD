--- a/llvm/lib/Target/X86/X86.td
+++ b/llvm/lib/Target/X86/X86.td
@@ -52,8 +52,16 @@
 def FeatureCMOV    : SubtargetFeature<"cmov","HasCMOV", "true",
                                       "Enable conditional move instructions">;
 
+// The i486 added BSWAP, CMPXCHG and XADD.  The i386 has none of them, so
+// without this feature byte swaps are expanded into shifts and rotates, and
+// atomic operations become calls to the __atomic_* runtime functions.
+def FeatureI486Ops : SubtargetFeature<"i486-ops", "HasI486Ops", "true",
+                                      "Enable the BSWAP, CMPXCHG and XADD instructions of the i486">;
+
+// Every processor with CMPXCHG8B also has the i486 instructions.
 def FeatureCX8     : SubtargetFeature<"cx8", "HasCX8", "true",
-                                      "Support CMPXCHG8B instructions">;
+                                      "Support CMPXCHG8B instructions",
+                                      [FeatureI486Ops]>;
 
 def FeatureCRC32   : SubtargetFeature<"crc32", "HasCRC32", "true",
                                       "Enable SSE 4.2 CRC32 instruction (used when SSE4.2 is supported but function is GPR only)">;
@@ -1895,7 +1903,7 @@
 
