--- /dev/null
+++ b/llvm/test/CodeGen/X86/i386-no-i486-ops.ll
@@ -0,0 +1,94 @@
+; RUN: llc < %s -mtriple=i386-unknown-linux-gnu -mcpu=i386 | FileCheck %s --check-prefixes=CHECK,I386
+; RUN: llc < %s -mtriple=i386-unknown-linux-gnu -mcpu=i386 -O0 | FileCheck %s --check-prefixes=CHECK,I386
+; RUN: llc < %s -mtriple=i386-unknown-linux-gnu -mcpu=i486 | FileCheck %s --check-prefixes=CHECK,I486
+; RUN: llc < %s -mtriple=i386-unknown-linux-gnu -mcpu=i386 -mattr=+i486-ops | FileCheck %s --check-prefixes=CHECK,I486
+; RUN: llc < %s -mtriple=i386-unknown-linux-gnu -mcpu=pentium4 | FileCheck %s --check-prefixes=CHECK,I486
+
+; The i386 has no BSWAP, CMPXCHG or XADD: byte swaps are expanded and atomic
+; operations call the __atomic_* runtime.
+
+define i32 @swap32(i32 %x) {
+; CHECK-LABEL: swap32:
+; I386-NOT: bswap
+; I486: bswapl
+  %r = call i32 @llvm.bswap.i32(i32 %x)
+  ret i32 %r
+}
+
+define i64 @swap64(i64 %x) {
+; CHECK-LABEL: swap64:
+; I386-NOT: bswap
+; I486: bswapl
+  %r = call i64 @llvm.bswap.i64(i64 %x)
+  ret i64 %r
+}
+
+define i16 @swap16(i16 %x) {
+; CHECK-LABEL: swap16:
+; CHECK: rolw $8
+  %r = call i16 @llvm.bswap.i16(i16 %x)
+  ret i16 %r
+}
+
+define i32 @cas32(ptr %p, i32 %old, i32 %new) {
+; CHECK-LABEL: cas32:
+; I386: calll __atomic_compare_exchange_4
+; I386-NOT: cmpxchg
+; I486: lock cmpxchgl
+  %pair = cmpxchg ptr %p, i32 %old, i32 %new seq_cst seq_cst
+  %r = extractvalue { i32, i1 } %pair, 0
+  ret i32 %r
+}
+
+define i32 @add32(ptr %p, i32 %v) {
+; CHECK-LABEL: add32:
+; I386: calll __atomic_fetch_add_4
+; I386-NOT: xadd
+; I486: lock xaddl
+  %r = atomicrmw add ptr %p, i32 %v seq_cst
+  ret i32 %r
+}
+
+define i8 @or8(ptr %p, i8 %v) {
+; CHECK-LABEL: or8:
+; I386: calll __atomic_fetch_or_1
+; I386-NOT: cmpxchg
+; I486: lock cmpxchgb
+  %r = atomicrmw or ptr %p, i8 %v seq_cst
+  ret i8 %r
+}
+
+define i32 @max32(ptr %p, i32 %v) {
+; CHECK-LABEL: max32:
+; I386: calll __atomic_compare_exchange_4
+; I386-NOT: cmpxchg
+; I486: lock cmpxchgl
+  %r = atomicrmw max ptr %p, i32 %v seq_cst
+  ret i32 %r
+}
+
+define i32 @xchg32(ptr %p, i32 %v) {
+; CHECK-LABEL: xchg32:
+; I386: calll __atomic_exchange_4
+; I486: xchgl
+  %r = atomicrmw xchg ptr %p, i32 %v seq_cst
+  ret i32 %r
+}
+
+define i32 @load32(ptr %p) {
+; CHECK-LABEL: load32:
+; I386: calll __atomic_load_4
+  %r = load atomic i32, ptr %p acquire, align 4
+  ret i32 %r
+}
+
+define void @store32(ptr %p, i32 %v) {
+; CHECK-LABEL: store32:
+; I386: calll __atomic_store_4
+  store atomic i32 %v, ptr %p release, align 4
+  ret void
+}
+
+declare i16 @llvm.bswap.i16(i16)
+declare i32 @llvm.bswap.i32(i32)
+declare i64 @llvm.bswap.i64(i64)
