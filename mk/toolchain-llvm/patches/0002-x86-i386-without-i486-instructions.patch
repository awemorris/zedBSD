--- a/llvm/lib/Target/X86/X86ISelLowering.cpp
+++ b/llvm/lib/Target/X86/X86ISelLowering.cpp
@@ -165,12 +165,18 @@
       addBypassSlowDiv(64, 32);
   }
 
+  // Without CMPXCHG and XADD (an i386) a compare-and-swap or a fetch-and-op
+  // that returns the old value has no instruction, so every atomic operation
+  // goes to the __atomic_* runtime, which then serializes the loads and the
+  // stores with the rest.
   if (Subtarget.canUseCMPXCHG16B())
     setMaxAtomicSizeInBitsSupported(128);
   else if (Subtarget.canUseCMPXCHG8B())
     setMaxAtomicSizeInBitsSupported(64);
-  else
+  else if (Subtarget.hasI486Ops())
     setMaxAtomicSizeInBitsSupported(32);
+  else
+    setMaxAtomicSizeInBitsSupported(0);
 
   setMaxDivRemBitWidthSupported(Subtarget.is64Bit() ? 128 : 64);
 
@@ -493,6 +499,10 @@
   if (!Subtarget.hasMOVBE())
     setOperationAction(ISD::BSWAP          , MVT::i16  , Expand);
 
+  // BSWAP came with the i486.
+  if (!Subtarget.hasI486Ops())
+    setOperationAction(ISD::BSWAP          , MVT::i32  , Expand);
