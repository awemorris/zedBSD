require zedbuild;
require ufs_format;
require overlay_journal_format;

func main(args) {
    var profile="ordinary"; var output=""; var backend=""; var sizeMiB=32; var i=0;
    while(i<Array.size(args)){
        if(args[i]=="--output"&&i+1<Array.size(args)){output=args[i+1];i=i+2;}
        else if(args[i]=="--backend"&&i+1<Array.size(args)){backend=args[i+1];i=i+2;}
        else if(args[i]=="--size-mib"&&i+1<Array.size(args)){sizeMiB=zbParseNumber(args[i+1]);i=i+2;}
        else if(args[i]=="--profile=journal-snapshot"){profile="journal-snapshot";i=i+1;}
        else {zbFail("invalid make-data-image argument: "+args[i]);}
    }
    if(output==""||backend==""||sizeMiB<16){zbFail("usage: make-data-image.noct --backend PATH --output PATH [--size-mib N]");}
    var root=output+".root.tmp";
    if(System.shell("rm -rf "+zbShellQuote(root)+" && mkdir -p "+zbShellQuote(root))!=0){zbFail("cannot prepare data staging root");}
    var journal=overlayEmptyJournal(); zbWriteFile(root+"/.zovl0",journal);
    var empty=Packed.uint8(128*1024); zbWriteFile(root+"/.zovl1",empty);
    ufsBuildProfile(backend,sizeMiB*1024*1024,root,output+".tmp",profile);
    if(System.shell("mv -f "+zbShellQuote(output+".tmp")+" "+zbShellQuote(output)+" && rm -rf "+zbShellQuote(root))!=0){zbFail("cannot publish data image");}
}
