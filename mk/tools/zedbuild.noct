// Shared host-side binary and command helpers for zedBSD build scripts.

func zbFail(message) {
    System.error(message);
}

func zbReadFile(path) {
    var size = FileUtil.getFileSize(path);
    if (size < 0) { zbFail("cannot stat input: " + path); }
    var file = File.open(path, "rb");
    var data = File.readExact(file, size);
    File.close(file);
    return data;
}

func zbShellQuote(text) {
    var result = "'";
    for (i in 0..String.charCount(text)) {
        var c = String.charAt(text, i);
        if (c == "'") { result = result + "'\\''"; }
        else { result = result + c; }
    }
    return result + "'";
}

func zbParent(path) {
    var last = -1;
    for (i in 0..String.charCount(path)) {
        if (String.charAt(path, i) == "/") { last = i; }
    }
    if (last < 0) { return "."; }
    if (last == 0) { return "/"; }
    return String.substring(path, 0, last);
}

func zbEnsureParent(path) {
    if (System.shell("mkdir -p " + zbShellQuote(zbParent(path))) != 0) {
        zbFail("cannot create output directory for " + path);
    }
}

func zbWriteFile(path, data) {
    zbEnsureParent(path);
    var file = File.open(path, "wb");
    File.writeAll(file, data, 0, Packed.size(data));
    File.close(file);
}

func zbAtomicWrite(path, data) {
    var temporary = path + ".tmp";
    zbWriteFile(temporary, data);
    if (System.shell("mv -f " + zbShellQuote(temporary) + " " +
                     zbShellQuote(path)) != 0) {
        zbFail("cannot replace output: " + path);
    }
}

func zbNeed(data, offset, size, what) {
    if (offset < 0 || size < 0 || offset > Packed.size(data) ||
        size > Packed.size(data) - offset) {
        zbFail("truncated " + what);
    }
}

func zbNeedBytes(data, offset, size, what) {
    if (Type.of(data) != "packed" || Packed.type(data) != "uint8") {
        zbFail(what + ": expected packed uint8");
    }
    zbNeed(data, offset, size, what);
}

func zbU16LE(data, offset) {
    zbNeed(data, offset, 2, "u16le");
    return data[offset] | (data[offset + 1] << 8);
}

func zbU16BE(data, offset) {
    zbNeed(data, offset, 2, "u16be");
    return (data[offset] << 8) | data[offset + 1];
}

func zbU32LE(data, offset) {
    zbNeedBytes(data, offset, 4, "u32le");
    return Long.from(data[offset]) +
           Long.from(data[offset + 1]) * 256 +
           Long.from(data[offset + 2]) * 65536 +
           Long.from(data[offset + 3]) * 16777216;
}

func zbU32BE(data, offset) {
    zbNeed(data, offset, 4, "u32be");
    return data[offset] * 16777216 + data[offset + 1] * 65536 +
           data[offset + 2] * 256 + data[offset + 3];
}

func zbI64LE(data, offset) {
    zbNeedBytes(data, offset, 8, "i64le");
    var low = zbU32LE(data, offset);
    var high = zbU32LE(data, offset + 4);
    if (high >= 2147483648L) { high = high - 4294967296L; }
    return low + high * 4294967296L;
}

func zbU64SmallLE(data, offset) {
    var low = zbU32LE(data, offset);
    var high = zbU32LE(data, offset + 4);
    return low + high * 4294967296L;
}

func zbPut16LE(data, offset, value) {
    zbNeed(data, offset, 2, "put u16le");
    data[offset] = value & 255;
    data[offset + 1] = (value >> 8) & 255;
}

func zbPut32LE(data, offset, value) {
    zbNeed(data, offset, 4, "put u32le");
    data[offset] = value & 255;
    data[offset + 1] = (value >> 8) & 255;
    data[offset + 2] = (value >> 16) & 255;
    data[offset + 3] = (value >> 24) & 255;
}

func zbPut64LE(data, offset, value) {
    zbNeedBytes(data, offset, 8, "put u64le");
    var kind = Type.of(value);
    if (kind != "int" && kind != "long") {
        zbFail("put u64le value is not an integer");
    }
    var remaining = Long.from(value);
    for (index in 0..8) {
        data[offset + index] = remaining & 255;
        remaining = remaining >> 8;
    }
}

func zbCopy(destination, destinationOffset, source, sourceOffset, count) {
    zbNeed(destination, destinationOffset, count, "copy destination");
    zbNeed(source, sourceOffset, count, "copy source");
    for (i in 0..count) {
        destination[destinationOffset + i] = source[sourceOffset + i];
    }
}

func zbBytesEqual(data, offset, text) {
    var count = String.byteLength(text);
    if (offset < 0 || offset + count > Packed.size(data)) { return false; }
    for (i in 0..count) {
        if (data[offset + i] != String.charCodeAt(text, i)) { return false; }
    }
    return true;
}

func zbParseNumber(text) {
    var negative = false;
    var pos = 0;
    if (String.charCount(text) > 0 && String.charAt(text, 0) == "-") {
        negative = true;
        pos = 1;
    }
    var base = 10;
    if (String.charCount(text) >= pos + 2 &&
        String.substring(text, pos, 2) == "0x") {
        base = 16;
        pos = pos + 2;
    }
    var value = 0;
    if (pos >= String.charCount(text)) { zbFail("invalid number: " + text); }
    while (pos < String.charCount(text)) {
        var code = String.charCodeAt(text, pos);
        var digit = -1;
        if (code >= 48 && code <= 57) { digit = code - 48; }
        else if (code >= 65 && code <= 70) { digit = code - 55; }
        else if (code >= 97 && code <= 102) { digit = code - 87; }
        if (digit < 0 || digit >= base) { zbFail("invalid number: " + text); }
        value = value * base + digit;
        pos = pos + 1;
    }
    if (negative) { return 0 - value; }
    return value;
}

func zbRoundUp(value, alignment) {
    return ((value + alignment - 1) / alignment) * alignment;
}

func zbDwordSumLE(data) {
    if ((Packed.size(data) & 3) != 0) { zbFail("dword sum is not aligned"); }
    var sum = 0;
    var offset = 0;
    while (offset < Packed.size(data)) {
        sum = (sum + zbU32LE(data, offset)) & 4294967295;
        offset = offset + 4;
    }
    return sum;
}
