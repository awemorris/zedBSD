+/*
+ * Gives the session's compiled program that is the same as a binary (its
+ * header and code), held once more, or a new one: a run with the header,
+ * then the code.  Returns the error of the run.
+ */
+static int
+pipeline_code(
+	struct nvrtx_vk_session *session,
+	const struct nvrtx_sm75_binary *binary,
+	struct nvrtx_vk_code **code)
+{
+	struct nvrtx_vk_code *found;
+	struct nvrtx_vk_code *made;
+	uint8_t *cpu;
+	uint32_t length;
+	uint32_t hash;
+	bool same;
+	int error;
+
+	/* The program's length (its header and code) and hash. */
+	length = PIPELINE_HEADER_BYTES + binary->code_words * 4U;
+	hash = pipeline_code_hash(binary);
+
+	/* The same program of another pipeline's is held once more. */
+	for (found = session->codes; found != NULL; found = found->next) {
+		same = pipeline_code_same(found, binary, length, hash);
+		if (!same)
+			continue;
+		if (found->references == 0xffffffffU)
+			break;
+		found->references++;
+		*code = found;
+		return 0;
+	}
+
+	/* A new one: its record, the copy it is found by, and its run. */
+	made = kern_calloc(1U, sizeof(*made));
+	if (made == NULL)
+		return ENOMEM;
+	made->image = kern_malloc(length);
+	if (made->image == NULL) {
+		kern_free(made);
+		return ENOMEM;
+	}
+	error = nvrtx_vk_gpu_alloc(session->owner, pipeline_program_bytes(binary), &made->token, &cpu, &made->va);
+	if (error != 0) {
+		kern_free(made->image);
+		kern_free(made);
+		return error;
+	}
+
+	/* The header where the address points, the code behind it; the same in the copy. */
+	kern_memcpy(made->image, binary->sph, PIPELINE_HEADER_BYTES);
+	kern_memcpy(made->image + PIPELINE_HEADER_BYTES, binary->code, (size_t)binary->code_words * 4U);
+	kern_memcpy(cpu, made->image, length);
+
+	/* Found from now on, held by the pipeline. */
+	made->length = length;
+	made->hash = hash;
+	made->references = 1U;
+	made->next = session->codes;
+	session->codes = made;
+
+	/* Succeeded: the program is in the GPU's memory. */
+	*code = made;
+	return 0;
+}
+
+/* Tells whether a compiled program of the session's is a binary's: the same length, hash, header and code. */
+static bool
+pipeline_code_same(
+	const struct nvrtx_vk_code *code,
+	const struct nvrtx_sm75_binary *binary,
+	uint32_t length,
+	uint32_t hash)
+{
+	int differ;
+
+	/* The length and the hash first. */
+	if (code->length != length || code->hash != hash)
+		return false;
+
+	/* Then the header and the code themselves (the copy in the kernel's memory). */
+	differ = kern_memcmp(code->image, binary->sph, PIPELINE_HEADER_BYTES);
+	if (differ != 0)
+		return false;
+	differ = kern_memcmp(code->image + PIPELINE_HEADER_BYTES, binary->code, (size_t)binary->code_words * 4U);
+	if (differ != 0)
+		return false;
+
+	/* Succeeded: the same program. */
+	return true;
+}
+
+/* Hashes a program's header and code (FNV-1a over their bytes). */
+static uint32_t
+pipeline_code_hash(
+	const struct nvrtx_sm75_binary *binary)
+{
+	const uint8_t *bytes;
+	uint32_t hash;
+	size_t count;
+	size_t index;
+
+	/* The header's bytes. */
+	hash = PIPELINE_HASH_START;
+	bytes = (const uint8_t *)binary->sph;
+	for (index = 0U; index < PIPELINE_HEADER_BYTES; index++) {
+		hash ^= bytes[index];
+		hash *= PIPELINE_HASH_PRIME;
+	}
+
+	/* The code's bytes. */
+	bytes = (const uint8_t *)binary->code;
+	count = (size_t)binary->code_words * 4U;
+	for (index = 0U; index < count; index++) {
+		hash ^= bytes[index];
+		hash *= PIPELINE_HASH_PRIME;
+	}
+
+	/* Succeeded: the hash. */
+	return hash;
+}
+
+/* Lets a pipeline's hold on a compiled program go; the last one frees its run. */
+static void
+pipeline_code_release(
+	struct nvrtx_vk_session *session,
+	struct nvrtx_vk_code *code)
+{
+	struct nvrtx_vk_code **link;
+
+	/* Others still hold it. */
+	code->references--;
+	if (code->references != 0U)
+		return;
+
+	/* Out of the session's list. */
+	for (link = &session->codes; *link != NULL; link = &(*link)->next) {
+		if (*link == code) {
+			*link = code->next;
+			break;
+		}
+	}
+
+	/* Its run, then its copy and record. */
+	nvrtx_vk_gpu_free(session->owner, code->token);
+	kern_free(code->image);
+	kern_free(code);
+}
