+/* DIAG: the GPU's timer at a passed run's start stamp, every run (timed or not). */
+int
+nvrtx_work_channel_run_start(
+	struct nvrtx_work_channel *channel,
+	uint32_t fence,
+	uint64_t *start_ns)
+{
+	size_t record;
+	uint32_t started;
+
+	record = work_run_record(fence);
+	started = work_semaphore_word(channel, record);
+	if (started != fence)
+		return ENOENT;
+	__atomic_thread_fence(__ATOMIC_ACQUIRE);
+	*start_ns = work_semaphore_timer(channel, record + WORK_STAMP_TIMER_AT);
+	__atomic_thread_fence(__ATOMIC_ACQUIRE);
+	started = work_semaphore_word(channel, record);
+	if (started != fence)
+		return ENOENT;
+	return 0;
+}
