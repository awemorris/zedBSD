+/*
+ * DIAG (not for the tree): every run of the newest submitting session, retired at the next submit once passed, so the
+ * GPU's time a run is counted for all runs (timed: end - start), and the start-to-start gap of back-to-back runs (any
+ * timing): a gap below 60 us is a busy GPU's time per run.  One line every 5 s.
+ */
+#define DIAG_RING 512U
+static uint32_t diag_fences[DIAG_RING];
+static uint32_t diag_head;
+static uint32_t diag_tail;
+static struct nvrtx_session *diag_session;
+static uint64_t diag_runs;
+static uint64_t diag_retired;
+static uint64_t diag_timed;
+static uint64_t diag_timed_ns;
+static uint64_t diag_gaps;
+static uint64_t diag_busy;
+static uint64_t diag_busy_ns;
+static uint64_t diag_busy_min;
+static uint64_t diag_lost;
+static uint32_t diag_prev_fence;
+static uint64_t diag_prev_start;
+static uint64_t diag_reported_us;
+static void diag_submitted(struct nvrtx_session *session, uint32_t fence);
 static bool vk_node_lost(struct nvrtx_session *session);
 static bool vk_node_quiet(struct nvrtx_session *session);
 static void vk_node_gr_check(struct nvrtx_node *node);
@@ -538,9 +561,80 @@ nvrtx_vk_gpu_submit(
 	session->run_us = submitted;
 	ticket->fence = fence;
 	ticket->submitted_us = submitted;
+	diag_submitted(session, fence);
 	return 0;
 }
 
+/* DIAG: retires the passed runs of the ring and adds the new one; says the counts every 5 s. */
+static void
+diag_submitted(
+	struct nvrtx_session *session,
+	uint32_t fence)
+{
+	struct nvrtx_work_channel *channel;
+	uint64_t gpu_ns;
+	uint64_t start;
+	uint64_t gap;
+	uint64_t now;
+	uint32_t old;
+
+	channel = session->channel;
+	if (session != diag_session) {
+		diag_session = session;
+		diag_head = diag_tail = 0U;
+		diag_prev_fence = 0U;
+	}
+	while (diag_tail != diag_head) {
+		old = diag_fences[diag_tail % DIAG_RING];
+		if (!nvrtx_work_channel_passed(channel, old))
+			break;
+		diag_tail++;
+		diag_retired++;
+		if (nvrtx_work_channel_run_time(channel, old, &gpu_ns) == 0) {
+			diag_timed++;
+			diag_timed_ns += gpu_ns;
+		}
+		if (nvrtx_work_channel_run_start(channel, old, &start) != 0) {
+			diag_lost++;
+			diag_prev_fence = 0U;
+			continue;
+		}
+		if (diag_prev_fence != 0U && old == diag_prev_fence + 1U && start > diag_prev_start) {
+			gap = start - diag_prev_start;
+			diag_gaps++;
+			if (gap < 60000U) {
+				diag_busy++;
+				diag_busy_ns += gap;
+				if (diag_busy_min == 0U || gap < diag_busy_min)
+					diag_busy_min = gap;
+			}
+		}
+		diag_prev_fence = old;
+		diag_prev_start = start;
+	}
+	if (diag_head - diag_tail >= DIAG_RING) {
+		diag_tail++;
+		diag_lost++;
+		diag_prev_fence = 0U;
+	}
+	diag_fences[diag_head % DIAG_RING] = fence;
+	diag_head++;
+	diag_runs++;
+	now = nvrtx_now_us();
+	if (diag_reported_us == 0U)
+		diag_reported_us = now;
+	if (now - diag_reported_us < 5000000U)
+		return;
+	diag_reported_us = now;
+	nvrtx_stage_mark("DIAG runs %llu retired %llu lost %llu timed %llu avg %lluns gaps %llu busy %llu avg %lluns min %lluns",
+	    (unsigned long long)diag_runs, (unsigned long long)diag_retired, (unsigned long long)diag_lost,
+	    (unsigned long long)diag_timed, (unsigned long long)(diag_timed != 0U ? diag_timed_ns / diag_timed : 0U),
+	    (unsigned long long)diag_gaps, (unsigned long long)diag_busy,
+	    (unsigned long long)(diag_busy != 0U ? diag_busy_ns / diag_busy : 0U), (unsigned long long)diag_busy_min);
+	diag_runs = diag_retired = diag_lost = diag_timed = diag_timed_ns = 0U;
+	diag_gaps = diag_busy = diag_busy_ns = diag_busy_min = 0U;
+}
