+/* Diagnostic: the last surface a flip was sent to, for a test that flips away and back. */
+static struct nvrtx_disp_surface scanout_diag_last_surface;
+static int scanout_diag_last_valid;
+
+const struct nvrtx_disp_surface *
+nvrtx_scanout_diag_last(
+	struct nvrtx_gpu *gpu)
+{
+	(void)gpu;
+	if (scanout_diag_last_valid == 0)
+		return NULL;
+	return &scanout_diag_last_surface;
+}
+
+void
+nvrtx_scanout_diag_note(
+	const struct nvrtx_disp_surface *surface)
+{
+	scanout_diag_last_surface = *surface;
+	scanout_diag_last_valid = 1;
+}
+
+/* Diagnostic: one armed core method's value (the method's absolute offset). */
+uint32_t
+nvrtx_scanout_diag_armed(
+	struct nvrtx_gpu *gpu,
+	uint32_t method)
+{
+	return nvrtx_rd32(gpu, SCANOUT_REG_CORE_ARMED + method);
+}
+
+/* Diagnostic: binds a context DMA object over a VRAM range to the core. */
+int
+nvrtx_scanout_diag_bind(
+	struct nvrtx_gpu *gpu,
+	uint32_t handle,
+	uint64_t start,
+	uint64_t limit)
+{
+	return scanout_bind(gpu, NVRTX_DISP_CHID_CORE, handle, NVRTX_DISP_CONTEXT_DMA_FLAGS, start, limit);
+}
+
+/*
+ * Diagnostic: sends core methods (absolute offsets) with an update without
+ * interlock and waits until it has finished.
+ */
+int
+nvrtx_scanout_diag_core(
+	struct nvrtx_gpu *gpu,
+	const uint32_t *methods,
+	const uint32_t *values,
+	unsigned count)
+{
+	unsigned index;
+	int error;
+
+	error = nvrtx_scanout_core_settled(gpu, 200000U);
+	if (error != 0)
+		return error;
+	error = scanout_core_room(gpu, SCANOUT_CURSOR_WORDS_MAX + count * 2U);
+	if (error != 0)
+		return error;
+	for (index = 0U; index < count; index++)
+		nvrtx_push_one(&gpu->display.core_push, methods[index], values[index]);
+	error = scanout_core_send_cursor(gpu);
+	if (error != 0)
+		return error;
+	return nvrtx_scanout_core_settled(gpu, 200000U);
+}
