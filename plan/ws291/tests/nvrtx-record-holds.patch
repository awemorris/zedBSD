+/*
+ * Moves a kept record's holds to its recording: an object the recording
+ * holds already lets the record's hold go, another is added to the
+ * recording's holds (which grow twice as large when full) and carries its
+ * mark.  When the holds cannot grow the record's hold goes too and the
+ * recording fails (it never runs, so nothing reads the object).
+ */
+static void
+record_keep_holds(
+	struct nvrtx_vk_session *session,
+	struct nvrtx_vk_command_buffer *command,
+	struct nvrtx_vk_record *record)
+{
+	struct nvrtx_vk_object **grown;
+	struct nvrtx_vk_object *object;
+	uint32_t capacity;
+	uint32_t index;
+
+	/* The recording's mark, given at its first hold. */
+	if (command->hold_mark == 0U) {
+		session->hold_marks++;
+		command->hold_mark = session->hold_marks;
+	}
+
+	/* Each object of the record. */
+	for (index = 0U; index < record->object_count; index++) {
+		object = record->objects[index];
+		if (object == NULL)
+			continue;
+
+		/* Held by the recording already: the record's hold is not needed. */
+		if (object->hold_mark == command->hold_mark) {
+			(void)nvrtx_vk_object_release(object);
+			continue;
+		}
+
+		/* A new one: the holds grow when full. */
+		if (command->hold_count == command->hold_capacity) {
+			capacity = RECORD_FIRST_CAPACITY;
+			if (command->hold_capacity != 0U)
+				capacity = command->hold_capacity * 2U;
+			grown = NULL;
+			if (capacity <= RECORD_MAX * NVRTX_VK_SETS_MAX)
+				grown = kern_malloc((size_t)capacity * sizeof(*grown));
+			if (grown == NULL) {
+				(void)nvrtx_vk_object_release(object);
+				if (command->error == 0)
+					command->error = ENOMEM;
+				continue;
+			}
+			if (command->hold_count != 0U)
+				kern_memcpy(grown, command->holds, (size_t)command->hold_count * sizeof(*grown));
+			if (command->holds != NULL)
+				kern_free(command->holds);
+			command->holds = grown;
+			command->hold_capacity = capacity;
+		}
+
+		/* The record's hold becomes the recording's. */
+		command->holds[command->hold_count] = object;
+		command->hold_count++;
+		object->hold_mark = command->hold_mark;
+	}
+}
