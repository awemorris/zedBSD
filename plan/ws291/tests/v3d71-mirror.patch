+/* Takes an image's snapshot for a render pass to store its tiles in as well. */
+int
+bcm2711_native_snapshot_mirror(
+	struct bcm2711_v3d_space *space,
+	struct bcm2711_buffer *buffer,
+	uint64_t offset,
