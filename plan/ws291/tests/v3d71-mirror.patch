+/*
+ * Gives a pass that stores a whole RGBA8 or BGRA8 image the image's texture
+ * snapshot as a mirror, when one exists (the image was sampled before) or
+ * the image may be sampled (one is made): the tiles are stored there too,
+ * in the UIF layout the texture reads, so the next pass that samples the
+ * image converts nothing.  On V3D 4.2 nothing changes.
+ */
+static void
+prepare_mirror(
+	struct bcm2711_vulkan_native_pass *pass)
+{
+#if CONFIG_DRIVER_BCM2712_GPU
+	struct bcm2711_vulkan_resource *image;
+	struct bcm2711_native_snapshot *snapshot;
+	bool whole;
+	int error;
+
+	/* A stored colour image of four-byte texels, rendered at its own size and pitch from its first byte. */
+	image = pass->target;
+	pass->mirror_why = 1;
+	if (image == NULL ||
+	    pass->state.store == 0 ||
+	    pass->state.source != 0 ||
+	    pass->target_level != 0)
+		return;
+	pass->mirror_why = 2;
+	if (image->format != VK_FORMAT_R8G8B8A8_UNORM && image->format != VK_FORMAT_B8G8R8A8_UNORM)
+		return;
+	pass->mirror_why = 3;
+	if (pass->state.width != image->width ||
+	    pass->state.height != image->height ||
+	    pass->state.pitch != image->pitch)
+		return;
+	pass->mirror_why = 4 + ((image->usage & VK_IMAGE_USAGE_SAMPLED_BIT) != 0 ? 1U : 0U) * 2U;
+
+	/* Every tile of the image, or only some of them. */
+	whole = pass->state.box_count == 0 &&
+	    pass->state.first_x == 0 &&
+	    pass->state.first_y == 0 &&
+	    pass->state.last_x == (pass->state.width + 63U) / 64U - 1U &&
+	    pass->state.last_y == (pass->state.height + 63U) / 64U - 1U;
+
+	/* The snapshot, when there is one to take. */
+	error = bcm2711_native_snapshot_mirror(
+		pass->space,
+		pass->output->buffer,
+		(uint64_t)pass->state.output - pass->output->address,
+		pass->state.width,
+		pass->state.height,
+		pass->state.pitch,
+		whole,
+		(image->usage & VK_IMAGE_USAGE_SAMPLED_BIT) != 0,
+		&snapshot);
+	if (error != 0) {
+		pass->mirror_why += (uint32_t)error * 16U + (whole ? 1U : 0U);
+		return;
+	}
+	pass->mirror_why = 0;
+	pass->mirror = snapshot;
+	pass->state.mirror = snapshot->pixels->view->address;
+	pass->state.mirror_height = (pass->state.height + 7U) / 8U;
+#else
+	/* The UIF mirror store is V3D 7.1's alone. */
+	(void)pass;
+#endif
