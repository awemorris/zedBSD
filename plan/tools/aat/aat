#!/usr/bin/env python3
"""aat: drives a zedBSD machine over SSH for the Agent Acceptance Test (WS173).

Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib

An agent runs this on the host to use a zedBSD desktop as a person would:
it moves and clicks the pointer, drags, turns the wheel, presses keys and
types, takes the screen back as a PNG, and waits for lines in the logs.
The same commands reach a bare Latitude 5330 booted from the AAT image and
a QEMU guest of plan/tools/guest/guest.py (--qemu), so the tool tests
itself on QEMU (README.md).

The input is P1's aat-input (ws173-p001, AAT_INPUT, default
/bin/aat-input): a root server on the target that holds a relative mouse,
an absolute pointer over the screen's pixels and a keyboard on the test
kernel's /dev/input-inject (CONFIG_INPUT_TEST_INJECT, test images only);
each command here is one aat-input command over SSH, which answers "ok".
The screen comes from the compositor's test-only capture (AAT_SHOT,
default "/bin/keiland-shot {path}").

    aat [TARGET OPTIONS] COMMAND ...

    aat check                       reach the target, name what is missing
    aat run 'ls /tmp'               a shell command there (its status is ours)
    aat get /tmp/x.log x.log        a file from there / put x.txt /tmp/x.txt
    aat start [--size WxH]          start aat-input (the screen's size from a shot)
    aat stop
    aat move X Y | rel DX DY | click X Y [--button B] [--count N] [--with alt]
    aat down [--button B] | up [--button B]
    aat drag X1 Y1 X2 Y2 [--steps N]   the left button
    aat wheel X Y N [H]             notches: N > 0 up, H > 0 right
    aat key ctrl+alt+t [enter ...]  chords of evdev names, each pressed and released
    aat type 'hello, world'         ASCII on a US layout
    aat shot screen.png             the screen, taken back
    aat mark NAME [--log PATH]      remember how long a log is now
    aat wait-log REGEX [--log PATH] [--since NAME] [--timeout S]
    aat lines REGEX [--log PATH] [--since NAME]
    aat windows [--log PATH]        windows from the compositor's KWL lines
    aat where SURFACE [--log PATH]  one window's x y width height

Target options (or AAT_TARGET): --target root@10.0.30.3[:22], --target 5330
(the Latitude 5330, root@10.0.30.3), or --qemu (the guest of
GUEST_RUNTIME/session.json).  The key is the guest harness's
(plan/tmp/guest/id_ed25519, which the AAT image trusts for root) unless
--identity names another; a user other than root reaches root through
sudo -S with AAT_PASSWORD (default "kei").  The default log is AAT_LOG or
/run/user/1000/session.log.  --local runs every command on this host
instead (the self-test, tests/run-host.sh).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import struct
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
HARNESS_KEY = ROOT / "plan/tmp/guest/id_ed25519"

# The machines named by a word.
ALIASES = {
	"5330": "root@10.0.30.3",
}

# Where things are on the target, each changeable from the environment.
DEFAULT_LOG = os.environ.get("AAT_LOG", "/run/user/1000/session.log")
INPUT = os.environ.get("AAT_INPUT", "/bin/aat-input")
SHOT = os.environ.get("AAT_SHOT", "/bin/keiland-shot {path}")
RUN_DIR = os.environ.get("AAT_RUN_DIR", "/tmp/aat")

# How long one command may take on the target (seconds), and how often a log is read while waiting.
COMMAND_TIMEOUT = 60
POLL_SECONDS = 0.3

# The buttons aat-input knows.
BUTTONS = ("left", "right", "middle")

# The default screen when no shot gives its size (aat-input's default, the Latitude 5330's panel).
DEFAULT_SCREEN = (1920, 1200)


def fail(message: str) -> "NoReturn":
	"""Stops with one line on the standard error."""
	print(f"aat: {message}", file=sys.stderr)
	raise SystemExit(1)


class Target:
	"""A machine reached over SSH (or this host, for the self-test), with the
	local state of this tool for it: the connection's control socket, the
	marks in its logs and the screen's size."""

	def __init__(self, arguments: argparse.Namespace):
		self.local = arguments.on_host
		self.host = None
		self.user = None
		self.port = None
		self.identity = arguments.identity
		if self.local:
			key = "local"
		elif arguments.qemu:
			runtime = Path(os.environ.get("GUEST_RUNTIME", str(ROOT / "build/guest"))).resolve()
			session_path = runtime / "session.json"
			if not session_path.is_file():
				fail(f"no QEMU guest: {session_path} is missing (plan/tools/guest/guest.sh start IMAGE)")
			session = json.loads(session_path.read_text())
			self.user, self.host, self.port = "root", "127.0.0.1", int(session["ssh_port"])
			key = f"qemu-{self.port}"
		else:
			name = arguments.target or os.environ.get("AAT_TARGET")
			if not name:
				fail("no target: --target user@host[:port], --target 5330, --qemu, or AAT_TARGET")
			name = ALIASES.get(name, name)
			match = re.fullmatch(r"(?:([^@]+)@)?([^:@]+)(?::(\d+))?", name)
			if match is None:
				fail(f"cannot read the target {name!r}")
			self.user = match.group(1) or "root"
			self.host = match.group(2)
			self.port = int(match.group(3) or 22)
			key = f"{self.user}-{self.host}-{self.port}"
		if self.identity is None and HARNESS_KEY.is_file():
			self.identity = str(HARNESS_KEY)
		state_root = Path(os.environ.get("AAT_STATE", str(ROOT / "build/aat")))
		self.state_dir = state_root / key
		self.state_dir.mkdir(parents=True, exist_ok=True)
		self.state_path = self.state_dir / "state.json"
		# ssh's control socket in a short directory of this user's: a Unix socket's path holds about 100 bytes, and
		# ssh-%C alone takes 45 of them (T1-200: build/aat/... in a worktree was too long).
		self.control_dir = Path(f"/tmp/aat-{os.getuid()}")
		self.control_dir.mkdir(mode=0o700, exist_ok=True)
		if self.control_dir.stat().st_uid != os.getuid():
			fail(f"{self.control_dir} is not this user's")

	# The local state: marks and the screen's size.

	def load_state(self) -> dict:
		"""Returns what was kept for this target (empty at first)."""
		try:
			return json.loads(self.state_path.read_text())
		except (OSError, ValueError):
			return {}

	def save_state(self, state: dict) -> None:
		"""Keeps the state for the next run of this tool."""
		temporary = self.state_path.with_suffix(".tmp")
		temporary.write_text(json.dumps(state, indent=1, sort_keys=True))
		temporary.replace(self.state_path)

	# Running commands there.

	def command(self, script: str) -> list[str]:
		"""Returns the argument list that runs a shell script on the target."""
		if self.local:
			return ["sh", "-c", script]
		options = [
			"-p", str(self.port),
			"-o", "StrictHostKeyChecking=no",
			"-o", "UserKnownHostsFile=/dev/null",
			"-o", "LogLevel=ERROR",
			"-o", "ConnectTimeout=5",
			"-o", "BatchMode=yes",
			"-o", "ServerAliveInterval=5",
			# One connection carries every command of a run of commands: each later ssh starts in milliseconds.
			"-o", "ControlMaster=auto",
			"-o", f"ControlPath={self.control_dir}/ssh-%C",
			"-o", "ControlPersist=120",
		]
		if self.identity:
			options += ["-i", self.identity]
		return ["ssh", *options, f"{self.user}@{self.host}", script]

	def run(self, script: str, data: bytes | None = None, timeout: float = COMMAND_TIMEOUT,
		check: bool = True) -> subprocess.CompletedProcess:
		"""Runs a shell script there; its output is returned as bytes."""
		try:
			result = subprocess.run(self.command(script), input=data, capture_output=True, timeout=timeout)
		except subprocess.TimeoutExpired:
			fail(f"the target did not answer within {timeout:g} s: {script[:80]}")
		if check and result.returncode != 0:
			error = result.stderr.decode("utf-8", "replace").strip()
			fail(f"failed on the target (status {result.returncode}): {script[:80]}{': ' + error if error else ''}")
		return result

	def root(self, script: str) -> str:
		"""Returns a script that runs as root: as it is for root, through sudo -S for another user (the
		password AAT_PASSWORD, default the test images' "kei"; the script gets no standard input then)."""
		if self.local or self.user == "root":
			return script
		password = os.environ.get("AAT_PASSWORD", "kei")
		return f"printf '%s\\n' {shlex.quote(password)} | sudo -S sh -c {shlex.quote(script)}"


def png_size(data: bytes) -> tuple[int, int]:
	"""Returns a PNG's width and height from its header."""
	if len(data) < 24 or data[:8] != b"\x89PNG\r\n\x1a\n" or data[12:16] != b"IHDR":
		fail("the shot is not a PNG")
	return struct.unpack(">II", data[16:24])


def take_shot(target: Target, remote: str | None = None) -> bytes:
	"""Has the target capture its screen and returns the PNG's bytes.  The capture and the copy back are two steps,
	so that a capture that fails says what it printed and how it ended (T1-200: "not found" from the shell)."""
	path = remote or f"{RUN_DIR}/shot.png"
	directory = os.path.dirname(path) or "."
	quoted = shlex.quote(path)
	program = shlex.split(SHOT)[0]
	capture = (
		f"mkdir -p {shlex.quote(directory)} || exit 1; rm -f {quoted}; {SHOT.format(path=quoted)} </dev/null 2>&1; "
		f"status=$?; [ $status -eq 0 ] || {{ echo \"status $status, id $(id -un)\"; ls -l {shlex.quote(program)}; exit 1; }}"
	)
	result = target.run(target.root(capture), check=False)
	if result.returncode != 0:
		said = " ".join((result.stdout + result.stderr).decode("utf-8", "replace").split())
		fail(f"the capture failed: {said[:400]}")
	data = target.run(target.root(f"cat {quoted}")).stdout
	png_size(data)
	return data


# The input: P1's aat-input (ws173-p001) on the target, one command a call, answering "ok" or "error WHY".

def aat_input(target: Target, words: list[str], timeout: float = 30.0) -> None:
	"""Runs one aat-input command on the target as root; stops when it does not answer ok."""
	script = target.root(" ".join(shlex.quote(word) for word in [*shlex.split(INPUT), *words]))
	result = target.run(script, timeout=timeout, check=False)
	answer = result.stdout.decode("utf-8", "replace").strip()
	if result.returncode != 0 or not answer.startswith("ok"):
		error = result.stderr.decode("utf-8", "replace").strip()
		fail(f"aat-input {' '.join(words)}: {answer or error or 'status ' + str(result.returncode)}")


def button_name(name: str) -> str:
	"""Checks a button's name."""
	if name not in BUTTONS:
		fail(f"no button {name!r} (left, right, middle)")
	return name


def point(target: Target, x: float, y: float) -> list[str]:
	"""Returns a point of the screen as aat-input's two words, refusing one off the screen."""
	width, height = target.load_state().get("screen", list(DEFAULT_SCREEN))
	if not (0 <= x < width and 0 <= y < height):
		fail(f"{x:g},{y:g} is off the screen ({width}x{height})")
	return [str(int(round(x))), str(int(round(y)))]


def text_pieces(text: str) -> list[list[str]]:
	"""Returns the commands that type ASCII text: its lines with aat-input's type, each newline an Enter."""
	for character in text:
		if not (character.isascii() and (character.isprintable() or character in "\n\t")):
			fail(f"cannot type {character!r} (ASCII on a US layout only)")
	commands = []
	for index, line in enumerate(text.split("\n")):
		if index:
			commands.append(["key", "enter"])
		if line:
			commands.append(["type", line])
	return commands


# The compositor's lines about windows: where each puts a window's body (the client's surface; a floating window's
# title bar is the 44 pixels ending 8 above it) and how big it is.  "GLASS press move" is where the pointer pressed,
# not where the window is, so it is not one of them.

WINDOW_LINES = (
	(re.compile(r"KWL MAP client=(\d+) surface=(\d+) x=(-?\d+) y=(-?\d+)"), "map"),
	(re.compile(r"KWL UNMAP client=(\d+) surface=(\d+)"), "unmap"),
	(re.compile(r"KWL WINDOW centred surface=(\d+) x=(-?\d+) y=(-?\d+) width=(\d+) height=(\d+)"), "place"),
	(re.compile(r"KWL RESIZE settled surface=(\d+) x=(-?\d+) y=(-?\d+) width=(\d+) height=(\d+)"), "place"),
	(re.compile(r"KWL RESIZE end surface=(\d+) width=(\d+) height=(\d+)"), "size"),
	(re.compile(r"KWL GLASS launch(?:-late)? surface=(\d+) from=-?\d+,-?\d+ to=(-?\d+),(-?\d+) size=(\d+)x(\d+)"), "place"),
	(re.compile(r"KWL GLASS moved surface=(\d+) x=(-?\d+) y=(-?\d+)"), "at"),
	(re.compile(r"KWL GLASS dock surface=(\d+) .* x=(-?\d+) y=(-?\d+) w=(\d+) h=(\d+)"), "dock"),
	(re.compile(r"KWL GLASS open-docked client=\d+ surface=(\d+) .* x=(-?\d+) y=(-?\d+) w=(\d+) h=(\d+)"), "dock"),
	(re.compile(r"KWL GLASS undock surface=(\d+) via=\S+ x=(-?\d+) y=(-?\d+)"), "undock"),
	(re.compile(r"KWL GLASS resized surface=(\d+) docked=(\d+) width=(\d+) height=(\d+)"), "resized"),
	(re.compile(r"KWL WINDOW unfullscreen surface=(\d+) x=(-?\d+) y=(-?\d+)"), "at"),
)


# A line's own client field (not front_client=).
CLIENT_FIELD = re.compile(r"(?<![\w])client=(\d+)")

# A client that left: its windows went with it (an application that ends at its close request commits no null image,
# so no KWL UNMAP comes for them).
CLIENT_GONE = re.compile(r"KWL CLIENT gone client=(\d+)\b")


def windows_from(text: str) -> dict[tuple[int, int], dict]:
	"""Returns the windows the compositor's lines describe, by (client, surface): the last place and size each line
	gave, and whether the window is docked (maximized).  A surface's number is its client's protocol ID, so two
	clients can have the same one: a line's client= tells them apart, and a line without one (an older compositor's)
	is the latest mapped window of that number's."""
	windows: dict[tuple[int, int], dict] = {}
	latest: dict[int, tuple[int, int]] = {}
	for line in text.splitlines():
		gone = CLIENT_GONE.search(line)
		if gone is not None:
			for key, window in windows.items():
				if key[0] == int(gone.group(1)):
					window["mapped"] = False
			continue
		for pattern, kind in WINDOW_LINES:
			match = pattern.search(line)
			if match is None:
				continue
			numbers = [int(value) for value in match.groups()]
			if kind in ("map", "unmap"):
				client, surface = numbers[0], numbers[1]
				key = (client, surface)
				if kind == "map":
					# A new mapping of the pair starts afresh (a client can map a surface again).
					windows[key] = {"surface": surface, "client": client, "mapped": True, "docked": 0,
						"x": numbers[2], "y": numbers[3]}
					latest[surface] = key
				elif key in windows:
					windows[key]["mapped"] = False
				break
			surface = numbers[0]
			# The lines name their client now (client=, P1 2026-10-05); an older compositor's do not, and then the
			# latest mapped window of that number is meant.
			named = CLIENT_FIELD.search(line)
			key = (int(named.group(1)), surface) if named else latest.get(surface, (-1, surface))
			window = windows.setdefault(key, {"surface": surface, "client": key[0], "mapped": False, "docked": 0})
			if kind == "place":
				window["x"], window["y"], window["width"], window["height"] = numbers[1:5]
			elif kind == "dock":
				window["x"], window["y"], window["width"], window["height"] = numbers[1:5]
				window["docked"] = 1
			elif kind == "undock":
				window["x"], window["y"] = numbers[1:3]
				window["docked"] = 0
			elif kind == "resized":
				window["docked"] = numbers[1]
				window["width"], window["height"] = numbers[2:4]
			elif kind == "size":
				window["width"], window["height"] = numbers[1:3]
			else:
				window["x"], window["y"] = numbers[1:3]
			break
	return windows


def read_log(target: Target, path: str, offset: int = 0) -> tuple[bytes, int]:
	"""Returns a log's bytes after an offset and its length now (a log that shrank is read from its start)."""
	quoted = shlex.quote(path)
	script = (
		f"[ -f {quoted} ] || {{ echo 0; exit 0; }}; n=$(wc -c < {quoted}); echo $n; "
		f"if [ $n -ge {offset} ]; then tail -c +{offset + 1} {quoted}; else cat {quoted}; fi"
	)
	data = target.run(target.root(script)).stdout
	head, _, body = data.partition(b"\n")
	length = int(head.strip() or b"0")
	if length < offset:
		return body, length
	return body[:max(0, length - offset)], length


def log_length(target: Target, path: str) -> int:
	"""Returns how many bytes a log has now (0 when it is not there)."""
	quoted = shlex.quote(path)
	data = target.run(target.root(f"if [ -f {quoted} ]; then wc -c < {quoted}; else echo 0; fi")).stdout
	return int(data.strip() or b"0")


def since_offset(target: Target, path: str, mark: str | None) -> int:
	"""Returns where a mark left a log (0 without one)."""
	if mark is None:
		return 0
	marks = target.load_state().get("marks", {})
	key = f"{path}#{mark}"
	if key not in marks:
		fail(f"no mark {mark!r} on {path} (aat mark {mark})")
	return int(marks[key])


# The commands.

def command_check(target: Target, arguments: argparse.Namespace) -> int:
	"""Reaches the target and says what it has and lacks."""
	shot_path = SHOT.split()[0]
	# The tools decide the status; the session's log is only reported (it is there once a session runs, T1-200).
	log = shlex.quote(arguments.log)
	script = (
		"uname -a; id -un; "
		f"for f in /dev/input-inject {shlex.quote(shlex.split(INPUT)[-1])} {shlex.quote(shot_path)}; do "
		"if [ -e \"$f\" ]; then echo \"have $f\"; else echo \"missing $f\"; fi; done; "
		f"if [ -e {log} ]; then echo \"log {arguments.log}\"; else echo \"no log {arguments.log} (no session yet, or --log)\"; fi"
	)
	result = target.run(target.root(script))
	sys.stdout.write(result.stdout.decode("utf-8", "replace"))
	return 1 if b"missing " in result.stdout else 0


def command_run(target: Target, arguments: argparse.Namespace) -> int:
	"""Runs a shell command there and passes its output and status on."""
	script = " ".join(arguments.words)
	if arguments.root:
		script = target.root(script)
	result = target.run(script, timeout=arguments.timeout, check=False)
	sys.stdout.buffer.write(result.stdout)
	sys.stderr.buffer.write(result.stderr)
	return result.returncode


def command_get(target: Target, arguments: argparse.Namespace) -> int:
	"""Copies a file from the target."""
	data = target.run(target.root(f"cat {shlex.quote(arguments.remote)}")).stdout
	Path(arguments.local_path).write_bytes(data)
	print(f"aat: got {arguments.remote} ({len(data)} bytes)")
	return 0


def command_put(target: Target, arguments: argparse.Namespace) -> int:
	"""Copies a file to the target (as the user connected, not root)."""
	data = Path(arguments.local_path).read_bytes()
	target.run(f"cat > {shlex.quote(arguments.remote)}", data=data)
	print(f"aat: put {arguments.remote} ({len(data)} bytes)")
	return 0


def command_start(target: Target, arguments: argparse.Namespace) -> int:
	"""Starts aat-input's server (a fresh one) over the screen's pixels."""
	if arguments.size:
		match = re.fullmatch(r"(\d+)x(\d+)", arguments.size)
		if match is None:
			fail(f"--size is WxH, not {arguments.size!r}")
		width, height = int(match.group(1)), int(match.group(2))
	else:
		width, height = png_size(take_shot(target))

	# A server left from before goes first (its answer does not matter).
	target.run(target.root(f"{INPUT} stop >/dev/null 2>&1; true"))

	# The server stays in the background with the descriptors it was started with: started on SSH's, the session
	# would never end (T1-200), so it starts on a file's and the file is read after the starter returns.
	said = shlex.quote(f"{RUN_DIR}/input-start.txt")
	script = target.root(
		f"mkdir -p {shlex.quote(RUN_DIR)} || exit 1; {INPUT} start --width {width} --height {height} "
		f"</dev/null >{said} 2>&1; status=$?; cat {said}; exit $status"
	)
	result = target.run(script, check=False)
	answer = result.stdout.decode("utf-8", "replace").strip()
	if result.returncode != 0 or "AAT-INPUT ready" not in answer:
		fail(f"aat-input start: {answer or result.stderr.decode('utf-8', 'replace').strip()}")
	state = target.load_state()
	state["screen"] = [width, height]
	target.save_state(state)
	print(f"aat: input started, screen {width}x{height}")
	return 0


def command_stop(target: Target, arguments: argparse.Namespace) -> int:
	"""Stops aat-input's server (its devices go away with it)."""
	aat_input(target, ["stop"])
	print("aat: input stopped")
	return 0


def command_move(target: Target, arguments: argparse.Namespace) -> int:
	"""Puts the pointer at a point."""
	aat_input(target, ["move-to", *point(target, arguments.x, arguments.y)])
	return 0


def command_rel(target: Target, arguments: argparse.Namespace) -> int:
	"""Moves the relative mouse by counts (the compositor's acceleration applies)."""
	aat_input(target, ["move", str(arguments.dx), str(arguments.dy)])
	return 0


def command_click(target: Target, arguments: argparse.Namespace) -> int:
	"""Clicks at a point: once, twice (a double click), or more."""
	button = button_name(arguments.button)
	where = point(target, arguments.x, arguments.y)
	held = [name.lower() for name in arguments.with_.split("+")] if arguments.with_ else []
	for name in held:
		aat_input(target, ["key-down", name])
	try:
		if arguments.count == 2:
			aat_input(target, ["double-click", button, *where])
		else:
			for _ in range(arguments.count):
				aat_input(target, ["click", button, *where])
	finally:
		# The keys held go up even when the click failed, the last first.
		for name in reversed(held):
			aat_input(target, ["key-up", name])
	return 0


def command_button(target: Target, arguments: argparse.Namespace, verb: str) -> int:
	"""Presses or lets go of a button where the pointer is."""
	aat_input(target, [verb, button_name(arguments.button)])
	return 0


def command_drag(target: Target, arguments: argparse.Namespace) -> int:
	"""Drags with the left button from one point to another in steps."""
	start = point(target, arguments.x1, arguments.y1)
	end = point(target, arguments.x2, arguments.y2)
	aat_input(target, ["drag", *start, *end, str(max(1, arguments.steps))])
	return 0


def command_tap(target: Target, arguments: argparse.Namespace) -> int:
	"""Taps the touch screen at a point (ws190-p002): once, or twice (a double tap)."""
	where = point(target, arguments.x, arguments.y)
	if arguments.count == 2:
		aat_input(target, ["double-tap", *where])
	else:
		for _ in range(arguments.count):
			aat_input(target, ["tap", *where])
	return 0


def command_touch_drag(target: Target, arguments: argparse.Namespace) -> int:
	"""Drags one finger on the touch screen from one point to another in steps, then lifts it."""
	start = point(target, arguments.x1, arguments.y1)
	end = point(target, arguments.x2, arguments.y2)
	aat_input(target, ["touch-drag", *start, *end, str(max(1, arguments.steps))])
	return 0


def command_finger(target: Target, arguments: argparse.Namespace, verb: str) -> int:
	"""Puts a finger of the touch screen down or moves it (at a point), or lifts it."""
	if verb == "touch-up":
		aat_input(target, [verb, str(arguments.id)])
	else:
		aat_input(target, [verb, str(arguments.id), *point(target, arguments.x, arguments.y)])
	return 0


def command_wheel(target: Target, arguments: argparse.Namespace) -> int:
	"""Turns the wheel at a point: notches, N > 0 up (and H > 0 right)."""
	aat_input(target, ["move-to", *point(target, arguments.x, arguments.y)])
	if arguments.n:
		aat_input(target, ["wheel", str(arguments.n)])
	if arguments.h:
		aat_input(target, ["hwheel", str(arguments.h)])
	return 0


def command_key(target: Target, arguments: argparse.Namespace) -> int:
	"""Presses chords one after another (evdev names in lower case: ctrl+alt+t, enter, f5)."""
	for chord in arguments.chords:
		aat_input(target, ["key", chord.lower()])
	return 0


def command_type(target: Target, arguments: argparse.Namespace) -> int:
	"""Types ASCII text."""
	for words in text_pieces(arguments.text):
		aat_input(target, words, timeout=30.0 + len(words[-1]) * 0.05)
	return 0


def command_shot(target: Target, arguments: argparse.Namespace) -> int:
	"""Takes the screen back as a PNG."""
	data = take_shot(target, arguments.remote)
	Path(arguments.local_path).write_bytes(data)
	width, height = png_size(data)
	print(f"aat: shot {arguments.local_path} {width}x{height}")
	return 0


def command_mark(target: Target, arguments: argparse.Namespace) -> int:
	"""Remembers how long a log is now, for --since."""
	length = log_length(target, arguments.log)
	state = target.load_state()
	state.setdefault("marks", {})[f"{arguments.log}#{arguments.name}"] = length
	target.save_state(state)
	print(f"aat: mark {arguments.name} {arguments.log} at {length}")
	return 0


def command_wait_log(target: Target, arguments: argparse.Namespace) -> int:
	"""Waits until a line of a log (after a mark) matches; prints it."""
	pattern = re.compile(arguments.regex)
	offset = since_offset(target, arguments.log, arguments.since)
	pending = b""
	deadline = time.monotonic() + arguments.timeout
	while True:
		data, length = read_log(target, arguments.log, offset)
		if length < offset:
			pending = b""
		offset = length
		pending += data
		lines = pending.split(b"\n")
		pending = lines.pop()
		for line in lines:
			text = line.decode("utf-8", "replace")
			if pattern.search(text):
				print(text)
				return 0
		if time.monotonic() >= deadline:
			print(f"aat: no line matched {arguments.regex!r} in {arguments.log} within {arguments.timeout:g} s", file=sys.stderr)
			return 1
		time.sleep(POLL_SECONDS)


def command_lines(target: Target, arguments: argparse.Namespace) -> int:
	"""Prints the lines of a log (after a mark) that match; 1 when none does."""
	pattern = re.compile(arguments.regex)
	data, _ = read_log(target, arguments.log, since_offset(target, arguments.log, arguments.since))
	found = 0
	for line in data.decode("utf-8", "replace").splitlines():
		if pattern.search(line):
			print(line)
			found += 1
	return 0 if found else 1


def command_windows(target: Target, arguments: argparse.Namespace) -> int:
	"""Lists the windows the compositor's lines describe."""
	data, _ = read_log(target, arguments.log, since_offset(target, arguments.log, arguments.since))
	windows = windows_from(data.decode("utf-8", "replace"))
	if arguments.json:
		print(json.dumps([windows[key] for key in sorted(windows)]))
		return 0
	print("surface client mapped x y width height docked")
	for key in sorted(windows):
		window = windows[key]
		print(" ".join(str(window.get(field, "-")) for field in ("surface", "client", "mapped", "x", "y", "width", "height", "docked")))
	return 0


def command_where(target: Target, arguments: argparse.Namespace) -> int:
	"""Prints one window's place and size ("x y width height"); 1 when not known.  Without --client, the latest
	mapped window with that surface number."""
	data, _ = read_log(target, arguments.log, since_offset(target, arguments.log, arguments.since))
	windows = windows_from(data.decode("utf-8", "replace"))
	found = [window for window in windows.values() if window["surface"] == arguments.surface and
		(arguments.client is None or window["client"] == arguments.client)]
	mapped = [window for window in found if window.get("mapped")]
	window = (mapped or found or [None])[-1]
	if window is None or "x" not in window:
		print(f"aat: no place known for surface {arguments.surface}", file=sys.stderr)
		return 1
	print(" ".join(str(window.get(field, "-")) for field in ("x", "y", "width", "height")))
	return 0


def parser() -> argparse.ArgumentParser:
	"""Returns the command line's parser."""
	top = argparse.ArgumentParser(prog="aat", description="Drives a zedBSD machine over SSH (WS173 AAT).")
	top.add_argument("--target", help="user@host[:port], or 5330")
	top.add_argument("--qemu", action="store_true", help="the guest of GUEST_RUNTIME/session.json")
	# Its own name: a positional "local" (get, put, shot) once overwrote it and ran those on this host (T1-200b).
	top.add_argument("--local", dest="on_host", action="store_true", help="run on this host (the self-test)")
	top.add_argument("--identity", help="the SSH key (default the guest harness's)")
	commands = top.add_subparsers(dest="command", required=True)

	def log_options(command: argparse.ArgumentParser, since: bool = True) -> None:
		command.add_argument("--log", default=DEFAULT_LOG)
		if since:
			command.add_argument("--since", help="a mark's name")

	command = commands.add_parser("check")
	command.add_argument("--log", default=DEFAULT_LOG)
	command = commands.add_parser("run")
	command.add_argument("--root", action="store_true", help="as root (sudo for another user)")
	command.add_argument("--timeout", type=float, default=COMMAND_TIMEOUT)
	command.add_argument("words", nargs="+")
	command = commands.add_parser("get")
	command.add_argument("remote")
	command.add_argument("local_path", metavar="LOCAL")
	command = commands.add_parser("put")
	command.add_argument("local_path", metavar="LOCAL")
	command.add_argument("remote")
	command = commands.add_parser("start")
	command.add_argument("--size", help="WxH (default: a shot's size)")
	commands.add_parser("stop")
	command = commands.add_parser("move")
	command.add_argument("x", type=float)
	command.add_argument("y", type=float)
	command = commands.add_parser("rel")
	command.add_argument("dx", type=int)
	command.add_argument("dy", type=int)
	command = commands.add_parser("click")
	command.add_argument("x", type=float)
	command.add_argument("y", type=float)
	command.add_argument("--button", default="left")
	command.add_argument("--count", type=int, default=1)
	command.add_argument("--with", dest="with_", help="keys held through the click: alt, ctrl+shift, ...")
	for name in ("down", "up"):
		command = commands.add_parser(name)
		command.add_argument("--button", default="left")
	command = commands.add_parser("drag")
	for name in ("x1", "y1", "x2", "y2"):
		command.add_argument(name, type=float)
	command.add_argument("--steps", type=int, default=20)
	command = commands.add_parser("tap", help="the touch screen: a finger's tap (--count 2: a double tap)")
	command.add_argument("x", type=float)
	command.add_argument("y", type=float)
	command.add_argument("--count", type=int, default=1)
	command = commands.add_parser("touch-drag", help="the touch screen: one finger's drag, then its lift")
	for name in ("x1", "y1", "x2", "y2"):
		command.add_argument(name, type=float)
	command.add_argument("--steps", type=int, default=20)
	for name in ("touch-down", "touch-move"):
		command = commands.add_parser(name, help="the touch screen: a finger (0..9) held at a point")
		command.add_argument("id", type=int)
		command.add_argument("x", type=float)
		command.add_argument("y", type=float)
	command = commands.add_parser("touch-up", help="the touch screen: a finger lifts")
	command.add_argument("id", type=int)
	command = commands.add_parser("wheel")
	command.add_argument("x", type=float)
	command.add_argument("y", type=float)
	command.add_argument("n", type=int, help="notches, > 0 up")
	command.add_argument("h", type=int, nargs="?", default=0, help="horizontal notches, > 0 right")
	command = commands.add_parser("key")
	command.add_argument("chords", nargs="+")
	command = commands.add_parser("type")
	command.add_argument("text")
	command = commands.add_parser("shot")
	command.add_argument("local_path", metavar="LOCAL")
	command.add_argument("--remote", help="where the target writes it first")
	command = commands.add_parser("mark")
	command.add_argument("name")
	log_options(command, since=False)
	command = commands.add_parser("wait-log")
	command.add_argument("regex")
	log_options(command)
	command.add_argument("--timeout", type=float, default=30.0)
	command = commands.add_parser("lines")
	command.add_argument("regex")
	log_options(command)
	command = commands.add_parser("windows")
	command.add_argument("--json", action="store_true", help="one JSON list")
	log_options(command)
	command = commands.add_parser("where")
	command.add_argument("surface", type=int)
	command.add_argument("--client", type=int, help="the client's number (KWL MAP client=)")
	log_options(command)
	return top


def main() -> int:
	"""Runs one command."""
	arguments = parser().parse_args()
	target = Target(arguments)
	handlers = {
		"check": command_check, "run": command_run, "get": command_get, "put": command_put,
		"start": command_start, "stop": command_stop, "move": command_move, "rel": command_rel,
		"click": command_click, "drag": command_drag, "wheel": command_wheel, "key": command_key,
		"type": command_type, "shot": command_shot, "mark": command_mark, "wait-log": command_wait_log,
		"lines": command_lines, "windows": command_windows, "where": command_where,
		"down": lambda t, a: command_button(t, a, "down"), "up": lambda t, a: command_button(t, a, "up"),
		"tap": command_tap, "touch-drag": command_touch_drag,
		"touch-down": lambda t, a: command_finger(t, a, "touch-down"),
		"touch-move": lambda t, a: command_finger(t, a, "touch-move"),
		"touch-up": lambda t, a: command_finger(t, a, "touch-up"),
	}
	return handlers[arguments.command](target, arguments)


if __name__ == "__main__":
	sys.exit(main())
