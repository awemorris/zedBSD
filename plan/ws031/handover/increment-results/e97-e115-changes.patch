+  {"out": "lcd_mreg_i915_reg.h", "dir": "i915", "source": "i915_reg.h", "path": "drivers/gpu/drm/i915/i915_reg.h"},
+  {"out": "lcd_mreg_combo_phy.h", "dir": "i915", "source": "display/intel_combo_phy_regs.h",
