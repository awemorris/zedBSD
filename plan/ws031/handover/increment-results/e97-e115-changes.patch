+#define NAMED_MODE(_name, _pclk, _x, _y, _flags, _mode)	\
+	{						\
+		.name = _name,				\
+		.pixel_clock_khz = _pclk,		\
+		.xres = _x,				\
+		.yres = _y,				\
+		.flags = _flags,			\
+		.tv_mode = _mode,			\
+	}
