+	if (!mask_empty(&pd->async_put_domains[1])) {
+		pd->async_put_domains[0] = pd->async_put_domains[1];
+		pd->async_put_domains[1].bits[0] = pd->async_put_domains[1].bits[1] = 0u;
+		pd->async_requeues++;
