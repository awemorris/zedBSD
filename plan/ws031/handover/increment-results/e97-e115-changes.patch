+ * (sha256 1969846dd3fdb5d7511319caf5f8e8481eacecad610fa429669450b9e5775b73) by tools/port_lcd_calc.py: 
+ * drm_dp_tps3_supported, drm_dp_tps4_supported, drm_dp_is_branch.
