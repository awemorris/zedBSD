+        T(5) + '"lcd: LCD-A-PLANE-WORDS PLANE_CTL / STRIDE / SIZE / COLOR_CTL / SURF equal Linux\'s dump, PLANE_SURF last");' + NL +
+        T(3) + "}" + NL +
+        T(3) + "rc = parity_lcd_emit_ddi(&lcd, 0, 0, 0, 0u, &dw, &buf);" + NL)
