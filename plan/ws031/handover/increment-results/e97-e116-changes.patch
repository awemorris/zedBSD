+}
+""", """	out->w[out->n].reg = reg;
+	out->w[out->n].value = value;
+	out->w[out->n].clear = 0u;
+	out->w[out->n].rmw = 0u;
+	out->n++;
+}
+
+static void record_rmw(void *ctx, u32 reg, u32 clear, u32 set)
+{
