+#define intel_set_cpu_fifo_underrun_reporting(i915, pipe, enable) PARITY_LCD_DECIDED(i915, "intel_set_cpu_fifo_underrun_reporting: underrun IRQ not wired; PIPESTATUS is read by the test")
