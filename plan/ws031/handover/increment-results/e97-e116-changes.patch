+#!/usr/bin/env python3
+"""WS031 E-115 round 11: pipe colour management (intel_color.c) for the state without LUTs / CTM.
+usage: round11.py <repo root>"""
+import sys, json
+NL, TAB = chr(10), chr(9)
+root = sys.argv[1].rstrip("/") + "/"
+L = "src/drivers/gpu/i915/parity/lcd/"
