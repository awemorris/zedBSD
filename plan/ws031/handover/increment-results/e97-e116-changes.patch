+  ssh solaris10-man "grep -qaE '$PASSRE' ~/bigbang/$LOG && grep -qa 'runner-result: selftest=PASS.*probe=COMPLETE.*cleanup=1' ~/bigbang/$LOG" || { echo "STOP: $NAME did not pass; no further submissions"; exit 1; }
