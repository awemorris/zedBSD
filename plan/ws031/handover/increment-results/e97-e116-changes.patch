+int parity_ddi_emit(struct parity_lcd_emit *emit, const struct drm_display_mode *mode, int port, int pipe,
+	int cpu_transcoder, int port_clock, int lanes, int pipe_bpp, u32 saved_port_bits, u32 *ddi_buf_ctl_value);
+
