+
+static int
+pd_async_test_cancel(void *ctx, int sync)
+{
+	int was = g_pd_async.queued;
+
+	(void)ctx;
+	g_pd_async.cancel_calls++;
+	if (sync)
+		g_pd_async.cancel_sync_calls++;
+	g_pd_async.queued = 0;
+	return was;
