+extern struct drm_encoder *parity_lcd_only_encoder;
+#define drm_for_each_encoder_mask(encoder, dev, mask) \
+	for ((encoder) = parity_lcd_only_encoder; (encoder) != 0; (encoder) = 0) for_each_if((mask) & (1u << (encoder)->index))
+
