+	uint32_t status;                /* ICL_PIPESTATUS as read */
+	uint32_t frame;                 /* PIPE_FRMCOUNT_G4X as read */
+	uint32_t imr;                   /* GEN8_DE_PIPE_IMR as read */
+	int steady;
+};
