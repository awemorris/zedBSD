+		/* not the last reference: an ordinary put, nothing parked */
+		(void)parity_display_power_get(pdc, PARITY_PW_DOMAIN_PIPE_A, cx);
+		(void)parity_display_power_get(pdc, PARITY_PW_DOMAIN_PIPE_A, cx);
