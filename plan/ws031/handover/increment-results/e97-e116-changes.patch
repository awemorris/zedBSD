+def lines_matching(text, regex, src, label, expect):
+    got = [l for l in text.split(NL) if re.search(regex, l)]
+    assert len(got) == expect, (label, len(got), expect)
+    manifest["kept"].setdefault(src, []).append(label)
+    return NL.join(got) + NL
