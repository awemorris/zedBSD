+	CHECK((lcd_fake_reg(&lcd, 0x46010) & 0xcc000000u) == 0xcc000000u && lcd_fake_reg(&lcd, 0x164284) == 0x00e001a5u &&
+	      lcd_fake_reg(&lcd, 0x164288) == 0x00000088u,
