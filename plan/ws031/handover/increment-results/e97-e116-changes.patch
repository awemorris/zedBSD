+    start = hits[0]
+    end = text.index(NL + "}" + NL, start) + 3
+    pre = text[:start].rstrip(NL)
+    if pre.endswith("*/"):
+        c = pre.rfind("/*")
+        seg = text[c:start]
+        if seg.count(NL) < 60 and (NL + NL) not in seg.rstrip(NL):
