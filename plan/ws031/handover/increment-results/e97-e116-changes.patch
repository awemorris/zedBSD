+def extra(text, srcname, src):
+    """the EXTRA functions port_lcd_modeset.json lists for this reference file"""
+    ranges = "".join(between(text, r[0], r[1], src, r[2]) + NL for r in SPEC.get("extra_ranges", {}).get(srcname, []))
