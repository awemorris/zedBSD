+static int
+pd_async_test_queue(void *ctx, int delay_ms)
+{
+	(void)ctx;
+	g_pd_async.queue_calls++;
+	if (g_pd_async.queued)
+		return 0;
+	g_pd_async.queued = 1;
+	g_pd_async.last_delay = delay_ms;
+	return 1;
