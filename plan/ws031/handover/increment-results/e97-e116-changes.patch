+#define assert_fdi_tx_pll_enabled(i915, pipe) ((void)0)
+
+#include "lcd_mreg_reg_defs.h"          /* reference, extracted macros: closure of the roots in tools/port_lcd_modeset.json */
+#include "lcd_mreg_display_reg_defs.h"
