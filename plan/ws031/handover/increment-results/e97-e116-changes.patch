+c = rep(c, "	u8 sync_mode_slaves_mask;" + NL, "	u8 sync_mode_slaves_mask;" + NL +
+        "	/* watermarks / DDB of the crtc (intel_crtc_wm_state.skl), and the one plane of this path with its state */" + NL +
