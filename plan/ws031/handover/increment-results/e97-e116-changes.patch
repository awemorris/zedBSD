+         "		goto lcdb_kept;" + NL + "	}" + NL + "	if (scratch_created) {" + NL)
+pc = rep(pc, "	parity_dump_trace(&trace);" + NL + '	kern_logf("i915: parity attach end:', "lcdb_kept:" + NL + "	parity_dump_trace(&trace);" + NL + '	kern_logf("i915: parity attach end:')
+save(P + "probe.c", pc)
+kt = load(P + "ktest.c")
