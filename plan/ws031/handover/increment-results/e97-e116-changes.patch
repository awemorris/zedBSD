+def between(text, a, b, src, label):
+    assert text.count(a) == 1, (label, "start", text.count(a))
+    s = text.index(a)
+    e = text.index(b, s) + len(b)
+    manifest["kept"].setdefault(src, []).append(label)
+    return text[s:e]
