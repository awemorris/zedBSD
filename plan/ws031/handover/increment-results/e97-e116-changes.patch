+/*
+ * zedBSD WS031: generated from Linux v6.8.12 drivers/gpu/drm/drm_modes.c
+ * (sha256 e3a32332f5eb4f8a40c7df278bcfc9fd3b21468f2c94aa0470cb1176c94680ef) by plan/ws031/handover/tools/port_lcd_calc.py.
