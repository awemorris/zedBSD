+
+#endif /* PARITY_LCD_KERNEL_H */
+""")
+open(root + L + "lcd_show_ktest.h", "w").write("""/* WS031 Linux-parity -- GPU-free kernel checks of LCD-B's production body with a real scanout object (lcd_show_ktest.c). */
