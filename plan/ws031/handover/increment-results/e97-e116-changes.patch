+build eu   -DPARITY_EU_TEST=1   || exit 1
+build draw -DPARITY_DRAW_TEST=1 || exit 1
+build r1   -DPARITY_R1_TEST=1   || exit 1
+build tex  -DPARITY_TEX_TEST=1  || exit 1
