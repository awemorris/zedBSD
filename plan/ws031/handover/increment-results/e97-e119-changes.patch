+
+c = load(L + "lcd_compat.h")
+c = rep(c, "	u8 dpcd[15];" + NL + "};",
+        "	u8 dpcd[15];" + NL +
+        "	u8 edp_dpcd[3];" + NL +
+        "	struct { int unused; } aux;" + NL +
+        "	u8 lttpr_common_caps[8];            /* DP_LTTPR_COMMON_CAP_SIZE */" + NL +
