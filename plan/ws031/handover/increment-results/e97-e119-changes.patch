+#define clamp_t(type, val, lo, hi) ({ type _v = (type)(val); type _l = (type)(lo); type _h = (type)(hi); _v < _l ? _l : (_v > _h ? _h : _v); })
+#define DIV_ROUND_CLOSEST_ULL(x, d) ((u64)(((u64)(x) + ((u64)(d) / 2u)) / (u64)(d)))
