+				"irq: VBL-PUT the last put masks vblank at once (vblank_disable_immediate)");
+			{
+				uint32_t before = kv.count[0];
+				unsigned acks = id.de_pipe_iir_acks[0];
+
+				kvb_raise_pipe = 0;
+				(void)kvb_read_frame(0);
