+j["macro_headers"].append({"out": "lcd_mreg_color.h", "dir": "i915", "source": "display/intel_color_regs.h",
+    "path": "drivers/gpu/drm/i915/display/intel_color_regs.h", "roots": [], "exclude": j["macro_headers"][0]["exclude"]})
