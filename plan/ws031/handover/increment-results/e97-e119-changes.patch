++		tf.stuck = 0;
++		rrc = parity_fhd_rt_unmap(&bmap, &vm, &tlb, &es, &m, &ulock);
++		check(rrc == 0 && bmap.released && bmap.scratch == 4u && bmap.unmap_calls == 2u &&
++			parity_fhd_rt_unmap(&bmap, &vm, &tlb, &es, &m, &ulock) == 0 && bmap.unmap_calls == 2u,
