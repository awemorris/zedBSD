++			due->firing = 1;
++			due->fired_count++;
++			spin_unlock(&tq->lock);
++			(void)parity_kqueue_work(tq->wq, &due->work);
++			spin_lock(&tq->lock);
++			due->firing = 0;
++			waitq_wake_all(&tq->waitq);
