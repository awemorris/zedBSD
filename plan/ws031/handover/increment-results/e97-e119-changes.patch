+#!/usr/bin/env python3
+"""WS031 E-119 records: ledger entry (results-ws031.md) and regression baseline.  usage: record_e119.py <repo root> <sweep line>"""
+import sys
+root = sys.argv[1].rstrip("/") + "/"
+sweep = sys.argv[2]
+L = root + "plan/ws031/results-ws031.md"
+B = root + "plan/ws031/regression-baseline.md"
+ledger = """
+
+## p011 å¢—åˆ†E-119 (2026-09-19): **åŒæœŸ flip å®Ÿæ©Ÿ PASS â€” LCD-Cï¼ˆCPU ã§ç”¨æ„ã—ãŸ A/Bï¼‰ã¨ LCD-Dï¼ˆè¡¨ç¤ºã—ã¦ã„ãªã„å´ã‚’ GPU ã§æãç›´ã—ã¦ flipï¼‰**ã€GPU æœªå®Œäº†æ™‚ã®ä¿è­·ã‚’å¤–å´ teardown ã¾ã§ã€PTE è§£æ”¾å¥‘ç´„ï¼‹GT TLB ç„¡åŠ¹åŒ–
+
+### 1. GPU æœªå®Œäº†æ™‚ã®ä¿è­·ï¼ˆãƒ¬ãƒ“ãƒ¥ãƒ¼â‘ ï¼‰
+`parity_lcdg_finish()`: submitted ã‹ã¤æœªå®Œäº†ãªã‚‰ `parity_fhd_render_keep()`ï¼ˆtextureï¼stateï¼batchï¼timelineï¼RTï¼ringï¼‹context stateï¼‰ã€scanout ã‚’ abandonã€`parity_lcd_show_retain_gpu()` ã§ device ã® GPU latchã€‚probe teardown ã¯ `parity_lcd_kernel_gpu_retained()` ãŒçœŸãªã‚‰ engines release ã¨ ppgttï¼gt_mem fini ã‚’è¡Œã‚ãªã„ã€‚runner ã¯ retained=1ã€‚GPU-free: FIN-GPUï¼FIN-REFUSEï¼FIN-TEARDOWNï¼FIN-NOTSHOWNï¼FIN-DISCARDã€‚
+
+### 2. PTE è§£æ”¾å¥‘ç´„ã¨ TLBï¼ˆãƒ¬ãƒ“ãƒ¥ãƒ¼â‘¡ï¼‰
+`parity_fhd_render_release()`: -EBUSYï¼ˆGPU æœªå®Œäº†ï¼‰â†’ å…¨ mapping ã‚’ scratch â†’ å‘¼å‡ºã—ã”ã¨ã« walk ã§ç¢ºèªï¼ˆåˆç®—ã—ãªã„ã€-EIO ã§ ownership ã‚’ä¿æŒï¼‰â†’ `parity_gt_invalidate_tlb_full()`ï¼ˆæ–°è¦ gt_tlb.c: mmio_invalidate_full æº–æ‹ ã€FORCEWAKE_ALLã€reset ã¨ã®ç›´åˆ—åŒ–ã€å…¨ engineã€gen12 registerã€OA WA 0xceecï¼‰â†’ è§£æ”¾ã€‚T1ã€œT3 harness ã¯ `eu_scrub_fixture_ptes()`ï¼ˆfixture ã¯ä¸å¤‰ï¼‰ã€‚å®Ÿæ©Ÿ LCD-G: 2028/2028ã€TLB rc=0ã€timeouts 0ã€‚
+
+### 3. display_acquiredã€vblank snapshotã€IRQ uninstall logï¼ˆãƒ¬ãƒ“ãƒ¥ãƒ¼â‘¢ã»ã‹ï¼‰
+G-NOTSTARTEDï¼ˆprepare æ‹’å¦ â†’ acquired=0ã€æ›¸è¾¼ã¿ 0ã€æ‰€æœ‰è€…ãŒå›žåŽï¼‰ã€‚vblank è¨ˆæ•°ã¯ `vbl_snapshot()`ã€‚uninstall log ã¯å®Ÿè¡Œæ™‚ã®ã¿ã€‚
+
