@@ -7,14 +7,14 @@ repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
 work=$(mktemp -d "${TMPDIR:-/tmp}/ws031-vk-host.XXXXXX")
 trap "rm -rf -- \"$work\"" EXIT HUP INT TERM
 compiler=${CC:-cc}
