+#define PARITY_LCD_DECIDED(i915, what) PARITY_LCD_STEP(i915, "(decided) " what)
+/* intel_initial_watermarks(): calls display.funcs.wm->initial_watermarks, which skl_wm_funcs (display version 9+)
