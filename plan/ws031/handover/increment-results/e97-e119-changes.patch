++			if (dw == 0)
++				continue;
++			if (dw->deadline <= now) {
++				due = dw;
++				tq->armed[i] = 0;
++				break;
++			}
++			if (earliest == 0u || dw->deadline < earliest)
++				earliest = dw->deadline;
++		}
++		if (due != 0) {
++			/*
