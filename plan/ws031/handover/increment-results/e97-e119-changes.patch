+#!/usr/bin/env python3
+"""WS031 E-114 round 2: object members the modeset bodies use; disable-side steps and dispatchers.
+usage: patch_compat2_e114.py <repo root>"""
+import sys
+NL, TAB = chr(10), chr(9)
