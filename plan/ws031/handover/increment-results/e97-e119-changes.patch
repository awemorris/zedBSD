+    "functions": ["lut_is_legacy", "icl_gamma_mode", "icl_csc_mode", "icl_load_csc_matrix", "icl_load_luts",
+                  "icl_color_commit_noarm", "icl_color_commit_arm", "intel_color_load_luts", "intel_color_commit_noarm",
+                  "intel_color_commit_arm"],
