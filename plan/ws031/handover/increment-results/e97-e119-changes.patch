+/* WS031 Linux-parity -- GPU-free kernel checks of LCD-B's production body with a real scanout object (lcd_show_ktest.c). */
+#ifndef PARITY_LCD_SHOW_KTEST_H
+#define PARITY_LCD_SHOW_KTEST_H
+
