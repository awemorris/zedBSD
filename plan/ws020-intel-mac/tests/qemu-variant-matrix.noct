require zedbuild;

// MAC-T020 finite firmware/layout acceptance matrix.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib

func normalizeProcessText(value) {
    var result = "";
    for (i in 0..String.charCount(value)) {
        if (String.charCodeAt(value, i) != 13) {
            result = result + String.charAt(value, i);
        }
    }
    return result;
}

func capture(command, what) {
    var child = Process.spawn(["/bin/sh", "-c", command + " 2>&1"]);
    if (child < 0) { zbFail("cannot start " + what); }
    var output = "";
    while (Process.isAlive(child) == 1) {
        output = output + Process.read(child, 100);
    }
    output = output + Process.read(child, 0);
    var status = Process.wait(child);
    Process.close(child);
    output = normalizeProcessText(output);
    while (String.charCount(output) > 0 &&
           String.charCodeAt(output, String.charCount(output) - 1) == 10) {
        output = String.substring(output, 0, String.charCount(output) - 1);
    }
    if (status != 0) {
        zbFail(what + " failed (status=" + status + "): " + output);
    }
    return output;
}

func run(repo, command, what) {
    var status = System.shell("cd " + zbShellQuote(repo) + " && " + command);
    if (status != 0) { zbFail(what + " failed (status=" + status + ")"); }
}

func runLogged(repo, log, command, what) {
    var status = System.shell("cd " + zbShellQuote(repo) + " && " + command +
                              " >" + zbShellQuote(log) + " 2>&1");
    if (status != 0) {
        zbFail(what + " failed (status=" + status + "; log=" + log + ")");
    }
}

func requirePattern(path, pattern, what) {
    if (System.shell("rg -a -q -- " + zbShellQuote(pattern) + " " +
                     zbShellQuote(path)) != 0) {
        zbFail(what + " is missing (log=" + path + ")");
    }
}

func rejectPattern(path, pattern, what) {
    var status = System.shell("rg -a -q -- " + zbShellQuote(pattern) + " " +
                              zbShellQuote(path));
    if (status == 0) { zbFail(what + " was observed (log=" + path + ")"); }
    // System.shell exposes the wait status on this host, so rg's ordinary
    // no-match exit may appear either as 1 or as 1<<8.
    if (status != 1 && status != 256) { zbFail("cannot inspect " + path); }
}

func resolveCommand(shellExpression, what) {
    var value = capture("command -v \"" + shellExpression + "\"", what);
    if (value == "") { zbFail(what + " resolved to an empty path"); }
    return value;
}

func resolveFile(shellExpression, what) {
    var value = capture("realpath \"" + shellExpression + "\"", what);
    if (FileUtil.checkFileExists(value) != 1) {
        zbFail(what + " not found: " + value);
    }
    return value;
}

func writeFixtureConfig(repo, destination) {
    var source = FileUtil.readText(repo + "/config.mk");
    FileUtil.writeText(destination, source +
        "\n# MAC-T020 QEMU-only overrides; repository config.mk is unchanged.\n" +
        "ZEDBSD_PLATFORM := amd64\n" +
        "ZEDBSD_ARCHITECTURE := amd64\n" +
        "ZEDBSD_BOARD := pcat\n" +
        "ZEDBSD_VARIANT := hybrid\n" +
        "CONFIG_DRIVER_NE2000 := n\n" +
        "CONFIG_DRIVER_PCI_UHCI := n\n" +
        "CONFIG_DRIVER_PCI_EHCI := n\n" +
        "CONFIG_DRIVER_PCI_XHCI := y\n" +
        "CONFIG_DRIVER_USB_STORAGE := y\n");
}

func makeVariables(config, build, evidence) {
    return " ZEDBSD_CONFIG=" + zbShellQuote(config) +
        " BUILD=" + zbShellQuote(build) +
        " ARCH_IMAGE_DIR=" + zbShellQuote(evidence + "/arch-images") +
        " DATA_IMAGE=" + zbShellQuote(evidence + "/data.img") +
        " SWAP_IMAGE=" + zbShellQuote(evidence + "/swapfile") +
        " ZEDBSD_IMAGE_HOST=" + zbShellQuote(evidence + "/zedimage-host");
}

func checkerArgs(build, evidence, layout, image) {
    var stage1 = build + "/bootloader/stage1.bin";
    if (layout == "bios") {
        stage1 = build + "/bootloader/stage1-native.bin";
    }
    return "--layout " + layout +
        " --machine pcat --stage1 " + zbShellQuote(stage1) +
        " --stage2 " + zbShellQuote(build + "/bootloader/stage2-chain.bin") +
        " --partition-pbr " +
        zbShellQuote(build + "/bootloader/partition-pbr.bin") +
        " --bootzbsd " + zbShellQuote(build + "/bootloader/BOOTZBSD.EXE") +
        " --kernel " + zbShellQuote(build + "/vmunix") +
        " --bootx64 " + zbShellQuote(build + "/uefi/BOOTX64.EFI") +
        " --zedbsd-config platform/amd64/zedbsd.cfg" +
        " --arch-profile amd64 --arch-image " +
        zbShellQuote(evidence + "/arch-images/amd64.ufs") +
        " --arch-format ufs --data-image " +
        zbShellQuote(evidence + "/data.img") +
        " --swapfile " + zbShellQuote(evidence + "/swapfile") + " " +
        zbShellQuote(image);
}

func imageBytes(layout) {
    if (layout == "hybrid") { return 203423744; }
    if (layout == "bios") { return 135266304; }
    return 202392064;
}

func expectedUsbBlocks(layout) {
    if (layout == "hybrid") { return 397312; }
    if (layout == "bios") { return 264192; }
    return 395297;
}

func expectedBootPartition(layout) {
    if (layout == "bios") { return 1; }
    return 2;
}

func buildImage(repo, evidence, config, build, layout) {
    var command = "TMPDIR=" + zbShellQuote(evidence + "/tmp") +
        " make --no-print-directory -j16 " +
        "ZEDBSD_PLATFORM=amd64 ZEDBSD_ARCHITECTURE=amd64 " +
        "ZEDBSD_BOARD=pcat ZEDBSD_VARIANT=" + layout +
        " CONFIG_DRIVER_PCI_UHCI=n CONFIG_DRIVER_PCI_EHCI=n" +
        " CONFIG_DRIVER_PCI_XHCI=y CONFIG_DRIVER_USB_STORAGE=y" +
        makeVariables(config, build, evidence) + " disk-image";
    runLogged(repo, evidence + "/images/build-" + layout + ".log", command,
              layout + " production image");
    var source = evidence + "/images/" + layout + ".img";
    run(repo, "test \"$(stat -c%s " +
        zbShellQuote(build + "/hdd-image.img") + ")\" = " +
        imageBytes(layout), layout + " exact artifact extent");
    run(repo, "cp --reflink=auto --sparse=always " +
        zbShellQuote(build + "/hdd-image.img") + " " + zbShellQuote(source),
        "retain " + layout + " source image");
    var checker = "build/NoctLang/build-static/noct --path=tools/build " +
        "platform/amd64/tools/check-amd64-gpt-image.noct ";
    runLogged(repo, evidence + "/images/check-" + layout + ".log",
        checker + checkerArgs(build, evidence, layout, source),
        layout + " byte-level image gate");
    run(repo, "sha256sum " + zbShellQuote(source) + " >" +
        zbShellQuote(source + ".sha256"), layout + " source hash");
    return source;
}

func commandText(command) {
    var result = "";
    for (i in 0..Array.size(command)) {
        if (i != 0) { result = result + " "; }
        result = result + zbShellQuote(command[i]);
    }
    return result + "\n";
}

func allZero(data) {
    for (i in 0..Packed.size(data)) {
        if (data[i] != 0) { return false; }
    }
    return true;
}

func allZeroRange(data, first, last) {
    if (first < 0 || last < first || last > Packed.size(data)) {
        return false;
    }
    for (i in first..last) {
        if (data[i] != 0) { return false; }
    }
    return true;
}

func equalRange(left, leftOffset, right, rightOffset, count) {
    if (leftOffset < 0 || rightOffset < 0 || count < 0 ||
        leftOffset + count > Packed.size(left) ||
        rightOffset + count > Packed.size(right)) {
        return false;
    }
    for (i in 0..count) {
        if (left[leftOffset + i] != right[rightOffset + i]) { return false; }
    }
    return true;
}

func crc32Range(data, start, count) {
    var crc = 4294967295;
    for (i in 0..count) {
        crc = crc ^ data[start + i];
        for (j in 0..8) {
            if ((crc & 1) != 0) { crc = (crc >> 1) ^ 0xedb88320; }
            else { crc = crc >> 1; }
        }
    }
    return (crc ^ 4294967295) & 4294967295;
}

func validPrimaryFront(front) {
    if (Packed.size(front) != 17408 ||
        !allZeroRange(front, 0, 446) || front[446] != 0 ||
        front[447] != 0 || front[448] != 2 || front[449] != 0 ||
        front[450] != 238 || front[451] != 255 || front[452] != 255 ||
        front[453] != 255 || zbU32LE(front, 454) != 1 ||
        zbU32LE(front, 458) != 395296 ||
        !allZeroRange(front, 462, 510) || front[510] != 85 ||
        front[511] != 170 || !zbBytesEqual(front, 512, "EFI PART") ||
        zbU32LE(front, 520) != 65536 || zbU32LE(front, 524) != 92 ||
        zbU32LE(front, 532) != 0 || zbU64SmallLE(front, 536) != 1 ||
        zbU64SmallLE(front, 544) != 395296 ||
        zbU64SmallLE(front, 552) != 34 ||
        zbU64SmallLE(front, 560) != 395263 ||
        zbU64SmallLE(front, 584) != 2 ||
        zbU32LE(front, 592) != 128 || zbU32LE(front, 596) != 128 ||
        !allZeroRange(front, 604, 1024)) {
        return false;
    }
    var header = Packed.uint8(92);
    zbCopy(header, 0, front, 512, 92);
    var stored = zbU32LE(header, 16);
    zbPut32LE(header, 16, 0);
    return stored == crc32Range(header, 0, 92) &&
        zbU32LE(front, 600) == crc32Range(front, 1024, 16384);
}

func validBackupMirror(front, tail) {
    var headerAt = 16384;
    if (Packed.size(front) != 17408 || Packed.size(tail) != 16896 ||
        !zbBytesEqual(tail, headerAt, "EFI PART") ||
        zbU32LE(tail, headerAt + 8) != 65536 ||
        zbU32LE(tail, headerAt + 12) != 92 ||
        zbU32LE(tail, headerAt + 20) != 0 ||
        zbU64SmallLE(tail, headerAt + 24) != 395296 ||
        zbU64SmallLE(tail, headerAt + 32) != 1 ||
        zbU64SmallLE(tail, headerAt + 40) != 34 ||
        zbU64SmallLE(tail, headerAt + 48) != 395263 ||
        zbU64SmallLE(tail, headerAt + 72) != 395264 ||
        zbU32LE(tail, headerAt + 80) != 128 ||
        zbU32LE(tail, headerAt + 84) != 128 ||
        zbU32LE(tail, headerAt + 88) != crc32Range(tail, 0, 16384) ||
        !equalRange(front, 568, tail, headerAt + 56, 16) ||
        !equalRange(front, 1024, tail, 0, 16384) ||
        !allZeroRange(tail, headerAt + 92, Packed.size(tail))) {
        return false;
    }
    var header = Packed.uint8(92);
    zbCopy(header, 0, tail, headerAt, 92);
    var stored = zbU32LE(header, 16);
    zbPut32LE(header, 16, 0);
    return stored == crc32Range(header, 0, 92);
}

func requireUefiState(image, cell, stage) {
    if (FileUtil.getFileSize(image) != 202392064) {
        zbFail("UEFI " + stage + " image has the wrong fixed extent");
    }
    var frontPath = cell + "/gpt-front-" + stage + ".bin";
    var tailPath = cell + "/gpt-tail-" + stage + ".bin";
    run("/", "dd if=" + zbShellQuote(image) + " of=" +
        zbShellQuote(frontPath) + " bs=512 count=34 status=none && dd if=" +
        zbShellQuote(image) + " of=" + zbShellQuote(tailPath) +
        " bs=512 skip=395264 count=33 status=none",
        "extract bounded UEFI GPT evidence");
    var front = zbReadFile(frontPath);
    var tail = zbReadFile(tailPath);
    if (!validPrimaryFront(front)) {
        zbFail("UEFI " + stage + " primary GPT geometry is invalid");
    }
    if (stage == "pre") {
        if (!allZero(tail)) {
            zbFail("UEFI source does not reserve a zero final GPT region");
        }
        FileUtil.writeText(cell + "/gpt-state-pre.txt",
                           "intentional-primary-only-zero-tail\n");
    } else if (allZero(tail)) {
        FileUtil.writeText(cell + "/gpt-state-post.txt",
                           "intentional-primary-only-zero-tail\n");
    } else if (validBackupMirror(front, tail)) {
        FileUtil.writeText(cell + "/gpt-state-post.txt",
                           "firmware-repaired-valid-mirror\n");
    } else {
        zbFail("UEFI postboot tail is malformed or contradicts the primary");
    }
    run("/", "sha256sum " + zbShellQuote(frontPath) + " " +
        zbShellQuote(tailPath) + " >" +
        zbShellQuote(cell + "/gpt-" + stage + ".sha256"),
        "hash bounded UEFI GPT evidence");
}

func prepareRunImage(source, destination, layout, cell) {
    run("/", "cp --reflink=auto --sparse=always " + zbShellQuote(source) +
        " " + zbShellQuote(destination) + " && cmp " +
        zbShellQuote(source) + " " + zbShellQuote(destination),
        "create exact disposable boot medium");
    run("/", "stat -c 'logical_bytes=%s allocated_blocks=%b " +
        "allocation_unit=%B' " + zbShellQuote(destination) + " >" +
        zbShellQuote(cell + "/image-stat-pre.txt"),
        "retain image extent evidence");
    if (layout == "uefi") {
        requireUefiState(destination, cell, "pre");
    }
}

func makeQemuCommand(qemu, seabios, ovmfCode, varsCopy, firmware, image,
                     guestLog, serialLog, firmwareLog) {
    var command = ["timeout", "120", qemu];
    if (firmware == "seabios") {
        Array.push(command, "-bios");
        Array.push(command, seabios);
    }
    Array.push(command, "-machine");
    Array.push(command, "q35");
    Array.push(command, "-accel");
    Array.push(command, "tcg,thread=single");
    Array.push(command, "-m");
    Array.push(command, "512");
    Array.push(command, "-smp");
    // MAC-T020 isolates image/firmware-path acceptance. SMP scheduling is a
    // separate concern and made this finite matrix needlessly nondeterministic.
    Array.push(command, "1");
    if (firmware == "ovmf") {
        Array.push(command, "-drive");
        Array.push(command, "if=pflash,format=raw,readonly=on,file=" + ovmfCode);
        Array.push(command, "-drive");
        Array.push(command, "if=pflash,format=raw,file=" + varsCopy);
    }
    Array.push(command, "-device");
    Array.push(command, "qemu-xhci,id=xhci");
    Array.push(command, "-drive");
    Array.push(command, "if=none,id=bootdisk,file=" + image + ",format=raw");
    Array.push(command, "-device");
    Array.push(command,
        "usb-storage,bus=xhci.0,port=1,drive=bootdisk,id=bootstick,bootindex=1");
    Array.push(command, "-boot");
    Array.push(command, "order=c,strict=on");
    Array.push(command, "-display");
    Array.push(command, "none");
    Array.push(command, "-monitor");
    Array.push(command, "stdio");
    Array.push(command, "-serial");
    Array.push(command, "file:" + serialLog);
    Array.push(command, "-debugcon");
    Array.push(command, "file:" + guestLog);
    if (firmware == "seabios") {
        Array.push(command, "-chardev");
        Array.push(command, "file,id=fwdebug,path=" + firmwareLog);
        Array.push(command, "-device");
        Array.push(command, "isa-debugcon,iobase=0x402,chardev=fwdebug");
    }
    Array.push(command, "-net");
    Array.push(command, "none");
    Array.push(command, "-no-reboot");
    Array.push(command, "-no-shutdown");
    return command;
}

func stopQemu(child) {
    if (Process.isAlive(child) == 1) { Process.write(child, "quit\n"); }
    var output = "";
    var ticks = 0;
    while (Process.isAlive(child) == 1 && ticks < 100) {
        output = output + Process.read(child, 100);
        ticks = ticks + 1;
    }
    output = output + Process.read(child, 0);
    var status = Process.wait(child);
    Process.close(child);
    return [status, normalizeProcessText(output)];
}

func hasText(path, marker) {
    if (FileUtil.checkFileExists(path) != 1) { return false; }
    return String.indexOf(FileUtil.readText(path), marker) >= 0;
}

func runPositiveQemu(command, cell, guestLog) {
    var child = Process.spawn(command);
    if (child < 0) { zbFail("cannot start QEMU for " + cell); }
    var output = "";
    var reached = false;
    var ticks = 0;
    while (ticks < 900 && Process.isAlive(child) == 1) {
        output = output + Process.read(child, 100);
        if (hasText(guestLog, "login:")) { reached = true; break; }
        ticks = ticks + 1;
    }
    if (!reached) {
        var failed = stopQemu(child);
        FileUtil.writeText(cell + "/qemu.log", output + failed[1]);
        zbFail("QEMU did not reach login (cell=" + cell + ")");
    }
    ticks = 0;
    while (ticks < 20 && Process.isAlive(child) == 1) {
        output = output + Process.read(child, 100);
        ticks = ticks + 1;
    }
    if (Process.isAlive(child) != 1) {
        var early = stopQemu(child);
        FileUtil.writeText(cell + "/qemu.log", output + early[1]);
        zbFail("QEMU exited during the post-login settle (cell=" + cell + ")");
    }
    var stopped = stopQemu(child);
    output = output + stopped[1];
    FileUtil.writeText(cell + "/qemu.log", output);
    if (stopped[0] != 0) {
        zbFail("QEMU monitor quit failed (cell=" + cell +
               ", status=" + stopped[0] + ")");
    }
}

func negativeFirmwareReached(firmware, serialLog, firmwareLog) {
    if (firmware == "ovmf") {
        return hasText(serialLog, "BdsDxe: failed to load Boot") &&
            hasText(serialLog, "QEMU USB HARDDRIVE") &&
            hasText(serialLog, ": Not Found") &&
            (hasText(serialLog, "UEFI Interactive Shell") ||
             hasText(serialLog, "Shell>"));
    }
    // A pure protective MBR still carries 0x55aa, so SeaBIOS hands its
    // all-zero bootstrap to 0000:7c00 instead of printing its own failure.
    // This marker is accepted only as part of runNegativeQemu's compound
    // byte-check + bounded-live-settle + empty-guest-log oracle.
    return hasText(firmwareLog, "Booting from Hard Disk") &&
        hasText(firmwareLog, "Booting from 0000:7c00");
}

func runNegativeQemu(command, firmware, cell, guestLog, serialLog,
                     firmwareLog) {
    var child = Process.spawn(command);
    if (child < 0) { zbFail("cannot start negative QEMU cell: " + cell); }
    var output = "";
    var reached = false;
    var ticks = 0;
    while (ticks < 300 && Process.isAlive(child) == 1) {
        output = output + Process.read(child, 100);
        if (negativeFirmwareReached(firmware, serialLog, firmwareLog)) {
            reached = true;
            break;
        }
        ticks = ticks + 1;
    }
    if (!reached) {
        var failed = stopQemu(child);
        FileUtil.writeText(cell + "/qemu.log", output + failed[1]);
        zbFail("negative firmware observation missing (cell=" + cell + ")");
    }
    ticks = 0;
    while (ticks < 20 && Process.isAlive(child) == 1) {
        output = output + Process.read(child, 100);
        ticks = ticks + 1;
    }
    if (Process.isAlive(child) != 1) {
        var early = stopQemu(child);
        FileUtil.writeText(cell + "/qemu.log", output + early[1]);
        zbFail("firmware exited during negative settle (cell=" + cell + ")");
    }
    var stopped = stopQemu(child);
    output = output + stopped[1];
    FileUtil.writeText(cell + "/qemu.log", output);
    if (stopped[0] != 0) {
        zbFail("negative QEMU monitor quit failed (cell=" + cell + ")");
    }
    if (FileUtil.getFileSize(guestLog) != 0) {
        zbFail("negative cell reached a zedBSD debug path (cell=" + cell + ")");
    }
}

func validatePositive(layout, firmware, guestLog, firmwareLog) {
    requirePattern(guestLog, "(^|[[:blank:]])login:[[:blank:]]*$",
                   "exact login prompt");
    requirePattern(guestLog, "init: system running", "running init state");
    requirePattern(guestLog, "boot: parameters: ", "kernel parameter handoff");
    requirePattern(guestLog,
                   "^vfs: boot0 UUID=[0-9A-Fa-f-]+ -> /dev/sda" +
                   expectedBootPartition(layout) + " " +
                   "\\(private FAT\\)$",
                   "boot partition resolution");
    requirePattern(guestLog, "swap: active sources=1 total=[1-9]",
                   "active boot swap source");
    requirePattern(guestLog, "usb-storage: sda blocks=" +
                   expectedUsbBlocks(layout) + " block-size=512",
                   "exact USB medium size");
    requirePattern(guestLog,
        "vfs: root=overlay lower=boot0:rootfs.img upper=boot0:data.img",
        "overlay-root resolution");
    if (firmware == "ovmf") {
        requirePattern(guestLog, "^A64 UEFI ENTRY$", "OVMF loader entry");
        requirePattern(guestLog, "^A64 UEFI EXIT$", "OVMF loader handoff");
    } else {
        requirePattern(firmwareLog, "Booting from Hard Disk",
                       "SeaBIOS disk selection");
        requirePattern(firmwareLog, "Booting from 0000:7c00",
                       "SeaBIOS MBR handoff");
    }
    rejectPattern(guestLog,
        "fatal:|FATAL:|kernel panic|panic:|amd64 fault v=|A64 .*FAIL|" +
        "VFS initialization failed|UFS initialization failed|" +
        "Input/output error|boot-storage wait expired|" +
        "gpt: .*rejected|vfs: .* failed|mount root overlay failed|" +
        "usb-storage: BOT|usb-storage: sd[a-z]+ .*error=[1-9]|" +
        "loop[0-9]+: .*error=[1-9]|xhci: .*failed|" +
        "xhci: transfer completion=|usb[0-9]+: port .*enumeration failed",
        "fatal, GPT, VFS, storage, or xHCI failure");
}

func runCell(qemu, seabios, ovmfCode, ovmfVars, source, layout, firmware,
             positive, evidence) {
    var polarity = "positive";
    if (!positive) { polarity = "negative"; }
    var cellName = layout + "-" + firmware + "-" + polarity;
    var cell = evidence + "/cells/" + cellName;
    run("/", "mkdir -p " + zbShellQuote(cell), "create cell directory");
    var runImage = cell + "/run.img";
    var guestLog = cell + "/debugcon.log";
    var serialLog = cell + "/serial.log";
    var firmwareLog = cell + "/firmware-debug.log";
    var varsCopy = cell + "/OVMF_VARS.fd";
    prepareRunImage(source, runImage, layout, cell);
    FileUtil.writeText(guestLog, "");
    FileUtil.writeText(serialLog, "");
    FileUtil.writeText(firmwareLog, "");
    if (firmware == "ovmf") {
        run("/", "cp " + zbShellQuote(ovmfVars) + " " +
            zbShellQuote(varsCopy) + " && sha256sum " +
            zbShellQuote(varsCopy) + " >" +
            zbShellQuote(cell + "/ovmf-vars-pre.sha256"),
            "create per-cell OVMF variables");
    }
    var command = makeQemuCommand(qemu, seabios, ovmfCode, varsCopy,
                                  firmware, runImage, guestLog, serialLog,
                                  firmwareLog);
    FileUtil.writeText(cell + "/qemu-command.txt", commandText(command));
    var started = zbParseNumber(capture("date +%s", "capture cell start"));
    if (positive) {
        runPositiveQemu(command, cell, guestLog);
        validatePositive(layout, firmware, guestLog, firmwareLog);
    } else {
        runNegativeQemu(command, firmware, cell, guestLog, serialLog,
                        firmwareLog);
        FileUtil.writeText(cell + "/absence-gate.txt",
            "byte_level_checker=PASS\n" +
            "checker_log=" + evidence + "/images/check-" + layout +
            ".log\nfirmware_observation=PASS\n" +
            "bounded_live_settle=PASS\nzedbsd_debug_path=absent\n");
    }
    var finished = zbParseNumber(capture("date +%s", "capture cell end"));
    if (layout == "uefi") {
        requireUefiState(runImage, cell, "post");
        run("/", "cmp " + zbShellQuote(cell + "/gpt-front-pre.bin") + " " +
            zbShellQuote(cell + "/gpt-front-post.bin"),
            "stable UEFI primary GPT front");
    }
    run("/", "sha256sum -c " + zbShellQuote(source + ".sha256") +
        " >" + zbShellQuote(cell + "/source-hash-after.log"),
        "immutable source image after QEMU");
    if (firmware == "ovmf") {
        run("/", "sha256sum " + zbShellQuote(varsCopy) + " >" +
            zbShellQuote(cell + "/ovmf-vars-post.sha256"),
            "retain postboot OVMF variable hash");
    }
    var elapsed = finished - started;
    FileUtil.writeText(cell + "/result.txt", "MAC-T020\t" + cellName +
        "\tPASS\telapsed_seconds=" + elapsed + "\n");
    run("/", "printf '%s\\tPASS\\t%s\\n' " + zbShellQuote(cellName) +
        " " + elapsed + " >>" + zbShellQuote(evidence + "/results.tsv"),
        "record cell result");
}

func main(args) {
    if (Array.size(args) != 2) {
        zbFail("usage: qemu-variant-matrix.noct REPOSITORY EVIDENCE");
    }
    var repo = capture("realpath " + zbShellQuote(args[0]),
                       "resolve repository path");
    var evidence = capture("realpath -m " + zbShellQuote(args[1]),
                           "resolve evidence path");
    if (FileUtil.checkFileExists(evidence) == 1) {
        zbFail("evidence path already exists: " + evidence);
    }
    run(repo, "mkdir -p " + zbShellQuote(evidence + "/images") + " " +
        zbShellQuote(evidence + "/cells") + " " +
        zbShellQuote(evidence + "/tmp"), "create private evidence tree");
    var config = evidence + "/config.mk";
    var build = evidence + "/build-amd64";
    writeFixtureConfig(repo, config);

    var qemu = resolveCommand("${QEMU_SYSTEM_X86_64:-qemu-system-x86_64}",
                              "qemu-system-x86_64");
    var seabios = resolveFile("${SEABIOS_CODE:-/usr/share/seabios/bios-256k.bin}",
                              "SeaBIOS firmware");
    var ovmfCode = resolveFile("${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}",
                               "OVMF code firmware");
    var ovmfVars = resolveFile("${OVMF_VARS:-/usr/share/OVMF/OVMF_VARS_4M.fd}",
                               "OVMF variable template");
    runLogged(repo, evidence + "/clean-private-build.log",
        "TMPDIR=" + zbShellQuote(evidence + "/tmp") +
        " make --no-print-directory ZEDBSD_CONFIG=" + zbShellQuote(config) +
        " BUILD=" + zbShellQuote(build) + " clean",
        "clean fixture-private BUILD");
    FileUtil.writeText(evidence + "/results.tsv",
                       "cell\tresult\telapsed_seconds\n");
    run(repo, "{ " + zbShellQuote(qemu) + " --version | sed -n '1p'; " +
        "printf 'qemu=%s\\nseabios=%s\\novmf_code=%s\\novmf_vars=%s\\n' " +
        zbShellQuote(qemu) + " " + zbShellQuote(seabios) + " " +
        zbShellQuote(ovmfCode) + " " + zbShellQuote(ovmfVars) + "; } >" +
        zbShellQuote(evidence + "/environment.txt") +
        " && sha256sum " + zbShellQuote(seabios) + " " +
        zbShellQuote(ovmfCode) + " " + zbShellQuote(ovmfVars) + " >" +
        zbShellQuote(evidence + "/firmware.sha256"),
        "retain firmware identity");

    var hybrid = buildImage(repo, evidence, config, build, "hybrid");
    runCell(qemu, seabios, ovmfCode, ovmfVars, hybrid, "hybrid", "seabios",
            true, evidence);
    runCell(qemu, seabios, ovmfCode, ovmfVars, hybrid, "hybrid", "ovmf",
            true, evidence);

    var bios = buildImage(repo, evidence, config, build, "bios");
    runCell(qemu, seabios, ovmfCode, ovmfVars, bios, "bios", "seabios",
            true, evidence);
    runCell(qemu, seabios, ovmfCode, ovmfVars, bios, "bios", "ovmf",
            false, evidence);

    var uefi = buildImage(repo, evidence, config, build, "uefi");
    runCell(qemu, seabios, ovmfCode, ovmfVars, uefi, "uefi", "ovmf",
            true, evidence);
    runCell(qemu, seabios, ovmfCode, ovmfVars, uefi, "uefi", "seabios",
            false, evidence);

    run(repo, "sha256sum " + zbShellQuote(build + "/vmunix") + " " +
        zbShellQuote(build + "/bootloader/stage1.bin") + " " +
        zbShellQuote(build + "/bootloader/stage1-native.bin") + " " +
        zbShellQuote(build + "/bootloader/stage2-chain.bin") + " " +
        zbShellQuote(build + "/bootloader/partition-pbr.bin") + " " +
        zbShellQuote(build + "/bootloader/BOOTZBSD.EXE") + " " +
        zbShellQuote(build + "/uefi/BOOTX64.EFI") + " >" +
        zbShellQuote(evidence + "/artifacts.sha256"),
        "retain compiled artifact hashes");
    run(repo, "test \"$(wc -l <" + zbShellQuote(evidence + "/results.tsv") +
        ")\" = 7", "complete 6-cell matrix");
    print("MAC-T020 QEMU Variant matrix: PASS (6 cells; " + evidence + ")");
}
