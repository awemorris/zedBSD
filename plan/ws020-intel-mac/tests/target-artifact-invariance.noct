require zedbuild;

// MAC-T001 compiled-artifact invariance fixture.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib

func runLogged(repo, output, command, what) {
    var status = System.shell("cd " + zbShellQuote(repo) + " && " + command +
        " >" + zbShellQuote(output) + " 2>&1");
    if (status != 0) {
        zbFail(what + " failed (status=" + status + "; log=" + output + ")");
    }
}

func run(repo, command, what) {
    var status = System.shell("cd " + zbShellQuote(repo) + " && " + command);
    if (status != 0) { zbFail(what + " failed (status=" + status + ")"); }
}

func buildCase(repo, evidence, name, variant, capacity) {
    var build = "build/ws020-p001-" + name;
    var log = evidence + "/build-" + name + ".log";
    runLogged(repo, evidence + "/clean-" + name + ".log",
              "make --no-print-directory ZEDBSD_CONFIG=config.mk BUILD=" +
              build + " clean", name + " owned BUILD cleanup");
    var common = "ZEDBSD_CONFIG=config.mk ZEDBSD_PLATFORM=amd64 " +
        "ZEDBSD_ARCHITECTURE=amd64 ZEDBSD_BOARD=pcat " +
        "ZEDBSD_VARIANT=" + variant + " ZEDBSD_IMAGE_SIZE_GIB=" + capacity +
        " BUILD=" + build;
    runLogged(repo, log, "make --no-print-directory -j16 " + common +
              " vmunix bootloader", name + " fresh artifact build");

    var artifacts = "vmunix bootloader/stage1.bin " +
        "bootloader/stage2-chain.bin bootloader/partition-pbr.bin " +
        "bootloader/BOOTZBSD.EXE uefi/BOOTX64.EFI";
    run(repo, "test -s " + build + "/vmunix && " +
        "test -s " + build + "/bootloader/stage1.bin && " +
        "test -s " + build + "/bootloader/stage2-chain.bin && " +
        "test -s " + build + "/bootloader/partition-pbr.bin && " +
        "test -s " + build + "/bootloader/BOOTZBSD.EXE && " +
        "test -s " + build + "/uefi/BOOTX64.EFI",
        name + " BIOS+UEFI loader family");
    run(repo, "(cd " + build + " && sha256sum " + artifacts + ") >" +
        zbShellQuote(evidence + "/hashes-" + name + ".txt"),
        name + " artifact manifest");
    run(repo, "(cd " + build + " && find . -type f -name '*.o' " +
        "-printf '%P\\n' | LC_ALL=C sort) >" +
        zbShellQuote(evidence + "/objects-" + name + ".txt"),
        name + " object manifest");
}

func contractCase(repo, evidence, name, variant, capacity) {
    var variables = "'^[A-Za-z0-9_]*(SOURCES|OBJS|CPPFLAGS|CFLAGS|" +
        "ASFLAGS|LDFLAGS)[[:space:]]*[:+?]?='";
    var command = "LC_ALL=C make --no-print-directory -pn " +
        "ZEDBSD_CONFIG=config.mk ZEDBSD_PLATFORM=amd64 " +
        "ZEDBSD_ARCHITECTURE=amd64 ZEDBSD_BOARD=pcat " +
        "ZEDBSD_VARIANT=" + variant + " ZEDBSD_IMAGE_SIZE_GIB=" + capacity +
        " BUILD=build/ws020-p001-contract vmunix bootloader";
    var raw = evidence + "/contract-" + name + ".raw";
    var unsorted = evidence + "/contract-" + name + ".unsorted";
    runLogged(repo, raw, command, name + " Make source graph");
    runLogged(repo, unsorted,
              "rg " + variables + " " + zbShellQuote(raw),
              name + " source/object/flag selection");
    runLogged(repo, evidence + "/contract-" + name + ".txt",
              "LC_ALL=C sort " + zbShellQuote(unsorted),
              name + " source/object/flag ordering");
}

func compare(repo, evidence, kind, left, right) {
    run(repo, "cmp " + zbShellQuote(evidence + "/" + kind + "-" + left +
        ".txt") + " " + zbShellQuote(evidence + "/" + kind + "-" + right +
        ".txt"), kind + " mismatch: " + left + " vs " + right);
}

func main(args) {
    if (Array.size(args) != 2) {
        zbFail("usage: target-artifact-invariance.noct REPOSITORY EVIDENCE");
    }
    var repo = args[0];
    var evidence = args[1];
    run(repo, "mkdir -p " + zbShellQuote(evidence), "create evidence directory");

    buildCase(repo, evidence, "hybrid-2", "hybrid", "2");
    buildCase(repo, evidence, "bios-2", "bios", "2");
    buildCase(repo, evidence, "uefi-2", "uefi", "2");
    buildCase(repo, evidence, "hybrid-256", "hybrid", "256");

    contractCase(repo, evidence, "hybrid-2", "hybrid", "2");
    contractCase(repo, evidence, "bios-2", "bios", "2");
    contractCase(repo, evidence, "uefi-2", "uefi", "2");
    contractCase(repo, evidence, "hybrid-256", "hybrid", "256");

    for (name in ["bios-2", "uefi-2", "hybrid-256"]) {
        compare(repo, evidence, "hashes", "hybrid-2", name);
        compare(repo, evidence, "objects", "hybrid-2", name);
        compare(repo, evidence, "contract", "hybrid-2", name);
    }
    print("MAC-T001 artifact invariance: PASS (3 Variants, 2/256 GiB; " +
          evidence + ")");
}
