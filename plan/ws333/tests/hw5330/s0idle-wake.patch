+/* Test only: the RTC alarm's fixed event, a wake from S0 idle. */
+static void
+test_rtc_alarm(
+	enum drv_acpi_fixed_event event,
+	void *argument)
+{
+	UNUSED_PARAMETER(event);
+	UNUSED_PARAMETER(argument);
+
+	/* Register C clears the alarm flag. */
+	(void)test_cmos_read(0x0cU);
+	kern_logf("acpi: test RTC alarm\n");
+	kern_sleep_note_wake(KERN_SLEEP_WAKE_TIMER);
+}
+
+/*
+ * Test only: arms the CMOS RTC alarm to ring when the seconds reach now
+ * plus SECONDS (minutes and hours do not care), with RTC_EN on, so the
+ * next S0 idle wakes by itself within a minute.
+ */
+void
+drv_acpi_test_wake_alarm(
+	unsigned seconds)
+{
+	uint8_t control;
+	uint8_t now;
+	uint8_t alarm;
+	unsigned poll;
+	int binary;
+	int error;
+
+	/* Waits for no update in progress, then reads the seconds. */
+	for (poll = 0U; poll < 100000U; poll++) {
+		if ((test_cmos_read(0x0aU) & 0x80U) == 0U)
+			break;
+	}
+	control = test_cmos_read(0x0bU);
+	binary = (control & 0x04U) != 0U;
+	now = test_cmos_read(0x00U);
+	if (!binary)
+		now = (uint8_t)((now >> 4) * 10U + (now & 0x0fU));
+
+	/* The alarm's seconds; minutes and hours 0xff do not care. */
+	alarm = (uint8_t)((now + seconds) % 60U);
+	if (!binary)
+		alarm = (uint8_t)(((alarm / 10U) << 4) | (alarm % 10U));
+	test_cmos_write(0x01U, alarm);
+	test_cmos_write(0x03U, 0xffU);
+	test_cmos_write(0x05U, 0xffU);
+
+	/* Clears an old flag, then lets the alarm raise its flag and RTC_STS. */
+	(void)test_cmos_read(0x0cU);
+	test_cmos_write(0x0bU, (uint8_t)(control | 0x20U));
+	error = drv_acpi_fixed_event_install(DRV_ACPI_EVENT_RTC, test_rtc_alarm, NULL);
+	kern_logf("acpi: test RTC alarm armed at second %u (now %u, control 0x%x, install %d)\n",
+	    (unsigned)((now + seconds) % 60U), (unsigned)now, (unsigned)control, error);
+}
+
+/* Test only: reads one CMOS register. */
+static uint8_t
+test_cmos_read(
+	uint8_t index)
+{
+	uint32_t value;
+
+	(void)drv_acpi_os_port_write(0x70U, 8U, index);
+	value = 0U;
+	(void)drv_acpi_os_port_read(0x71U, 8U, &value);
+	return (uint8_t)value;
+}
+
+/* Test only: writes one CMOS register. */
+static void
+test_cmos_write(
+	uint8_t index,
+	uint8_t value)
+{
+	(void)drv_acpi_os_port_write(0x70U, 8U, index);
+	(void)drv_acpi_os_port_write(0x71U, 8U, value);
+}
+
