diff --git a/mk/config.mk b/mk/config.mk
--- a/mk/config.mk
+++ b/mk/config.mk
@@ -468,13 +468,20 @@
 # Framework
 ########################
 
-# [Generic CPU performance monitoring driver] (/dev/thermal)
-CONFIG_KERN_CPU_PERF              ?= n
-
 # [x86 Power Control driver] (/dev/thermal)
-#  - Depends: CONFIG_KERN_CPU_PERF
+#  - The model-specific registers of the x86 processor driver: HWP, the
+#    hardware feedback, the energy meters and the idle residency.
+#  - The CPU performance framework (src/kern/cpuperf.c) and the driver's
+#    CPUID part are always built; this switch adds only the MSR path.
+#  - Off until the acceptance on a real machine has passed.
 CONFIG_DRIVER_X86_POWER_CONTROL   ?= n
 
+# [Dell SMM fan boost]
+#  - Raises a Dell laptop fan's state through the SMM fan call.
+#  - Off: a raised state did not lift the fan on the machine tried.
+#  - Depends: CONFIG_DRIVER_ACPI
+CONFIG_DRIVER_DELL_SMM_BOOST      ?= n
+
 # [RPi5 processor temperature] (sysctl hw.thermal)
 #  - TODO: need to port to /dev/thermal
 CONFIG_DRIVER_RPI5_FAN            ?= n
diff --git a/mk/kernel.mk b/mk/kernel.mk
--- a/mk/kernel.mk
+++ b/mk/kernel.mk
@@ -61,6 +61,7 @@
 	src/kern/tty-csi.c \
 	src/kern/thermal.c \
 	src/kern/thermal-guard.c \
+	src/kern/cpuperf.c \
 	src/kern/text-display.c \
 	src/kern/partition.c \
 	src/kern/klog.c \
@@ -1248,14 +1249,6 @@
 	src/drivers/platform/rpi-common/rpi-bt-link.c
 endif
 
-# [Generic CPU performance monitoring driver] (/dev/thermal)
-#  - XXX: TODO: move this module to drivers/
-ifneq ($(filter y,$(CONFIG_KERN_CPU_PERF) $(CONFIG_DRIVER_CPU_PERF)),)
-KERN_CPPFLAGS += -DCONFIG_KERN_CPU_PERF=1 -DCONFIG_CPU_PERF=1
-KERN_SOURCES += \
-	src/kern/cpuperf.c
-endif
-
 # [Smart Card driver] (/dev/smartcard)
 ifneq ($(filter y,$(CONFIG_DRIVER_SMARTCARD) $(CONFIG_DRIVER_USB_CCID)),)
 KERN_CPPFLAGS += -DCONFIG_DRIVER_SMARTCARD=1
@@ -1264,8 +1257,9 @@
 endif
 
 # [x86 Power Control driver]
+#  - The sources read CONFIG_CPU_PERF (cpu-x86-insn.h reads CONFIG_KERN_CPU_PERF).
 ifneq ($(filter y,$(CONFIG_DRIVER_X86_POWER_CONTROL)),)
-KERN_CPPFLAGS += -DCONFIG_DRIVER_X86_POWER_CONTROL=1
+KERN_CPPFLAGS += -DCONFIG_DRIVER_X86_POWER_CONTROL=1 -DCONFIG_CPU_PERF=1 -DCONFIG_KERN_CPU_PERF=1
 KERN_SOURCES += \
 	src/drivers/platform/pcat/cpu-x86/cpux86-hwp.c \
 	src/drivers/platform/pcat/cpu-x86/cpux86-pstate.c \
