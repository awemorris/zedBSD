+/*
+ * Reports whether every reader of a value takes it through an operand
+ * whose sources name the vertex input and coefficient banks (float
+ * arithmetic and its single operations, outputs, and the pixel stores
+ * and samples that move their operands first).
+ */
+static int
+register_readers(
+	const struct powervr_ir_shader *shader,
+	unsigned value)
+{
+	const struct powervr_ir_instruction *reader;
+	unsigned at;
+	unsigned source;
+	unsigned opcode;
+
+	/* Each read. */
+	for (at = 0; at < shader->instruction_count; at++) {
+		reader = &shader->instructions[at];
+		opcode = reader->opcode;
+		for (source = 0; source < 4; source++) {
+			if (reader->source[source].kind != POWERVR_IR_OPERAND_VALUE || reader->source[source].value != value)
+				continue;
+			if (opcode != POWERVR_IR_FLOAT_ADD && opcode != POWERVR_IR_FLOAT_MULTIPLY && opcode != POWERVR_IR_FLOAT_MULTIPLY_ADD &&
+			    opcode != POWERVR_IR_FLOAT_MINIMUM && opcode != POWERVR_IR_FLOAT_MAXIMUM && opcode != POWERVR_IR_FLOAT_RECIPROCAL &&
+			    opcode != POWERVR_IR_FLOAT_RECIPROCAL_ROOT && opcode != POWERVR_IR_OUTPUT && opcode != POWERVR_IR_PIXEL_STORE &&
+			    opcode != POWERVR_IR_SAMPLE)
+				return 0;
+		}
+	}
+	return 1;
+}
