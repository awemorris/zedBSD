+ * generation of the last flip.  Each buffer is shown with its own
+ * rotation (clockwise degrees, 0 or 180): the displayed one's goes with
+ * current, the armed one's with pending, and a latch moves both.
  */
 struct i915_xd_flip {
 	uint32_t current;
 	uint32_t pending;
 	uint32_t old;
+	uint32_t current_rotation;
