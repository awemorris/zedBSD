+/*
+ * Where a frame goes while a flip may be armed: into the buffer the
+ * screen does not show, then a flip to it; into the buffer the armed
+ * flip shows next, with no new flip (the newest frame wins); or, when
+ * the armed flip shows its buffer with another rotation, after the armed
+ * flip is waited for, into the buffer not shown, then a flip.
+ */
+#define I915_XD_TARGET_BACK		0U
+#define I915_XD_TARGET_ARMED		1U
+#define I915_XD_TARGET_SETTLE		2U
