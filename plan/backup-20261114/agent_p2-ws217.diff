 #define I915_XD_PLANE_CTL_FORMAT		0x0f800000U
 #define I915_XD_PLANE_CTL_FORMAT_XRGB8888	0x08U
 #define I915_XD_PLANE_CTL_TILING		0x00001c00U
+
+/*
+ * The plane's hardware rotation in its control word: the field, and the
+ * value that turns the plane by 180 degrees (0 is no rotation).  Display 13
+ * defines only these two values; a 180-degree linear plane keeps its
+ * offset, position and stride.
+ *
+ * Values referenced: Intel Iris Xe and UHD Graphics Open Source PRM,
+ * "Tiger Lake", Volume 2c: Command Reference: Registers, Part 2,
+ * December 2021, Revision 1.0 (Doc Ref # IHD-OS-TGL-Vol 2c-12.21),
+ * PLANE_CTL (Plane Rotation); Intel Arc A-Series Graphics Open-Source PRM,
+ * "Alchemist", Volume 2c: Command Reference: Registers, Part 2,
+ * March 2023, Revision 1.0 (Doc Ref # IHD-OS-ACM-Vol 2c-3.23), PLANE_CTL
+ * (Plane Rotation).
+ */
+#define I915_XD_PLANE_CTL_ROTATE		0x00000003U
+#define I915_XD_PLANE_CTL_ROTATE_180		0x2U
 #define I915_XD_PLANE_STRIDE(pipe)		(0x70188U + I915_XD_PIPE_STRIDE * (pipe))
 #define I915_XD_PLANE_STRIDE_UNITS		0x00000fffU
 #define I915_XD_PLANE_POS(pipe)			(0x7018cU + I915_XD_PIPE_STRIDE * (pipe))
