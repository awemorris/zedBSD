+
 	/* Fences need the shared completion capability of this node. */
 	fenced = 0U;
 	if (request.signal_fd >= 0)
@@ -4477,14 +4491,19 @@ static int
 gpu_commit_plane_check(
 	const struct gpu_display_plane_state *state)
