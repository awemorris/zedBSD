+	/* A multisampled image is fetched with the sample as its layer. */
+	if (type->image_ms != 0U)
+		shape |= DRV_GPU_IR_IMAGE_MULTISAMPLED;
+
+	/* Succeeded: the shape the instruction carries. */
+	return shape;
