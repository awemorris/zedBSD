+static int
+lower_derivative(
+	struct gfx10_lowering *lowering,
+	const struct drv_gpu_shader_ir_inst *instruction,
+	uint32_t dst)
+{
+	struct amdrdna_gfx10_inst inst;
+	unsigned source;
+	unsigned start;
+	unsigned end;
+	unsigned zero;
