+/*
+ * perf-read (q1540): how fast the core reads memory through its texture
+ * unit.  A full-screen quad without blending samples one texel a pixel
+ * (nearest) of a 1920x1080 OPTIMAL texture, from device-local memory and
+ * from host-visible memory, and of a 64x64 one the texture cache holds.
+ * The difference to the small texture's time is the reading of the
+ * 1920x1080x4 bytes, printed as MB/s.  Device-local memory goes through
+ * the core's system level cache only when the driver maps it so;
+ * host-visible memory always goes around it.
+ */
+static VkResult
+case_perf_read(
+	struct vkmatrix *run)
+{
+	struct vkmatrix_shape shape;
+	VkSubresourceLayout layout;
+	uint64_t spent[PERF_READ_TEXTURES];
+	uint64_t rate[PERF_READ_SMALL];
+	uint64_t bytes;
+	uint32_t *texels;
+	uint32_t pipeline;
+	uint32_t first;
+	uint32_t index;
+	VkResult status;
+
+	/* Opaque texels of a pattern, enough for the large textures. */
+	bytes = (uint64_t)VKMATRIX_LINEAR_WIDTH * VKMATRIX_LINEAR_HEIGHT * 4U;
+	texels = malloc((size_t)bytes);
+	if (texels == NULL) {
+		run->failed_call = "malloc";
+		return VK_ERROR_OUT_OF_HOST_MEMORY;
+	}
+	for (index = 0; index < VKMATRIX_LINEAR_WIDTH * VKMATRIX_LINEAR_HEIGHT; index++)
+		texels[index] = 0xff000000U | (index * 2654435761U >> 8);
+
+	/* The large texture in device-local memory, the same in host-visible memory, then the small one (PERF_READ_*). */
+	run->texture_width = VKMATRIX_LINEAR_WIDTH;
+	run->texture_height = VKMATRIX_LINEAR_HEIGHT;
+	status = vkmatrix_texture(run, 0, texels, VK_FILTER_NEAREST);
+	if (status == VK_SUCCESS) {
+		run->texture_host = 1;
+		status = vkmatrix_texture(run, 0, texels, VK_FILTER_NEAREST);
+	}
+	if (status == VK_SUCCESS) {
+		run->texture_host = 0;
+		run->texture_width = 0;
+		run->texture_height = 0;
+		status = vkmatrix_texture(run, 64U, texels, VK_FILTER_NEAREST);
+	}
+	free(texels);
+	if (status != VK_SUCCESS)
+		return status;
+
+	/* The textured pipeline without blending, and the quad over the whole target. */
+	memset(&shape, 0, sizeof(shape));
+	shape.vertex = vkmatrix_texture_vert;
+	shape.vertex_size = sizeof(vkmatrix_texture_vert);
+	shape.fragment = vkmatrix_texture_frag;
+	shape.fragment_size = sizeof(vkmatrix_texture_frag);
+	shape.layout = VKMATRIX_TEXTURE;
+	shape.texture = 1;
+	shape.blend = VKMATRIX_OPAQUE;
+	status = vkmatrix_pipeline(run, &shape, &pipeline);
+	if (status != VK_SUCCESS)
+		return status;
+	first = vkmatrix_texture_quad(run, 0.0f, 0.0f, 64.0f, 64.0f);
+
+	/* The 1920x1080 attachment. */
+	status = linear_target(run, VK_IMAGE_TILING_OPTIMAL, &layout);
+	if (status != VK_SUCCESS)
+		return status;
+
+	/* Each texture's time a frame. */
+	for (index = 0; index < PERF_READ_TEXTURES; index++) {
+		status = perf_read_frames(run, pipeline, first, run->textures[index].set, &spent[index]);
+		if (status != VK_SUCCESS)
+			return status;
+	}
+
+	/* Each large texture's rate: its bytes over the time it took beyond the small one's (bytes a microsecond are MB/s); 0 when none. */
+	for (index = 0; index < PERF_READ_SMALL; index++) {
+		rate[index] = 0;
+		if (spent[index] > spent[PERF_READ_SMALL])
+			rate[index] = bytes * 1000U / (spent[index] - spent[PERF_READ_SMALL]);
+	}
+
+	/* The line, and nothing for the shared target's comparison to say. */
+	snprintf(run->note, sizeof(run->note), "perf read: device %lu us, host %lu us, small %lu us; device %lu MB/s, host %lu MB/s over %u frames of 1920x1080",
+		 (unsigned long)(spent[PERF_READ_DEVICE] / 1000U), (unsigned long)(spent[PERF_READ_HOST] / 1000U),
+		 (unsigned long)(spent[PERF_READ_SMALL] / 1000U), (unsigned long)rate[PERF_READ_DEVICE],
+		 (unsigned long)rate[PERF_READ_HOST], (unsigned)PERF_FRAMES);
+	memcpy(run->expected, run->pixels, sizeof(run->expected));
+	run->tolerance = 0;
+
+	/* Succeeded: the timing is printed. */
+	return VK_SUCCESS;
+}
+
+/* Times perf-read's quad over one texture: the average of PERF_FRAMES frames after one not counted, in nanoseconds. */
+static VkResult
+perf_read_frames(
+	struct vkmatrix *run,
+	uint32_t pipeline,
+	uint32_t first,
+	VkDescriptorSet set,
+	uint64_t *average)
+{
+	VkCommandBufferBeginInfo begin;
+	VkRenderPassBeginInfo pass;
+	VkClearValue value;
+	VkViewport viewport;
+	VkRect2D scissor;
+	VkSubmitInfo submit;
+	uint64_t started;
+	uint64_t spent;
+	uint64_t total;
+	uint32_t frame;
+	VkResult status;
+
+	/* The frames, the first not counted. */
+	total = 0;
+	for (frame = 0; frame <= PERF_FRAMES; frame++) {
+		/* The command buffer and a cleared pass of the whole target. */
+		memset(&begin, 0, sizeof(begin));
+		begin.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+		begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+		vkResetCommandBuffer(run->command, 0);
+		vkBeginCommandBuffer(run->command, &begin);
+		memset(&value, 0, sizeof(value));
+		memcpy(value.color.float32, background, sizeof(value.color.float32));
+		memset(&pass, 0, sizeof(pass));
+		pass.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+		pass.renderPass = run->clear_pass;
+		pass.framebuffer = run->wide_framebuffer;
+		pass.renderArea.extent.width = VKMATRIX_LINEAR_WIDTH;
+		pass.renderArea.extent.height = VKMATRIX_LINEAR_HEIGHT;
+		pass.clearValueCount = 1;
+		pass.pClearValues = &value;
+		vkCmdBeginRenderPass(run->command, &pass, VK_SUBPASS_CONTENTS_INLINE);
+
+		/* The quad over the whole target, sampling the texture. */
+		memset(&viewport, 0, sizeof(viewport));
+		viewport.width = (float)VKMATRIX_LINEAR_WIDTH;
+		viewport.height = (float)VKMATRIX_LINEAR_HEIGHT;
+		viewport.maxDepth = 1.0f;
+		vkCmdSetViewport(run->command, 0, 1, &viewport);
+		memset(&scissor, 0, sizeof(scissor));
+		scissor.extent.width = VKMATRIX_LINEAR_WIDTH;
+		scissor.extent.height = VKMATRIX_LINEAR_HEIGHT;
+		vkCmdSetScissor(run->command, 0, 1, &scissor);
+		vkmatrix_bind(run, pipeline);
+		vkCmdBindDescriptorSets(run->command, VK_PIPELINE_BIND_POINT_GRAPHICS, run->layouts[pipeline], 0, 1, &set, 0, NULL);
+		vkCmdDraw(run->command, 6, 1, first, 0);
+		vkCmdEndRenderPass(run->command);
+		vkEndCommandBuffer(run->command);
+
+		/* The submit and its wait, timed. */
+		memset(&submit, 0, sizeof(submit));
+		submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+		submit.commandBufferCount = 1;
+		submit.pCommandBuffers = &run->command;
+		vkResetFences(run->device, 1, &run->fence);
+		started = perf_now_ns();
+		run->failed_call = "vkQueueSubmit (perf read)";
+		status = vkQueueSubmit(run->queue, 1, &submit, run->fence);
+		if (status != VK_SUCCESS)
+			return status;
+		run->failed_call = "vkWaitForFences (perf read)";
+		status = vkWaitForFences(run->device, 1, &run->fence, VK_TRUE, VKMATRIX_WAIT_NS);
+		if (status != VK_SUCCESS)
+			return status;
+		spent = perf_now_ns() - started;
+
+		/* Counted after the first frame. */
+		if (frame != 0)
+			total += spent;
+	}
+
+	/* Succeeded: the average time of a frame. */
+	*average = total / PERF_FRAMES;
+	return VK_SUCCESS;
+}
