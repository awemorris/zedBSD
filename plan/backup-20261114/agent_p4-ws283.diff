+#!/bin/sh
+# HT2's machine: the V3D 7.1 compute dispatch model (qpu71-compute-machine.c) checked with programs assembled by
+# the production 7.1 encoder, against the unmodified MIT Mesa 26.2.6 decoder.
+# Usage: sh plan/ws283/tests/qpu71-compute-machine-host-test.sh [output-directory]
+set -eu
+out=${1:-build/ws283-compute-machine-host}
+sh plan/ws283/tests/mesa-oracle.sh "$out"
+mesa=$out/mesa-26.2.6/src
+cc -std=gnu11 -O1 -Wall -Wextra -Werror -Iinclude -Isrc -I. -I"$out/mesa-host" -I"$mesa" \
+    plan/ws283/tests/qpu71-compute-machine-host-test.c plan/ws283/tests/qpu71-compute-machine.c plan/ws283/tests/qpu71-rules.c \
+    src/drivers/gpu/bcm2711/compiler/qpu71.c src/drivers/gpu/bcm2711/compiler/qpu-branch.c \
+    "$out/mesa-pack.o" "$out/mesa-instr.o" -lm -o "$out/qpu71-compute-machine-host-test"
+timeout 300 "$out/qpu71-compute-machine-host-test"
diff --git a/plan/ws283/tests/qpu71-compute-machine.c b/plan/ws283/tests/qpu71-compute-machine.c
new file mode 100644
index 0000000000..1a8f9d96e7
--- /dev/null
+++ b/plan/ws283/tests/qpu71-compute-machine.c
@@ -0,0 +1,1688 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * Host model of a V3D 7.1 compute dispatch; see qpu71-compute-machine.h.
+ *
+ * The ALU semantics and the word timing follow the graphics lane model
+ * (plan/ws279/tests/qpu71-machine.c).  The compute rules are the facts of
+ * WS283's design sections 1.4, 1.6, 1.8 and 1.9 (Mesa 26.2.6
+ * src/broadcom/compiler/nir_to_vir.c, qpu_schedule.c and qpu_validate.c,
+ * the 7.x branches); the decoder is the unmodified MIT Mesa one,
+ * independent of the production encoder.
+ */
+#include <assert.h>
+#include <math.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "broadcom/qpu/qpu_instr.h"
+#include "plan/ws283/tests/qpu71-compute-machine.h"
+
+/* Register-file entries keep their numbers; flag A follows them. */
+#define MACHINE_FLAGS 64U
+#define MACHINE_RESOURCES 65U
+#define LANES QPU71_COMPUTE_LANES
+#define ALL_LANES 0xffffU
+
+/* No event is pending. */
+#define MACHINE_NONE 0xffffffffU
+
+/* The most lookups one thread may have outstanding (Mesa nir_to_vir.c MAX_TMU_QUEUE_SIZE). */
+#define MACHINE_TMU_QUEUE 8U
+
+/* The value a lane gets from a lookup it did not make. */
+#define MACHINE_POISON 0xdeadbeefU
+
+/* The regular per-pixel TMU configurations of a vector of two to four words (Mesa nir_to_vir.c lines 43-52). */
+#define MACHINE_CONFIG_VEC2 0xfffffffaU
+#define MACHINE_CONFIG_VEC4 0xfffffffcU
+
+/* One load waiting for its results to be read with ldtmu. */
+struct lookup {
+	uint32_t words;
+	uint32_t read;
+	uint32_t value[LANES][4];
+};
+
+/* One batch of sixteen lanes running as one QPU thread. */
+struct batch {
+	uint32_t number;
+	uint32_t supergroup;
+	uint32_t dispatched;
+	uint32_t value[MACHINE_RESOURCES][LANES];
+	bool lost[MACHINE_RESOURCES];
+	uint32_t pending_value[MACHINE_RESOURCES][LANES];
+	uint32_t pending_mask[MACHINE_RESOURCES];
+	uint32_t pending_land[MACHINE_RESOURCES];
+	uint32_t flag_b[LANES];
+	uint32_t pending_flag_b[LANES];
+	uint32_t pc;
+	uint32_t time;
+	uint32_t uniform_index;
+	/* Thread switches: the last one, when it takes effect, the marked last switch and the thread end. */
+	uint32_t last_switch;
+	uint32_t switch_effect;
+	bool last_marked;
+	uint32_t last_marked_switch;
+	uint32_t thread_end;
+	bool ended;
+	/* A taken branch: when the jump happens, where to, and where the uniform stream continues. */
+	uint32_t branch_time;
+	uint32_t branch_jump;
+	uint32_t branch_target;
+	uint32_t branch_uniform;
+	bool branch_moves_uniform;
+	/* The uniform address window. */
+	uint32_t unifa_time;
+	uint32_t unifa_address;
+	bool unifa_valid;
+	/* The integer multiply's latched top half. */
+	uint32_t rtop[LANES];
+	bool rtop_valid;
+	/* The open TMU sequence: data words per lane and the writes it took. */
+	uint32_t data[LANES][4];
+	uint32_t data_count[LANES];
+	uint32_t sequence_writes;
+	bool sequence_open;
+	/* Outstanding lookups and stores not yet waited for. */
+	struct lookup queue[MACHINE_TMU_QUEUE];
+	uint32_t queue_head;
+	uint32_t queue_count;
+	uint32_t pending_stores;
+	/* The barrier: written to SYNCB, and waiting at the switch after it. */
+	bool barrier_written;
+	bool barrier_waiting;
+	uint32_t last_special;
+};
+
+/* The whole job. */
+struct machine {
+	const struct v3d_device_info *device;
+	const struct qpu71_compute_setup *setup;
+	struct qpu71_compute_result *result;
+	struct batch *batches;
+	uint32_t batch_count;
+	struct batch *current;
+	uint32_t supergroup_count;
+	/* The batches of each supergroup and how many wait at its barrier. */
+	uint32_t *supergroup_batches;
+	uint32_t *supergroup_waiting;
+};
+
+static void fail(const struct machine *machine, const char *reason);
+static void build_batches(struct machine *machine);
+static void start_batch(struct machine *machine, struct batch *batch, uint32_t number, uint32_t supergroup, uint32_t seed);
+static void run_batch(struct machine *machine, struct batch *batch);
+static void finish_batch(struct machine *machine, struct batch *batch);
+static void decode_word(struct machine *machine, uint32_t index, struct v3d_qpu_instr *instruction);
+static void run_word(struct machine *machine, const struct v3d_qpu_instr *instruction);
+static void run_branch(struct machine *machine, const struct v3d_qpu_instr *instruction);
+static void run_alus(struct machine *machine, const struct v3d_qpu_instr *instruction);
+static void run_signals(struct machine *machine, const struct v3d_qpu_instr *instruction);
+static void run_switch(struct machine *machine, const struct v3d_qpu_instr *instruction);
+static void switch_effect(struct machine *machine);
+static void check_word_rules(struct machine *machine, const struct v3d_qpu_instr *instruction);
+static void land(struct machine *machine);
+static void read_resource(struct machine *machine, uint32_t resource, uint32_t *lanes);
+static void read_input(struct machine *machine, uint32_t address, bool constant, uint32_t *lanes);
+static void write_resource(struct machine *machine, uint32_t resource, const uint32_t *lanes, uint32_t mask, uint32_t delay);
+static uint32_t condition_mask(struct machine *machine, enum v3d_qpu_cond condition);
+static uint32_t add_result(struct machine *machine, const struct v3d_qpu_instr *instruction, uint32_t lane, uint32_t left, uint32_t right, bool *flags_set, uint32_t *flag);
+static uint32_t mul_result(struct machine *machine, const struct v3d_qpu_instr *instruction, uint32_t lane, uint32_t left, uint32_t right, bool *flags_set, uint32_t *flag);
+static void write_destination(struct machine *machine, uint32_t address, bool magic, const uint32_t *lanes, uint32_t mask, uint32_t delay);
+static void tmu_address(struct machine *machine, const uint32_t *lanes, uint32_t mask, uint32_t config);
+static void tmu_data(struct machine *machine, const uint32_t *lanes, uint32_t mask);
+static void tmu_wait(struct machine *machine);
+static uint8_t *memory_at(struct machine *machine, uint32_t address, uint32_t bytes, bool write);
+static uint32_t next_uniform(struct machine *machine);
+static uint32_t float_bits(float number);
+static float bits_float(uint32_t bits);
+static uint32_t truth(bool condition);
+static int32_t float_to_signed(float number);
+static uint32_t float_to_unsigned(float number);
+
+/*
+ * Runs every batch of one job.
+ */
+void
+qpu71_compute_run(
+	const struct v3d_device_info *device,
+	const struct qpu71_compute_setup *setup,
+	struct qpu71_compute_result *result)
+{
+	struct machine machine;
+	struct batch *batch;
+	uint32_t remaining;
+	uint32_t index;
+	uint32_t turn;
+	uint32_t tried;
+
+	/* The job's batches are formed the way the CSD forms them. */
+	memset(&machine, 0, sizeof(machine));
+	memset(result, 0, sizeof(*result));
+	machine.device = device;
+	machine.setup = setup;
+	machine.result = result;
+	if (setup->threads != 2 && setup->threads != 4)
+		fail(&machine, "threads must be two or four");
+	if (setup->workgroups_per_supergroup == 0 || setup->workgroups_per_supergroup > 16)
+		fail(&machine, "workgroups per supergroup must be one to sixteen");
+	build_batches(&machine);
+
+	/* Threads take turns at their switches until every batch has ended; all are resident at once. */
+	remaining = machine.batch_count;
+	turn = 0;
+	while (remaining != 0) {
+		/* The next batch that is neither ended nor waiting at a barrier runs. */
+		batch = NULL;
+		for (tried = 0; tried < machine.batch_count; tried++) {
+			index = (turn + tried) % machine.batch_count;
+			if (machine.batches[index].ended || machine.batches[index].barrier_waiting)
+				continue;
+			batch = &machine.batches[index];
+			break;
+		}
+		if (batch == NULL)
+			fail(&machine, "deadlock: every remaining batch waits at a barrier");
+		turn = (batch->number + 1) % machine.batch_count;
+
+		/* The batch runs until its switch takes effect or it ends. */
+		machine.current = batch;
+		run_batch(&machine, batch);
+		if (batch->ended)
+			remaining--;
+	}
+
+	/* Succeeded: the counts describe the job. */
+	result->batches = machine.batch_count;
+	result->supergroups = machine.supergroup_count;
+	free(machine.batches);
+	free(machine.supergroup_batches);
+	free(machine.supergroup_waiting);
+}
+
+/*
+ * Tells the payload b of a workgroup size.
+ */
+uint32_t
+qpu71_compute_index_bits(
+	uint32_t workgroup_size)
+{
+	uint32_t bits;
+
+	/* The local index occupies the top b bits of rf2; at least 64 invocations' worth (Mesa nir_to_vir.c). */
+	bits = 6;
+	while ((1U << bits) < workgroup_size)
+		bits++;
+	return bits;
+}
+
+/* Forms the job's supergroups and batches and gives every lane its payload. */
+static void
+build_batches(
+	struct machine *machine)
+{
+	const struct qpu71_compute_setup *setup;
+	struct batch *batch;
+	uint32_t size;
+	uint32_t groups;
+	uint32_t per_supergroup;
+	uint32_t supergroup;
+	uint32_t first;
+	uint32_t count;
+	uint32_t invocations;
+	uint32_t batches;
+	uint32_t invocation;
+	uint32_t lane;
+	uint32_t group;
+	uint32_t local;
+	uint32_t bits;
+	uint32_t slot;
+	uint32_t gx;
+	uint32_t gy;
+	uint32_t gz;
+
+	/* The sizes of the job. */
+	setup = machine->setup;
+	size = setup->local_size[0] * setup->local_size[1] * setup->local_size[2];
+	groups = setup->groups[0] * setup->groups[1] * setup->groups[2];
+	if (size == 0 || size > 256 || groups == 0)
+		fail(machine, "empty or oversized dispatch");
+	per_supergroup = setup->workgroups_per_supergroup;
+	machine->supergroup_count = (groups + per_supergroup - 1) / per_supergroup;
+	bits = qpu71_compute_index_bits(size);
+
+	/* Counts the batches: each supergroup's invocations in groups of sixteen lanes. */
+	batches = 0;
+	for (supergroup = 0; supergroup < machine->supergroup_count; supergroup++) {
+		first = supergroup * per_supergroup;
+		count = groups - first;
+		if (count > per_supergroup)
+			count = per_supergroup;
+		batches += (count * size + LANES - 1) / LANES;
+	}
+	machine->batch_count = batches;
+	machine->batches = calloc(batches, sizeof(*machine->batches));
+	machine->supergroup_batches = calloc(machine->supergroup_count, sizeof(uint32_t));
+	machine->supergroup_waiting = calloc(machine->supergroup_count, sizeof(uint32_t));
+	assert(machine->batches != NULL && machine->supergroup_batches != NULL && machine->supergroup_waiting != NULL);
+
+	/* Every lane of every batch takes the payload of its invocation; the rest of the batch is not dispatched. */
+	batches = 0;
+	for (supergroup = 0; supergroup < machine->supergroup_count; supergroup++) {
+		first = supergroup * per_supergroup;
+		count = groups - first;
+		if (count > per_supergroup)
+			count = per_supergroup;
+		invocations = count * size;
+		for (invocation = 0; invocation < invocations; invocation += LANES) {
+			batch = &machine->batches[batches];
+			start_batch(machine, batch, batches, supergroup, setup->garbage_seed + batches);
+			machine->supergroup_batches[supergroup]++;
+			for (lane = 0; lane < LANES && invocation + lane < invocations; lane++) {
+				group = first + (invocation + lane) / size;
+				local = (invocation + lane) % size;
+				gx = group % setup->groups[0];
+				gy = (group / setup->groups[0]) % setup->groups[1];
+				gz = group / (setup->groups[0] * setup->groups[1]);
+
+				/* Assumed: the memory slot is the workgroup's index in the job, modulo the field's range (all 16 bits for one invocation). */
+				slot = group & ((1U << (16 - bits)) - 1U);
+				if (size == 1)
+					slot = group & 0xffffU;
+				batch->value[3][lane] = gx | (gy << 16);
+				batch->value[2][lane] = gz | (slot << 16) | (local << (32 - bits));
+				batch->dispatched |= 1U << lane;
+			}
+			batches++;
+		}
+	}
+}
+
+/* Starts one batch with garbage in its registers, nothing in flight and nothing pending. */
+static void
+start_batch(
+	struct machine *machine,
+	struct batch *batch,
+	uint32_t number,
+	uint32_t supergroup,
+	uint32_t seed)
+{
+	uint32_t resource;
+	uint32_t lane;
+
+	/* Garbage everywhere makes a read of an unwritten register visible. */
+	(void)machine;
+	memset(batch, 0, sizeof(*batch));
+	batch->number = number;
+	batch->supergroup = supergroup;
+	seed = seed * 2654435761U + 12345U;
+	for (resource = 0; resource < MACHINE_RESOURCES; resource++) {
+		for (lane = 0; lane < LANES; lane++) {
+			seed = seed * 1103515245U + 12345U;
+			batch->value[resource][lane] = seed;
+		}
+		batch->pending_land[resource] = MACHINE_NONE;
+	}
+
+	/* The flags start clear; no switch, branch, window or special function yet. */
+	memset(batch->value[MACHINE_FLAGS], 0, sizeof(batch->value[MACHINE_FLAGS]));
+	batch->last_switch = MACHINE_NONE;
+	batch->switch_effect = MACHINE_NONE;
+	batch->thread_end = MACHINE_NONE;
+	batch->branch_time = MACHINE_NONE;
+	batch->branch_jump = MACHINE_NONE;
+	batch->unifa_time = MACHINE_NONE;
+	batch->last_special = MACHINE_NONE;
+}
+
+/* Runs one batch until its thread switch takes effect or it ends. */
+static void
+run_batch(
+	struct machine *machine,
+	struct batch *batch)
+{
+	const struct qpu71_compute_setup *setup;
+	struct v3d_qpu_instr instruction;
+	uint32_t supergroup;
+	uint32_t index;
+
+	/* Words run one after another; branches and switches act between them. */
+	setup = machine->setup;
+	for (;;) {
+		/* Writes that landed at the end of the previous word become visible. */
+		land(machine);
+
+		/* The thread end's second delay word was the last. */
+		if (batch->thread_end != MACHINE_NONE && batch->time == batch->thread_end + 3) {
+			finish_batch(machine, batch);
+			return;
+		}
+
+		/* A switch takes effect between words; a switch after a barrier write waits for the supergroup. */
+		if (batch->switch_effect == batch->time) {
+			batch->switch_effect = MACHINE_NONE;
+			switch_effect(machine);
+			if (batch->barrier_written) {
+				batch->barrier_written = false;
+				batch->barrier_waiting = true;
+				supergroup = batch->supergroup;
+				machine->supergroup_waiting[supergroup]++;
+				machine->result->barriers++;
+
+				/* The last batch to arrive releases them all. */
+				if (machine->supergroup_waiting[supergroup] == machine->supergroup_batches[supergroup]) {
+					machine->supergroup_waiting[supergroup] = 0;
+					for (index = 0; index < machine->batch_count; index++) {
+						if (machine->batches[index].supergroup == supergroup)
+							machine->batches[index].barrier_waiting = false;
+					}
+				}
+			}
+
+			/* Another thread runs now. */
+			return;
+		}
+
+		/* A taken branch jumps after its three delay words; the uniform stream moves with it. */
+		if (batch->branch_jump == batch->time) {
+			batch->pc = batch->branch_target;
+			if (batch->branch_moves_uniform)
+				batch->uniform_index = batch->branch_uniform;
+			batch->branch_jump = MACHINE_NONE;
+			machine->result->branches_taken++;
+		}
+
+		/* The program never runs past its last word. */
+		if (batch->pc >= setup->code_count)
+			fail(machine, "program runs past its last word");
+
+		/* One word runs. */
+		decode_word(machine, batch->pc, &instruction);
+		run_word(machine, &instruction);
+		batch->pc++;
+		batch->time++;
+		machine->result->words++;
+		if (machine->result->words > 200000000U)
+			fail(machine, "the job does not end");
+	}
+}
+
+/* Checks that an ending batch leaves no transaction behind. */
+static void
+finish_batch(
+	struct machine *machine,
+	struct batch *batch)
+{
+	uint32_t index;
+
+	/* Every lookup was read, every store waited for and the sequence closed. */
+	if (batch->queue_count != 0)
+		fail(machine, "thread ends with lookups not read");
+	if (batch->pending_stores != 0)
+		fail(machine, "thread ends with stores not waited for (no TMUWT)");
+	if (batch->sequence_open)
+		fail(machine, "thread ends inside a TMU sequence");
+	if (batch->barrier_written)
+		fail(machine, "thread ends after a barrier write without its switch");
+
+	/* A batch that ends while others of its supergroup wait at a barrier leaves them waiting forever. */
+	for (index = 0; index < machine->batch_count; index++) {
+		if (machine->batches[index].supergroup != batch->supergroup)
+			continue;
+		if (machine->batches[index].barrier_waiting)
+			fail(machine, "thread ends while its supergroup waits at a barrier");
+	}
+	if (batch->uniform_index > machine->result->uniforms_read)
+		machine->result->uniforms_read = batch->uniform_index;
+	batch->ended = true;
+}
+
+/* Reads one word with the independent decoder; it must rebuild exactly. */
+static void
+decode_word(
+	struct machine *machine,
+	uint32_t index,
+	struct v3d_qpu_instr *instruction)
+{
+	uint64_t repacked;
+	bool accepted;
+
+	/* The decoder recognises the word and the packer rebuilds it. */
+	memset(instruction, 0, sizeof(*instruction));
+	accepted = v3d_qpu_instr_unpack(machine->device, machine->setup->code[index], instruction);
+	if (!accepted)
+		fail(machine, "word does not decode");
+	repacked = 0;
+	accepted = v3d_qpu_instr_pack(machine->device, instruction, &repacked);
+	if (!accepted || repacked != machine->setup->code[index])
+		fail(machine, "word does not repack to itself");
+}
+
+/* Runs one decoded word. */
+static void
+run_word(
+	struct machine *machine,
+	const struct v3d_qpu_instr *instruction)
+{
+	/* A branch word has no ALUs and no signals. */
+	if (instruction->type == V3D_QPU_INSTR_TYPE_BRANCH) {
+		run_branch(machine, instruction);
+		return;
+	}
+
+	/* Output packing and the flag updates are outside the compiler's vocabulary. */
+	if (instruction->flags.auf != V3D_QPU_UF_NONE || instruction->flags.muf != V3D_QPU_UF_NONE)
+		fail(machine, "flag update operations are not modeled");
+	if (instruction->alu.add.output_pack != V3D_QPU_PACK_NONE || instruction->alu.mul.output_pack != V3D_QPU_PACK_NONE)
+		fail(machine, "output packing is not modeled");
+
+	/* The word's rules, its ALUs, its loads and its switch. */
+	check_word_rules(machine, instruction);
+	run_alus(machine, instruction);
+	run_signals(machine, instruction);
+	run_switch(machine, instruction);
+}
+
+/* Runs one branch word: the condition over the counted lanes, the uniform it reads and the jump three words later. */
+static void
+run_branch(
+	struct machine *machine,
+	const struct v3d_qpu_instr *instruction)
+{
+	struct batch *batch;
+	uint32_t counted;
+	uint32_t flag;
+	uint32_t set;
+	uint32_t lane;
+	uint32_t uniform;
+	int32_t words;
+	bool taken;
+
+	/* A branch is no closer than its predecessor's delay words, nor inside a switch's. */
+	batch = machine->current;
+	if (batch->branch_time != MACHINE_NONE && batch->time <= batch->branch_time + 3)
+		fail(machine, "branch inside another branch's delay words");
+	if (batch->last_switch != MACHINE_NONE && batch->time <= batch->last_switch + 2)
+		fail(machine, "branch inside a thread switch's delay words");
+	if (batch->unifa_time != MACHINE_NONE && batch->time <= batch->unifa_time + 3)
+		fail(machine, "branch within three words of a unifa write");
+	if (batch->thread_end != MACHINE_NONE)
+		fail(machine, "branch after the thread end");
+
+	/* No TMU transaction may cross a block boundary. */
+	if (batch->sequence_open || batch->queue_count != 0 || batch->pending_stores != 0)
+		fail(machine, "TMU lookups, stores or a sequence outstanding at a branch");
+
+	/* Only relative targets and relative uniform moves are used. */
+	if (instruction->branch.bdi != V3D_QPU_BRANCH_DEST_REL)
+		fail(machine, "branch target other than relative");
+	if (instruction->branch.ub && instruction->branch.bdu != V3D_QPU_BRANCH_DEST_REL)
+		fail(machine, "uniform move other than relative");
+	if (instruction->branch.msfign == V3D_QPU_MSFIGN_Q)
+		fail(machine, "branch ignoring the Q lanes is not modeled");
+
+	/* Lanes the CSD did not dispatch are left out of the count when the branch ignores the P lanes. */
+	counted = ALL_LANES;
+	if (instruction->branch.msfign == V3D_QPU_MSFIGN_P)
+		counted = batch->dispatched;
+	set = 0;
+	if (instruction->branch.cond != V3D_QPU_BRANCH_COND_ALWAYS) {
+		read_resource(machine, MACHINE_FLAGS, NULL);
+		for (lane = 0; lane < LANES; lane++) {
+			flag = batch->value[MACHINE_FLAGS][lane];
+			if (flag != 0)
+				set |= 1U << lane;
+		}
+	}
+	set &= counted;
+
+	/* The condition. */
+	taken = false;
+	switch (instruction->branch.cond) {
+	case V3D_QPU_BRANCH_COND_ALWAYS:
+		taken = true;
+		break;
+	case V3D_QPU_BRANCH_COND_A0:
+		taken = (set & 1U) != 0;
+		break;
+	case V3D_QPU_BRANCH_COND_NA0:
+		taken = (set & 1U) == 0;
+		break;
+	case V3D_QPU_BRANCH_COND_ALLA:
+		taken = set == counted;
+		break;
+	case V3D_QPU_BRANCH_COND_ANYNA:
+		taken = set != counted;
+		break;
+	case V3D_QPU_BRANCH_COND_ANYA:
+		taken = set != 0;
+		break;
+	case V3D_QPU_BRANCH_COND_ALLNA:
+		taken = set == 0;
+		break;
+	default:
+		fail(machine, "unknown branch condition");
+	}
+
+	/* A branch that moves the uniform stream reads its offset from the stream whether or not it is taken. */
+	uniform = 0;
+	if (instruction->branch.ub)
+		uniform = next_uniform(machine);
+	batch->branch_time = batch->time;
+	if (!taken)
+		return;
+
+	/* The jump happens after the three delay words; the target counts from the word after them. */
+	words = (int32_t)instruction->branch.offset / 8;
+	if ((int64_t)batch->pc + 4 + words < 0 || (int64_t)batch->pc + 4 + words >= machine->setup->code_count)
+		fail(machine, "branch target outside the program");
+	batch->branch_jump = batch->time + 4;
+	batch->branch_target = (uint32_t)((int32_t)batch->pc + 4 + words);
+	batch->branch_moves_uniform = instruction->branch.ub;
+	if (instruction->branch.ub) {
+		if ((uniform & 3U) != 0)
+			fail(machine, "uniform move not a whole number of words");
+		if ((int64_t)batch->uniform_index + (int32_t)uniform / 4 < 0)
+			fail(machine, "uniform move before the stream");
+		batch->branch_uniform = (uint32_t)((int32_t)batch->uniform_index + (int32_t)uniform / 4);
+	}
+}
+
+/* Runs both ALUs of one word on every lane: sources read at the start, predicates from the old flags. */
+static void
+run_alus(
+	struct machine *machine,
+	const struct v3d_qpu_instr *instruction)
+{
+	struct batch *batch;
+	uint32_t add_left[LANES];
+	uint32_t add_right[LANES];
+	uint32_t mul_left[LANES];
+	uint32_t mul_right[LANES];
+	uint32_t add_bits[LANES];
+	uint32_t mul_bits[LANES];
+	uint32_t flags[LANES];
+	uint32_t add_mask;
+	uint32_t mul_mask;
+	uint32_t flag;
+	uint32_t delay;
+	uint32_t lane;
+	int add_sources;
+	int mul_sources;
+	bool add_flags;
+	bool mul_flags;
+	bool flags_set;
+
+	/* Both ALUs read their sources when the word starts. */
+	batch = machine->current;
+	memset(add_left, 0, sizeof(add_left));
+	memset(add_right, 0, sizeof(add_right));
+	memset(mul_left, 0, sizeof(mul_left));
+	memset(mul_right, 0, sizeof(mul_right));
+	add_sources = 0;
+	mul_sources = 0;
+	if (instruction->alu.add.op != V3D_QPU_A_NOP)
+		add_sources = v3d_qpu_add_op_num_src(instruction->alu.add.op);
+	if (instruction->alu.mul.op != V3D_QPU_M_NOP)
+		mul_sources = v3d_qpu_mul_op_num_src(instruction->alu.mul.op);
+	if (add_sources > 0)
+		read_input(machine, instruction->alu.add.a.raddr, instruction->sig.small_imm_a, add_left);
+	if (add_sources > 1)
+		read_input(machine, instruction->alu.add.b.raddr, instruction->sig.small_imm_b, add_right);
+	if (mul_sources > 0)
+		read_input(machine, instruction->alu.mul.a.raddr, instruction->sig.small_imm_c, mul_left);
+	if (mul_sources > 1)
+		read_input(machine, instruction->alu.mul.b.raddr, instruction->sig.small_imm_d, mul_right);
+
+	/* Predicates read the flags as they were when the word started. */
+	add_mask = 0;
+	mul_mask = 0;
+	if (instruction->alu.add.op != V3D_QPU_A_NOP)
+		add_mask = condition_mask(machine, instruction->flags.ac);
+	if (instruction->alu.mul.op != V3D_QPU_M_NOP)
+		mul_mask = condition_mask(machine, instruction->flags.mc);
+
+	/* Each ALU computes on every lane. */
+	add_flags = false;
+	mul_flags = false;
+	memset(flags, 0, sizeof(flags));
+	for (lane = 0; lane < LANES; lane++) {
+		add_bits[lane] = 0;
+		mul_bits[lane] = 0;
+		flags_set = false;
+		flag = 0;
+		if (instruction->alu.add.op != V3D_QPU_A_NOP) {
+			add_bits[lane] = add_result(machine, instruction, lane, add_left[lane], add_right[lane], &flags_set, &flag);
+			if (flags_set) {
+				add_flags = true;
+				flags[lane] = flag;
+			}
+		}
+		flags_set = false;
+		if (instruction->alu.mul.op != V3D_QPU_M_NOP) {
+			mul_bits[lane] = mul_result(machine, instruction, lane, mul_left[lane], mul_right[lane], &flags_set, &flag);
+			if (flags_set) {
+				mul_flags = true;
+				flags[lane] = flag;
+			}
+		}
+	}
+	if (add_flags && mul_flags)
+		fail(machine, "both ALUs push flags");
+
+	/* A special function's result lands a word later; the writes go to registers or peripherals. */
+	delay = 0;
+	if (v3d_qpu_instr_is_sfu(instruction))
+		delay = 1;
+	if (instruction->alu.add.op != V3D_QPU_A_NOP && v3d_qpu_add_op_has_dst(instruction->alu.add.op) && (add_mask != 0 || instruction->alu.add.magic_write))
+		write_destination(machine, instruction->alu.add.waddr, instruction->alu.add.magic_write, add_bits, add_mask, delay);
+	if (instruction->alu.mul.op != V3D_QPU_M_NOP && v3d_qpu_mul_op_has_dst(instruction->alu.mul.op) && (mul_mask != 0 || instruction->alu.mul.magic_write))
+		write_destination(machine, instruction->alu.mul.waddr, instruction->alu.mul.magic_write, mul_bits, mul_mask, 0);
+
+	/* A push moves flag A to B and sets the new A on every lane when the word ends. */
+	if (add_flags || mul_flags) {
+		batch->lost[MACHINE_FLAGS] = false;
+		for (lane = 0; lane < LANES; lane++)
+			batch->pending_flag_b[lane] = batch->value[MACHINE_FLAGS][lane];
+		write_resource(machine, MACHINE_FLAGS, flags, ALL_LANES, 0);
+	}
+}
+
+/* Runs one word's uniform and TMU result loads, which write when the word ends. */
+static void
+run_signals(
+	struct machine *machine,
+	const struct v3d_qpu_instr *instruction)
+{
+	struct batch *batch;
+	struct lookup *lookup;
+	uint32_t lanes[LANES];
+	uint32_t word;
+	uint32_t lane;
+	uint8_t *bytes;
+
+	/* A uniform load to a register. */
+	batch = machine->current;
+	if (instruction->sig.ldunifrf) {
+		if (instruction->sig_magic)
+			fail(machine, "uniform load to a magic address is not modeled");
+		word = next_uniform(machine);
+		for (lane = 0; lane < LANES; lane++)
+			lanes[lane] = word;
+		write_resource(machine, instruction->sig_addr, lanes, ALL_LANES, 0);
+	}
+	if (instruction->sig.ldunif) {
+		word = next_uniform(machine);
+		for (lane = 0; lane < LANES; lane++)
+			lanes[lane] = word;
+		write_resource(machine, 0, lanes, ALL_LANES, 0);
+	}
+
+	/* A load through the uniform address window: the next word of memory, the same on every lane. */
+	if (instruction->sig.ldunifa || instruction->sig.ldunifarf) {
+		if (!batch->unifa_valid)
+			fail(machine, "ldunifa without a unifa write");
+		if (batch->time <= batch->unifa_time + 3)
+			fail(machine, "ldunifa within three words of its unifa write");
+		bytes = memory_at(machine, batch->unifa_address, 4, false);
+		memcpy(&word, bytes, sizeof(word));
+		batch->unifa_address += 4;
+		for (lane = 0; lane < LANES; lane++)
+			lanes[lane] = word;
+		if (instruction->sig.ldunifarf) {
+			if (instruction->sig_magic)
+				fail(machine, "ldunifarf to a magic address is not modeled");
+			write_resource(machine, instruction->sig_addr, lanes, ALL_LANES, 0);
+		} else {
+			write_resource(machine, 0, lanes, ALL_LANES, 0);
+		}
+	}
+
+	/* A TMU result: the next word of the oldest lookup. */
+	if (instruction->sig.ldtmu) {
+		if (instruction->sig_magic)
+			fail(machine, "TMU result to a magic address is not modeled");
+		if (batch->sequence_open)
+			fail(machine, "ldtmu inside a TMU sequence");
+		if (batch->queue_count == 0)
+			fail(machine, "ldtmu with no outstanding lookup");
+		lookup = &batch->queue[batch->queue_head];
+		for (lane = 0; lane < LANES; lane++)
+			lanes[lane] = lookup->value[lane][lookup->read];
+		write_resource(machine, instruction->sig_addr, lanes, ALL_LANES, 0);
+		lookup->read++;
+		if (lookup->read == lookup->words) {
+			batch->queue_head = (batch->queue_head + 1) % MACHINE_TMU_QUEUE;
+			batch->queue_count--;
+		}
+	}
+
+	/* The texture configuration signal belongs to graphics. */
+	if (instruction->sig.wrtmuc || instruction->sig.ldvary || instruction->sig.ldtlb || instruction->sig.ldtlbu || instruction->sig.ldvpm)
+		fail(machine, "graphics signal in a compute program");
+}
+
+/* Notes one word's switch: it takes effect after its two delay words; two in a row mark the last one. */
+static void
+run_switch(
+	struct machine *machine,
+	const struct v3d_qpu_instr *instruction)
+{
+	struct batch *batch;
+	uint32_t time;
+
+	/* A word without a switch changes nothing here. */
+	batch = machine->current;
+	if (!instruction->sig.thrsw)
+		return;
+
+	/* No switch inside a branch's delay words. */
+	time = batch->time;
+	if (batch->branch_time != MACHINE_NONE && time <= batch->branch_time + 3)
+		fail(machine, "thread switch inside a branch's delay words");
+
+	/* A switch right after an unmarked one marks it as the last; it is not a switch of its own. */
+	if (batch->last_switch != MACHINE_NONE && batch->last_switch + 1 == time && !batch->last_marked && !machine->setup->single_segment) {
+		batch->last_marked = true;
+		batch->last_marked_switch = batch->last_switch;
+		return;
+	}
+
+	/* Any other switch is outside the previous one's delay words; after the last one, it ends the thread. */
+	if (batch->last_switch != MACHINE_NONE && time < batch->last_switch + 3)
+		fail(machine, "thread switch inside another switch's delay words");
+	if (batch->sequence_open)
+		fail(machine, "thread switch inside a TMU sequence");
+	if (batch->last_marked || machine->setup->single_segment) {
+		if (batch->thread_end != MACHINE_NONE)
+			fail(machine, "second thread end");
+		batch->thread_end = time;
+		return;
+	}
+
+	/* The switch takes effect after its two delay words. */
+	batch->last_switch = time;
+	batch->switch_effect = time + 3;
+}
+
+/* Applies a thread switch: rf0, the flags and the multiply's top half are lost. */
+static void
+switch_effect(
+	struct machine *machine)
+{
+	struct batch *batch;
+	uint32_t resource;
+
+	/* A write still in flight would land in the other thread. */
+	batch = machine->current;
+	for (resource = 0; resource < MACHINE_RESOURCES; resource++) {
+		if (batch->pending_land[resource] != MACHINE_NONE)
+			fail(machine, "write in flight across a thread switch");
+	}
+
+	/* The multiply's top half does not survive another thread's multiplies. */
+	if (batch->rtop_valid)
+		fail(machine, "thread switch between MULTOP and UMUL24");
+	batch->lost[0] = true;
+	batch->lost[MACHINE_FLAGS] = true;
+}
+
+/* Checks the per-word unit, small immediate, uniform, special function and thread end rules. */
+static void
+check_word_rules(
+	struct machine *machine,
+	const struct v3d_qpu_instr *instruction)
+{
+	struct batch *batch;
+	uint32_t restricted;
+	uint32_t uniforms;
+	uint32_t immediates;
+	uint32_t slot;
+	uint32_t limit;
+	bool special;
+	bool add_register;
+	bool mul_register;
+	bool signal_register;
+
+	/* One restricted unit per word: a TMU write, a special function or the VPM. */
+	batch = machine->current;
+	special = v3d_qpu_instr_is_sfu(instruction);
+	restricted = 0;
+	if (v3d_qpu_writes_tmu(machine->device, instruction))
+		restricted++;
+	if (special)
+		restricted++;
+	if (v3d_qpu_uses_vpm(instruction))
+		restricted++;
+	if (restricted > 1)
+		fail(machine, "more than one restricted peripheral unit in one word");
+
+	/* One small immediate per word, on an ALU that runs an operation. */
+	immediates = 0;
+	if (instruction->sig.small_imm_a || instruction->sig.small_imm_b)
+		immediates++;
+	if (instruction->sig.small_imm_c || instruction->sig.small_imm_d)
+		immediates++;
+	if (immediates > 1)
+		fail(machine, "more than one small immediate in one word");
+
+	/* One uniform per word: a load, a load through the window, or an implicit one. */
+	uniforms = 0;
+	if (instruction->sig.ldunifrf || instruction->sig.ldunif)
+		uniforms++;
+	if (instruction->sig.ldunifa || instruction->sig.ldunifarf)
+		uniforms++;
+	if (instruction->alu.add.op != V3D_QPU_A_NOP && instruction->alu.add.magic_write && v3d_qpu_magic_waddr_loads_unif(instruction->alu.add.waddr))
+		uniforms++;
+	if (instruction->alu.mul.op != V3D_QPU_M_NOP && instruction->alu.mul.magic_write && v3d_qpu_magic_waddr_loads_unif(instruction->alu.mul.waddr))
+		uniforms++;
+	if (uniforms > 1)
+		fail(machine, "more than one uniform read in one word");
+
+	/* A branch's delay words read no uniform and write no unifa. */
+	if (batch->branch_time != MACHINE_NONE && batch->time <= batch->branch_time + 3) {
+		if (uniforms != 0)
+			fail(machine, "uniform read in a branch's delay words");
+		if (v3d_qpu_writes_unifa(machine->device, instruction))
+			fail(machine, "unifa write in a branch's delay words");
+	}
+
+	/* The registers a thread sees. */
+	limit = 64;
+	if (machine->setup->threads == 4)
+		limit = 32;
+	if (instruction->alu.add.op != V3D_QPU_A_NOP && !instruction->alu.add.magic_write && instruction->alu.add.waddr >= limit)
+		fail(machine, "register outside the thread's window written");
+	if (instruction->alu.mul.op != V3D_QPU_M_NOP && !instruction->alu.mul.magic_write && instruction->alu.mul.waddr >= limit)
+		fail(machine, "register outside the thread's window written");
+
+	/* A special function starts no sooner than two words after the previous one. */
+	if (special) {
+		if (batch->last_special != MACHINE_NONE && batch->time < batch->last_special + 2)
+			fail(machine, "special function too soon after another");
+		batch->last_special = batch->time;
+	}
+
+	/* A switch's delay words start no special function and read no TMU result. */
+	slot = 3;
+	if (instruction->sig.thrsw)
+		slot = 0;
+	if (batch->last_switch != MACHINE_NONE && batch->time <= batch->last_switch + 2)
+		slot = batch->time - batch->last_switch;
+	if (slot <= 2) {
+		if (special && slot > 0)
+			fail(machine, "special function in a thread switch's delay words");
+		if (instruction->sig.ldtmu)
+			fail(machine, "TMU result read in a thread switch's words");
+	}
+
+	/* The thread end's words write no register through an ALU in the end word, touch neither rf2 nor rf3, and read no uniform after it. */
+	if (batch->thread_end == MACHINE_NONE && !(instruction->sig.thrsw && (batch->last_marked || machine->setup->single_segment)))
+		return;
+	add_register = false;
+	mul_register = false;
+	if (instruction->alu.add.op != V3D_QPU_A_NOP && !instruction->alu.add.magic_write)
+		add_register = v3d_qpu_add_op_has_dst(instruction->alu.add.op);
+	if (instruction->alu.mul.op != V3D_QPU_M_NOP && !instruction->alu.mul.magic_write)
+		mul_register = v3d_qpu_mul_op_has_dst(instruction->alu.mul.op);
+	if (instruction->sig.thrsw && (add_register || mul_register))
+		fail(machine, "ALU register write in the thread end's word");
+	if (add_register && (instruction->alu.add.waddr == 2 || instruction->alu.add.waddr == 3))
+		fail(machine, "rf2 or rf3 written in the thread end's words");
+	if (mul_register && (instruction->alu.mul.waddr == 2 || instruction->alu.mul.waddr == 3))
+		fail(machine, "rf2 or rf3 written in the thread end's words");
+	signal_register = v3d_qpu_sig_writes_address(machine->device, &instruction->sig);
+	if (signal_register && !instruction->sig_magic && (instruction->sig_addr == 2 || instruction->sig_addr == 3))
+		fail(machine, "rf2 or rf3 written by a signal in the thread end's words");
+	if (special && !instruction->sig.thrsw)
+		fail(machine, "special function in the thread end's delay words");
+	if (v3d71_qpu_reads_raddr(instruction, 2) || v3d71_qpu_reads_raddr(instruction, 3))
+		fail(machine, "rf2 or rf3 read in the thread end's words");
+	if (uniforms != 0 && !instruction->sig.thrsw)
+		fail(machine, "uniform read in the thread end's delay words");
+	if (instruction->alu.add.op == V3D_QPU_A_TMUWT && batch->thread_end != MACHINE_NONE && batch->time == batch->thread_end + 2)
+		fail(machine, "TMUWT as the program's last word");
+}
+
+/* Makes the writes that landed at the end of the previous word visible on the lanes they wrote. */
+static void
+land(
+	struct machine *machine)
+{
+	struct batch *batch;
+	uint32_t resource;
+	uint32_t lane;
+
+	/* A write landing at the end of word w is visible from word w + 1. */
+	batch = machine->current;
+	for (resource = 0; resource < MACHINE_RESOURCES; resource++) {
+		if (batch->pending_land[resource] == MACHINE_NONE)
+			continue;
+		if (batch->pending_land[resource] >= batch->time)
+			continue;
+		for (lane = 0; lane < LANES; lane++) {
+			if ((batch->pending_mask[resource] & (1U << lane)) == 0)
+				continue;
+			batch->value[resource][lane] = batch->pending_value[resource][lane];
+			if (resource == MACHINE_FLAGS)
+				batch->flag_b[lane] = batch->pending_flag_b[lane];
+		}
+		batch->lost[resource] = false;
+		batch->pending_land[resource] = MACHINE_NONE;
+	}
+}
+
+/* Reads one register or the flags on every lane, refusing a value in flight or lost. */
+static void
+read_resource(
+	struct machine *machine,
+	uint32_t resource,
+	uint32_t *lanes)
+{
+	struct batch *batch;
+
+	/* A write still on its way means the read would see an older value than the program meant. */
+	batch = machine->current;
+	if (resource < 64 && resource >= 32 && machine->setup->threads == 4)
+		fail(machine, "register outside the thread's window read");
+	if (batch->pending_land[resource] != MACHINE_NONE)
+		fail(machine, "read of a resource whose write is in flight");
+	if (batch->lost[resource])
+		fail(machine, "read of rf0 or the flags across a thread switch");
+	if (lanes != NULL)
+		memcpy(lanes, batch->value[resource], sizeof(uint32_t) * LANES);
+}
+
+/* Reads one input of the word on every lane: a register, or the small immediate in its read address. */
+static void
+read_input(
+	struct machine *machine,
+	uint32_t address,
+	bool constant,
+	uint32_t *lanes)
+{
+	uint32_t bits;
+	uint32_t lane;
+	bool accepted;
+
+	/* A register read. */
+	if (!constant) {
+		read_resource(machine, address, lanes);
+		return;
+	}
+
+	/* The read address holds the small immediate's index. */
+	accepted = v3d_qpu_small_imm_unpack(machine->device, address, &bits);
+	if (!accepted)
+		fail(machine, "small constant does not decode");
+	for (lane = 0; lane < LANES; lane++)
+		lanes[lane] = bits;
+}
+
+/* Starts one write of the lanes in a mask that lands at the end of the word plus a delay. */
+static void
+write_resource(
+	struct machine *machine,
+	uint32_t resource,
+	const uint32_t *lanes,
+	uint32_t mask,
+	uint32_t delay)
+{
+	struct batch *batch;
+
+	/* Two writes of one resource in flight would race. */
+	batch = machine->current;
+	if (batch->pending_land[resource] != MACHINE_NONE)
+		fail(machine, "write while another write of the resource is in flight");
+	memcpy(batch->pending_value[resource], lanes, sizeof(uint32_t) * LANES);
+	batch->pending_mask[resource] = mask;
+	batch->pending_land[resource] = batch->time + delay;
+}
+
+/* Tells on which lanes a predicate holds, from the flags as they were when the word started. */
+static uint32_t
+condition_mask(
+	struct machine *machine,
+	enum v3d_qpu_cond condition)
+{
+	struct batch *batch;
+	uint32_t mask;
+	uint32_t lane;
+	bool holds;
+
+	/* An unpredicated write happens on every lane. */
+	batch = machine->current;
+	if (condition == V3D_QPU_COND_NONE)
+		return ALL_LANES;
+
+	/* Reading A checks it is visible; B moves with A. */
+	read_resource(machine, MACHINE_FLAGS, NULL);
+	mask = 0;
+	for (lane = 0; lane < LANES; lane++) {
+		holds = false;
+		switch (condition) {
+		case V3D_QPU_COND_IFA:
+			holds = batch->value[MACHINE_FLAGS][lane] != 0;
+			break;
+		case V3D_QPU_COND_IFNA:
+			holds = batch->value[MACHINE_FLAGS][lane] == 0;
+			break;
+		case V3D_QPU_COND_IFB:
+			holds = batch->flag_b[lane] != 0;
+			break;
+		case V3D_QPU_COND_IFNB:
+			holds = batch->flag_b[lane] == 0;
+			break;
+		default:
+			fail(machine, "unknown predicate");
+		}
+		if (holds)
+			mask |= 1U << lane;
+	}
+	return mask;
+}
+
+/* Computes one add ALU operation on one lane and, when it pushes flags, the lane's new flag A. */
+static uint32_t
+add_result(
+	struct machine *machine,
+	const struct v3d_qpu_instr *instruction,
+	uint32_t lane,
+	uint32_t left,
+	uint32_t right,
+	bool *flags_set,
+	uint32_t *flag)
+{
+	struct batch *batch;
+	enum v3d_qpu_pf push;
+	float a;
+	float b;
+	uint32_t bits;
+	uint32_t carry;
+
+	/* Inputs are whole 32-bit values. */
+	batch = machine->current;
+	if (instruction->alu.add.a.unpack != V3D_QPU_UNPACK_NONE || instruction->alu.add.b.unpack != V3D_QPU_UNPACK_NONE)
+		fail(machine, "add input unpacking is not modeled");
+	a = bits_float(left);
+	b = bits_float(right);
+	bits = 0;
+	carry = 0;
+	push = instruction->flags.apf;
+
+	/* The operation identities come from the independent decoder. */
+	switch (instruction->alu.add.op) {
+	case V3D_QPU_A_FADD:
+	case V3D_QPU_A_FADDNF:
+		bits = float_bits(a + b);
+		break;
+	case V3D_QPU_A_FSUB:
+		bits = float_bits(a - b);
+		break;
+	case V3D_QPU_A_FMIN:
+		bits = float_bits(fminf(a, b));
+		break;
+	case V3D_QPU_A_FMAX:
+		bits = float_bits(fmaxf(a, b));
+		break;
+	case V3D_QPU_A_MOV:
+		bits = left;
+		break;
+	case V3D_QPU_A_ADD:
+		bits = left + right;
+		carry = truth(bits < left);
+		break;
+	case V3D_QPU_A_SUB:
+		/* The carry of a subtraction is its borrow: the left input below the right, unsigned. */
+		bits = left - right;
+		carry = truth(left < right);
+		break;
+	case V3D_QPU_A_MIN:
+		/* The carry of a minimum is set when the left input is above the right, signed. */
+		bits = right;
+		if ((int32_t)left < (int32_t)right)
+			bits = left;
+		carry = truth((int32_t)left > (int32_t)right);
+		break;
+	case V3D_QPU_A_MAX:
+		bits = right;
+		if ((int32_t)left > (int32_t)right)
+			bits = left;
+		break;
+	case V3D_QPU_A_UMIN:
+		/* Assumed by analogy with the signed minimum: set when the left input is above the right. */
+		bits = right;
+		if (left < right)
+			bits = left;
+		carry = truth(left > right);
+		break;
+	case V3D_QPU_A_UMAX:
+		bits = right;
+		if (left > right)
+			bits = left;
+		break;
+	case V3D_QPU_A_SHL:
+		bits = left << (right & 31U);
+		break;
+	case V3D_QPU_A_SHR:
+		bits = left >> (right & 31U);
+		break;
+	case V3D_QPU_A_ASR:
+		bits = (uint32_t)((int32_t)left >> (right & 31U));
+		break;
+	case V3D_QPU_A_AND:
+		bits = left & right;
+		break;
+	case V3D_QPU_A_OR:
+		bits = left | right;
+		break;
+	case V3D_QPU_A_XOR:
+		bits = left ^ right;
+		break;
+	case V3D_QPU_A_NOT:
+		bits = ~left;
+		break;
+	case V3D_QPU_A_NEG:
+		bits = 0U - left;
+		break;
+	case V3D_QPU_A_RECIP:
+		bits = float_bits(1.0f / a);
+		break;
+	case V3D_QPU_A_RSQRT:
+		bits = float_bits(1.0f / sqrtf(a));
+		break;
+	case V3D_QPU_A_EXP:
+		bits = float_bits(exp2f(a));
+		break;
+	case V3D_QPU_A_LOG:
+		bits = float_bits(log2f(a));
+		break;
+	case V3D_QPU_A_FFLOOR:
+		bits = float_bits(floorf(a));
+		break;
+	case V3D_QPU_A_FCEIL:
+		bits = float_bits(ceilf(a));
+		break;
+	case V3D_QPU_A_FTRUNC:
+		bits = float_bits(truncf(a));
+		break;
+	case V3D_QPU_A_FROUND:
+		bits = float_bits(rintf(a));
+		break;
+	case V3D_QPU_A_FTOIZ:
+		bits = (uint32_t)float_to_signed(a);
+		break;
+	case V3D_QPU_A_FTOUZ:
+		bits = float_to_unsigned(a);
+		break;
+	case V3D_QPU_A_ITOF:
+		bits = float_bits((float)(int32_t)left);
+		break;
+	case V3D_QPU_A_UTOF:
+		bits = float_bits((float)left);
+		break;
+	case V3D_QPU_A_EIDX:
+		bits = lane;
+		break;
+	case V3D_QPU_A_TIDX:
+		bits = batch->number % machine->setup->threads;
+		break;
+	case V3D_QPU_A_BARRIERID:
+		bits = batch->supergroup;
+		break;
+	case V3D_QPU_A_MSF:
+		/* Assumed: the multisample flags of a compute lane are set exactly when the CSD dispatched it. */
+		bits = 0;
+		if ((batch->dispatched & (1U << lane)) != 0)
+			bits = 0xfU;
+		break;
+	case V3D_QPU_A_TMUWT:
+		if (lane == 0)
+			tmu_wait(machine);
+		return 0;
+	case V3D_QPU_A_FCMP:
+		/* A float comparison pushes its own ordered flag. */
+		if (push == V3D_QPU_PF_PUSHZ)
+			*flag = truth(a == b);
+		else if (push == V3D_QPU_PF_PUSHN)
+			*flag = truth(a < b);
+		else if (push == V3D_QPU_PF_PUSHC)
+			*flag = truth(a <= b);
+		else
+			fail(machine, "comparison without a flag push");
+		*flags_set = true;
+		return 0;
+	default:
+		fprintf(stderr, "unmodeled add operation %s\n", v3d_qpu_add_op_name(instruction->alu.add.op));
+		fail(machine, "unmodeled add operation");
+	}
+
+	/* An integer push takes the zero, the sign or the carry of the computed bits. */
+	if (push == V3D_QPU_PF_NONE)
+		return bits;
+	*flags_set = true;
+	if (push == V3D_QPU_PF_PUSHZ) {
+		*flag = truth(bits == 0);
+	} else if (push == V3D_QPU_PF_PUSHN) {
+		*flag = truth((bits & 0x80000000U) != 0);
+	} else if (push == V3D_QPU_PF_PUSHC) {
+		/* Only the operations whose carry the compiler uses have one modeled. */
+		if (instruction->alu.add.op != V3D_QPU_A_SUB &&
+		    instruction->alu.add.op != V3D_QPU_A_ADD &&
+		    instruction->alu.add.op != V3D_QPU_A_MIN &&
+		    instruction->alu.add.op != V3D_QPU_A_UMIN)
+			fail(machine, "carry push of an operation without a modeled carry");
+		*flag = carry;
+	}
+	return bits;
+}
+
+/* Computes one multiply ALU operation on one lane. */
+static uint32_t
+mul_result(
+	struct machine *machine,
+	const struct v3d_qpu_instr *instruction,
+	uint32_t lane,
+	uint32_t left,
+	uint32_t right,
+	bool *flags_set,
+	uint32_t *flag)
+{
+	struct batch *batch;
+	uint32_t bits;
+	uint32_t low;
+
+	/* Multiplication, integer arithmetic and moves are the multiply operations used. */
+	batch = machine->current;
+	if (instruction->alu.mul.a.unpack != V3D_QPU_UNPACK_NONE || instruction->alu.mul.b.unpack != V3D_QPU_UNPACK_NONE)
+		fail(machine, "multiply input unpacking is not modeled");
+	switch (instruction->alu.mul.op) {
+	case V3D_QPU_M_FMUL:
+		bits = float_bits(bits_float(left) * bits_float(right));
+		break;
+	case V3D_QPU_M_MOV:
+		bits = left;
+		break;
+	case V3D_QPU_M_ADD:
+		bits = left + right;
+		break;
+	case V3D_QPU_M_SUB:
+		bits = left - right;
+		break;
+	case V3D_QPU_M_MULTOP:
+		/* The latch holds the part of the 32-bit product that the 24-bit multiply leaves out. */
+		low = (left & 0xffffffU) * (right & 0xffffffU);
+		batch->rtop[lane] = left * right - low;
+		if (lane == LANES - 1)
+			batch->rtop_valid = true;
+		return 0;
+	case V3D_QPU_M_UMUL24:
+	case V3D_QPU_M_UMUL24_RTOP0:
+		/* The 24-bit product plus the latched part; without a MULTOP the latch adds nothing. */
+		bits = (left & 0xffffffU) * (right & 0xffffffU);
+		if (batch->rtop_valid)
+			bits += batch->rtop[lane];
+		if (lane == LANES - 1)
+			batch->rtop_valid = false;
+		break;
+	default:
+		fprintf(stderr, "unmodeled multiply operation %s\n", v3d_qpu_mul_op_name(instruction->alu.mul.op));
+		fail(machine, "unmodeled multiply operation");
+		return 0;
+	}
+
+	/* A multiply ALU zero push follows its own result. */
+	if (instruction->flags.mpf != V3D_QPU_PF_NONE) {
+		if (instruction->flags.mpf != V3D_QPU_PF_PUSHZ)
+			fail(machine, "multiply flag push other than zero is not modeled");
+		*flags_set = true;
+		*flag = truth(bits == 0);
+	}
+	return bits;
+}
+
+/* Writes one ALU result to a register or a peripheral on the lanes of a mask. */
+static void
+write_destination(
+	struct machine *machine,
+	uint32_t address,
+	bool magic,
+	const uint32_t *lanes,
+	uint32_t mask,
+	uint32_t delay)
+{
+	struct batch *batch;
+	uint32_t lane;
+	uint32_t config;
+
+	/* A register write lands when the word ends, a special function's a word later; a write of no lane changes nothing. */
+	batch = machine->current;
+	if (!magic && mask == 0)
+		return;
+	if (!magic) {
+		write_resource(machine, address, lanes, mask, delay);
+		return;
+	}
+	if (delay != 0)
+		fail(machine, "special function result to a magic address");
+
+	/* The peripherals of a compute program. */
+	switch (address) {
+	case V3D_QPU_WADDR_NOP:
+		return;
+	case V3D_QPU_WADDR_TMUD:
+		tmu_data(machine, lanes, mask);
+		return;
+	case V3D_QPU_WADDR_TMUA:
+		tmu_address(machine, lanes, mask, 0xffffffffU);
+		return;
+	case V3D_QPU_WADDR_TMUAU:
+		config = next_uniform(machine);
+		tmu_address(machine, lanes, mask, config);
+		return;
+	case V3D_QPU_WADDR_UNIFA:
+		/* The window takes lane 0's address; every dispatched lane must agree, or the address is not uniform. */
+		if (mask != ALL_LANES)
+			fail(machine, "conditional unifa write");
+		for (lane = 1; lane < LANES; lane++) {
+			if ((batch->dispatched & (1U << lane)) == 0)
+				continue;
+			if (lanes[lane] != lanes[0])
+				fail(machine, "unifa address differs between lanes");
+		}
+		if ((lanes[0] & 3U) != 0)
+			fail(machine, "unifa address not word aligned");
+		batch->unifa_address = lanes[0];
+		batch->unifa_valid = true;
+		batch->unifa_time = batch->time;
+		return;
+	case V3D_QPU_WADDR_SYNCB:
+		/* The barrier: every lookup read and every store waited for first. */
+		if (batch->queue_count != 0 || batch->pending_stores != 0 || batch->sequence_open)
+			fail(machine, "barrier with TMU transactions outstanding");
+		if (batch->barrier_written)
+			fail(machine, "second barrier write before its switch");
+		if (mask != ALL_LANES)
+			fail(machine, "conditional barrier write");
+		batch->barrier_written = true;
+		return;
+	default:
+		break;
+	}
+
+	/* Any other peripheral is outside the compiler's vocabulary. */
+	fprintf(stderr, "unmodeled peripheral address %u\n", address);
+	fail(machine, "unmodeled peripheral write");
+}
+
+/* Adds one data word to the open TMU sequence on the lanes of a mask. */
+static void
+tmu_data(
+	struct machine *machine,
+	const uint32_t *lanes,
+	uint32_t mask)
+{
+	struct batch *batch;
+	uint32_t lane;
+
+	/* A sequence takes at most four data words per lane. */
+	batch = machine->current;
+	batch->sequence_open = true;
+	batch->sequence_writes++;
+	for (lane = 0; lane < LANES; lane++) {
+		if ((mask & (1U << lane)) == 0)
+			continue;
+		if (batch->data_count[lane] >= 4)
+			fail(machine, "more than four TMU data words in one sequence");
+		batch->data[lane][batch->data_count[lane]] = lanes[lane];
+		batch->data_count[lane]++;
+	}
+}
+
+/* Ends the open TMU sequence with its address: a store when it carries data, a load otherwise. */
+static void
+tmu_address(
+	struct machine *machine,
+	const uint32_t *lanes,
+	uint32_t mask,
+	uint32_t config)
+{
+	struct batch *batch;
+	struct lookup *lookup;
+	uint32_t words;
+	uint32_t lane;
+	uint32_t word;
+	uint32_t data_lanes;
+	uint32_t active;
+	uint32_t outstanding;
+	uint32_t index;
+	uint8_t *bytes;
+
+	/* The configuration names a regular per-pixel access of one to four words. */
+	batch = machine->current;
+	words = 1;
+	if (config != 0xffffffffU) {
+		if (config < MACHINE_CONFIG_VEC2 || config > MACHINE_CONFIG_VEC4)
+			fail(machine, "TMU configuration other than a regular per-pixel vector");
+		words = config - MACHINE_CONFIG_VEC2 + 2;
+	}
+
+	/* Assumed unknown: a conditional address write that enables no lane (the hardware's behaviour is not documented). */
+	if (mask == 0)
+		fail(machine, "conditional TMU address write with no lane enabled (hardware behaviour unknown)");
+
+	/* The sequence's writes fit the input FIFO of a thread. */
+	batch->sequence_writes++;
+	if (batch->sequence_writes > 16 / machine->setup->threads)
+		fail(machine, "TMU sequence exceeds the input FIFO of a thread");
+	batch->sequence_open = false;
+	batch->sequence_writes = 0;
+
+	/* The lanes that access memory: enabled by the predicate and dispatched (assumed: an undispatched lane does not access). */
+	active = mask & batch->dispatched;
+	data_lanes = 0;
+	for (lane = 0; lane < LANES; lane++) {
+		if (batch->data_count[lane] != 0)
+			data_lanes |= 1U << lane;
+	}
+
+	/* A store writes each active lane's data words. */
+	if (data_lanes != 0) {
+		for (lane = 0; lane < LANES; lane++) {
+			if ((active & (1U << lane)) == 0)
+				continue;
+			if (batch->data_count[lane] != words)
+				fail(machine, "TMU store data words differ from its configuration");
+			if ((lanes[lane] & 3U) != 0)
+				fail(machine, "TMU store address not word aligned");
+			bytes = memory_at(machine, lanes[lane], 4 * words, true);
+			memcpy(bytes, batch->data[lane], 4 * words);
+		}
+		memset(batch->data_count, 0, sizeof(batch->data_count));
+		batch->pending_stores++;
+		machine->result->stores++;
+		if (batch->queue_count + batch->pending_stores > MACHINE_TMU_QUEUE)
+			fail(machine, "more than eight TMU operations outstanding");
+		return;
+	}
+
+	/* A load: the output FIFO of a thread holds every unread word. */
+	if (mask != ALL_LANES)
+		fail(machine, "conditional TMU load (loads are unconditional and clamped)");
+	outstanding = words;
+	for (index = 0; index < batch->queue_count; index++) {
+		lookup = &batch->queue[(batch->queue_head + index) % MACHINE_TMU_QUEUE];
+		outstanding += lookup->words - lookup->read;
+	}
+	if (outstanding > 16 / machine->setup->threads)
+		fail(machine, "TMU lookups exceed the output FIFO of a thread");
+	if (batch->queue_count + batch->pending_stores + 1 > MACHINE_TMU_QUEUE)
+		fail(machine, "more than eight TMU operations outstanding");
+
+	/* Each active lane reads its words now; the others get poison. */
+	lookup = &batch->queue[(batch->queue_head + batch->queue_count) % MACHINE_TMU_QUEUE];
+	memset(lookup, 0, sizeof(*lookup));
+	lookup->words = words;
+	for (lane = 0; lane < LANES; lane++) {
+		for (word = 0; word < words; word++)
+			lookup->value[lane][word] = MACHINE_POISON;
+		if ((active & (1U << lane)) == 0)
+			continue;
+		if ((lanes[lane] & 3U) != 0)
+			fail(machine, "TMU load address not word aligned");
+		bytes = memory_at(machine, lanes[lane], 4 * words, false);
+		memcpy(lookup->value[lane], bytes, 4 * words);
+	}
+	batch->queue_count++;
+	machine->result->loads++;
+}
+
+/* Waits for every store of the thread. */
+static void
+tmu_wait(
+	struct machine *machine)
+{
+	/* The stores complete; the lookups are unaffected. */
+	if (machine->current->sequence_open)
+		fail(machine, "TMUWT inside a TMU sequence");
+	machine->current->pending_stores = 0;
+}
+
+/* Finds the host bytes of an access, which must lie in one buffer (and a writable one for a store). */
+static uint8_t *
+memory_at(
+	struct machine *machine,
+	uint32_t address,
+	uint32_t bytes,
+	bool write)
+{
+	const struct qpu71_compute_setup *setup;
+	struct qpu71_compute_region *region;
+	uint32_t index;
+
+	/* The first buffer that holds the whole access. */
+	setup = machine->setup;
+	for (index = 0; index < setup->region_count; index++) {
+		region = &setup->regions[index];
+		if (address < region->address)
+			continue;
+		if ((uint64_t)address + bytes > (uint64_t)region->address + region->size)
+			continue;
+		if (write && region->writable == 0)
+			fail(machine, "store into a read-only buffer");
+		return region->bytes + (address - region->address);
+	}
+
+	/* An access outside every buffer would reach another session's memory. */
+	fprintf(stderr, "qpu compute machine: access of %u bytes at 0x%08x\n", bytes, address);
+	fail(machine, "memory access outside every buffer");
+	return NULL;
+}
+
+/* Reads the next word of the uniform stream. */
+static uint32_t
+next_uniform(
+	struct machine *machine)
+{
+	struct batch *batch;
+
+	/* A read beyond the stream would take whatever memory follows it. */
+	batch = machine->current;
+	if (batch->uniform_index >= machine->setup->uniform_count)
+		fail(machine, "uniform stream read beyond its end");
+	batch->uniform_index++;
+	if (batch->uniform_index > machine->result->uniforms_read)
+		machine->result->uniforms_read = batch->uniform_index;
+	return machine->setup->uniforms[batch->uniform_index - 1];
+}
+
+/* Reports a broken rule with the batch and word it happened at and stops. */
+static void
+fail(
+	const struct machine *machine,
+	const char *reason)
+{
+	const struct batch *batch;
+
+	/* The batch and the word index name where the program broke the rule. */
+	batch = machine->current;
+	if (batch == NULL) {
+		fprintf(stderr, "qpu compute machine: %s\n", reason);
+		abort();
+	}
+	fprintf(stderr, "qpu compute machine: batch %u word %u (time %u): %s\n", batch->number, batch->pc, batch->time, reason);
+	if (batch->pc < machine->setup->code_count)
+		fprintf(stderr, "qpu compute machine: word bits %016llx\n", (unsigned long long)machine->setup->code[batch->pc]);
+	abort();
+}
+
+/* Converts a float to its bits. */
+static uint32_t
+float_bits(
+	float number)
+{
+	uint32_t bits;
+
+	/* A copy avoids aliasing assumptions. */
+	memcpy(&bits, &number, sizeof(bits));
+	return bits;
+}
+
+/* Converts bits to a float. */
+static float
+bits_float(
+	uint32_t bits)
+{
+	float number;
+
+	/* A copy avoids aliasing assumptions. */
+	memcpy(&number, &bits, sizeof(number));
+	return number;
+}
+
+/* Builds an all-ones or zero lane value. */
+static uint32_t
+truth(
+	bool condition)
+{
+	/* True is all ones, as the flags and Boolean values hold it. */
+	if (condition)
+		return 0xffffffffU;
+	return 0;
+}
+
+/* Converts a float to a signed integer, saturating and taking NaN to zero. */
+static int32_t
+float_to_signed(
+	float number)
+{
+	/* Out-of-range values saturate; NaN compares unequal to itself. */
+	if (number != number)
+		return 0;
+	if (number >= 2147483648.0f)
+		return 2147483647;
+	if (number < -2147483648.0f)
+		return (int32_t)0x80000000U;
+	return (int32_t)number;
+}
+
+/* Converts a float to an unsigned integer, saturating and taking NaN to zero. */
+static uint32_t
+float_to_unsigned(
+	float number)
+{
+	/* Out-of-range values saturate; NaN compares unequal to itself. */
+	if (number != number || number <= 0.0f)
+		return 0;
+	if (number >= 4294967296.0f)
+		return 0xffffffffU;
+	return (uint32_t)number;
+}
diff --git a/plan/ws283/tests/qpu71-compute-machine.h b/plan/ws283/tests/qpu71-compute-machine.h
new file mode 100644
index 0000000000..34d745c8bf
--- /dev/null
+++ b/plan/ws283/tests/qpu71-compute-machine.h
@@ -0,0 +1,95 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * Host model of a V3D 7.1 compute dispatch: every batch of sixteen lanes of
+ * one CSD job, run as QPU threads that take turns at their thread switches.
+ *
+ * The words are read with the unmodified MIT Mesa decoder.  The model
+ * builds each lane's payload the way the CSD does (workgroup ids in rf3,
+ * the z id, the workgroup's memory slot and the local invocation index in
+ * rf2), runs the sixteen lanes of a batch in lockstep with per-lane
+ * predication and lane flags, and keeps the timing of the lane model of the
+ * graphics compiler (sources read when a word starts, results land when it
+ * ends, a special function's a word later).  It adds what a compute
+ * program uses: relative branches with their three delay words and the
+ * all/any lane conditions (ignoring the lanes the CSD did not dispatch),
+ * the uniform stream moved by a branch, general TMU loads and stores with
+ * their FIFO limits against a list of buffers (an access outside every
+ * buffer is a failure), the TMU write wait, the uniform address window
+ * (unifa and ldunifa), the integer multiply's latched top half and the
+ * workgroup barrier of a supergroup (a batch that never reaches it while
+ * the others wait is a deadlock and a failure).
+ *
+ * The behaviour the model assumes and the hardware may not have is marked
+ * where it is decided: a lane the CSD did not dispatch neither loads nor
+ * stores, the memory slot of a workgroup is its index in the job modulo
+ * the slot field's range, and a conditional TMU address write with no lane
+ * enabled is a failure (the hardware's behaviour is not documented).  It is
+ * a test model, not a cycle model.
+ */
+#ifndef WS283_QPU71_COMPUTE_MACHINE_H
+#define WS283_QPU71_COMPUTE_MACHINE_H
+
+#include <stdint.h>
+
+#include "broadcom/common/v3d_device_info.h"
+#include "broadcom/qpu/qpu_instr.h"
+
+/* The lanes of one batch. */
+#define QPU71_COMPUTE_LANES 16U
+
+/* One buffer the program may read, and write when writable; the bytes are the host's copy. */
+struct qpu71_compute_region {
+	uint32_t address;
+	uint32_t size;
+	uint8_t *bytes;
+	uint32_t writable;
+};
+
+/* What one CSD job supplies. */
+struct qpu71_compute_setup {
+	const uint64_t *code;
+	uint32_t code_count;
+	/* The uniform stream, the same for every batch (CFG6 names one stream). */
+	const uint32_t *uniforms;
+	uint32_t uniform_count;
+	struct qpu71_compute_region *regions;
+	uint32_t region_count;
+	/* The workgroup size and the number of workgroups in each dimension. */
+	uint32_t local_size[3];
+	uint32_t groups[3];
+	/* Workgroups per supergroup (CFG3), at least one and at most sixteen. */
+	uint32_t workgroups_per_supergroup;
+	/* Two or four threads per QPU: four leave a thread rf0 to rf31 and halve the TMU FIFOs. */
+	uint32_t threads;
+	/* Set when the program has no marked last switch, so its first switch ends the thread (CFG5 SINGLE_SEG). */
+	uint32_t single_segment;
+	/* Fills every register before the program runs, so a read of an unwritten one is visible. */
+	uint32_t garbage_seed;
+};
+
+/* What one job produced. */
+struct qpu71_compute_result {
+	uint32_t batches;
+	uint32_t supergroups;
+	uint32_t words;
+	uint32_t loads;
+	uint32_t stores;
+	uint32_t barriers;
+	uint32_t branches_taken;
+	/* The largest number of uniforms one batch consumed. */
+	uint32_t uniforms_read;
+};
+
+/* Runs every batch of one job; a broken rule prints the batch and word and stops the test. */
+void qpu71_compute_run(const struct v3d_device_info *device, const struct qpu71_compute_setup *setup, struct qpu71_compute_result *result);
+
+/* Tells the payload b of a workgroup size: log2 of the next power of two of max(size, 64). */
+uint32_t qpu71_compute_index_bits(uint32_t workgroup_size);
+
+#endif
diff --git a/plan/ws283/tests/qpu71-format-host-test.c b/plan/ws283/tests/qpu71-format-host-test.c
new file mode 100644
index 0000000000..467d330b38
--- /dev/null
+++ b/plan/ws283/tests/qpu71-format-host-test.c
@@ -0,0 +1,774 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The V3D 7.1 instruction encoder (qpu71.c) checked against the unmodified MIT Mesa packer and decoder (ws279-p004).
+ *
+ * Every semantic operation is encoded, decoded by Mesa's 7.1 decoder, and
+ * compared with the expected Mesa operation, read addresses and write
+ * address; Mesa's packer must rebuild the same word, both from the decoded
+ * instruction and from an instruction built here from the semantic
+ * description alone.  The refused combinations of the 7.1 word are checked
+ * too.
+ */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <uapi/errno.h>
+
+#include "drivers/gpu/bcm2711/compiler/qpu.h"
+#include "broadcom/common/v3d_device_info.h"
+#include "broadcom/qpu/qpu_instr.h"
+
+/* One semantic operation, the Mesa operation it must decode as on each ALU, and its input unpack. */
+struct expected_operation {
+	enum bcm2711_qpu_operation native;
+	enum v3d_qpu_add_op add;
+	enum v3d_qpu_mul_op multiply;
+	enum v3d_qpu_input_unpack unpack;
+};
+
+/*
+ * The operation vocabulary as Mesa names it on V3D 7.1.
+ *
+ * An operation with no form on one ALU names that ALU's no-operation.
+ */
+static const struct expected_operation expected_operations[] = {
+	{BCM2711_QPU_MOVE, V3D_QPU_A_MOV, V3D_QPU_M_MOV, V3D_QPU_UNPACK_NONE},
