 		return 0;
 	case BCM2711_QPU_MOVE:
 	case BCM2711_QPU_HALF_LOW:
@@ -577,6 +583,21 @@ operation_fields(
 		alu->operation = 187;
 		alu->left = 2;
 		break;
+	case BCM2711_QPU_THREAD_INDEX:
+		alu->operation = 187;
+		alu->left = 1;
+		break;
+	case BCM2711_QPU_BARRIER_ID:
+		alu->operation = 187;
+		alu->left = 4;
+		alu->right = 2;
+		break;
+	case BCM2711_QPU_MULTIPLY_TOP:
+		alu->operation = 10;
+		break;
+	case BCM2711_QPU_MULTIPLY_24:
+		alu->operation = 3;
+		break;
 	default:
 		return ENOTSUP;
 	}
