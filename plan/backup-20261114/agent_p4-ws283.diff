diff --git a/plan/ws283/tests/graphics-regression-host-test.sh b/plan/ws283/tests/graphics-regression-host-test.sh
new file mode 100644
index 0000000000..2cd81705ad
--- /dev/null
+++ b/plan/ws283/tests/graphics-regression-host-test.sh
@@ -0,0 +1,33 @@
+#!/bin/sh
+# HT5: the graphics regression of both V3D shader compilers after the compute changes.  Runs, against the
+# unmodified MIT Mesa 26.2.6 oracle: the 4.2 encoder format test and the 4.2 shader test of plan/tools/v3d-qpu,
+# and the 7.1 encoder format test and the 7.1 shader test (the WS279 tests, kept here while the compute work
+# changes the 7.1 compiler).
+# Usage: sh plan/ws283/tests/graphics-regression-host-test.sh [output-directory]
+set -eu
+out=${1:-build/ws283-graphics-host}
+sh plan/ws283/tests/mesa-oracle.sh "$out"
+mesa=$out/mesa-26.2.6/src
+flags="-std=c99 -Wall -Wextra -Werror -Iinclude -Isrc -I. -I$out/mesa-host -I$mesa"
+compiler=src/drivers/gpu/bcm2711/compiler
+cc $flags plan/tools/v3d-qpu/qpu-format-host-test.c $compiler/qpu.c \
+    "$out/mesa-pack.o" "$out/mesa-instr.o" -o "$out/qpu-format-host-test"
+"$out/qpu-format-host-test"
+cc -O1 $flags plan/tools/v3d-qpu/shader-host-test.c plan/tools/v3d-qpu/qpu-machine.c \
+    src/drivers/gpu/compiler/spirv.c src/drivers/gpu/compiler/optimize.c \
+    $compiler/shader.c $compiler/shader-analyze.c $compiler/shader-lower.c $compiler/shader-output.c \
+    $compiler/shader-schedule.c $compiler/qpu.c $compiler/qpu-branch.c \
+    "$out/mesa-pack.o" "$out/mesa-instr.o" -lm -o "$out/shader-host-test"
+timeout 600 "$out/shader-host-test" > "$out/shader-host-test.out"
+tail -1 "$out/shader-host-test.out"
+cc $flags plan/ws283/tests/qpu71-format-host-test.c $compiler/qpu71.c \
+    "$out/mesa-pack.o" "$out/mesa-instr.o" -o "$out/qpu71-format-host-test"
+"$out/qpu71-format-host-test"
+cc -O1 $flags plan/ws283/tests/shader71-host-test.c plan/ws279/tests/qpu71-machine.c \
+    src/drivers/gpu/compiler/spirv.c src/drivers/gpu/compiler/optimize.c \
+    $compiler/shader.c $compiler/shader-analyze.c $compiler/shader71-lower.c $compiler/shader71-output.c \
+    $compiler/shader71-schedule.c $compiler/shader-compute.c $compiler/qpu71.c $compiler/qpu-branch.c \
+    "$out/mesa-pack.o" "$out/mesa-instr.o" -lm -o "$out/shader71-host-test"
+timeout 600 "$out/shader71-host-test" > "$out/shader71-host-test.out"
+tail -1 "$out/shader71-host-test.out"
+echo "graphics-regression-host-test PASS"
diff --git a/plan/ws283/tests/mesa-oracle.sh b/plan/ws283/tests/mesa-oracle.sh
new file mode 100644
index 0000000000..9e8b9f5eef
--- /dev/null
+++ b/plan/ws283/tests/mesa-oracle.sh
@@ -0,0 +1,45 @@
+#!/bin/sh
+# Builds the unmodified MIT Mesa 26.2.6 V3D packer and decoder objects that the WS283 host tests use as their
+# oracle.  The pinned release tarball is checked, its src/broadcom is unpacked into the output directory, and
+# minimal standard helper declarations replace the build-system-only Mesa util headers.
+# Usage: sh plan/ws283/tests/mesa-oracle.sh <output-directory> [tarball]
+# Prints nothing on success; the objects are <output>/mesa-pack.o and <output>/mesa-instr.o, the include roots
+# <output>/mesa-host and <output>/mesa-26.2.6/src.
+set -eu
+out=$1
+tarball=${2:-${MESA_TARBALL:-/home/awe/zedBSD-claude1/build/distfiles/mesa-26.2.6.tar.xz}}
+mkdir -p "$out/mesa-host/util"
+echo "b9436b3e1a8be76fbd4823dc884f90596ab7c6ac5e1867a305e66ffccfb31a92  $tarball" | sha256sum -c --quiet
+if [ ! -f "$out/mesa-26.2.6/src/broadcom/qpu/qpu_pack.c" ]; then
+    tar -xJf "$tarball" -C "$out" --wildcards 'mesa-26.2.6/src/broadcom/*'
+fi
+mesa=$out/mesa-26.2.6/src
+cat > "$out/mesa-host/util/macros.h" <<'HEADER'
+#ifndef WS283_MESA_HOST_MACROS_H
+#define WS283_MESA_HOST_MACROS_H
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define STATIC_ASSERT(e) _Static_assert(e, #e)
+#define BITFIELD64_BIT(n) (UINT64_C(1) << (n))
+#define BITFIELD64_RANGE(b,n) (((n) == 64 ? UINT64_MAX : ((UINT64_C(1) << (n)) - 1)) << (b))
+#define UNREACHABLE(reason) abort()
+#define ATTRIBUTE_CONST __attribute__((const))
+#define ATTRIBUTE_PURE __attribute__((pure))
+#endif
+HEADER
+cat > "$out/mesa-host/util/bitscan.h" <<'HEADER'
+#ifndef WS283_MESA_HOST_BITSCAN_H
+#define WS283_MESA_HOST_BITSCAN_H
+#include <strings.h>
+#endif
+HEADER
+sha256sum -c --quiet <<HASHES
+fb2c4077517fdbecd0d076721df14aaf88b5f374dfb702de073da922242a848b  $mesa/broadcom/qpu/qpu_pack.c
+125761b56819085278c6685fc8b664b944e07cf563834e18de1ccbdbedf0cd9b  $mesa/broadcom/qpu/qpu_instr.h
+2c631bd8a936fba5a5d607e7d526604e1691c99295d08ed0948f981e41ee85f6  $mesa/broadcom/qpu/qpu_instr.c
+fe2e5f19c4d3310d6002f5478ecaf0c259b051113723835649060cbfc7c57973  $mesa/broadcom/common/v3d_device_info.h
+HASHES
+cc -std=gnu11 -Wall -Werror -I"$out/mesa-host" -I"$mesa" -c "$mesa/broadcom/qpu/qpu_pack.c" -o "$out/mesa-pack.o"
+cc -std=gnu11 -Wall -Werror -I"$out/mesa-host" -I"$mesa" -c "$mesa/broadcom/qpu/qpu_instr.c" -o "$out/mesa-instr.o"
diff --git a/plan/ws283/tests/qpu-compute-format-host-test.c b/plan/ws283/tests/qpu-compute-format-host-test.c
new file mode 100644
index 0000000000..9ae2ce973f
--- /dev/null
+++ b/plan/ws283/tests/qpu-compute-format-host-test.c
@@ -0,0 +1,450 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The compute additions of the V3D instruction encoders checked against the
+ * unmodified MIT Mesa packer and decoder.
+ *
+ * The test is built twice: with qpu.c for V3D 4.2 (QPU_TEST_VERSION 42) and
+ * with qpu71.c for V3D 7.1 (QPU_TEST_VERSION 71), both with qpu-branch.c.
+ * Each new operation (thread index, barrier identity, the two halves of the
+ * integer multiply) and every branch form is encoded, decoded by Mesa,
+ * compared field by field with the expected Mesa instruction, and packed
+ * again by Mesa into the same word.  The writes a compute shader makes to
+ * the unifa, TMU and barrier magic addresses and the uniform address load
+ * are checked the same way.
+ */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <uapi/errno.h>
+
+#include "drivers/gpu/bcm2711/compiler/qpu.h"
+#include "broadcom/common/v3d_device_info.h"
+#include "broadcom/qpu/qpu_instr.h"
+
+#ifndef QPU_TEST_VERSION
+#error "QPU_TEST_VERSION must be 42 or 71"
+#endif
+
+/* The magic write addresses a compute shader uses (Mesa qpu_instr.h, the same numbers on 4.2 and 7.1). */
+#define MAGIC_UNIFA 9
+#define MAGIC_TMUD 11
+#define MAGIC_TMUA 12
+#define MAGIC_TMUAU 13
+#define MAGIC_SYNCB 18
+#define MAGIC_DISCARD 6
+
+static void check_word(const struct v3d_device_info *device, uint64_t word, struct v3d_qpu_instr *decoded);
+static void check_add_operation(const struct v3d_device_info *device, enum bcm2711_qpu_operation operation, enum v3d_qpu_add_op expected, uint32_t magic, uint32_t destination);
+static void check_multiply(const struct v3d_device_info *device);
+static void check_magic_writes(const struct v3d_device_info *device);
+static void check_branches(const struct v3d_device_info *device);
+static void check_branch(const struct v3d_device_info *device, enum bcm2711_qpu_branch_condition condition, enum v3d_qpu_branch_cond expected, enum bcm2711_qpu_branch_ignore ignore, int32_t words, uint32_t uniform_relative);
+static void check_refusals(void);
+static uint32_t register_read(const struct v3d_qpu_instr *decoded, uint32_t multiply, uint32_t right);
+
+/*
+ * Verifies the compute operations, the magic writes and the branch word on one version.
+ */
+int
+main(
+	void)
+{
+	struct v3d_device_info device;
+
+	/* The oracle is the fixed decoder and packer of the version under test. */
+	memset(&device, 0, sizeof(device));
+	device.ver = QPU_TEST_VERSION;
+	device.rev = 0;
+	device.has_accumulators = true;
+	if (QPU_TEST_VERSION == 71) {
+		device.rev = 10;
+		device.has_accumulators = false;
+	}
+
+	/* The thread index and the barrier identity are add ALU operations without inputs. */
+	check_add_operation(&device, BCM2711_QPU_THREAD_INDEX, V3D_QPU_A_TIDX, 0, 5);
+	check_add_operation(&device, BCM2711_QPU_BARRIER_ID, V3D_QPU_A_BARRIERID, 1, MAGIC_SYNCB);
+
+	/* The TMU write wait keeps its form beside them. */
+	check_add_operation(&device, BCM2711_QPU_TEXTURE_WAIT, V3D_QPU_A_TMUWT, 1, MAGIC_DISCARD);
+
+	/* The integer multiply, the magic writes, the branch and the refusals. */
+	check_multiply(&device);
+	check_magic_writes(&device);
+	check_branches(&device);
+	check_refusals();
+
+	/* Succeeded: the pinned MIT encoder and decoder agree with the independent production words. */
+	printf("qpu-compute-format-host-test %d PASS\n", QPU_TEST_VERSION);
+	return 0;
+}
+
+/* Decodes one word with Mesa and requires Mesa to pack the decoded instruction into the same word. */
+static void
+check_word(
+	const struct v3d_device_info *device,
+	uint64_t word,
+	struct v3d_qpu_instr *decoded)
+{
+	uint64_t repacked;
+	bool unpacked;
+	bool packed;
+
+	/* The decoder must recognise the word. */
+	memset(decoded, 0, sizeof(*decoded));
+	unpacked = v3d_qpu_instr_unpack(device, word, decoded);
+	if (!unpacked)
+		fprintf(stderr, "unpack failed: %016llx\n", (unsigned long long)word);
+	assert(unpacked);
+
+	/* The packer must rebuild the identical word from the decoded instruction. */
+	repacked = 0;
+	packed = v3d_qpu_instr_pack(device, decoded, &repacked);
+	assert(packed);
+	if (repacked != word)
+		fprintf(stderr, "repack differs: %016llx %016llx\n", (unsigned long long)word, (unsigned long long)repacked);
+	assert(repacked == word);
+}
+
+/* Checks one input-less add ALU operation written to a register or a magic address. */
+static void
+check_add_operation(
+	const struct v3d_device_info *device,
+	enum bcm2711_qpu_operation operation,
+	enum v3d_qpu_add_op expected,
+	uint32_t magic,
+	uint32_t destination)
+{
+	struct bcm2711_qpu_instruction instruction;
+	struct v3d_qpu_instr decoded;
+	uint64_t word;
+	int error;
+
+	/* The operation runs on the add ALU and reads nothing. */
+	assert(bcm2711_qpu_operation_unit(operation) == BCM2711_QPU_UNIT_ADD);
+	assert(bcm2711_qpu_operation_sources(operation) == 0);
+
+	/* The word carries the operation alone. */
+	memset(&instruction, 0, sizeof(instruction));
+	instruction.operation = operation;
+	instruction.destination.number = destination;
+	instruction.destination.peripheral = magic;
+	error = bcm2711_qpu_encode(&instruction, &word);
+	assert(error == 0);
+
+	/* Mesa decodes the operation, its destination and an idle multiply ALU. */
+	check_word(device, word, &decoded);
+	assert(decoded.type == V3D_QPU_INSTR_TYPE_ALU);
+	assert(decoded.alu.add.op == expected);
+	assert(decoded.alu.add.waddr == destination);
+	assert(decoded.alu.add.magic_write == (magic != 0));
+	assert(decoded.alu.mul.op == V3D_QPU_M_NOP);
+}
+
+/*
+ * Checks the two halves of the 32-bit integer multiply on the multiply ALU,
+ * alone and beside an add ALU operation.
+ */
+static void
+check_multiply(
+	const struct v3d_device_info *device)
+{
+	struct bcm2711_qpu_instruction instruction;
+	struct bcm2711_qpu_bundle bundle;
+	struct v3d_qpu_instr decoded;
+	uint64_t word;
+	int error;
+
+	/* Both halves run only on the multiply ALU and read two inputs. */
+	assert(bcm2711_qpu_operation_unit(BCM2711_QPU_MULTIPLY_TOP) == BCM2711_QPU_UNIT_MULTIPLY);
+	assert(bcm2711_qpu_operation_unit(BCM2711_QPU_MULTIPLY_24) == BCM2711_QPU_UNIT_MULTIPLY);
+	assert(bcm2711_qpu_operation_sources(BCM2711_QPU_MULTIPLY_TOP) == 2);
+	assert(bcm2711_qpu_operation_sources(BCM2711_QPU_MULTIPLY_24) == 2);
+
+	/* The top half writes nothing; its result goes to the latch the low half reads. */
+	memset(&instruction, 0, sizeof(instruction));
+	instruction.operation = BCM2711_QPU_MULTIPLY_TOP;
+	instruction.destination.number = MAGIC_DISCARD;
+	instruction.destination.peripheral = 1;
+	instruction.left.kind = BCM2711_QPU_REGISTER;
+	instruction.left.number = 7;
+	instruction.right.kind = BCM2711_QPU_REGISTER;
+	instruction.right.number = 9;
+	error = bcm2711_qpu_encode(&instruction, &word);
+	assert(error == 0);
+	check_word(device, word, &decoded);
+	assert(decoded.alu.mul.op == V3D_QPU_M_MULTOP);
+	assert(decoded.alu.add.op == V3D_QPU_A_NOP);
+	assert(register_read(&decoded, 1, 0) == 7);
+	assert(register_read(&decoded, 1, 1) == 9);
+
+	/* The low half writes the product to a register. */
+	instruction.operation = BCM2711_QPU_MULTIPLY_24;
+	instruction.destination.number = 12;
+	instruction.destination.peripheral = 0;
+	error = bcm2711_qpu_encode(&instruction, &word);
+	assert(error == 0);
+	check_word(device, word, &decoded);
+	assert(decoded.alu.mul.op == V3D_QPU_M_UMUL24);
+	assert(decoded.alu.mul.waddr == 12);
+	assert(!decoded.alu.mul.magic_write);
+	assert(register_read(&decoded, 1, 0) == 7);
+	assert(register_read(&decoded, 1, 1) == 9);
+
+	/* The low half may share its word with an add ALU operation reading the same registers and a small constant. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.multiply = instruction;
+	bundle.add.operation = BCM2711_QPU_INTEGER_ADD;
+	bundle.add.destination.number = 13;
+	bundle.add.left.kind = BCM2711_QPU_REGISTER;
+	bundle.add.left.number = 7;
+	bundle.add.right.kind = BCM2711_QPU_CONSTANT;
+	bundle.add.right.number = 4;
+	if (QPU_TEST_VERSION == 42) {
+		/* On 4.2 the word's two read ports already hold both registers; the constant would need a third. */
+		error = bcm2711_qpu_encode_bundle(&bundle, &word);
+		assert(error == ENOTSUP);
+		bundle.add.left.number = 9;
+		bundle.add.right.kind = BCM2711_QPU_REGISTER;
+		bundle.add.right.number = 7;
+	}
+	error = bcm2711_qpu_encode_bundle(&bundle, &word);
+	assert(error == 0);
+	check_word(device, word, &decoded);
+	assert(decoded.alu.mul.op == V3D_QPU_M_UMUL24);
+	assert(decoded.alu.add.op == V3D_QPU_A_ADD);
+	assert(decoded.alu.add.waddr == 13);
+}
+
+/*
+ * Checks the magic writes of a compute shader: the unifa address, the TMU
+ * data, address and configured address, and the uniform address load.
+ */
+static void
+check_magic_writes(
+	const struct v3d_device_info *device)
+{
+	static const uint32_t addresses[] = {MAGIC_UNIFA, MAGIC_TMUD, MAGIC_TMUA, MAGIC_TMUAU, MAGIC_SYNCB};
+	struct bcm2711_qpu_instruction instruction;
+	struct v3d_qpu_instr decoded;
+	uint64_t word;
+	uint32_t index;
+	int error;
+
+	/* Each address takes a move of a register on the multiply ALU (the semantic encoder's choice for a move). */
+	for (index = 0; index < sizeof(addresses) / sizeof(addresses[0]); index++) {
+		memset(&instruction, 0, sizeof(instruction));
+		instruction.operation = BCM2711_QPU_MOVE;
+		instruction.destination.number = addresses[index];
+		instruction.destination.peripheral = 1;
+		instruction.left.kind = BCM2711_QPU_REGISTER;
+		instruction.left.number = 20;
+		error = bcm2711_qpu_encode(&instruction, &word);
+		assert(error == 0);
+		check_word(device, word, &decoded);
+		if (QPU_TEST_VERSION == 71) {
+			/* 7.1 has the move on the add ALU first. */
+			assert(decoded.alu.add.op == V3D_QPU_A_MOV);
+			assert(decoded.alu.add.waddr == addresses[index]);
+			assert(decoded.alu.add.magic_write);
+		} else {
+			/* 4.2 has it on the multiply ALU. */
+			assert(decoded.alu.mul.op == V3D_QPU_M_MOV);
+			assert(decoded.alu.mul.waddr == addresses[index]);
+			assert(decoded.alu.mul.magic_write);
+		}
+	}
+
+	/* The uniform address load writes its word to rf0 on 7.1 and to r5 on 4.2, with no destination field. */
+	memset(&instruction, 0, sizeof(instruction));
+	instruction.signal = BCM2711_QPU_SIGNAL_UNIFORM_ADDRESS;
+	error = bcm2711_qpu_encode(&instruction, &word);
+	assert(error == 0);
+	check_word(device, word, &decoded);
+	assert(decoded.sig.ldunifa);
+
+	/* Its register-destination form names the register in the conditions field. */
+	instruction.signal = BCM2711_QPU_SIGNAL_UNIFORM_ADDRESS_REGISTER;
+	instruction.signal_destination.number = 30;
+	error = bcm2711_qpu_encode(&instruction, &word);
+	assert(error == 0);
+	check_word(device, word, &decoded);
+	assert(decoded.sig.ldunifarf);
+	assert(decoded.sig_addr == 30);
+	assert(!decoded.sig_magic);
+}
+
+/* Checks every branch condition, the three ignore modes, forward and backward targets and the uniform update. */
+static void
+check_branches(
+	const struct v3d_device_info *device)
+{
+	/* Each condition with a forward target ignoring the P lanes, as a compute shader's branches do. */
+	check_branch(device, BCM2711_QPU_BRANCH_ALWAYS, V3D_QPU_BRANCH_COND_ALWAYS, BCM2711_QPU_BRANCH_IGNORE_NONE, 0, 0);
+	check_branch(device, BCM2711_QPU_BRANCH_LANE0_A, V3D_QPU_BRANCH_COND_A0, BCM2711_QPU_BRANCH_IGNORE_P, 5, 0);
+	check_branch(device, BCM2711_QPU_BRANCH_LANE0_NOT_A, V3D_QPU_BRANCH_COND_NA0, BCM2711_QPU_BRANCH_IGNORE_P, 6, 0);
+	check_branch(device, BCM2711_QPU_BRANCH_ALL_A, V3D_QPU_BRANCH_COND_ALLA, BCM2711_QPU_BRANCH_IGNORE_P, 7, 0);
+	check_branch(device, BCM2711_QPU_BRANCH_ANY_NOT_A, V3D_QPU_BRANCH_COND_ANYNA, BCM2711_QPU_BRANCH_IGNORE_Q, 8, 0);
+	check_branch(device, BCM2711_QPU_BRANCH_ANY_A, V3D_QPU_BRANCH_COND_ANYA, BCM2711_QPU_BRANCH_IGNORE_P, 9, 0);
+	check_branch(device, BCM2711_QPU_BRANCH_ALL_NOT_A, V3D_QPU_BRANCH_COND_ALLNA, BCM2711_QPU_BRANCH_IGNORE_P, 10, 0);
+
+	/* A loop's backward branch moves the uniform stream back with it. */
+	check_branch(device, BCM2711_QPU_BRANCH_ANY_A, V3D_QPU_BRANCH_COND_ANYA, BCM2711_QPU_BRANCH_IGNORE_P, -12, 1);
+	check_branch(device, BCM2711_QPU_BRANCH_ANY_A, V3D_QPU_BRANCH_COND_ANYA, BCM2711_QPU_BRANCH_IGNORE_P, -1, 1);
+
+	/* Distances that use the high offset field, both ways, and the extremes. */
+	check_branch(device, BCM2711_QPU_BRANCH_ALL_NOT_A, V3D_QPU_BRANCH_COND_ALLNA, BCM2711_QPU_BRANCH_IGNORE_P, 0x00300001, 0);
+	check_branch(device, BCM2711_QPU_BRANCH_ALL_NOT_A, V3D_QPU_BRANCH_COND_ALLNA, BCM2711_QPU_BRANCH_IGNORE_P, -0x00300001, 1);
+	check_branch(device, BCM2711_QPU_BRANCH_ALWAYS, V3D_QPU_BRANCH_COND_ALWAYS, BCM2711_QPU_BRANCH_IGNORE_NONE, 0x0fffffff, 0);
+	check_branch(device, BCM2711_QPU_BRANCH_ALWAYS, V3D_QPU_BRANCH_COND_ALWAYS, BCM2711_QPU_BRANCH_IGNORE_NONE, -0x0fffffff, 0);
+}
+
+/* Checks one branch word against Mesa's decoder and against Mesa's packing of the same branch. */
+static void
+check_branch(
+	const struct v3d_device_info *device,
+	enum bcm2711_qpu_branch_condition condition,
+	enum v3d_qpu_branch_cond expected,
+	enum bcm2711_qpu_branch_ignore ignore,
+	int32_t words,
+	uint32_t uniform_relative)
+{
+	struct bcm2711_qpu_branch branch;
+	struct v3d_qpu_instr decoded;
+	struct v3d_qpu_instr mesa;
+	uint64_t word;
+	uint64_t mesa_word;
+	bool packed;
+	int error;
+
+	/* The production word. */
+	memset(&branch, 0, sizeof(branch));
+	branch.condition = condition;
+	branch.ignore = ignore;
+	branch.words = words;
+	branch.uniform_relative = uniform_relative;
+	error = bcm2711_qpu_encode_branch(&branch, &word);
+	assert(error == 0);
+
+	/* Mesa decodes the condition, the ignore mode, the relative target and the uniform update. */
+	check_word(device, word, &decoded);
+	assert(decoded.type == V3D_QPU_INSTR_TYPE_BRANCH);
+	assert(decoded.branch.cond == expected);
+	assert((uint32_t)decoded.branch.msfign == (uint32_t)ignore);
+	assert(decoded.branch.bdi == V3D_QPU_BRANCH_DEST_REL);
+	assert(decoded.branch.offset == (uint32_t)words * 8U);
+	assert(decoded.branch.ub == (uniform_relative != 0));
+	if (uniform_relative != 0)
+		assert(decoded.branch.bdu == V3D_QPU_BRANCH_DEST_REL);
+
+	/* Mesa packs the same branch, built from the description alone, into the same word. */
+	memset(&mesa, 0, sizeof(mesa));
+	mesa.type = V3D_QPU_INSTR_TYPE_BRANCH;
+	mesa.branch.cond = expected;
+	mesa.branch.msfign = (enum v3d_qpu_msfign)ignore;
+	mesa.branch.bdi = V3D_QPU_BRANCH_DEST_REL;
+	mesa.branch.ub = uniform_relative != 0;
+	mesa.branch.bdu = V3D_QPU_BRANCH_DEST_ABS;
+	if (uniform_relative != 0)
+		mesa.branch.bdu = V3D_QPU_BRANCH_DEST_REL;
+	mesa.branch.offset = (uint32_t)words * 8U;
+	mesa_word = 0;
+	packed = v3d_qpu_instr_pack(device, &mesa, &mesa_word);
+	assert(packed);
+	if (mesa_word != word)
+		fprintf(stderr, "branch differs: %016llx %016llx\n", (unsigned long long)word, (unsigned long long)mesa_word);
+	assert(mesa_word == word);
+}
+
+/* Checks that malformed branches and misplaced compute operations are refused without writing the word. */
+static void
+check_refusals(
+	void)
+{
+	struct bcm2711_qpu_branch branch;
+	struct bcm2711_qpu_bundle bundle;
+	uint64_t word;
+	int error;
+
+	/* A distance whose byte offset leaves the signed 32-bit range. */
+	memset(&branch, 0, sizeof(branch));
+	word = 0x1234;
+	branch.words = 0x10000000;
+	error = bcm2711_qpu_encode_branch(&branch, &word);
+	assert(error == EINVAL);
+	branch.words = -0x10000000;
+	error = bcm2711_qpu_encode_branch(&branch, &word);
+	assert(error == EINVAL);
+
+	/* An unknown condition, ignore mode or uniform flag. */
+	branch.words = 0;
+	branch.condition = (enum bcm2711_qpu_branch_condition)7;
+	error = bcm2711_qpu_encode_branch(&branch, &word);
+	assert(error == EINVAL);
+	branch.condition = BCM2711_QPU_BRANCH_ALWAYS;
+	branch.ignore = (enum bcm2711_qpu_branch_ignore)3;
+	error = bcm2711_qpu_encode_branch(&branch, &word);
+	assert(error == EINVAL);
+	branch.ignore = BCM2711_QPU_BRANCH_IGNORE_NONE;
+	branch.uniform_relative = 2;
+	error = bcm2711_qpu_encode_branch(&branch, &word);
+	assert(error == EINVAL);
+	assert(word == 0x1234);
+
+	/* Neither half of the multiply exists on the add ALU, nor the barrier identity on the multiply ALU. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_MULTIPLY_TOP;
+	bundle.add.destination.number = MAGIC_DISCARD;
+	bundle.add.destination.peripheral = 1;
+	error = bcm2711_qpu_encode_bundle(&bundle, &word);
+	assert(error == EINVAL);
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.multiply.operation = BCM2711_QPU_BARRIER_ID;
+	bundle.multiply.destination.number = MAGIC_SYNCB;
+	bundle.multiply.destination.peripheral = 1;
+	error = bcm2711_qpu_encode_bundle(&bundle, &word);
+	assert(error == EINVAL);
+	assert(word == 0x1234);
+}
+
+/* Reports the register one input of one ALU reads, through the mux on 4.2 or the read address on 7.1. */
+static uint32_t
+register_read(
+	const struct v3d_qpu_instr *decoded,
+	uint32_t multiply,
+	uint32_t right)
+{
+	const struct v3d_qpu_input *input;
+	enum v3d_qpu_mux mux;
+
+	/* The input of the ALU named. */
+	input = &decoded->alu.add.a;
+	if (multiply != 0 && right != 0) {
+		input = &decoded->alu.mul.b;
+	} else if (multiply != 0) {
+		input = &decoded->alu.mul.a;
+	} else if (right != 0) {
+		input = &decoded->alu.add.b;
+	}
+
+	/* 7.1 names the register directly. */
+	if (QPU_TEST_VERSION == 71)
+		return input->raddr;
+
+	/* 4.2 names a read port that holds it. */
+	mux = input->mux;
+	assert(mux == V3D_QPU_MUX_A || mux == V3D_QPU_MUX_B);
+	if (mux == V3D_QPU_MUX_A)
+		return decoded->raddr_a;
+
+	/* Port B holds the other register. */
+	return decoded->raddr_b;
+}
diff --git a/plan/ws283/tests/qpu-compute-format-host-test.sh b/plan/ws283/tests/qpu-compute-format-host-test.sh
new file mode 100644
index 0000000000..b66f30b718
--- /dev/null
+++ b/plan/ws283/tests/qpu-compute-format-host-test.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# HT1: the compute additions of both V3D encoders (qpu.c for 4.2, qpu71.c for 7.1, and the shared branch word in
+# qpu-branch.c) checked against the unmodified MIT Mesa 26.2.6 packer and decoder.
+# Usage: sh plan/ws283/tests/qpu-compute-format-host-test.sh [output-directory]
+set -eu
+out=${1:-build/ws283-qpu-compute-host}
+sh plan/ws283/tests/mesa-oracle.sh "$out"
+mesa=$out/mesa-26.2.6/src
+for version in 42 71; do
+    encoder=src/drivers/gpu/bcm2711/compiler/qpu.c
+    if [ "$version" = 71 ]; then
+        encoder=src/drivers/gpu/bcm2711/compiler/qpu71.c
+    fi
+    cc -std=c99 -Wall -Wextra -Werror -DQPU_TEST_VERSION=$version -Iinclude -Isrc -I"$out/mesa-host" -I"$mesa" \
+        plan/ws283/tests/qpu-compute-format-host-test.c "$encoder" src/drivers/gpu/bcm2711/compiler/qpu-branch.c \
+        "$out/mesa-pack.o" "$out/mesa-instr.o" -o "$out/qpu-compute-format-host-test-$version"
+    "$out/qpu-compute-format-host-test-$version"
+done
diff --git a/plan/ws283/tests/qpu71-compute-machine-host-test.c b/plan/ws283/tests/qpu71-compute-machine-host-test.c
new file mode 100644
index 0000000000..cb70b01533
--- /dev/null
+++ b/plan/ws283/tests/qpu71-compute-machine-host-test.c
@@ -0,0 +1,860 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The V3D 7.1 compute dispatch model checked with small programs assembled
+ * by the production encoder (qpu71.c, qpu-branch.c).
+ *
+ * The programs exercise the payload of a partial batch and of a supergroup,
+ * the integer multiply, a divergent loop whose body reads a uniform that
+ * the backward branch rewinds, the uniform address window, and a workgroup
+ * barrier across three batches.  Programs that break a rule (a store
+ * outside every buffer, a missing TMU write wait, a conditional store with
+ * no lane enabled, an early ldunifa, a barrier one batch never reaches)
+ * must stop the model; each runs in a child process.
+ */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "drivers/gpu/bcm2711/compiler/qpu.h"
+#include "plan/ws283/tests/qpu71-compute-machine.h"
+#include "plan/ws283/tests/qpu71-rules.h"
+
+#define MAGIC_UNIFA 9
+#define MAGIC_TMUD 11
+#define MAGIC_TMUA 12
+#define MAGIC_TMUAU 13
+#define MAGIC_SYNCB 18
+#define MAGIC_DISCARD 6
+#define PREDICATE_A 1
+#define PUSH_CARRY 3
+
+/* A program being assembled. */
+struct program {
+	uint64_t code[128];
+	uint32_t count;
+};
+
+static struct bcm2711_qpu_source reg(uint32_t number);
+static struct bcm2711_qpu_source imm(uint32_t bits);
+static void alu(struct program *program, enum bcm2711_qpu_operation operation, uint32_t destination, uint32_t magic, struct bcm2711_qpu_source left, struct bcm2711_qpu_source right, uint32_t predicate, uint32_t push);
+static void sig(struct program *program, enum bcm2711_qpu_signal kind, uint32_t destination, uint32_t thread_switch);
+static void nop(struct program *program);
+static void branch(struct program *program, enum bcm2711_qpu_branch_condition condition, uint32_t target, uint32_t uniform_relative);
+static uint32_t rules_of(const struct v3d_device_info *device, const struct qpu71_compute_setup *setup);
+static void check_rules(const struct v3d_device_info *device);
+static void build_ids(struct program *program, uint32_t wait);
+static void build_loop(struct program *program);
+static void build_window(struct program *program, uint32_t early);
+static void build_barrier(struct program *program, uint32_t skip);
+static void build_conditional_store(struct program *program);
+static void run_ids(const struct v3d_device_info *device, uint32_t size_ok, uint32_t wait);
+static void run_loop(const struct v3d_device_info *device);
+static void run_window(const struct v3d_device_info *device, uint32_t early);
+static void run_barrier(const struct v3d_device_info *device, uint32_t skip);
+static void run_conditional_store(const struct v3d_device_info *device);
+static void expect_failure(const char *name, void (*body)(const struct v3d_device_info *, uint32_t), const struct v3d_device_info *device, uint32_t argument);
+static void ids_too_small(const struct v3d_device_info *device, uint32_t argument);
+static void ids_without_wait(const struct v3d_device_info *device, uint32_t argument);
+static void window_early(const struct v3d_device_info *device, uint32_t argument);
+static void barrier_skipped(const struct v3d_device_info *device, uint32_t argument);
+static void store_no_lane(const struct v3d_device_info *device, uint32_t argument);
+
+/*
+ * Runs the passing programs and the programs that must stop the model.
+ */
+int
+main(
+	void)
+{
+	struct v3d_device_info device;
+
+	/* The 7.1.10 engine of the Raspberry Pi 5. */
+	memset(&device, 0, sizeof(device));
+	device.ver = 71;
+	device.rev = 10;
+
+	/* The programs that keep every rule. */
+	run_ids(&device, 1, 1);
+	run_loop(&device);
+	run_window(&device, 0);
+	run_barrier(&device, 0);
+
+	/* The static checker passes every program above and finds the broken rules below. */
+	check_rules(&device);
+
+	/* The programs that break one. */
+	expect_failure("store outside every buffer", ids_too_small, &device, 0);
+	expect_failure("missing TMU write wait", ids_without_wait, &device, 0);
+	expect_failure("early ldunifa", window_early, &device, 0);
+	expect_failure("barrier one batch skips", barrier_skipped, &device, 0);
+	expect_failure("conditional store with no lane", store_no_lane, &device, 0);
+
+	/* Succeeded. */
+	puts("qpu71-compute-machine-host-test PASS");
+	return 0;
+}
+
+/* Names a register source. */
+static struct bcm2711_qpu_source
+reg(
+	uint32_t number)
+{
+	struct bcm2711_qpu_source source;
+
+	/* A register of the thread's window. */
+	source.kind = BCM2711_QPU_REGISTER;
+	source.number = number;
+	return source;
+}
+
+/* Names a small constant source. */
+static struct bcm2711_qpu_source
+imm(
+	uint32_t bits)
+{
+	struct bcm2711_qpu_source source;
+
+	/* The constant's actual bits. */
+	source.kind = BCM2711_QPU_CONSTANT;
+	source.number = bits;
+	return source;
+}
+
+/* Appends one ALU word. */
+static void
+alu(
+	struct program *program,
+	enum bcm2711_qpu_operation operation,
+	uint32_t destination,
+	uint32_t magic,
+	struct bcm2711_qpu_source left,
+	struct bcm2711_qpu_source right,
+	uint32_t predicate,
+	uint32_t push)
+{
+	struct bcm2711_qpu_instruction instruction;
+	int error;
+
+	/* One operation alone in its word. */
+	memset(&instruction, 0, sizeof(instruction));
+	instruction.operation = operation;
+	instruction.destination.number = destination;
+	instruction.destination.peripheral = magic;
+	instruction.left = left;
+	instruction.right = right;
+	instruction.predicate = predicate;
+	instruction.push_flags = push;
+	error = bcm2711_qpu_encode(&instruction, &program->code[program->count]);
+	assert(error == 0);
+	program->count++;
+}
+
+/* Appends one word with a signal and no operation. */
+static void
+sig(
+	struct program *program,
+	enum bcm2711_qpu_signal kind,
+	uint32_t destination,
+	uint32_t thread_switch)
+{
+	struct bcm2711_qpu_bundle bundle;
+	int error;
+
+	/* Both ALUs idle. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.signal = kind;
+	bundle.signal_destination.number = destination;
+	bundle.thread_switch = thread_switch;
+	error = bcm2711_qpu_encode_bundle(&bundle, &program->code[program->count]);
+	assert(error == 0);
+	program->count++;
+}
+
+/* Appends one idle word. */
+static void
+nop(
+	struct program *program)
+{
+	/* No signal, no operation. */
+	sig(program, BCM2711_QPU_SIGNAL_NONE, 0, 0);
+}
+
+/* Appends one relative branch to a word index. */
+static void
+branch(
+	struct program *program,
+	enum bcm2711_qpu_branch_condition condition,
+	uint32_t target,
+	uint32_t uniform_relative)
+{
+	struct bcm2711_qpu_branch word;
+	int error;
+
+	/* The target counts from the word after the three delay words; dispatched lanes only are counted. */
+	memset(&word, 0, sizeof(word));
+	word.condition = condition;
+	word.ignore = BCM2711_QPU_BRANCH_IGNORE_P;
+	word.words = (int32_t)target - (int32_t)(program->count + 4);
+	word.uniform_relative = uniform_relative;
+	error = bcm2711_qpu_encode_branch(&word, &program->code[program->count]);
+	assert(error == 0);
+	program->count++;
+}
+
+/*
+ * The payload program: each invocation stores its rf3 and rf2 as a vector
+ * of two at 8 × (workgroup × 24 + local index).  Uniforms: the buffer, the
+ * workgroup size, the local index shift, the x mask, the vector config.
+ */
+static void
+build_ids(
+	struct program *program,
+	uint32_t wait)
+{
+	/* The uniforms. */
+	program->count = 0;
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 4, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 5, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 7, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 9, 0);
+
+	/* local = rf2 >> (32 - b), x = rf3 & 0xffff, global = x × size + local. */
+	alu(program, BCM2711_QPU_SHIFT_RIGHT, 6, 0, reg(2), reg(7), 0, 0);
+	alu(program, BCM2711_QPU_BITS_AND, 8, 0, reg(3), reg(9), 0, 0);
+	alu(program, BCM2711_QPU_MULTIPLY_TOP, MAGIC_DISCARD, 1, reg(8), reg(5), 0, 0);
+	alu(program, BCM2711_QPU_MULTIPLY_24, 10, 0, reg(8), reg(5), 0, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 10, 0, reg(10), reg(6), 0, 0);
+	alu(program, BCM2711_QPU_SHIFT_LEFT, 11, 0, reg(10), imm(3), 0, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 11, 0, reg(4), reg(11), 0, 0);
+
+	/* The vector store of the two payload words, its wait and the end. */
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUD, 1, reg(3), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUD, 1, reg(2), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUAU, 1, reg(11), reg(0), 0, 0);
+	if (wait != 0)
+		alu(program, BCM2711_QPU_TEXTURE_WAIT, MAGIC_DISCARD, 1, reg(0), reg(0), 0, 0);
+	sig(program, BCM2711_QPU_SIGNAL_NONE, 0, 1);
+	nop(program);
+	nop(program);
+}
+
+/* Runs the payload program over three workgroups of 24 in supergroups of two. */
+static void
+run_ids(
+	const struct v3d_device_info *device,
+	uint32_t size_ok,
+	uint32_t wait)
+{
+	struct program program;
+	struct qpu71_compute_setup setup;
+	struct qpu71_compute_result result;
+	struct qpu71_compute_region region;
+	uint32_t memory[2 * 72];
+	uint32_t uniforms[5];
+	uint32_t group;
+	uint32_t local;
+	uint32_t bits;
+
+	/* The buffer holds one vector of two per invocation, one fewer when the test wants a failure. */
+	build_ids(&program, wait);
+	memset(memory, 0, sizeof(memory));
+	region.address = 0x10000;
+	region.size = sizeof(memory);
+	if (size_ok == 0)
+		region.size -= 8;
+	region.bytes = (uint8_t *)memory;
+	region.writable = 1;
+	bits = qpu71_compute_index_bits(24);
+	uniforms[0] = region.address;
+	uniforms[1] = 24;
+	uniforms[2] = 32 - bits;
+	uniforms[3] = 0xffff;
+	uniforms[4] = 0xfffffffaU;
+
+	/* Three workgroups of 24: the first supergroup holds two (three batches), the second one (two, the last half full). */
+	memset(&setup, 0, sizeof(setup));
+	setup.code = program.code;
+	setup.code_count = program.count;
+	setup.uniforms = uniforms;
+	setup.uniform_count = 5;
+	setup.regions = &region;
+	setup.region_count = 1;
+	setup.local_size[0] = 24;
+	setup.local_size[1] = 1;
+	setup.local_size[2] = 1;
+	setup.groups[0] = 3;
+	setup.groups[1] = 1;
+	setup.groups[2] = 1;
+	setup.workgroups_per_supergroup = 2;
+	setup.threads = 4;
+	setup.single_segment = 1;
+	setup.garbage_seed = 7;
+	if (size_ok != 0 && wait != 0)
+		assert(rules_of(device, &setup) == 0);
+	qpu71_compute_run(device, &setup, &result);
+	assert(result.batches == 5);
+	assert(result.supergroups == 2);
+	assert(result.stores == 5);
+	assert(result.uniforms_read == 5);
+
+	/* Every invocation wrote its payload: the x id, and z, the memory slot and the local index. */
+	for (group = 0; group < 3; group++) {
+		for (local = 0; local < 24; local++) {
+			assert(memory[2 * (group * 24 + local)] == group);
+			assert(memory[2 * (group * 24 + local) + 1] == ((group << 16) | (local << (32 - bits))));
+		}
+	}
+	puts("qpu71-compute-machine payload, partial batch and multiply: PASS");
+}
+
+/*
+ * The divergent loop: each invocation adds the loop's uniform (10) once per
+ * iteration while i < local & 3, and stores the sum at 4 × local.  The
+ * backward branch rewinds the uniform stream by the loop's two uniforms.
+ */
+static void
+build_loop(
+	struct program *program)
+{
+	uint32_t head;
+
+	/* The buffer, the shift; local and n = local & 3; sum and i start at zero. */
+	program->count = 0;
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 4, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 7, 0);
+	alu(program, BCM2711_QPU_SHIFT_RIGHT, 6, 0, reg(2), reg(7), 0, 0);
+	alu(program, BCM2711_QPU_BITS_AND, 8, 0, reg(6), imm(3), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, 9, 0, imm(0), imm(0), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, 10, 0, imm(0), imm(0), 0, 0);
+
+	/* The body: read the uniform, and while i < n add it and count. */
+	head = program->count;
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 11, 0);
+	alu(program, BCM2711_QPU_INTEGER_SUBTRACT, MAGIC_DISCARD, 1, reg(10), reg(8), 0, PUSH_CARRY);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 9, 0, reg(9), reg(11), PREDICATE_A, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 10, 0, reg(10), imm(1), PREDICATE_A, 0);
+	alu(program, BCM2711_QPU_INTEGER_SUBTRACT, MAGIC_DISCARD, 1, reg(10), reg(8), 0, PUSH_CARRY);
+	branch(program, BCM2711_QPU_BRANCH_ANY_A, head, 1);
+	nop(program);
+	nop(program);
+	nop(program);
+
+	/* The store at 4 × local. */
+	alu(program, BCM2711_QPU_SHIFT_LEFT, 12, 0, reg(6), imm(2), 0, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 12, 0, reg(4), reg(12), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUD, 1, reg(9), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUA, 1, reg(12), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_TEXTURE_WAIT, MAGIC_DISCARD, 1, reg(0), reg(0), 0, 0);
+	sig(program, BCM2711_QPU_SIGNAL_NONE, 0, 1);
+	nop(program);
+	nop(program);
+}
+
+/* Runs the loop over one workgroup of 20 (a full and a partial batch). */
+static void
+run_loop(
+	const struct v3d_device_info *device)
+{
+	struct program program;
+	struct qpu71_compute_setup setup;
+	struct qpu71_compute_result result;
+	struct qpu71_compute_region region;
+	uint32_t memory[20];
+	uint32_t uniforms[4];
+	uint32_t local;
+
+	/* The stream: the buffer, the shift, then the loop's uniform and its rewind of two words. */
+	build_loop(&program);
+	memset(memory, 0, sizeof(memory));
+	region.address = 0x20000;
+	region.size = sizeof(memory);
+	region.bytes = (uint8_t *)memory;
+	region.writable = 1;
+	uniforms[0] = region.address;
+	uniforms[1] = 32 - qpu71_compute_index_bits(20);
+	uniforms[2] = 10;
+	uniforms[3] = (uint32_t)-8;
+	memset(&setup, 0, sizeof(setup));
+	setup.code = program.code;
+	setup.code_count = program.count;
+	setup.uniforms = uniforms;
+	setup.uniform_count = 4;
+	setup.regions = &region;
+	setup.region_count = 1;
+	setup.local_size[0] = 20;
+	setup.local_size[1] = 1;
+	setup.local_size[2] = 1;
+	setup.groups[0] = 1;
+	setup.groups[1] = 1;
+	setup.groups[2] = 1;
+	setup.workgroups_per_supergroup = 1;
+	setup.threads = 4;
+	setup.single_segment = 1;
+	assert(rules_of(device, &setup) == 0);
+	qpu71_compute_run(device, &setup, &result);
+	assert(result.batches == 2);
+
+	/* Each invocation summed the uniform n times; the first batch looped three times, the second (lanes 16-19) three. */
+	for (local = 0; local < 20; local++)
+		assert(memory[local] == 10 * (local & 3));
+	assert(result.branches_taken == 4);
+	puts("qpu71-compute-machine divergent loop and uniform rewind: PASS");
+}
+
+/*
+ * The uniform address window: two words read through ldunifarf, summed and
+ * stored at 4 × lane.  An early variant reads one word too soon.
+ */
+static void
+build_window(
+	struct program *program,
+	uint32_t early)
+{
+	/* The weights and the buffer; the window opens three words before the first read. */
+	program->count = 0;
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 4, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 5, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_UNIFA, 1, reg(4), reg(0), 0, 0);
+	nop(program);
+	nop(program);
+	if (early == 0)
+		nop(program);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_ADDRESS_REGISTER, 6, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_ADDRESS_REGISTER, 7, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 8, 0, reg(6), reg(7), 0, 0);
+	alu(program, BCM2711_QPU_ELEMENT_INDEX, 9, 0, reg(0), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_SHIFT_LEFT, 9, 0, reg(9), imm(2), 0, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 9, 0, reg(5), reg(9), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUD, 1, reg(8), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUA, 1, reg(9), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_TEXTURE_WAIT, MAGIC_DISCARD, 1, reg(0), reg(0), 0, 0);
+	sig(program, BCM2711_QPU_SIGNAL_NONE, 0, 1);
+	nop(program);
+	nop(program);
+}
+
+/* Runs the window program on one batch of sixteen. */
+static void
+run_window(
+	const struct v3d_device_info *device,
+	uint32_t early)
+{
+	struct program program;
+	struct qpu71_compute_setup setup;
+	struct qpu71_compute_result result;
+	struct qpu71_compute_region regions[2];
+	uint32_t weights[2];
+	uint32_t memory[16];
+	uint32_t uniforms[2];
+	uint32_t lane;
+
+	/* A read-only weights buffer and the output. */
+	build_window(&program, early);
+	weights[0] = 1000;
+	weights[1] = 234;
+	memset(memory, 0, sizeof(memory));
+	regions[0].address = 0x30000;
+	regions[0].size = sizeof(weights);
+	regions[0].bytes = (uint8_t *)weights;
+	regions[0].writable = 0;
+	regions[1].address = 0x40000;
+	regions[1].size = sizeof(memory);
+	regions[1].bytes = (uint8_t *)memory;
+	regions[1].writable = 1;
+	uniforms[0] = regions[0].address;
+	uniforms[1] = regions[1].address;
+	memset(&setup, 0, sizeof(setup));
+	setup.code = program.code;
+	setup.code_count = program.count;
+	setup.uniforms = uniforms;
+	setup.uniform_count = 2;
+	setup.regions = regions;
+	setup.region_count = 2;
+	setup.local_size[0] = 16;
+	setup.local_size[1] = 1;
+	setup.local_size[2] = 1;
+	setup.groups[0] = 1;
+	setup.groups[1] = 1;
+	setup.groups[2] = 1;
+	setup.workgroups_per_supergroup = 1;
+	setup.threads = 2;
+	setup.single_segment = 1;
+	if (early == 0)
+		assert(rules_of(device, &setup) == 0);
+	qpu71_compute_run(device, &setup, &result);
+
+	/* Every lane stored the sum of the two window words. */
+	for (lane = 0; lane < 16; lane++)
+		assert(memory[lane] == 1234);
+	puts("qpu71-compute-machine uniform address window: PASS");
+}
+
+/*
+ * The barrier program: every invocation stores its global index, waits at
+ * the barrier, and copies its neighbour's (index XOR 1) to the second
+ * buffer.  A skipping variant lets the batches of the second workgroup's
+ * odd lanes... more simply, makes every batch whose first lane has x id 1
+ * branch over the barrier, so the others wait forever.
+ */
+static void
+build_barrier(
+	struct program *program,
+	uint32_t skip)
+{
+	uint32_t over;
+	uint32_t patch;
+	struct bcm2711_qpu_branch word;
+	int error;
+
+	/* The buffers, the shift, the mask, the size; global = x × 24 + local; own address. */
+	program->count = 0;
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 4, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 15, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 7, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 9, 0);
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 5, 0);
+	alu(program, BCM2711_QPU_SHIFT_RIGHT, 6, 0, reg(2), reg(7), 0, 0);
+	alu(program, BCM2711_QPU_BITS_AND, 8, 0, reg(3), reg(9), 0, 0);
+	alu(program, BCM2711_QPU_MULTIPLY_TOP, MAGIC_DISCARD, 1, reg(8), reg(5), 0, 0);
+	alu(program, BCM2711_QPU_MULTIPLY_24, 10, 0, reg(8), reg(5), 0, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 10, 0, reg(10), reg(6), 0, 0);
+	alu(program, BCM2711_QPU_SHIFT_LEFT, 11, 0, reg(10), imm(2), 0, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 11, 0, reg(4), reg(11), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUD, 1, reg(10), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUA, 1, reg(11), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_TEXTURE_WAIT, MAGIC_DISCARD, 1, reg(0), reg(0), 0, 0);
+
+	/* The skipping variant branches over the barrier when lane 0's x id is not zero (flag A = x != 0 via borrow of 0 - x). */
+	patch = 0;
+	if (skip != 0) {
+		alu(program, BCM2711_QPU_INTEGER_SUBTRACT, MAGIC_DISCARD, 1, imm(0), reg(8), 0, PUSH_CARRY);
+		patch = program->count;
+		nop(program);
+		nop(program);
+		nop(program);
+		nop(program);
+	}
+
+	/* The barrier and the switch that waits for the supergroup. */
+	alu(program, BCM2711_QPU_BARRIER_ID, MAGIC_SYNCB, 1, reg(0), reg(0), 0, 0);
+	sig(program, BCM2711_QPU_SIGNAL_NONE, 0, 1);
+	nop(program);
+	nop(program);
+	over = program->count;
+	if (skip != 0) {
+		memset(&word, 0, sizeof(word));
+		word.condition = BCM2711_QPU_BRANCH_LANE0_A;
+		word.ignore = BCM2711_QPU_BRANCH_IGNORE_P;
+		word.words = (int32_t)over - (int32_t)(patch + 4);
+		error = bcm2711_qpu_encode_branch(&word, &program->code[patch]);
+		assert(error == 0);
+	}
+
+	/* The neighbour's index, loaded and copied to the second buffer. */
+	alu(program, BCM2711_QPU_BITS_XOR, 12, 0, reg(10), imm(1), 0, 0);
+	alu(program, BCM2711_QPU_SHIFT_LEFT, 12, 0, reg(12), imm(2), 0, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 12, 0, reg(4), reg(12), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUA, 1, reg(12), reg(0), 0, 0);
+	nop(program);
+	sig(program, BCM2711_QPU_SIGNAL_TEXTURE, 13, 0);
+	alu(program, BCM2711_QPU_SHIFT_LEFT, 16, 0, reg(10), imm(2), 0, 0);
+	alu(program, BCM2711_QPU_INTEGER_ADD, 16, 0, reg(15), reg(16), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUD, 1, reg(13), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUA, 1, reg(16), reg(0), 0, 0);
+	alu(program, BCM2711_QPU_TEXTURE_WAIT, MAGIC_DISCARD, 1, reg(0), reg(0), 0, 0);
+
+	/* The marked last switch (two in a row) and the thread end. */
+	sig(program, BCM2711_QPU_SIGNAL_NONE, 0, 1);
+	sig(program, BCM2711_QPU_SIGNAL_NONE, 0, 1);
+	nop(program);
+	sig(program, BCM2711_QPU_SIGNAL_NONE, 0, 1);
+	nop(program);
+	nop(program);
+}
+
+/* Runs the barrier program over two workgroups of 24 in one supergroup (three batches). */
+static void
+run_barrier(
+	const struct v3d_device_info *device,
+	uint32_t skip)
+{
+	struct program program;
+	struct qpu71_compute_setup setup;
+	struct qpu71_compute_result result;
+	struct qpu71_compute_region regions[2];
+	uint32_t first[48];
+	uint32_t second[48];
+	uint32_t uniforms[5];
+	uint32_t index;
+
+	/* Two buffers of one word per invocation. */
+	build_barrier(&program, skip);
+	memset(first, 0, sizeof(first));
+	memset(second, 0, sizeof(second));
+	regions[0].address = 0x50000;
+	regions[0].size = sizeof(first);
+	regions[0].bytes = (uint8_t *)first;
+	regions[0].writable = 1;
+	regions[1].address = 0x60000;
+	regions[1].size = sizeof(second);
+	regions[1].bytes = (uint8_t *)second;
+	regions[1].writable = 1;
+	uniforms[0] = regions[0].address;
+	uniforms[1] = regions[1].address;
+	uniforms[2] = 32 - qpu71_compute_index_bits(24);
+	uniforms[3] = 0xffff;
+	uniforms[4] = 24;
+	memset(&setup, 0, sizeof(setup));
+	setup.code = program.code;
+	setup.code_count = program.count;
+	setup.uniforms = uniforms;
+	setup.uniform_count = 5;
+	setup.regions = regions;
+	setup.region_count = 2;
+	setup.local_size[0] = 24;
+	setup.local_size[1] = 1;
+	setup.local_size[2] = 1;
+	setup.groups[0] = 2;
+	setup.groups[1] = 1;
+	setup.groups[2] = 1;
+	setup.workgroups_per_supergroup = 2;
+	setup.threads = 4;
+	setup.single_segment = 0;
+	assert(rules_of(device, &setup) == 0);
+	qpu71_compute_run(device, &setup, &result);
+	assert(result.batches == 3);
+	assert(result.barriers == 3);
+
+	/* Every invocation saw its neighbour's store, made before the barrier. */
+	for (index = 0; index < 48; index++) {
+		assert(first[index] == index);
+		assert(second[index] == (index ^ 1U));
+	}
+	puts("qpu71-compute-machine barrier across three batches: PASS");
+}
+
+/* A store predicated on a flag no lane has: the store must be wrapped in a branch instead. */
+static void
+build_conditional_store(
+	struct program *program)
+{
+	/* Flag A = the buffer address below itself (never), then a predicated store. */
+	program->count = 0;
+	sig(program, BCM2711_QPU_SIGNAL_UNIFORM_REGISTER, 4, 0);
+	alu(program, BCM2711_QPU_INTEGER_SUBTRACT, MAGIC_DISCARD, 1, reg(4), reg(4), 0, PUSH_CARRY);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUD, 1, reg(4), reg(0), PREDICATE_A, 0);
+	alu(program, BCM2711_QPU_MOVE, MAGIC_TMUA, 1, reg(4), reg(0), PREDICATE_A, 0);
+	alu(program, BCM2711_QPU_TEXTURE_WAIT, MAGIC_DISCARD, 1, reg(0), reg(0), 0, 0);
+	sig(program, BCM2711_QPU_SIGNAL_NONE, 0, 1);
+	nop(program);
+	nop(program);
+}
+
+/* Runs the conditional store on one batch. */
+static void
+run_conditional_store(
+	const struct v3d_device_info *device)
+{
+	struct program program;
+	struct qpu71_compute_setup setup;
+	struct qpu71_compute_result result;
+	struct qpu71_compute_region region;
+	uint32_t memory[4];
+	uint32_t uniforms[1];
+
+	/* One buffer, one batch. */
+	build_conditional_store(&program);
+	region.address = 0x70000;
+	region.size = sizeof(memory);
+	region.bytes = (uint8_t *)memory;
+	region.writable = 1;
+	uniforms[0] = region.address;
+	memset(&setup, 0, sizeof(setup));
+	setup.code = program.code;
+	setup.code_count = program.count;
+	setup.uniforms = uniforms;
+	setup.uniform_count = 1;
+	setup.regions = &region;
+	setup.region_count = 1;
+	setup.local_size[0] = 16;
+	setup.local_size[1] = 1;
+	setup.local_size[2] = 1;
+	setup.groups[0] = 1;
+	setup.groups[1] = 1;
+	setup.groups[2] = 1;
+	setup.workgroups_per_supergroup = 1;
+	setup.threads = 4;
+	setup.single_segment = 1;
+	qpu71_compute_run(device, &setup, &result);
+}
+
+/* Runs one body in a child process and requires the model to stop it. */
+static void
+expect_failure(
+	const char *name,
+	void (*body)(const struct v3d_device_info *, uint32_t),
+	const struct v3d_device_info *device,
+	uint32_t argument)
+{
+	pid_t child;
+	int status;
+
+	/* The child's abort is the expected outcome; its message goes to the log. */
+	fflush(stdout);
+	child = fork();
+	assert(child >= 0);
+	if (child == 0) {
+		body(device, argument);
+		_exit(0);
+	}
+	assert(waitpid(child, &status, 0) == child);
+	if (!WIFSIGNALED(status)) {
+		fprintf(stderr, "expected the model to stop: %s\n", name);
+		abort();
+	}
+	printf("qpu71-compute-machine refuses %s: PASS\n", name);
+}
+
+/* The payload program with a buffer one vector short. */
+static void
+ids_too_small(
+	const struct v3d_device_info *device,
+	uint32_t argument)
+{
+	/* The last invocation's store leaves the buffer. */
+	(void)argument;
+	run_ids(device, 0, 1);
+}
+
+/* The payload program without its TMU write wait. */
+static void
+ids_without_wait(
+	const struct v3d_device_info *device,
+	uint32_t argument)
+{
+	/* The thread ends with its store not waited for. */
+	(void)argument;
+	run_ids(device, 1, 0);
+}
+
+/* The window program reading one word too soon. */
+static void
+window_early(
+	const struct v3d_device_info *device,
+	uint32_t argument)
+{
+	/* The ldunifarf is two words after its unifa write. */
+	(void)argument;
+	run_window(device, 1);
+}
+
+/* The barrier program whose batches of the second workgroup skip the barrier. */
+static void
+barrier_skipped(
+	const struct v3d_device_info *device,
+	uint32_t argument)
+{
+	/* The first workgroup's batches wait forever. */
+	(void)argument;
+	run_barrier(device, 1);
+}
+
+/* The store with no lane enabled. */
+static void
+store_no_lane(
+	const struct v3d_device_info *device,
+	uint32_t argument)
+{
+	/* The hardware's behaviour is unknown, so the model refuses it. */
+	(void)argument;
+	run_conditional_store(device);
+}
+
+/* Runs the static checker over one job's program and stream. */
+static uint32_t
+rules_of(
+	const struct v3d_device_info *device,
+	const struct qpu71_compute_setup *setup)
+{
+	struct qpu71_rules_program program;
+
+	/* The program, its stream and its threading, as a compute program. */
+	memset(&program, 0, sizeof(program));
+	program.code = setup->code;
+	program.count = setup->code_count;
+	program.uniforms = setup->uniforms;
+	program.uniform_count = setup->uniform_count;
+	program.threads = setup->threads;
+	program.single_segment = setup->single_segment;
+	program.compute = 1;
+	return qpu71_rules_check(device, &program, 1);
+}
+
+/* Requires the static checker to find each rule broken in a variant of the programs. */
+static void
+check_rules(
+	const struct v3d_device_info *device)
+{
+	struct qpu71_rules_program rules;
+	struct program program;
+	struct bcm2711_qpu_branch word;
+	uint32_t uniforms[5];
+	uint32_t found;
+	int error;
+
+	/* An early ldunifa (rule 3). */
+	memset(&rules, 0, sizeof(rules));
+	rules.threads = 2;
+	rules.single_segment = 1;
+	rules.compute = 1;
+	build_window(&program, 1);
+	rules.code = program.code;
+	rules.count = program.count;
+	found = qpu71_rules_check(device, &rules, 0);
+	assert(found != 0);
+
+	/* A store never waited for (rule 9). */
+	build_ids(&program, 0);
+	rules.code = program.code;
+	rules.count = program.count;
+	rules.threads = 4;
+	found = qpu71_rules_check(device, &rules, 0);
+	assert(found != 0);
+
+	/* A loop whose branch rewinds one uniform too few (rule 12). */
+	build_loop(&program);
+	rules.code = program.code;
+	rules.count = program.count;
+	uniforms[0] = 0;
+	uniforms[1] = 26;
+	uniforms[2] = 10;
+	uniforms[3] = (uint32_t)-4;
+	rules.uniforms = uniforms;
+	rules.uniform_count = 4;
+	found = qpu71_rules_check(device, &rules, 0);
+	assert(found == 1);
+
+	/* The same loop whose branch counts the lanes the CSD did not dispatch (rule 11). */
+	uniforms[3] = (uint32_t)-8;
+	memset(&word, 0, sizeof(word));
+	word.condition = BCM2711_QPU_BRANCH_ANY_A;
+	word.ignore = BCM2711_QPU_BRANCH_IGNORE_NONE;
+	word.words = -9;
+	word.uniform_relative = 1;
+	error = bcm2711_qpu_encode_branch(&word, &program.code[11]);
+	assert(error == 0);
+	found = qpu71_rules_check(device, &rules, 0);
+	assert(found == 1);
+	puts("qpu71-rules finds an early ldunifa, a store never waited for, a short rewind and a branch counting undispatched lanes: PASS");
+}
