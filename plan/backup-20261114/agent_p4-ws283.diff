diff --git a/src/drivers/gpu/bcm2711/vk/vulkan-pipeline-compute.c b/src/drivers/gpu/bcm2711/vk/vulkan-pipeline-compute.c
new file mode 100644
index 0000000000..54fbead3cc
--- /dev/null
+++ b/src/drivers/gpu/bcm2711/vk/vulkan-pipeline-compute.c
@@ -0,0 +1,278 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * Compute pipelines: one VkComputePipelineCreateInfo decoded from the wire,
+ * its module compiled as a native compute program, and the program's
+ * uniforms checked against the pipeline layout.
+ *
+ * A compute pipeline keeps its program where a graphics pipeline keeps its
+ * coordinate program and has no render pass; the draw paths refuse it by
+ * its compute flag.
+ */
+#include <kern/kcrt.h>
+#include <kern/kmem.h>
+#include <uapi/errno.h>
+
+#include "drivers/gpu/bcm2711/vk/vulkan-pipeline.h"
+#include "drivers/gpu/i915/vk/vk-codec.inc"
+
+/* The SPIR-V execution model of a compute entry point (GLCompute). */
+#define COMPUTE_MODEL 5U
+
+static int build_compute(struct bcm2711_vulkan_session *session, struct bcm2711_vulkan_object *device, const VkComputePipelineCreateInfo *info, struct bcm2711_vulkan_pipeline *pipeline);
+static int compute_module(struct bcm2711_vulkan_session *session, struct bcm2711_vulkan_object *device, const VkPipelineShaderStageCreateInfo *stage, struct bcm2711_vulkan_module **module);
+static int compute_entry(const struct bcm2711_vulkan_module *module);
+static int compute_interface(const struct bcm2711_shader_binary *program, const struct bcm2711_vulkan_pipeline_layout *layout);
+
+/*
+ * Decodes one VkComputePipelineCreateInfo of a creation batch into command-arena storage.
+ */
+int
+bcm2711_vulkan_pipeline_compute_decode(
+	struct bcm2711_vulkan_session *session,
+	struct i915_wire_reader *reader,
+	VkComputePipelineCreateInfo *info)
+{
+	/* The shared codec reads the record and its nested stage. */
+	kern_memset(info, 0, sizeof(*info));
+	i915_vkc_dec_VkComputePipelineCreateInfo(reader, &session->arena, info);
+	if (reader->error != 0)
+		return EINVAL;
+
+	/* Succeeded: the record holds the client's description. */
+	return 0;
+}
+
+/*
+ * Builds a fully owned immutable compute pipeline.
+ */
+int
+bcm2711_vulkan_pipeline_build_compute(
+	struct bcm2711_vulkan_session *session,
+	struct bcm2711_vulkan_object *device,
+	const VkComputePipelineCreateInfo *info,
+	struct bcm2711_vulkan_pipeline **pipeline)
+{
+	struct bcm2711_vulkan_pipeline *created;
+	int error;
+	int retired;
+
+	/* Failure never publishes a partial pipeline. */
+	*pipeline = NULL;
+	created = kern_calloc(1, sizeof(*created));
+	if (created == NULL)
+		return ENOMEM;
+	created->compute = 1;
+	error = build_compute(session, device, info, created);
+	if (error != 0) {
+		retired = bcm2711_vulkan_pipeline_release(session, created);
+		if (retired != 0)
+			return retired;
+		return error;
+	}
+
+	/* Succeeded: the caller publishes the complete pipeline. */
+	*pipeline = created;
+	return 0;
+}
+
+/* Acquires the layout and device, compiles the module and checks the program against the layout. */
+static int
+build_compute(
+	struct bcm2711_vulkan_session *session,
+	struct bcm2711_vulkan_object *device,
+	const VkComputePipelineCreateInfo *info,
+	struct bcm2711_vulkan_pipeline *pipeline)
+{
+	struct bcm2711_vulkan_object *layout_object;
+	struct bcm2711_vulkan_pipeline_layout *layout;
+	struct bcm2711_vulkan_module *module;
+	struct bcm2711_shader_diagnostic diagnostic;
+	struct bcm2711_shader_key key;
+	int error;
+
+	/* No derivative, cache or chained pipeline features. */
+	if (info->sType != VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO || info->pNext != NULL || info->flags != 0)
+		return ENOTSUP;
+	if (info->basePipelineHandle != VK_NULL_HANDLE)
+		return ENOTSUP;
+
+	/* The same-device layout and module. */
+	layout_object = bcm2711_vulkan_object_find(session, I915_VK_OBJ_PIPELINE_LAYOUT, (uint64_t)(uintptr_t)info->layout);
+	if (layout_object == NULL)
+		return EINVAL;
+	layout = layout_object->payload;
+	if (layout->owner.device != device)
+		return EINVAL;
+	error = compute_module(session, device, &info->stage, &module);
+	if (error != 0)
+		return error;
+
+	/* Each recorded edge owns only a successfully acquired reference. */
+	error = bcm2711_vulkan_object_retain(layout_object);
+	if (error != 0)
+		return error;
+	pipeline->owner.parent = layout_object;
+	error = bcm2711_vulkan_object_retain(device);
+	if (error != 0)
+		return error;
+	pipeline->owner.device = device;
+
+	/* A compute program needs no varying key. */
+	kern_memset(&key, 0, sizeof(key));
+	kern_memset(&diagnostic, 0, sizeof(diagnostic));
+	error = bcm2711_shader_compile(module->words, module->word_count, BCM2711_SHADER_COMPUTE, &key, &pipeline->programs[0], &diagnostic);
+	if (error != 0)
+		return error;
+
+	/* Every uniform the program reads has a binding of the right type visible to compute. */
+	error = compute_interface(pipeline->programs[0], layout);
+	if (error != 0)
+		return error;
+
+	/* Succeeded: the program can be dispatched with the layout's descriptors. */
+	return 0;
+}
+
+/* Selects the stage's same-device module with the single main GLCompute entry and no specialization. */
+static int
+compute_module(
+	struct bcm2711_vulkan_session *session,
+	struct bcm2711_vulkan_object *device,
+	const VkPipelineShaderStageCreateInfo *stage,
+	struct bcm2711_vulkan_module **module)
+{
+	struct bcm2711_vulkan_object *object;
+	struct bcm2711_vulkan_module *candidate;
+	int name;
+	int error;
+
+	/* One compute stage without extensions or specialization constants. */
+	if (stage->sType != VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO ||
+	    stage->pNext != NULL ||
+	    stage->flags != 0 ||
+	    stage->stage != VK_SHADER_STAGE_COMPUTE_BIT)
+		return ENOTSUP;
+	if (stage->pSpecializationInfo != NULL && stage->pSpecializationInfo->mapEntryCount != 0)
+		return ENOTSUP;
+	if (stage->pName == NULL)
+		return EINVAL;
+	name = kern_strcmp(stage->pName, "main");
+	if (name != 0)
+		return ENOTSUP;
+
+	/* The module belongs to the device. */
+	object = bcm2711_vulkan_object_find(session, I915_VK_OBJ_SHADER_MODULE, (uint64_t)(uintptr_t)stage->module);
+	if (object == NULL)
+		return EINVAL;
+	candidate = object->payload;
+	if (candidate->owner.device != device)
+		return EINVAL;
+	error = compute_entry(candidate);
+	if (error != 0)
+		return error;
+
+	/* Succeeded: the module stays stable under the controller mutex while it is compiled. */
+	*module = candidate;
+	return 0;
+}
+
+/* Requires exactly one entry point, "main", of the GLCompute model. */
+static int
+compute_entry(
+	const struct bcm2711_vulkan_module *module)
+{
+	uint32_t offset;
+	uint32_t length;
+	uint32_t opcode;
+	uint32_t entries;
+
+	/* Walks complete instructions after the header. */
+	entries = 0;
+	offset = 5;
+	while (offset < module->word_count) {
+		length = module->words[offset] >> 16;
+		opcode = module->words[offset] & 0xffffU;
+		if (length == 0 || length > module->word_count - offset)
+			return EINVAL;
+
+		/* OpEntryPoint: the model, then the name "main" with its terminator. */
+		if (opcode == 15U) {
+			if (entries != 0 || length < 5)
+				return ENOTSUP;
+			if (module->words[offset + 1] != COMPUTE_MODEL ||
+			    module->words[offset + 3] != 0x6e69616dU ||
+			    module->words[offset + 4] != 0)
+				return ENOTSUP;
+			entries++;
+		}
+		offset += length;
+	}
+
+	/* One entry is required. */
+	if (entries != 1)
+		return EINVAL;
+
+	/* Succeeded: the parser's single entry is the one Vulkan names. */
+	return 0;
+}
+
+/* Checks every uniform of a compute program against the layout's bindings and push ranges. */
+static int
+compute_interface(
+	const struct bcm2711_shader_binary *program,
+	const struct bcm2711_vulkan_pipeline_layout *layout)
+{
+	const struct bcm2711_shader_uniform *uniform;
+	const struct bcm2711_vulkan_set_layout *set;
+	const struct bcm2711_vulkan_binding_layout *binding;
+	VkDescriptorType type;
+	uint32_t index;
+	uint32_t candidate;
+
+	/* Each uniform the runtime fills from the bound state. */
+	for (index = 0; index < program->uniform_count; index++) {
+		uniform = &program->uniforms[index];
+		if (uniform->kind == BCM2711_SHADER_PUSH) {
+			if ((uniform->offset & 3U) != 0 || uniform->offset >= 4U * BCM2711_VULKAN_PUSH_WORDS)
+				return EINVAL;
+			if ((layout->push[uniform->offset / 4U] & VK_SHADER_STAGE_COMPUTE_BIT) == 0)
+				return EINVAL;
+			continue;
+		}
+
+		/* Constants and the dispatch's own words need no binding. */
+		type = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+		if (uniform->kind == BCM2711_SHADER_BLOCK) {
+			type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+		} else if (uniform->kind != BCM2711_SHADER_STORAGE_BASE &&
+			   uniform->kind != BCM2711_SHADER_STORAGE_LIMIT &&
+			   uniform->kind != BCM2711_SHADER_STORAGE_SIZE) {
+			continue;
+		}
+
+		/* The binding exists, has the type and is visible to compute. */
+		if (uniform->set >= layout->count)
+			return EINVAL;
+		set = layout->sets[uniform->set]->payload;
+		binding = NULL;
+		for (candidate = 0; candidate < set->count; candidate++) {
+			if (set->bindings[candidate].number == uniform->binding)
+				binding = &set->bindings[candidate];
+		}
+		if (binding == NULL)
+			return EINVAL;
+		if ((binding->stages & VK_SHADER_STAGE_COMPUTE_BIT) == 0)
+			return EINVAL;
+		if (binding->type != type)
+			return EINVAL;
+	}
+
+	/* Succeeded: every uniform has a compatible binding. */
+	return 0;
+}
