+
+/*
+ * HT2: compute programs compiled by the V3D 7.1 compiler and run on the
+ * compute dispatch model, compared with a C reference.
+ *
+ * Each GLSL program (plan/ws283/tests/compute/, compiled to SPIR-V by the
+ * script) is compiled with bcm2711_shader_compile, checked by the static
+ * rule checker, and run as one CSD job with the uniform stream the runtime
+ * would build from the program's uniform list.  Buffers sit inside larger
+ * host memory with canaries before and after their descriptor range, so a
+ * clamped access that strays shows as a changed canary and an unclamped
+ * one as an access outside every buffer.
+ */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "drivers/gpu/bcm2711/compiler/shader.h"
+#include "plan/ws283/tests/qpu71-compute-machine.h"
+#include "plan/ws283/tests/qpu71-rules.h"
+
+#define CANARY 0xcafef00dU
+#define CANARY_WORDS 16U
+#define MAX_BUFFERS 4U
+#define ARENA_ADDRESS 0x08000000U
+
+/* One bound storage buffer: its descriptor range inside host memory with canaries around it. */
+struct buffer {
+	uint32_t binding;
+	uint32_t words;
+	uint32_t *memory;
+	uint32_t address;
+};
+
+/* One dispatch of one program. */
+struct job {
+	const char *name;
+	struct bcm2711_shader_binary *binary;
+	struct buffer buffers[MAX_BUFFERS];
+	uint32_t buffer_count;
+	uint8_t push[64];
+	uint32_t groups[3];
+};
+
+static struct bcm2711_shader_binary *compile(const char *directory, const char *name);
+static void add_buffer(struct job *job, uint32_t binding, uint32_t words, const uint32_t *contents);
+static uint32_t *buffer_words(struct job *job, uint32_t binding);
+static void run(const struct v3d_device_info *device, struct job *job);
+static uint32_t supergroup(uint32_t size, uint32_t groups);
+static void free_job(struct job *job);
+static uint32_t float_bits(float number);
+static float bits_float(uint32_t bits);
+static void test_saxpy(const struct v3d_device_info *device, const char *directory);
+static void test_ids(const struct v3d_device_info *device, const char *directory);
+static void test_divide(const struct v3d_device_info *device, const char *directory);
+static void test_integer(const struct v3d_device_info *device, const char *directory);
+static void test_loops(const struct v3d_device_info *device, const char *directory);
+static void test_conv1x1(const struct v3d_device_info *device, const char *directory);
+static void test_shared(const struct v3d_device_info *device, const char *directory);
+
+/* The kernel allocation API on the host allocator, for the production compiler and parser. */
+void *kern_calloc(size_t count, size_t bytes);
+void *kern_malloc(size_t bytes);
+void *kern_realloc(void *pointer, size_t bytes);
+void kern_free(void *pointer);
+
+/* Allocates zeroed host memory. */
+void *
+kern_calloc(
+	size_t count,
+	size_t bytes)
+{
+	/* The host allocator. */
+	return calloc(count, bytes);
+}
+
+/* Allocates host memory. */
+void *
+kern_malloc(
+	size_t bytes)
+{
+	/* The host allocator. */
+	return malloc(bytes);
+}
+
+/* Grows host memory. */
+void *
+kern_realloc(
+	void *pointer,
+	size_t bytes)
+{
+	/* The host allocator. */
+	return realloc(pointer, bytes);
+}
+
+/* Releases host memory. */
+void
+kern_free(
+	void *pointer)
+{
+	/* The host allocator. */
+	free(pointer);
+}
+
+/*
+ * Compiles and runs every program.
+ */
+int
+main(
+	int argc,
+	char **argv)
+{
+	struct v3d_device_info device;
+
+	/* The directory of the compiled SPIR-V. */
+	if (argc != 2) {
+		fprintf(stderr, "usage: compute-host-test SPIRV-DIRECTORY\n");
+		return 2;
+	}
+	memset(&device, 0, sizeof(device));
+	device.ver = 71;
+	device.rev = 10;
+
+	/* The programs. */
+	test_saxpy(&device, argv[1]);
+	test_ids(&device, argv[1]);
+	test_divide(&device, argv[1]);
+	test_integer(&device, argv[1]);
+	test_loops(&device, argv[1]);
+	test_conv1x1(&device, argv[1]);
+	test_shared(&device, argv[1]);
+	puts("compute-host-test PASS");
+	return 0;
+}
+
+/* Compiles one SPIR-V file of the directory as a compute program. */
+static struct bcm2711_shader_binary *
+compile(
+	const char *directory,
+	const char *name)
+{
+	struct bcm2711_shader_binary *binary;
+	struct bcm2711_shader_diagnostic diagnostic;
+	struct bcm2711_shader_key key;
+	char path[512];
+	uint32_t *words;
+	long bytes;
+	FILE *file;
+	int error;
+
+	/* The whole file. */
+	snprintf(path, sizeof(path), "%s/%s.spv", directory, name);
+	file = fopen(path, "rb");
+	assert(file != NULL);
+	fseek(file, 0, SEEK_END);
+	bytes = ftell(file);
+	fseek(file, 0, SEEK_SET);
+	words = malloc((size_t)bytes);
+	assert(words != NULL);
+	assert(fread(words, 1, (size_t)bytes, file) == (size_t)bytes);
+	fclose(file);
+
+	/* The compile. */
+	memset(&key, 0, sizeof(key));
+	memset(&diagnostic, 0, sizeof(diagnostic));
+	binary = NULL;
+	error = bcm2711_shader_compile(words, (size_t)bytes / 4, BCM2711_SHADER_COMPUTE, &key, &binary, &diagnostic);
+	free(words);
+	if (error != 0) {
+		fprintf(stderr, "%s: compile error %d at %u: %s\n", name, error, diagnostic.instruction, diagnostic.reason != NULL ? diagnostic.reason : "(none)");
+		abort();
+	}
+	printf("%s: %u words, %u uniforms, %u threads, %s segment\n", name, binary->code_count, binary->uniform_count, binary->threads, binary->starts_final ? "single" : "multiple");
+	return binary;
+}
+
+/* Binds one buffer of set 0 with canaries around its range. */
+static void
+add_buffer(
+	struct job *job,
+	uint32_t binding,
+	uint32_t words,
+	const uint32_t *contents)
+{
+	struct buffer *buffer;
+	uint32_t index;
+
+	/* The memory holds canaries, the range, canaries. */
+	assert(job->buffer_count < MAX_BUFFERS);
+	buffer = &job->buffers[job->buffer_count];
+	buffer->binding = binding;
+	buffer->words = words;
+	buffer->memory = malloc((words + 2 * CANARY_WORDS) * sizeof(uint32_t));
+	assert(buffer->memory != NULL);
+	for (index = 0; index < words + 2 * CANARY_WORDS; index++)
+		buffer->memory[index] = CANARY;
+	if (contents != NULL)
+		memcpy(buffer->memory + CANARY_WORDS, contents, words * sizeof(uint32_t));
+	else
+		memset(buffer->memory + CANARY_WORDS, 0, words * sizeof(uint32_t));
+	buffer->address = 0x100000U * (job->buffer_count + 1) + CANARY_WORDS * 4;
+	job->buffer_count++;
+}
+
+/* Gives the range of the buffer of a binding. */
+static uint32_t *
+buffer_words(
+	struct job *job,
+	uint32_t binding)
+{
+	uint32_t index;
+
+	/* The buffer bound there. */
+	for (index = 0; index < job->buffer_count; index++) {
+		if (job->buffers[index].binding == binding)
+			return job->buffers[index].memory + CANARY_WORDS;
+	}
+	abort();
+}
+
+/* Builds the uniform stream, checks the program's rules and runs the job; the canaries must be intact. */
+static void
+run(
+	const struct v3d_device_info *device,
+	struct job *job)
+{
+	struct bcm2711_shader_binary *binary;
+	struct bcm2711_shader_uniform *uniform;
+	struct qpu71_compute_setup setup;
+	struct qpu71_compute_result result;
+	struct qpu71_compute_region regions[MAX_BUFFERS + 1];
+	uint8_t *arena;
+	uint32_t arena_bytes;
+	struct qpu71_rules_program rules;
+	struct buffer *buffer;
+	uint32_t *stream;
+	uint32_t index;
+	uint32_t word;
+	uint32_t bytes;
+	uint32_t found;
+	uint32_t size;
+
+	/* Each uniform the program names becomes the word the runtime would supply. */
+	binary = job->binary;
+	stream = calloc(binary->uniform_count + 1, sizeof(uint32_t));
+	assert(stream != NULL);
+	for (index = 0; index < binary->uniform_count; index++) {
+		uniform = &binary->uniforms[index];
+		buffer = NULL;
+		for (word = 0; word < job->buffer_count; word++) {
+			if (uniform->set == 0 && job->buffers[word].binding == uniform->binding)
+				buffer = &job->buffers[word];
+		}
+		switch (uniform->kind) {
+		case BCM2711_SHADER_CONSTANT:
+			stream[index] = uniform->bits;
+			break;
+		case BCM2711_SHADER_PUSH:
+			assert(uniform->offset + 4 <= sizeof(job->push));
+			memcpy(&stream[index], job->push + uniform->offset, 4);
+			break;
+		case BCM2711_SHADER_STORAGE_BASE:
+			assert(buffer != NULL);
+			stream[index] = buffer->address;
+			break;
+		case BCM2711_SHADER_STORAGE_LIMIT:
+			assert(buffer != NULL);
+			bytes = buffer->words * 4;
+			stream[index] = 0;
+			if (bytes >= uniform->bits)
+				stream[index] = bytes - uniform->bits;
+			break;
+		case BCM2711_SHADER_STORAGE_SIZE:
+			assert(buffer != NULL);
+			stream[index] = buffer->words * 4;
+			break;
+		case BCM2711_SHADER_GROUP_COUNT:
+			assert(uniform->bits < 3);
+			stream[index] = job->groups[uniform->bits];
+			break;
+		case BCM2711_SHADER_GROUP_BASE:
+			stream[index] = 0;
+			break;
+		case BCM2711_SHADER_SHARED_BASE:
+			stream[index] = ARENA_ADDRESS;
+			break;
+		case BCM2711_SHADER_SHARED_LIMIT:
+			stream[index] = binary->shared_bytes * job->groups[0] * job->groups[1] * job->groups[2] - uniform->bits;
+			break;
+		default:
+			fprintf(stderr, "%s: uniform kind %u not supplied by the test\n", job->name, uniform->kind);
+			abort();
+		}
+	}
+
+	/* The static rules. */
+	memset(&rules, 0, sizeof(rules));
+	rules.code = binary->code;
+	rules.count = binary->code_count;
+	rules.uniforms = stream;
+	rules.uniform_count = binary->uniform_count;
+	rules.threads = binary->threads;
+	rules.single_segment = binary->starts_final;
+	rules.compute = 1;
+	found = qpu71_rules_check(device, &rules, 0);
+	if (found != 0) {
+		fprintf(stderr, "%s: %u rules broken\n", job->name, found);
+		abort();
+	}
+
+	/* The regions are the whole host memory of each buffer, canaries included. */
+	for (index = 0; index < job->buffer_count; index++) {
+		buffer = &job->buffers[index];
+		regions[index].address = buffer->address - CANARY_WORDS * 4;
+		regions[index].size = (buffer->words + 2 * CANARY_WORDS) * 4;
+		regions[index].bytes = (uint8_t *)buffer->memory;
+		regions[index].writable = 1;
+	}
+	/* The shared arena: one slot per workgroup, like the runtime's. */
+	arena = NULL;
+	arena_bytes = binary->shared_bytes * job->groups[0] * job->groups[1] * job->groups[2];
+	if (arena_bytes != 0) {
+		arena = calloc(1, arena_bytes);
+		assert(arena != NULL);
+		regions[job->buffer_count].address = ARENA_ADDRESS;
+		regions[job->buffer_count].size = arena_bytes;
+		regions[job->buffer_count].bytes = arena;
+		regions[job->buffer_count].writable = 1;
+	}
+	memset(&setup, 0, sizeof(setup));
+	setup.code = binary->code;
+	setup.code_count = binary->code_count;
+	setup.uniforms = stream;
+	setup.uniform_count = binary->uniform_count;
+	setup.regions = regions;
+	setup.region_count = job->buffer_count;
+	if (arena != NULL)
+		setup.region_count++;
+	memcpy(setup.local_size, binary->local_size, sizeof(setup.local_size));
+	memcpy(setup.groups, job->groups, sizeof(setup.groups));
+	size = binary->local_size[0] * binary->local_size[1] * binary->local_size[2];
+	setup.workgroups_per_supergroup = supergroup(size, job->groups[0] * job->groups[1] * job->groups[2]);
+	if (binary->uses_barrier != 0 && setup.workgroups_per_supergroup * size > 8U * binary->threads / 2U * 16U)
+		setup.workgroups_per_supergroup = 8U * binary->threads / 2U * 16U / size;
+	setup.threads = binary->threads;
+	setup.single_segment = binary->starts_final;
+	setup.garbage_seed = 99;
+	qpu71_compute_run(device, &setup, &result);
+	printf("%s: %u batches in %u supergroups, %u words run, %u loads, %u stores\n", job->name, result.batches, result.supergroups, result.words, result.loads, result.stores);
+
+	/* No canary changed. */
+	for (index = 0; index < job->buffer_count; index++) {
+		buffer = &job->buffers[index];
+		for (word = 0; word < CANARY_WORDS; word++) {
+			assert(buffer->memory[word] == CANARY);
+			assert(buffer->memory[CANARY_WORDS + buffer->words + word] == CANARY);
+		}
+	}
+	free(stream);
+	free(arena);
+}
+
+/* Chooses the workgroups of a supergroup: one for a size of whole batches, else the count that wastes the fewest lanes. */
+static uint32_t
+supergroup(
+	uint32_t size,
+	uint32_t groups)
+{
+	uint32_t best;
+	uint32_t count;
+	uint32_t waste;
+	uint32_t least;
+
+	/* A size of whole batches needs no packing. */
+	if (size % 16 == 0)
+		return 1;
+	best = 1;
+	least = 0xffffffffU;
+	for (count = 1; count <= 16 && count <= groups; count++) {
+		waste = ((count * size + 15) / 16) * 16 - count * size;
+		if (waste < least) {
+			least = waste;
+			best = count;
+		}
+	}
+	return best;
+}
+
+/* Releases a job's buffers and program. */
+static void
+free_job(
+	struct job *job)
+{
+	uint32_t index;
+
+	/* Every buffer and the binary. */
+	for (index = 0; index < job->buffer_count; index++)
+		free(job->buffers[index].memory);
+	bcm2711_shader_binary_free(job->binary);
+}
+
+/* Converts a float to its bits. */
+static uint32_t
+float_bits(
+	float number)
+{
+	uint32_t bits;
+
+	/* A copy avoids aliasing assumptions. */
+	memcpy(&bits, &number, sizeof(bits));
+	return bits;
+}
+
+/* Converts bits to a float. */
+static float
+bits_float(
+	uint32_t bits)
+{
+	float number;
+
+	/* A copy avoids aliasing assumptions. */
+	memcpy(&number, &bits, sizeof(number));
+	return number;
+}
+
+/* saxpy over 1000 elements in workgroups of 64 (the last partial, its tail outside n). */
+static void
+test_saxpy(
+	const struct v3d_device_info *device,
+	const char *directory)
+{
+	struct job job;
+	uint32_t x[1024];
+	uint32_t y[1024];
+	uint32_t n;
+	uint32_t index;
+	float a;
+	float expected;
+	uint32_t *out;
+
+	/* The inputs; y beyond n must stay untouched. */
+	memset(&job, 0, sizeof(job));
+	job.name = "saxpy";
+	job.binary = compile(directory, "saxpy");
+	n = 1000;
+	a = 2.5f;
+	for (index = 0; index < 1024; index++) {
+		x[index] = float_bits((float)index * 0.25f);
+		y[index] = float_bits(1.0f - (float)index);
+	}
+	add_buffer(&job, 0, 1024, x);
+	add_buffer(&job, 1, 1024, y);
+	memcpy(job.push, &a, 4);
+	memcpy(job.push + 4, &n, 4);
+	job.groups[0] = 16;
+	job.groups[1] = 1;
+	job.groups[2] = 1;
+	run(device, &job);
+
+	/* Each element below n is a × x + y, computed in the same order as the program; the rest are as they were. */
+	out = buffer_words(&job, 1);
+	for (index = 0; index < 1024; index++) {
+		expected = bits_float(y[index]);
+		if (index < n)
+			expected = a * bits_float(x[index]) + bits_float(y[index]);
+		if (out[index] != float_bits(expected)) {
+			fprintf(stderr, "saxpy: element %u is %08x, expected %08x\n", index, out[index], float_bits(expected));
+			abort();
+		}
+	}
+	free_job(&job);
+	puts("saxpy: PASS");
+}
+
+/* Every built-in value for local size (4, 2, 3) and (3, 5, 2) workgroups. */
+static void
+test_ids(
+	const struct v3d_device_info *device,
+	const char *directory)
+{
+	struct job job;
+	uint32_t *out;
+	uint32_t gx;
+	uint32_t gy;
+	uint32_t gz;
+	uint32_t local;
+	uint32_t base;
+
+	/* One output buffer of ten words per invocation. */
+	memset(&job, 0, sizeof(job));
+	job.name = "ids";
+	job.binary = compile(directory, "ids");
+	add_buffer(&job, 0, 30 * 24 * 10, NULL);
+	job.groups[0] = 3;
+	job.groups[1] = 5;
+	job.groups[2] = 2;
+	run(device, &job);
+
+	/* Every invocation's values. */
+	out = buffer_words(&job, 0);
+	for (gz = 0; gz < 2; gz++) {
+		for (gy = 0; gy < 5; gy++) {
+			for (gx = 0; gx < 3; gx++) {
+				for (local = 0; local < 24; local++) {
+					base = (((gz * 5 + gy) * 3 + gx) * 24 + local) * 10;
+					assert(out[base + 0] == local % 4);
+					assert(out[base + 1] == (local / 4) % 2);
+					assert(out[base + 2] == local / 8);
+					assert(out[base + 3] == gx);
+					assert(out[base + 4] == gy);
+					assert(out[base + 5] == gz);
+					assert(out[base + 6] == 3);
+					assert(out[base + 7] == 5);
+					assert(out[base + 8] == 2);
+					assert(out[base + 9] == local);
+				}
+			}
+		}
+	}
+	free_job(&job);
+	puts("ids: PASS");
+}
+
+/* Quotients, remainders and signed moduli of edge values and pseudo-random pairs. */
+static void
+test_divide(
+	const struct v3d_device_info *device,
+	const char *directory)
+{
+	static const uint32_t edges[] = {0, 1, 2, 3, 7, 8, 255, 256, 0x7fffffffU, 0x80000000U, 0x80000001U, 0xfffffffeU, 0xffffffffU, 1000000007U, 65535, 65536};
+	struct job job;
+	uint32_t a[4096];
+	uint32_t b[4096];
+	uint32_t *out;
+	uint32_t index;
+	uint32_t seed;
+	int32_t sn;
+	int32_t sd;
+	int32_t modulo;
+	uint32_t count;
+	uint32_t failures;
+
+	/* Every pair of edges (divisor nonzero), then random pairs of mixed magnitudes. */
+	count = 0;
+	for (index = 0; index < 16 * 16; index++) {
+		if (edges[index % 16] == 0)
+			continue;
+		a[count] = edges[index / 16];
+		b[count] = edges[index % 16];
+		count++;
+	}
+	seed = 12345;
+	while (count < 4096) {
+		seed = seed * 1103515245U + 12345U;
+		a[count] = seed ^ (seed << 7);
+		seed = seed * 1103515245U + 12345U;
+		b[count] = (seed >> (seed % 31U)) | 1U;
+		if ((count & 7U) == 0)
+			b[count] = a[count] / 3U + 1U;
+		if ((count & 15U) == 1)
+			b[count] = a[count] + 1U;
+		if ((count & 15U) == 2)
+			b[count] = a[count];
+		if (b[count] == 0)
+			b[count] = 1;
+		count++;
+	}
+	memset(&job, 0, sizeof(job));
+	job.name = "divide";
+	job.binary = compile(directory, "divide");
+	add_buffer(&job, 0, 4096, a);
+	add_buffer(&job, 1, 4096, b);
+	add_buffer(&job, 2, 4096 * 6, NULL);
+	job.groups[0] = 64;
+	job.groups[1] = 1;
+	job.groups[2] = 1;
+	run(device, &job);
+
+	/* Each result against C; the signed quotient of the most negative by -1 is skipped (undefined). */
+	out = buffer_words(&job, 2);
+	failures = 0;
+	for (index = 0; index < 4096; index++) {
+		sn = (int32_t)a[index];
+		sd = (int32_t)b[index];
+		if (out[index * 6 + 0] != a[index] / b[index] || out[index * 6 + 1] != a[index] % b[index]) {
+			fprintf(stderr, "divide: %u / %u gave %u r %u\n", a[index], b[index], out[index * 6 + 0], out[index * 6 + 1]);
+			abort();
+		}
+		if (!(sn == INT32_MIN && sd == -1)) {
+			/* glslang makes int % an OpSMod: the result takes the divisor's sign. */
+			modulo = sn % sd;
+			if (modulo != 0 && (modulo < 0) != (sd < 0))
+				modulo += sd;
+			if (out[index * 6 + 2] != (uint32_t)(sn / sd) || out[index * 6 + 3] != (uint32_t)modulo) {
+				fprintf(stderr, "divide: %d / %d gave %d r %d\n", sn, sd, (int32_t)out[index * 6 + 2], (int32_t)out[index * 6 + 3]);
+				failures++;
+			}
+		}
+		assert(out[index * 6 + 4] == a[index] / 8);
+		assert(out[index * 6 + 5] == a[index] % 8);
+	}
+	assert(failures == 0);
+	free_job(&job);
+	puts("divide: PASS");
+}
+
+/* Products, comparisons and an out-of-range offset clamped to the buffer's last word. */
+static void
+test_integer(
+	const struct v3d_device_info *device,
+	const char *directory)
+{
+	struct job job;
+	uint32_t a[48];
+	uint32_t b[48];
+	uint32_t *out;
+	uint32_t index;
+	uint32_t flags;
+	uint32_t seed;
+
+	/* Mixed signs and equal pairs over two workgroups of 24. */
+	seed = 777;
+	for (index = 0; index < 48; index++) {
+		seed = seed * 1103515245U + 12345U;
+		a[index] = seed;
+		seed = seed * 1103515245U + 12345U;
+		b[index] = seed;
+		if (index % 5 == 0)
+			b[index] = a[index];
+		if (index % 7 == 0)
+			b[index] = a[index] ^ 0x80000000U;
+	}
+	memset(&job, 0, sizeof(job));
+	job.name = "integer";
+	job.binary = compile(directory, "integer");
+	add_buffer(&job, 0, 48, a);
+	add_buffer(&job, 1, 48, b);
+	add_buffer(&job, 2, 48 * 3 + 1, NULL);
+	job.groups[0] = 2;
+	job.groups[1] = 1;
+	job.groups[2] = 1;
+	run(device, &job);
+
+	/* Each invocation's three words; the far store landed on the clamped last word. */
+	out = buffer_words(&job, 2);
+	for (index = 0; index < 48; index++) {
+		flags = 0;
+		if (a[index] < b[index])
+			flags |= 1;
+		if (a[index] >= b[index])
+			flags |= 2;
+		if ((int32_t)a[index] < (int32_t)b[index])
+			flags |= 4;
+		if ((int32_t)a[index] >= (int32_t)b[index])
+			flags |= 8;
+		if (a[index] == b[index])
+			flags |= 16;
+		if (a[index] != b[index])
+			flags |= 32;
+		assert(out[index * 3 + 0] == a[index] * b[index]);
+		assert(out[index * 3 + 1] == flags);
+		assert(out[index * 3 + 2] == a[index] * 7 + b[index]);
+	}
+	assert(out[48 * 3] == 0xdead);
+	free_job(&job);
+	puts("integer: PASS");
+}
+
+/* Uniform, divergent and nested loops over two workgroups of 24. */
+static void
+test_loops(
+	const struct v3d_device_info *device,
+	const char *directory)
+{
+	struct job job;
+	uint32_t w[16];
+	uint32_t *out;
+	uint32_t index;
+	uint32_t n;
+	uint32_t c;
+	uint32_t t;
+	uint32_t j;
+	uint32_t a;
+	uint32_t b;
+	float s;
+
+	/* Eleven weights read by every invocation; out holds o[i] and the nested loop's words from 64 on. */
+	n = 11;
+	for (index = 0; index < 16; index++)
+		w[index] = float_bits((float)index * 1.5f);
+	memset(&job, 0, sizeof(job));
+	job.name = "loops";
+	job.binary = compile(directory, "loops");
+	add_buffer(&job, 0, 64 + 48 * 3, NULL);
+	add_buffer(&job, 1, 16, w);
+	memcpy(job.push, &n, 4);
+	job.groups[0] = 2;
+	job.groups[1] = 1;
+	job.groups[2] = 1;
+	run(device, &job);
+
+	/* Each invocation's results. */
+	s = 0.0f;
+	for (index = 0; index < n; index++)
+		s += bits_float(w[index]);
+	out = buffer_words(&job, 0);
+	for (index = 0; index < 48; index++) {
+		c = 0;
+		for (j = 0; j < index % 7; j++)
+			c += j + 1;
+		if (out[index] != c + (uint32_t)s) {
+			fprintf(stderr, "loops: o[%u] = %u, expected %u\n", index, out[index], c + (uint32_t)s);
+			abort();
+		}
+		t = 0;
+		for (a = 0; a < 3; a++) {
+			for (b = 0; b <= a; b++)
+				t += a * 10 + b;
+			assert(out[64 + index * 3 + a] == t);
+		}
+	}
+	free_job(&job);
+	puts("loops: PASS");
+}
+
+/* The representative 1x1 convolution: four output blocks of three input blocks over 100 pixels, within 1e-4. */
+static void
+test_conv1x1(
+	const struct v3d_device_info *device,
+	const char *directory)
+{
+	enum { CI = 3, PIXELS = 100, OUT = 4 };
+	struct job job;
+	static uint32_t x[CI * PIXELS * 4];
+	static uint32_t w[OUT * CI * 4 * 4];
+	uint32_t bias[OUT * 4];
+	uint32_t push[2];
+	uint32_t *out;
+	uint32_t index;
+	uint32_t ob;
+	uint32_t pixel;
+	uint32_t channel;
+	uint32_t ci;
+	uint32_t k;
+	uint32_t seed;
+	float accumulator;
+	float got;
+
+	/* Small pseudo-random inputs, weights and biases. */
+	seed = 4242;
+	for (index = 0; index < CI * PIXELS * 4; index++) {
+		seed = seed * 1103515245U + 12345U;
+		x[index] = float_bits((float)((int32_t)(seed >> 16) % 200 - 100) / 100.0f);
+	}
+	for (index = 0; index < OUT * CI * 16; index++) {
+		seed = seed * 1103515245U + 12345U;
+		w[index] = float_bits((float)((int32_t)(seed >> 16) % 200 - 100) / 400.0f);
+	}
+	for (index = 0; index < OUT * 4; index++)
+		bias[index] = float_bits((float)index / 16.0f - 0.5f);
+	memset(&job, 0, sizeof(job));
+	job.name = "conv1x1";
+	job.binary = compile(directory, "conv1x1");
+	add_buffer(&job, 0, CI * PIXELS * 4, x);
+	add_buffer(&job, 1, OUT * CI * 16, w);
+	add_buffer(&job, 2, OUT * 4, bias);
+	add_buffer(&job, 3, OUT * PIXELS * 4, NULL);
+	push[0] = CI;
+	push[1] = PIXELS;
+	memcpy(job.push, push, sizeof(push));
+	job.groups[0] = 1;
+	job.groups[1] = OUT / 2;
+	job.groups[2] = 1;
+	run(device, &job);
+
+	/* Each output channel of each pixel against the C sum. */
+	out = buffer_words(&job, 3);
+	for (ob = 0; ob < OUT; ob++) {
+		for (pixel = 0; pixel < PIXELS; pixel++) {
+			for (channel = 0; channel < 4; channel++) {
+				accumulator = 0.0f;
+				for (ci = 0; ci < CI; ci++) {
+					for (k = 0; k < 4; k++)
+						accumulator += bits_float(w[((ob * CI + ci) * 4 + k) * 4 + channel]) * bits_float(x[(ci * PIXELS + pixel) * 4 + k]);
+				}
+				accumulator += bits_float(bias[ob * 4 + channel]);
+				accumulator = accumulator / (1.0f + expf(-accumulator));
+				got = bits_float(out[(ob * PIXELS + pixel) * 4 + channel]);
+				if (fabsf(got - accumulator) > 1e-4f * (1.0f + fabsf(accumulator))) {
+					fprintf(stderr, "conv1x1: block %u pixel %u channel %u is %g, expected %g\n", ob, pixel, channel, got, accumulator);
+					abort();
+				}
+			}
+		}
+	}
+	free_job(&job);
+	puts("conv1x1: PASS");
+}
+
+/* Shared memory and barriers over five workgroups of 24 packed into supergroups. */
+static void
+test_shared(
+	const struct v3d_device_info *device,
+	const char *directory)
+{
+	struct job job;
+	uint32_t a[120];
+	uint32_t *out;
+	uint32_t index;
+	uint32_t group;
+	uint32_t local;
+	uint32_t sum;
+
+	/* Distinct values per invocation. */
+	for (index = 0; index < 120; index++)
+		a[index] = index * 7U + 3U;
+	memset(&job, 0, sizeof(job));
+	job.name = "shared";
+	job.binary = compile(directory, "shared");
+	assert(job.binary->uses_barrier != 0);
+	assert(job.binary->shared_bytes == 112);
+	add_buffer(&job, 0, 120, a);
+	add_buffer(&job, 1, 240, NULL);
+	job.groups[0] = 5;
+	job.groups[1] = 1;
+	job.groups[2] = 1;
+	run(device, &job);
+
+	/* The neighbour's value and the workgroup's sum. */
+	out = buffer_words(&job, 1);
+	for (group = 0; group < 5; group++) {
+		sum = 0;
+		for (local = 0; local < 24; local++)
+			sum += a[group * 24 + local];
+		for (local = 0; local < 24; local++) {
+			index = group * 24 + local;
+			assert(out[index * 2] == a[group * 24 + (local + 1) % 24]);
+			assert(out[index * 2 + 1] == sum);
+		}
+	}
+	free_job(&job);
+	puts("shared: PASS");
+}
diff --git a/plan/ws283/tests/compute-host-test.sh b/plan/ws283/tests/compute-host-test.sh
new file mode 100644
index 0000000000..4135436e29
--- /dev/null
+++ b/plan/ws283/tests/compute-host-test.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# HT2: the compute programs of plan/ws283/tests/compute/ compiled (glslc) and then compiled again by the V3D 7.1
+# compiler, checked by the static rule checker and run on the compute dispatch model against a C reference,
+# with the unmodified MIT Mesa 26.2.6 decoder as the model's decoder.
+# Usage: sh plan/ws283/tests/compute-host-test.sh [output-directory]
+set -eu
+out=${1:-build/ws283-compute-host}
+sh plan/ws283/tests/mesa-oracle.sh "$out"
+mesa=$out/mesa-26.2.6/src
+mkdir -p "$out/spirv"
+for shader in plan/ws283/tests/compute/*.comp; do
+    name=$(basename "$shader" .comp)
+    glslc -O0 --target-env=vulkan1.0 -o "$out/spirv/$name.spv" "$shader"
+done
+compiler=src/drivers/gpu/bcm2711/compiler
+cc -std=c99 -O1 -ffp-contract=off -Wall -Wextra -Werror -Iinclude -Isrc -I. -I"$out/mesa-host" -I"$mesa" \
+    plan/ws283/tests/compute-host-test.c plan/ws283/tests/qpu71-compute-machine.c plan/ws283/tests/qpu71-rules.c \
+    src/drivers/gpu/compiler/spirv.c src/drivers/gpu/compiler/optimize.c \
+    $compiler/shader.c $compiler/shader-analyze.c $compiler/shader71-lower.c $compiler/shader71-output.c \
+    $compiler/shader71-schedule.c $compiler/shader-compute.c $compiler/qpu71.c $compiler/qpu-branch.c \
+    "$out/mesa-pack.o" "$out/mesa-instr.o" -lm -o "$out/compute-host-test"
+timeout 600 "$out/compute-host-test" "$out/spirv"
diff --git a/plan/ws283/tests/compute/conv1x1.comp b/plan/ws283/tests/compute/conv1x1.comp
new file mode 100644
index 0000000000..612b24ee83
--- /dev/null
+++ b/plan/ws283/tests/compute/conv1x1.comp
@@ -0,0 +1,38 @@
+#version 450
+// A representative WS284 1x1 convolution in the C4 layout (blocks of four channels, one vec4 per pixel):
+// two output blocks (eight channels) for two pixels per invocation, a loop over the input blocks whose count is
+// a push constant, the output block pair chosen by gl_WorkGroupID.y (uniform, for the weight reads), bias and SiLU.
+layout(local_size_x = 64) in;
+layout(set = 0, binding = 0) readonly buffer I { vec4 x[]; };
+layout(set = 0, binding = 1) readonly buffer W { vec4 w[]; };
+layout(set = 0, binding = 2) readonly buffer B { vec4 bias[]; };
+layout(set = 0, binding = 3) buffer O { vec4 y[]; };
+layout(push_constant) uniform P { uint ci_blocks; uint pixels; } pc;
+void main()
+{
+	uint p0 = gl_GlobalInvocationID.x * 2u;
+	uint ob = gl_WorkGroupID.y * 2u;
+	vec4 a0 = vec4(0.0), a1 = vec4(0.0), b0 = vec4(0.0), b1 = vec4(0.0);
+	for (uint ci = 0u; ci < pc.ci_blocks; ci++) {
+		vec4 u = x[ci * pc.pixels + p0];
+		vec4 v = x[ci * pc.pixels + p0 + 1u];
+		uint wb = ((ob * pc.ci_blocks) + ci) * 4u;
+		uint wc = (((ob + 1u) * pc.ci_blocks) + ci) * 4u;
+		a0 += w[wb + 0u] * u.x + w[wb + 1u] * u.y + w[wb + 2u] * u.z + w[wb + 3u] * u.w;
+		a1 += w[wb + 0u] * v.x + w[wb + 1u] * v.y + w[wb + 2u] * v.z + w[wb + 3u] * v.w;
+		b0 += w[wc + 0u] * u.x + w[wc + 1u] * u.y + w[wc + 2u] * u.z + w[wc + 3u] * u.w;
+		b1 += w[wc + 0u] * v.x + w[wc + 1u] * v.y + w[wc + 2u] * v.z + w[wc + 3u] * v.w;
+	}
+	a0 += bias[ob]; a1 += bias[ob];
+	b0 += bias[ob + 1u]; b1 += bias[ob + 1u];
+	a0 = a0 / (1.0 + exp(-a0)); a1 = a1 / (1.0 + exp(-a1));
+	b0 = b0 / (1.0 + exp(-b0)); b1 = b1 / (1.0 + exp(-b1));
+	if (p0 < pc.pixels) {
+		y[ob * pc.pixels + p0] = a0;
+		y[(ob + 1u) * pc.pixels + p0] = b0;
+	}
+	if (p0 + 1u < pc.pixels) {
+		y[ob * pc.pixels + p0 + 1u] = a1;
+		y[(ob + 1u) * pc.pixels + p0 + 1u] = b1;
+	}
+}
diff --git a/plan/ws283/tests/compute/divide.comp b/plan/ws283/tests/compute/divide.comp
new file mode 100644
index 0000000000..0255d0f525
--- /dev/null
+++ b/plan/ws283/tests/compute/divide.comp
@@ -0,0 +1,18 @@
+#version 450
+// Unsigned and signed quotients and remainders (int % is an OpSMod) of computed operands.
+layout(local_size_x = 64) in;
+layout(set = 0, binding = 0) readonly buffer A { uint a[]; };
+layout(set = 0, binding = 1) readonly buffer B { uint b[]; };
+layout(set = 0, binding = 2) buffer O { uint o[]; };
+void main()
+{
+	uint i = gl_GlobalInvocationID.x;
+	uint n = a[i];
+	uint d = b[i];
+	o[i * 6u + 0u] = n / d;
+	o[i * 6u + 1u] = n % d;
+	o[i * 6u + 2u] = uint(int(n) / int(d));
+	o[i * 6u + 3u] = uint(int(n) % int(d));
+	o[i * 6u + 4u] = n / 8u;
+	o[i * 6u + 5u] = n % 8u;
+}
diff --git a/plan/ws283/tests/compute/ids.comp b/plan/ws283/tests/compute/ids.comp
new file mode 100644
index 0000000000..066f3d4951
--- /dev/null
+++ b/plan/ws283/tests/compute/ids.comp
@@ -0,0 +1,19 @@
+#version 450
+// Every built-in value of every invocation, ten words per invocation.
+layout(local_size_x = 4, local_size_y = 2, local_size_z = 3) in;
+layout(set = 0, binding = 0) buffer O { uint o[]; };
+void main()
+{
+	uint group = (gl_WorkGroupID.z * gl_NumWorkGroups.y + gl_WorkGroupID.y) * gl_NumWorkGroups.x + gl_WorkGroupID.x;
+	uint base = (group * 24u + gl_LocalInvocationIndex) * 10u;
+	o[base + 0u] = gl_LocalInvocationID.x;
+	o[base + 1u] = gl_LocalInvocationID.y;
+	o[base + 2u] = gl_LocalInvocationID.z;
+	o[base + 3u] = gl_WorkGroupID.x;
+	o[base + 4u] = gl_WorkGroupID.y;
+	o[base + 5u] = gl_WorkGroupID.z;
+	o[base + 6u] = gl_NumWorkGroups.x;
+	o[base + 7u] = gl_NumWorkGroups.y;
+	o[base + 8u] = gl_NumWorkGroups.z;
+	o[base + 9u] = gl_LocalInvocationIndex;
+}
diff --git a/plan/ws283/tests/compute/integer.comp b/plan/ws283/tests/compute/integer.comp
new file mode 100644
index 0000000000..b27dd4e030
--- /dev/null
+++ b/plan/ws283/tests/compute/integer.comp
@@ -0,0 +1,23 @@
+#version 450
+// Integer products and comparisons, and an offset far outside the buffer.
+layout(local_size_x = 24) in;
+layout(set = 0, binding = 0) readonly buffer A { uint a[]; };
+layout(set = 0, binding = 1) readonly buffer B { uint b[]; };
+layout(set = 0, binding = 2) buffer O { uint o[]; };
+void main()
+{
+	uint i = gl_GlobalInvocationID.x;
+	uint x = a[i];
+	uint y = b[i];
+	uint flags = 0u;
+	if (x < y) flags |= 1u;
+	if (x >= y) flags |= 2u;
+	if (int(x) < int(y)) flags |= 4u;
+	if (int(x) >= int(y)) flags |= 8u;
+	if (x == y) flags |= 16u;
+	if (x != y) flags |= 32u;
+	o[i * 3u + 0u] = x * y;
+	o[i * 3u + 1u] = flags;
+	o[i * 3u + 2u] = x * 7u + y;
+	o[i * 3u + 0x10000000u] = 0xdeadu;
+}
diff --git a/plan/ws283/tests/compute/loops.comp b/plan/ws283/tests/compute/loops.comp
new file mode 100644
index 0000000000..55c3f21c14
--- /dev/null
+++ b/plan/ws283/tests/compute/loops.comp
@@ -0,0 +1,23 @@
+#version 450
+// A uniform loop over a weight buffer, a divergent loop, and a nested loop with a store inside.
+layout(local_size_x = 24) in;
+layout(set = 0, binding = 0) buffer O { uint o[]; };
+layout(set = 0, binding = 1) readonly buffer W { float w[]; };
+layout(push_constant) uniform P { uint n; } pc;
+void main()
+{
+	uint i = gl_GlobalInvocationID.x;
+	float s = 0.0;
+	for (uint k = 0u; k < pc.n; k++)
+		s += w[k];
+	uint c = 0u;
+	for (uint j = 0u; j < i % 7u; j++)
+		c += j + 1u;
+	uint t = 0u;
+	for (uint a = 0u; a < 3u; a++) {
+		for (uint b = 0u; b <= a; b++)
+			t += a * 10u + b;
+		o[64u + i * 3u + a] = t;
+	}
+	o[i] = c + uint(s);
+}
diff --git a/plan/ws283/tests/compute/saxpy.comp b/plan/ws283/tests/compute/saxpy.comp
new file mode 100644
index 0000000000..48fd1d09c6
--- /dev/null
+++ b/plan/ws283/tests/compute/saxpy.comp
@@ -0,0 +1,12 @@
+#version 450
+// y[i] = a * x[i] + y[i] for i < n.
+layout(local_size_x = 64) in;
+layout(set = 0, binding = 0) readonly buffer X { float x[]; };
+layout(set = 0, binding = 1) buffer Y { float y[]; };
+layout(push_constant) uniform P { float a; uint n; } pc;
+void main()
+{
+	uint i = gl_GlobalInvocationID.x;
+	if (i < pc.n)
+		y[i] = pc.a * x[i] + y[i];
+}
diff --git a/plan/ws283/tests/compute/shared.comp b/plan/ws283/tests/compute/shared.comp
new file mode 100644
index 0000000000..9bd4a9db85
--- /dev/null
+++ b/plan/ws283/tests/compute/shared.comp
@@ -0,0 +1,24 @@
+#version 450
+// Shared memory across a barrier: each invocation stores its value, waits, reads its neighbour's, and a second
+// pair of barriers sums the workgroup in two steps (an unrolled reduction; a barrier in a loop is refused).
+layout(local_size_x = 24) in;
+layout(set = 0, binding = 0) readonly buffer A { uint a[]; };
+layout(set = 0, binding = 1) buffer O { uint o[]; };
+shared uint s[24];
+shared uint partial[4];
+void main()
+{
+	uint l = gl_LocalInvocationID.x;
+	uint i = gl_GlobalInvocationID.x;
+	s[l] = a[i];
+	barrier();
+	o[i * 2u] = s[(l + 1u) % 24u];
+	if (l < 4u) {
+		uint t = 0u;
+		for (uint k = 0u; k < 6u; k++)
+			t += s[l * 6u + k];
+		partial[l] = t;
+	}
+	barrier();
+	o[i * 2u + 1u] = partial[0] + partial[1] + partial[2] + partial[3];
+}
