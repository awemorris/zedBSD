diff --git a/src/drivers/gpu/bcm2711/vk/vulkan-compute-config.c b/src/drivers/gpu/bcm2711/vk/vulkan-compute-config.c
new file mode 100644
index 0000000000..5864deb412
--- /dev/null
+++ b/src/drivers/gpu/bcm2711/vk/vulkan-compute-config.c
@@ -0,0 +1,138 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The CSD configuration of a compute dispatch, separate from the job so a
+ * host test can check it alone.
+ */
+#include "drivers/gpu/bcm2711/vk/vulkan-compute-config.h"
+
+/*
+ * The CSD configuration fields.
+ *
+ * Values referenced: Mesa 26.2.6 src/broadcom/common/v3d_csd.h and
+ * src/broadcom/vulkan/v3dv_cmd_buffer.c (the CFG0 to CFG6 words: the
+ * workgroup count in the top half of CFG0 to CFG2; CFG3's workgroups per
+ * supergroup at bit 8, batches per supergroup minus one at bit 12 and the
+ * workgroup size in the low byte, 256 written as 0; CFG5's single segment
+ * bit 1 and four-thread bit 0).
+ */
+#define COMPUTE_COUNT_SHIFT 16
+#define COMPUTE_SUPERGROUP_SHIFT 8
+#define COMPUTE_BATCHES_SHIFT 12
+#define COMPUTE_SINGLE_SEGMENT 2U
+#define COMPUTE_FOUR_THREADS 1U
+#define COMPUTE_LANES 16U
+
+static uint32_t supergroup(uint32_t size, uint32_t groups, uint32_t barrier, uint32_t threads);
+
+/*
+ * Computes CFG0 to CFG6 of a CSD job running a whole dispatch; minus_one
+ * says the engine takes the batch count minus one.
+ */
+void
+bcm2711_vulkan_compute_configuration(
+	const struct bcm2711_shader_binary *program,
+	const uint32_t *groups,
+	bool minus_one,
+	uint32_t code,
+	uint32_t uniforms,
+	uint32_t *configuration)
+{
+	uint32_t size;
+	uint32_t total;
+	uint32_t per_supergroup;
+	uint32_t batches_per_supergroup;
+	uint32_t batches;
+	uint32_t remainder;
+
+	/*
+	 * The workgroups of a supergroup share batches of sixteen lanes; the
+	 * batch count is the whole supergroups' plus the last, partial one's.
+	 */
+	size = program->local_size[0] * program->local_size[1] * program->local_size[2];
+	total = groups[0] * groups[1] * groups[2];
+	per_supergroup = supergroup(size, total, program->uses_barrier, program->threads);
+	batches_per_supergroup = (per_supergroup * size + COMPUTE_LANES - 1U) / COMPUTE_LANES;
+	remainder = total % per_supergroup;
+	batches = batches_per_supergroup * (total / per_supergroup) + (remainder * size + COMPUTE_LANES - 1U) / COMPUTE_LANES;
+
+	/* The counts, the supergroup and the batches. */
+	configuration[0] = groups[0] << COMPUTE_COUNT_SHIFT;
+	configuration[1] = groups[1] << COMPUTE_COUNT_SHIFT;
+	configuration[2] = groups[2] << COMPUTE_COUNT_SHIFT;
+	configuration[3] = ((per_supergroup & 0xfU) << COMPUTE_SUPERGROUP_SHIFT) |
+				((batches_per_supergroup - 1U) << COMPUTE_BATCHES_SHIFT) |
+				(size & 0xffU);
+	configuration[4] = batches;
+	if (minus_one)
+		configuration[4] = batches - 1U;
+
+	/* The code with its segment and threading bits, and the uniform stream. */
+	configuration[5] = code;
+	if (program->starts_final != 0)
+		configuration[5] |= COMPUTE_SINGLE_SEGMENT;
+	if (program->threads == 4)
+		configuration[5] |= COMPUTE_FOUR_THREADS;
+	configuration[6] = uniforms;
+}
+
+/*
+ * Chooses the workgroups of a supergroup: one for a size of whole batches,
+ * otherwise the count up to sixteen (and the dispatch's) that leaves the
+ * fewest idle lanes.
+ *
+ * A program with a barrier waits for its whole supergroup, so a
+ * supergroup takes at most half the QPU threads (counted for eight QPUs,
+ * the smaller engine, which is safe on both) and the other half can run.
+ *
+ * Values referenced: Mesa 26.2.6 src/broadcom/common/v3d_util.c
+ * (v3d_csd_choose_workgroups_per_supergroup).
+ */
+static uint32_t
+supergroup(
+	uint32_t size,
+	uint32_t groups,
+	uint32_t barrier,
+	uint32_t threads)
+{
+	uint32_t best;
+	uint32_t count;
+	uint32_t waste;
+	uint32_t least;
+	uint32_t most;
+	uint32_t batches;
+
+	/* Whole batches need no packing. */
+	if (size % COMPUTE_LANES == 0)
+		return 1;
+
+	/* The barrier's limit on the supergroup's batches. */
+	most = 16;
+	if (barrier != 0) {
+		batches = size;
+		if (batches > 8U * threads / 2U)
+			batches = 8U * threads / 2U;
+		most = batches * COMPUTE_LANES / size;
+		if (most == 0)
+			most = 1;
+		if (most > 16)
+			most = 16;
+	}
+
+	/* The count that wastes the fewest lanes, the smallest on a tie. */
+	best = 1;
+	least = 0xffffffffU;
+	for (count = 1; count <= most && count <= groups; count++) {
+		waste = ((count * size + COMPUTE_LANES - 1U) / COMPUTE_LANES) * COMPUTE_LANES - count * size;
+		if (waste < least) {
+			least = waste;
+			best = count;
+		}
+	}
+	return best;
+}
