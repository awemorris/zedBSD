index 377a8efab6..3a98154d99 100644
--- a/src/drivers/gpu/bcm2711/compiler/qpu.h
+++ b/src/drivers/gpu/bcm2711/compiler/qpu.h
@@ -79,7 +79,19 @@ enum bcm2711_qpu_operation {
 	BCM2711_QPU_PIXEL_X,
 	BCM2711_QPU_PIXEL_Y,
 	BCM2711_QPU_INSTANCE_INDEX,
-	BCM2711_QPU_ELEMENT_INDEX
+	BCM2711_QPU_ELEMENT_INDEX,
+
+	/* The index of the QPU thread running the lane (the hardware thread number). */
+	BCM2711_QPU_THREAD_INDEX,
+
+	/* Reports the lane's barrier identity; written to the barrier magic address, it joins the workgroup barrier. */
+	BCM2711_QPU_BARRIER_ID,
+
+	/* Latches the high part of a 32-bit integer product of its two sources for the next MULTIPLY_24. */
+	BCM2711_QPU_MULTIPLY_TOP,
+
+	/* The low 24-bit product of its two sources plus the part MULTIPLY_TOP latched: the low 32 bits of the full product. */
+	BCM2711_QPU_MULTIPLY_24
 };
 
 /* Signals describe one hardware transaction; delay and termination scheduling stays with the compiler. */
@@ -136,8 +148,44 @@ struct bcm2711_qpu_bundle {
 	uint32_t thread_switch;
 };
 
+/* The lane flag condition under which a branch is taken; the A flags are the ones a flag push sets. */
+enum bcm2711_qpu_branch_condition {
+	BCM2711_QPU_BRANCH_ALWAYS,
+	BCM2711_QPU_BRANCH_LANE0_A,
+	BCM2711_QPU_BRANCH_LANE0_NOT_A,
+	BCM2711_QPU_BRANCH_ALL_A,
+	BCM2711_QPU_BRANCH_ANY_NOT_A,
+	BCM2711_QPU_BRANCH_ANY_A,
+	BCM2711_QPU_BRANCH_ALL_NOT_A
+};
+
+/* Which lanes a branch condition ignores: none, the lanes the multisample flags P mark out, or those Q marks out. */
+enum bcm2711_qpu_branch_ignore {
+	BCM2711_QPU_BRANCH_IGNORE_NONE,
+	BCM2711_QPU_BRANCH_IGNORE_P,
+	BCM2711_QPU_BRANCH_IGNORE_Q
+};
+
+/*
+ * One relative branch word.
+ *
+ * The three words after the branch always execute.  The target is counted
+ * in words from the word after those three delay slots.  A branch that
+ * moves the uniform stream reads its byte offset from the stream itself,
+ * relative to the uniform after the one the branch reads.
+ */
+struct bcm2711_qpu_branch {
+	enum bcm2711_qpu_branch_condition condition;
+	enum bcm2711_qpu_branch_ignore ignore;
+	int32_t words;
+
+	/* Set to move the uniform stream by the relative byte offset in the branch's own uniform when the branch is taken. */
+	uint32_t uniform_relative;
+};
+
 int bcm2711_qpu_encode(const struct bcm2711_qpu_instruction *instruction, uint64_t *word);
 int bcm2711_qpu_encode_bundle(const struct bcm2711_qpu_bundle *bundle, uint64_t *word);
+int bcm2711_qpu_encode_branch(const struct bcm2711_qpu_branch *branch, uint64_t *word);
 int bcm2711_qpu_small_constant(uint32_t bits, uint32_t *encoded);
 enum bcm2711_qpu_unit bcm2711_qpu_operation_unit(enum bcm2711_qpu_operation operation);
 uint32_t bcm2711_qpu_operation_sources(enum bcm2711_qpu_operation operation);
