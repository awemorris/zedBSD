--- /dev/null
+++ b/src/drivers/gpu/bcm2711/vk/vulkan-native-compute.c
@@ -0,0 +1,298 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The native execution of one prepared vkCmdDispatch as one CSD job.
+ *
+ * The program is uploaded, its uniform stream is built from the event's
+ * descriptor snapshot, push words and workgroup counts, the CSD
+ * configuration is computed from the workgroup size, and the job runs to
+ * completion; the runner flushes the caches before it and drains the TMU
+ * writes and cleans L2T after it.
+ *
+ * A storage buffer's limit is its range less the access size, so the
+ * program's clamped addresses stay inside the bound range: the GPU page
+ * table serves every session, and the clamp keeps a program out of the
+ * others' memory.
+ */
+#include <kern/dcache.h>
+#include <kern/device-io.h>
+#include <kern/kcrt.h>
+#include <uapi/errno.h>
+
+#include "drivers/gpu/bcm2711/render-device.h"
+#include "drivers/gpu/bcm2711/native-storage.h"
+#include "drivers/gpu/bcm2711/v3d-job.h"
+#include "drivers/gpu/bcm2711/vk/vulkan-native-compute.h"
+
+static int indirect_groups(const struct bcm2711_vulkan_prepared_event *event, uint32_t *groups);
+static int build_uniforms(const struct bcm2711_vulkan_prepared_event *event, const uint32_t *groups, uint32_t arena, uint32_t arena_bytes, uint32_t *words);
+static int storage_descriptor(const struct bcm2711_vulkan_prepared_event *event, const struct bcm2711_shader_uniform *uniform, const struct bcm2711_vulkan_descriptor **descriptor);
+
+/*
+ * Runs one prepared dispatch to completion under the controller mutex.
+ */
+int
+bcm2711_vulkan_native_compute_run(
+	struct bcm2711_render_device *controller,
+	struct bcm2711_render_session *session,
+	const struct bcm2711_vulkan_prepared_event *event)
+{
+	const struct bcm2711_shader_binary *program;
+	struct bcm2711_native_storage *code;
+	struct bcm2711_native_storage *uniforms;
+	struct bcm2711_native_storage *shared;
+	uint64_t arena_bytes;
+	uint32_t arena;
+	struct bcm2711_v3d_job job;
+	struct bcm2711_v3d_job_result result;
+	uint32_t *words;
+	uint32_t groups[3];
+	bool minus_one;
+	int error;
+	int released;
+	int synchronized;
+
+	/* The counts: recorded, or read from the indirect buffer now that every earlier job has retired. */
+	program = event->pipeline->programs[0];
+	groups[0] = event->draw[0];
+	groups[1] = event->draw[1];
+	groups[2] = event->draw[2];
+	if (event->opcode == GPU_OP_CMD_DISPATCH_INDIRECT) {
+		error = indirect_groups(event, groups);
+		if (error != 0)
+			return error;
+	}
+
+	/* A dispatch with no workgroup along some axis does nothing. */
+	if (groups[0] == 0 || groups[1] == 0 || groups[2] == 0)
+		return 0;
+	if (program->uniform_count == 0)
+		return EINVAL;
+
+	/* The shared memory arena: one slot per workgroup of the job, at most 16 MiB (a larger one is not split yet). */
+	arena_bytes = (uint64_t)program->shared_bytes * groups[0] * groups[1] * groups[2];
+	if (arena_bytes > 16U * 1024U * 1024U)
+		return ENOTSUP;
+
+	/* The code, the uniform stream and the arena are placed in native storage owned by this session's build. */
+	code = NULL;
+	uniforms = NULL;
+	shared = NULL;
+	arena = 0;
+	error = bcm2711_v3d_memory_begin(&controller->space);
+	if (error != 0)
+		return error;
+	controller->space.builder = session->owner;
+	error = bcm2711_native_program_upload(&controller->space, program, &code);
+	if (error == 0)
+		error = bcm2711_native_storage_create_as(&controller->space, (uint64_t)program->uniform_count * 4U, BCM2711_NATIVE_STORAGE_WRITTEN, &uniforms);
+	if (error == 0 && arena_bytes != 0) {
+		error = bcm2711_native_storage_create_as(&controller->space, arena_bytes, BCM2711_NATIVE_STORAGE_OWNED, &shared);
+		if (error == 0)
+			error = bcm2711_native_storage_clean(shared);
+		if (error == 0)
+			arena = shared->view->address;
+	}
+	if (error == 0) {
+		words = (uint32_t *)(void *)uniforms->view->buffer->address;
+		error = build_uniforms(event, groups, arena, (uint32_t)arena_bytes, words);
+	}
+	if (error == 0)
+		error = bcm2711_native_storage_clean(uniforms);
+	controller->space.builder = 0;
+	synchronized = bcm2711_v3d_memory_end(&controller->space);
+	if (error == 0 && synchronized != 0)
+		error = synchronized;
+	if (error != 0) {
+		released = bcm2711_native_storage_release(&controller->space, &shared, true);
+		if (released == 0)
+			released = bcm2711_native_storage_release(&controller->space, &uniforms, true);
+		if (released == 0)
+			released = bcm2711_native_storage_release(&controller->space, &code, true);
+		if (released != 0)
+			return released;
+		return error;
+	}
+
+	/* The CSD job of the whole dispatch. */
+	kern_memset(&job, 0, sizeof(job));
+	job.kind = BCM2711_V3D_JOB_COMPUTE;
+	minus_one = bcm2711_v3d_csd_batches_minus_one(controller->space.native);
+	bcm2711_vulkan_compute_configuration(program, groups, minus_one, code->view->address, uniforms->view->address, job.command.compute.configuration);
+	job.command.compute.shader_bytes = program->code_count * 8U;
+	job.command.compute.uniform_bytes = program->uniform_count * 4U;
+	kern_io_write_barrier();
+	kern_memset(&result, 0, sizeof(result));
+	error = bcm2711_v3d_job_run(controller->space.native, &job, &result);
+
+	/* A job not proved retired keeps its storage until a checked reset. */
+	released = bcm2711_native_storage_release(&controller->space, &shared, result.retired);
+	if (released == 0)
+		released = bcm2711_native_storage_release(&controller->space, &uniforms, result.retired);
+	if (released == 0)
+		released = bcm2711_native_storage_release(&controller->space, &code, result.retired);
+	if (error != 0)
+		return error;
+	if (released != 0)
+		return released;
+	if (!result.retired)
+		return EIO;
+
+	/* Completion and the L2T clean precede a CPU read of the storage buffers. */
+	kern_io_read_barrier();
+
+	/* Succeeded: the dispatch ran and its stores reached memory. */
+	return 0;
+}
+
+/*
+ * Reads an indirect dispatch's three counts past the CPU caches; a count
+ * above 65535 fails the dispatch (the device-lost case of the design).
+ */
+static int
+indirect_groups(
+	const struct bcm2711_vulkan_prepared_event *event,
+	uint32_t *groups)
+{
+	struct bcm2711_v3d_view *view;
+	uint32_t address;
+	uint32_t index;
+	void *cpu;
+	int error;
+
+	/* The three words in current coherent storage. */
+	error = bcm2711_vulkan_resource_backing(event->vertices[0], event->offsets[0], 12, &view, &address, &cpu);
+	if (error != 0)
+		return error;
+	kern_dcache_invalidate_range(cpu, 12);
+	kern_io_read_barrier();
+	kern_memcpy(groups, cpu, 12);
+
+	/* Each count within the limit. */
+	for (index = 0; index < 3; index++) {
+		if (groups[index] > 65535)
+			return EINVAL;
+	}
+
+	/* Succeeded: the counts are read. */
+	return 0;
+}
+
+/* Fills the uniform stream in the program's order from the event's snapshot. */
+static int
+build_uniforms(
+	const struct bcm2711_vulkan_prepared_event *event,
+	const uint32_t *groups,
+	uint32_t arena,
+	uint32_t arena_bytes,
+	uint32_t *words)
+{
+	const struct bcm2711_shader_binary *program;
+	const struct bcm2711_shader_uniform *uniform;
+	const struct bcm2711_vulkan_descriptor *descriptor;
+	struct bcm2711_vulkan_resource *resource;
+	struct bcm2711_v3d_view *view;
+	void *cpu;
+	uint32_t address;
+	uint32_t index;
+	int error;
+
+	/* Each uniform is the word the program expects at its place. */
+	program = event->pipeline->programs[0];
+	for (index = 0; index < program->uniform_count; index++) {
+		uniform = &program->uniforms[index];
+		switch (uniform->kind) {
+		case BCM2711_SHADER_CONSTANT:
+			words[index] = uniform->bits;
+			break;
+		case BCM2711_SHADER_PUSH:
+			if ((uniform->offset & 3U) != 0 || uniform->offset >= 4U * BCM2711_VULKAN_PUSH_WORDS)
+				return EINVAL;
+			words[index] = event->push[0][uniform->offset / 4U];
+			break;
+		case BCM2711_SHADER_GROUP_COUNT:
+			if (uniform->bits > 2)
+				return EINVAL;
+			words[index] = groups[uniform->bits];
+			break;
+		case BCM2711_SHADER_GROUP_BASE:
+			/* The whole dispatch is one CSD job, starting at workgroup zero. */
+			words[index] = 0;
+			break;
+		case BCM2711_SHADER_SHARED_BASE:
+			words[index] = arena;
+			break;
+		case BCM2711_SHADER_SHARED_LIMIT:
+			/* The arena's last start for an access of `bits` bytes. */
+			words[index] = 0;
+			if (arena_bytes >= uniform->bits)
+				words[index] = arena_bytes - uniform->bits;
+			break;
+		case BCM2711_SHADER_STORAGE_BASE:
+		case BCM2711_SHADER_STORAGE_LIMIT:
+		case BCM2711_SHADER_STORAGE_SIZE:
+			/* The bound range's address, its last start for an access of `bits` bytes, or its size. */
+			error = storage_descriptor(event, uniform, &descriptor);
+			if (error != 0)
+				return error;
+			resource = descriptor->buffer->payload;
+			error = bcm2711_vulkan_resource_backing(resource, descriptor->offset, descriptor->bytes, &view, &address, &cpu);
+			if (error != 0)
+				return error;
+			if (uniform->kind == BCM2711_SHADER_STORAGE_BASE) {
+				words[index] = address;
+			} else if (uniform->kind == BCM2711_SHADER_STORAGE_SIZE) {
+				words[index] = (uint32_t)descriptor->bytes;
+			} else {
+				words[index] = 0;
+				if (descriptor->bytes >= uniform->bits)
+					words[index] = (uint32_t)descriptor->bytes - uniform->bits;
+			}
+			break;
+		default:
+			/* Uniform blocks and graphics words have no compute supplier yet. */
+			return ENOTSUP;
+		}
+	}
+
+	/* Succeeded: the stream is complete. */
+	return 0;
+}
+
+/* Finds the snapshot's descriptor of a uniform's (set, binding) through the pipeline layout's canonical slot. */
+static int
+storage_descriptor(
+	const struct bcm2711_vulkan_prepared_event *event,
+	const struct bcm2711_shader_uniform *uniform,
+	const struct bcm2711_vulkan_descriptor **descriptor)
+{
+	const struct bcm2711_vulkan_pipeline_layout *layout;
+	const struct bcm2711_vulkan_set_layout *set;
+	uint32_t slot;
+
+	/* The slot whose binding number is the uniform's. */
+	layout = event->pipeline->owner.parent->payload;
+	if (uniform->set >= layout->count || uniform->set >= BCM2711_VULKAN_PIPELINE_SETS)
+		return EINVAL;
+	set = layout->sets[uniform->set]->payload;
+	for (slot = 0; slot < set->count; slot++) {
+		if (set->bindings[slot].number != uniform->binding)
+			continue;
+
+		/* The snapshot holds the slot when the program uses it. */
+		if ((event->used[uniform->set] & (1U << slot)) == 0)
+			return EINVAL;
+		*descriptor = &event->descriptors[uniform->set][slot];
+		if ((*descriptor)->buffer == NULL)
+			return EINVAL;
+		return 0;
+	}
+
+	/* A binding the layout lacks. */
+	return EINVAL;
+}
