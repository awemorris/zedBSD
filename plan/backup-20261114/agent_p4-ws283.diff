+#!/bin/sh
+# HT3: the CSD configuration words of a compute dispatch against the design's worked examples and the compute
+# dispatch model's batches (unmodified MIT Mesa 26.2.6 decoder in the model).
+# Usage: sh plan/ws283/tests/compute-config-host-test.sh [output-directory]
+set -eu
+out=${1:-build/ws283-compute-config-host}
+sh plan/ws283/tests/mesa-oracle.sh "$out"
+mesa=$out/mesa-26.2.6/src
+cc -std=c99 -O1 -Wall -Wextra -Werror -Iinclude -Isrc -I. -I"$out/mesa-host" -I"$mesa" \
+    plan/ws283/tests/compute-config-host-test.c src/drivers/gpu/bcm2711/vk/vulkan-compute-config.c \
+    plan/ws283/tests/qpu71-compute-machine.c src/drivers/gpu/bcm2711/compiler/qpu71.c \
+    src/drivers/gpu/bcm2711/compiler/qpu-branch.c "$out/mesa-pack.o" "$out/mesa-instr.o" -lm \
+    -o "$out/compute-config-host-test"
+timeout 300 "$out/compute-config-host-test"
