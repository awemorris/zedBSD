@@ -0,0 +1,139 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * HT3: the CSD configuration of a compute dispatch (vk/vulkan-compute-config.c)
+ * against the worked examples of WS283's design section 2.4, and its batch
+ * count against the batches the compute dispatch model forms for the same
+ * dispatch from the same supergroup choice.
+ */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "drivers/gpu/bcm2711/compiler/qpu.h"
+#include "drivers/gpu/bcm2711/vk/vulkan-compute-config.h"
+#include "plan/ws283/tests/qpu71-compute-machine.h"
+
+/* One worked example: the workgroup size, the group count, and the expected supergroup, batches per supergroup and CFG4. */
+struct example {
+	uint32_t size;
+	uint32_t groups;
+	uint32_t per_supergroup;
+	uint32_t batches_per_supergroup;
+	uint32_t batches;
+};
+
+static const struct example examples[] = {
+	{24, 1, 1, 2, 2},
+	{24, 64, 2, 3, 96},
+	{40, 64, 2, 5, 160},
+	{8, 3, 2, 1, 2},
+	{256, 4, 1, 16, 64},
+	{64, 65535, 1, 4, 262140},
+	{1, 100, 16, 1, 7},
+	{17, 5, 5, 6, 6},
+};
+
+/*
+ * Checks every example's CFG words, with and without the minus-one count,
+ * and the model's batch count.
+ */
+int
+main(
+	void)
+{
+	struct bcm2711_shader_binary binary;
+	struct v3d_device_info device;
+	struct qpu71_compute_setup setup;
+	struct qpu71_compute_result result;
+	struct bcm2711_qpu_instruction instruction;
+	uint64_t code[3];
+	uint32_t configuration[7];
+	uint32_t groups[3];
+	uint32_t index;
+	uint32_t expected;
+	int error;
+
+	/* A program that only ends: a single-segment thread end and its two delay words. */
+	memset(&instruction, 0, sizeof(instruction));
+	instruction.signal = BCM2711_QPU_SIGNAL_SWITCH;
+	error = bcm2711_qpu_encode(&instruction, &code[0]);
+	assert(error == 0);
+	memset(&instruction, 0, sizeof(instruction));
+	error = bcm2711_qpu_encode(&instruction, &code[1]);
+	assert(error == 0);
+	code[2] = code[1];
+	memset(&device, 0, sizeof(device));
+	device.ver = 71;
+	device.rev = 10;
+
+	/* Each example. */
+	for (index = 0; index < sizeof(examples) / sizeof(examples[0]); index++) {
+		memset(&binary, 0, sizeof(binary));
+		binary.local_size[0] = examples[index].size;
+		binary.local_size[1] = 1;
+		binary.local_size[2] = 1;
+		binary.threads = 4;
+		binary.starts_final = 1;
+		groups[0] = examples[index].groups;
+		groups[1] = 1;
+		groups[2] = 1;
+		bcm2711_vulkan_compute_configuration(&binary, groups, false, 0x10000, 0x20000, configuration);
+		assert(configuration[0] == examples[index].groups << 16);
+		assert(configuration[1] == 1U << 16);
+		assert(configuration[2] == 1U << 16);
+		expected = ((examples[index].per_supergroup & 0xfU) << 8) | ((examples[index].batches_per_supergroup - 1U) << 12) | (examples[index].size & 0xffU);
+		if (configuration[3] != expected) {
+			fprintf(stderr, "example %u: CFG3 %08x, expected %08x\n", index, configuration[3], expected);
+			return 1;
+		}
+		assert(configuration[4] == examples[index].batches);
+		assert(configuration[5] == (0x10000U | 3U));
+		assert(configuration[6] == 0x20000U);
+
+		/* The older count is one less. */
+		bcm2711_vulkan_compute_configuration(&binary, groups, true, 0x10000, 0x20000, configuration);
+		assert(configuration[4] == examples[index].batches - 1U);
+
+		/* The model forms the same number of batches from the same supergroup (the largest dispatch is skipped for time). */
+		if (examples[index].groups > 4096)
+			continue;
+		memset(&setup, 0, sizeof(setup));
+		setup.code = code;
+		setup.code_count = 3;
+		setup.local_size[0] = examples[index].size;
+		setup.local_size[1] = 1;
+		setup.local_size[2] = 1;
+		setup.groups[0] = examples[index].groups;
+		setup.groups[1] = 1;
+		setup.groups[2] = 1;
+		setup.workgroups_per_supergroup = examples[index].per_supergroup;
+		setup.threads = 4;
+		setup.single_segment = 1;
+		qpu71_compute_run(&device, &setup, &result);
+		assert(result.batches == examples[index].batches);
+	}
+
+	/* A two-thread, multiple-segment program drops both CFG5 bits; a 3D dispatch keeps each count. */
+	memset(&binary, 0, sizeof(binary));
+	binary.local_size[0] = 4;
+	binary.local_size[1] = 2;
+	binary.local_size[2] = 3;
+	binary.threads = 2;
+	groups[0] = 3;
+	groups[1] = 5;
+	groups[2] = 2;
+	bcm2711_vulkan_compute_configuration(&binary, groups, false, 0x10000, 0x20000, configuration);
+	assert(configuration[0] == 3U << 16 && configuration[1] == 5U << 16 && configuration[2] == 2U << 16);
+	assert(configuration[5] == 0x10000U);
+	assert((configuration[3] & 0xffU) == 24);
+	puts("compute-config-host-test PASS");
+	return 0;
+}
