+/* Checks one semantic operation on the add ALU and on the multiply ALU where it exists there. */
+static void
+check_operation(
+	const struct v3d_device_info *device,
+	const struct expected_operation *expected)
+{
+	/* The add ALU's form. */
+	if (expected->add != V3D_QPU_A_NOP)
+		check_alu(device, expected, 0);
+
+	/* The multiply ALU's form. */
+	if (expected->multiply != V3D_QPU_M_NOP)
+		check_alu(device, expected, 1);
+}
+
+/*
+ * Encodes one operation on one ALU with distinct registers and checks it through the oracle.
+ *
+ * Every pair of source and destination numbers is tried so no field is
+ * truncated or exchanged.
+ */
+static void
+check_alu(
+	const struct v3d_device_info *device,
+	const struct expected_operation *expected,
+	uint32_t multiply)
+{
+	struct bcm2711_qpu_bundle bundle;
+	struct bcm2711_qpu_instruction *instruction;
+	struct v3d_qpu_instr decoded;
+	uint64_t word;
+	uint64_t mesa;
+	uint32_t sources;
+	uint32_t trial;
+	uint32_t left;
+	uint32_t right;
+	uint32_t destination;
+	int error;
+
+	/* Several register numbers reach every bit of the six-bit fields. */
+	sources = bcm2711_qpu_operation_sources(expected->native);
+	for (trial = 0; trial < 64; trial++) {
+		left = trial;
+		right = (trial * 37U + 11U) % 64U;
+		destination = (trial * 13U + 5U) % 64U;
+
+		/* An order-sensitive maximum needs distinct inputs. */
+		if (expected->native == BCM2711_QPU_FLOAT_MAXIMUM && left == right)
+			continue;
+
+		/* The operation on the chosen ALU, the other idle. */
+		memset(&bundle, 0, sizeof(bundle));
+		instruction = &bundle.add;
+		if (multiply != 0)
+			instruction = &bundle.multiply;
+		instruction->operation = expected->native;
+		instruction->destination.number = destination;
+		instruction->left.kind = BCM2711_QPU_REGISTER;
+		instruction->left.number = left;
+		instruction->right.kind = BCM2711_QPU_REGISTER;
+		instruction->right.number = right;
+
+		/* The word decodes as the expected operation and repacks to itself. */
+		decode_bundle(device, &bundle, &decoded);
+		if (multiply == 0) {
+			if (decoded.alu.add.op != expected->add || decoded.alu.mul.op != V3D_QPU_M_NOP) {
+				fprintf(stderr, "operation %u on add: decoded %u/%u\n", (unsigned)expected->native, (unsigned)decoded.alu.add.op, (unsigned)decoded.alu.mul.op);
+				assert(0);
+			}
+		} else {
+			if (decoded.alu.mul.op != expected->multiply || decoded.alu.add.op != V3D_QPU_A_NOP) {
+				fprintf(stderr, "operation %u on mul: decoded %u/%u\n", (unsigned)expected->native, (unsigned)decoded.alu.add.op, (unsigned)decoded.alu.mul.op);
+				assert(0);
+			}
+		}
+
+		/* The inputs, unpack and destination are the semantic ones; order-sensitive operations may exchange their inputs. */
+		if (multiply == 0) {
+			if (sources >= 1)
+				assert(decoded.alu.add.a.unpack == expected->unpack);
+			if (sources == 1)
+				assert(decoded.alu.add.a.raddr == left);
+			if (sources == 2) {
+				assert((decoded.alu.add.a.raddr == left && decoded.alu.add.b.raddr == right) ||
+				       (decoded.alu.add.a.raddr == right && decoded.alu.add.b.raddr == left));
+			}
+			if (expected->native != BCM2711_QPU_VPM_STORE) {
+				assert(decoded.alu.add.waddr == destination);
+				assert(!decoded.alu.add.magic_write);
+			}
+		} else {
+			if (sources >= 1)
+				assert(decoded.alu.mul.a.unpack == expected->unpack);
+			if (sources == 1)
+				assert(decoded.alu.mul.a.raddr == left);
+			if (sources == 2) {
+				assert(decoded.alu.mul.a.raddr == left);
+				assert(decoded.alu.mul.b.raddr == right);
+			}
+			assert(decoded.alu.mul.waddr == destination);
+			assert(!decoded.alu.mul.magic_write);
+		}
+
+		/* The non-commutative operations keep their input order. */
+		if (multiply == 0 && sources == 2 && expected->native != BCM2711_QPU_FLOAT_ADD &&
+		    expected->native != BCM2711_QPU_FLOAT_MINIMUM && expected->native != BCM2711_QPU_FLOAT_MAXIMUM) {
+			assert(decoded.alu.add.a.raddr == left);
+			assert(decoded.alu.add.b.raddr == right);
+		}
+
+		/* Mesa's packer, given only the semantic description, builds the same word. */
+		word = 0;
+		error = bcm2711_qpu_encode_bundle(&bundle, &word);
+		assert(error == 0);
+		mesa_word(device, &bundle, expected, multiply, &mesa);
+		if (mesa != word) {
+			fprintf(stderr, "operation %u on %s: production %016llx, Mesa %016llx\n", (unsigned)expected->native, multiply ? "mul" : "add", (unsigned long long)word, (unsigned long long)mesa);
+			assert(0);
+		}
+	}
+}
+
+/* Builds the word of one register-only operation with Mesa's packer from the semantic description. */
+static void
+mesa_word(
+	const struct v3d_device_info *device,
+	const struct bcm2711_qpu_bundle *bundle,
+	const struct expected_operation *expected,
+	uint32_t multiply,
+	uint64_t *word)
+{
+	const struct bcm2711_qpu_instruction *instruction;
+	struct v3d_qpu_instr mesa;
+	uint32_t sources;
+	bool accepted;
+
+	/* Both ALUs start idle, writing the discarding magic address. */
+	memset(&mesa, 0, sizeof(mesa));
+	mesa.type = V3D_QPU_INSTR_TYPE_ALU;
+	mesa.alu.add.op = V3D_QPU_A_NOP;
+	mesa.alu.add.waddr = V3D_QPU_WADDR_NOP;
+	mesa.alu.add.magic_write = true;
+	mesa.alu.mul.op = V3D_QPU_M_NOP;
+	mesa.alu.mul.waddr = V3D_QPU_WADDR_NOP;
+	mesa.alu.mul.magic_write = true;
+
+	/* The semantic operation takes its ALU with its inputs in order. */
+	sources = bcm2711_qpu_operation_sources(expected->native);
+	if (multiply == 0) {
+		instruction = &bundle->add;
+		mesa.alu.add.op = expected->add;
+		mesa.alu.add.waddr = instruction->destination.number;
+		mesa.alu.add.magic_write = false;
+		mesa.alu.add.a.unpack = expected->unpack;
+		if (sources >= 1)
+			mesa.alu.add.a.raddr = instruction->left.number;
+		if (sources >= 2)
+			mesa.alu.add.b.raddr = instruction->right.number;
+
+		/* Mesa chooses the order of a float add or minimum itself; a maximum's inputs are given in the order it needs. */
+		if (expected->native == BCM2711_QPU_FLOAT_MAXIMUM && instruction->left.number < instruction->right.number) {
+			mesa.alu.add.a.raddr = instruction->right.number;
+			mesa.alu.add.b.raddr = instruction->left.number;
+		}
+	} else {
+		instruction = &bundle->multiply;
+		mesa.alu.mul.op = expected->multiply;
+		mesa.alu.mul.waddr = instruction->destination.number;
+		mesa.alu.mul.magic_write = false;
+		mesa.alu.mul.a.unpack = expected->unpack;
+		if (sources >= 1)
+			mesa.alu.mul.a.raddr = instruction->left.number;
+		if (sources >= 2)
+			mesa.alu.mul.b.raddr = instruction->right.number;
+	}
+
+	/* The packer accepts the description. */
+	accepted = v3d_qpu_instr_pack(device, &mesa, word);
+	assert(accepted);
+}
+
+/* Verifies every signal, the signal destination, predicates and flag pushes through the decoder. */
+static void
+check_signals(
+	const struct v3d_device_info *device)
+{
+	struct bcm2711_qpu_bundle bundle;
+	struct v3d_qpu_instr decoded;
+	uint32_t signal;
+	uint32_t predicate;
+	bool addressed;
+
+	/* Every signal alone on an idle word, with an addressed destination. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.signal_destination.number = 29;
+	for (signal = 1; signal <= BCM2711_QPU_SIGNAL_UNIFORM_ADDRESS_REGISTER; signal++) {
+		bundle.signal = (enum bcm2711_qpu_signal)signal;
+		decode_bundle(device, &bundle, &decoded);
+		assert(decoded.sig.thrsw == (signal == BCM2711_QPU_SIGNAL_SWITCH));
+		assert(decoded.sig.ldunif == (signal == BCM2711_QPU_SIGNAL_UNIFORM));
+		assert(decoded.sig.ldtmu == (signal == BCM2711_QPU_SIGNAL_TEXTURE));
+		assert(decoded.sig.ldvary == (signal == BCM2711_QPU_SIGNAL_VARYING));
+		assert(decoded.sig.ldunifrf == (signal == BCM2711_QPU_SIGNAL_UNIFORM_REGISTER));
+		assert(decoded.sig.ldtlb == (signal == BCM2711_QPU_SIGNAL_TILE));
+		assert(decoded.sig.ldtlbu == (signal == BCM2711_QPU_SIGNAL_TILE_CONFIGURED));
+		assert(decoded.sig.wrtmuc == (signal == BCM2711_QPU_SIGNAL_TEXTURE_CONFIG));
+		assert(decoded.sig.ldunifa == (signal == BCM2711_QPU_SIGNAL_UNIFORM_ADDRESS));
+		assert(decoded.sig.ldunifarf == (signal == BCM2711_QPU_SIGNAL_UNIFORM_ADDRESS_REGISTER));
+
+		/* An addressed signal names the register, never the lane flags. */
+		addressed = v3d_qpu_sig_writes_address(device, &decoded.sig);
+		if (addressed) {
+			assert(decoded.sig_addr == 29);
+			assert(!decoded.sig_magic);
+		}
+
+		/* The implicit rf0 writes of 7.1: uniform, uniform-address and varying loads. */
+		assert(v3d_qpu_writes_rf0_implicitly(device, &decoded) ==
+		       (signal == BCM2711_QPU_SIGNAL_UNIFORM ||
+			signal == BCM2711_QPU_SIGNAL_UNIFORM_ADDRESS ||
+			signal == BCM2711_QPU_SIGNAL_VARYING));
+	}
+
+	/* A magic signal destination: a texture result to the TMU's configuration address is magic. */
+	bundle.signal = BCM2711_QPU_SIGNAL_TEXTURE;
+	bundle.signal_destination.number = 32;
+	bundle.signal_destination.peripheral = 1;
+	decode_bundle(device, &bundle, &decoded);
+	assert(decoded.sig_addr == 32);
+	assert(decoded.sig_magic);
+
+	/* Each predicate on each ALU reaches the oracle's condition field. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_MOVE;
+	bundle.add.destination.number = 9;
+	bundle.add.left.number = 4;
+	for (predicate = 1; predicate <= 4; predicate++) {
+		bundle.add.predicate = predicate;
+		decode_bundle(device, &bundle, &decoded);
+		assert(decoded.flags.ac == (enum v3d_qpu_cond)predicate);
+	}
+
+	/* Each flag push on the add ALU. */
+	bundle.add.predicate = 0;
+	bundle.add.operation = BCM2711_QPU_INTEGER_SUBTRACT;
+	bundle.add.right.number = 5;
+	for (predicate = 1; predicate <= 3; predicate++) {
+		bundle.add.push_flags = predicate;
+		decode_bundle(device, &bundle, &decoded);
+		assert(decoded.flags.apf == (enum v3d_qpu_pf)predicate);
+	}
+}
+
+/* Compares the small immediates with all forty-eight Mesa values, on each of the four read addresses. */
+static void
+check_constants(
+	const struct v3d_device_info *device)
+{
+	struct bcm2711_qpu_bundle bundle;
+	struct v3d_qpu_instr decoded;
+	uint32_t bits;
+	uint32_t index;
+	uint32_t encoded;
+	uint32_t decoded_bits;
+	bool accepted;
+	int error;
+
+	/* Each index converts from its bits and back. */
+	for (index = 0; index < 48; index++) {
+		accepted = v3d_qpu_small_imm_unpack(device, index, &bits);
+		assert(accepted);
+		error = bcm2711_qpu_small_constant(bits, &encoded);
+		assert(error == 0);
+		assert(encoded == index);
+
+		/* On the add ALU's a input. */
+		memset(&bundle, 0, sizeof(bundle));
+		bundle.add.operation = BCM2711_QPU_INTEGER_SUBTRACT;
+		bundle.add.destination.number = 3;
+		bundle.add.left.kind = BCM2711_QPU_CONSTANT;
+		bundle.add.left.number = bits;
+		bundle.add.right.kind = BCM2711_QPU_REGISTER;
+		bundle.add.right.number = 27;
+		decode_bundle(device, &bundle, &decoded);
+		assert(decoded.sig.small_imm_a);
+		assert(!decoded.sig.small_imm_b && !decoded.sig.small_imm_c && !decoded.sig.small_imm_d);
+		accepted = v3d_qpu_small_imm_unpack(device, decoded.alu.add.a.raddr, &decoded_bits);
+		assert(accepted && decoded_bits == bits);
+		assert(decoded.alu.add.b.raddr == 27);
+
+		/* On the add ALU's b input. */
+		bundle.add.left.kind = BCM2711_QPU_REGISTER;
+		bundle.add.left.number = 27;
+		bundle.add.right.kind = BCM2711_QPU_CONSTANT;
+		bundle.add.right.number = bits;
+		decode_bundle(device, &bundle, &decoded);
+		assert(decoded.sig.small_imm_b);
+		accepted = v3d_qpu_small_imm_unpack(device, decoded.alu.add.b.raddr, &decoded_bits);
+		assert(accepted && decoded_bits == bits);
+
+		/* On the multiply ALU's a input. */
+		memset(&bundle, 0, sizeof(bundle));
+		bundle.multiply.operation = BCM2711_QPU_FLOAT_MULTIPLY;
+		bundle.multiply.destination.number = 3;
+		bundle.multiply.left.kind = BCM2711_QPU_CONSTANT;
+		bundle.multiply.left.number = bits;
+		bundle.multiply.right.kind = BCM2711_QPU_REGISTER;
+		bundle.multiply.right.number = 27;
+		decode_bundle(device, &bundle, &decoded);
+		assert(decoded.sig.small_imm_c);
+		accepted = v3d_qpu_small_imm_unpack(device, decoded.alu.mul.a.raddr, &decoded_bits);
+		assert(accepted && decoded_bits == bits);
+
+		/* On the multiply ALU's b input. */
+		bundle.multiply.left.kind = BCM2711_QPU_REGISTER;
+		bundle.multiply.left.number = 27;
+		bundle.multiply.right.kind = BCM2711_QPU_CONSTANT;
+		bundle.multiply.right.number = bits;
+		decode_bundle(device, &bundle, &decoded);
+		assert(decoded.sig.small_imm_d);
+		accepted = v3d_qpu_small_imm_unpack(device, decoded.alu.mul.b.raddr, &decoded_bits);
+		assert(accepted && decoded_bits == bits);
+
+		/* A one-input move reads its immediate through a. */
+		memset(&bundle, 0, sizeof(bundle));
+		bundle.add.operation = BCM2711_QPU_MOVE;
+		bundle.add.destination.number = 3;
+		bundle.add.left.kind = BCM2711_QPU_CONSTANT;
+		bundle.add.left.number = bits;
+		decode_bundle(device, &bundle, &decoded);
+		assert(decoded.alu.add.op == V3D_QPU_A_MOV && decoded.sig.small_imm_a);
+	}
+
+	/* A float add, minimum and maximum with an immediate keep their identity whichever side the immediate is on. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.destination.number = 3;
+	bundle.add.left.kind = BCM2711_QPU_REGISTER;
+	bundle.add.left.number = 40;
+	bundle.add.right.kind = BCM2711_QPU_CONSTANT;
+	bundle.add.right.number = 0x3f800000U;
+	bundle.add.operation = BCM2711_QPU_FLOAT_ADD;
+	decode_bundle(device, &bundle, &decoded);
+	assert(decoded.alu.add.op == V3D_QPU_A_FADD);
+	bundle.add.operation = BCM2711_QPU_FLOAT_MINIMUM;
+	decode_bundle(device, &bundle, &decoded);
+	assert(decoded.alu.add.op == V3D_QPU_A_FMIN);
+	bundle.add.operation = BCM2711_QPU_FLOAT_MAXIMUM;
+	decode_bundle(device, &bundle, &decoded);
+	assert(decoded.alu.add.op == V3D_QPU_A_FMAX);
+	bundle.add.left = bundle.add.right;
+	bundle.add.right.kind = BCM2711_QPU_REGISTER;
+	bundle.add.right.number = 40;
+	decode_bundle(device, &bundle, &decoded);
+	assert(decoded.alu.add.op == V3D_QPU_A_FMAX);
+	bundle.add.operation = BCM2711_QPU_FLOAT_ADD;
+	decode_bundle(device, &bundle, &decoded);
+	assert(decoded.alu.add.op == V3D_QPU_A_FADD);
+
+	/* Nonrepresentable constants are refused exactly, without approximating or truncating their bits. */
+	encoded = 99;
+	error = bcm2711_qpu_small_constant(0x3f800001U, &encoded);
+	assert(error == ENOTSUP && encoded == 99);
+}
+
+/* Encodes one word, decodes it with the oracle and checks the oracle rebuilds the same word. */
+static void
+decode_bundle(
+	const struct v3d_device_info *device,
+	const struct bcm2711_qpu_bundle *bundle,
+	struct v3d_qpu_instr *decoded)
+{
+	uint64_t word;
+	uint64_t repacked;
+	bool accepted;
+	int error;
+
+	/* The word must encode. */
+	error = bcm2711_qpu_encode_bundle(bundle, &word);
+	if (error != 0) {
+		fprintf(stderr, "bundle refused with %d\n", error);
+		assert(0);
+	}
+
+	/* It decodes as an ALU word. */
+	memset(decoded, 0, sizeof(*decoded));
+	accepted = v3d_qpu_instr_unpack(device, word, decoded);
+	if (!accepted) {
+		fprintf(stderr, "word %016llx does not decode\n", (unsigned long long)word);
+		assert(0);
+	}
+	assert(decoded->type == V3D_QPU_INSTR_TYPE_ALU);
+
+	/* It repacks to itself. */
+	accepted = v3d_qpu_instr_pack(device, decoded, &repacked);
+	if (!accepted || repacked != word) {
+		fprintf(stderr, "word %016llx repacks as %016llx\n", (unsigned long long)word, (unsigned long long)repacked);
+		assert(0);
+	}
+}
+
+/* Checks paired ALU operations, combined conditions and switch signals. */
+static void
+check_bundles(
+	const struct v3d_device_info *device)
+{
+	static const enum bcm2711_qpu_signal combined[6] = {
+		BCM2711_QPU_SIGNAL_NONE,
+		BCM2711_QPU_SIGNAL_UNIFORM,
+		BCM2711_QPU_SIGNAL_TEXTURE,
+		BCM2711_QPU_SIGNAL_VARYING,
+		BCM2711_QPU_SIGNAL_UNIFORM_REGISTER,
+		BCM2711_QPU_SIGNAL_TEXTURE_CONFIG};
+	struct bcm2711_qpu_bundle bundle;
+	struct v3d_qpu_instr decoded;
+	uint32_t add_predicate;
+	uint32_t mul_predicate;
+	uint32_t push;
+	uint32_t index;
+	bool addressed;
+
+	/* An add and a multiply reading four different registers: 7.1 has a read address for each input. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_FLOAT_SUBTRACT;
+	bundle.add.destination.number = 10;
+	bundle.add.left.number = 20;
+	bundle.add.right.number = 21;
+	bundle.multiply.operation = BCM2711_QPU_FLOAT_MULTIPLY;
+	bundle.multiply.destination.number = 11;
+	bundle.multiply.left.number = 22;
+	bundle.multiply.right.number = 23;
+	decode_bundle(device, &bundle, &decoded);
+	assert(decoded.alu.add.op == V3D_QPU_A_FSUB && decoded.alu.mul.op == V3D_QPU_M_FMUL);
+	assert(decoded.alu.add.waddr == 10 && decoded.alu.mul.waddr == 11);
+	assert(decoded.alu.add.a.raddr == 20 && decoded.alu.add.b.raddr == 21);
+	assert(decoded.alu.mul.a.raddr == 22 && decoded.alu.mul.b.raddr == 23);
+
+	/* A move on each ALU together: the add ALU's MOV and the multiply ALU's MOV. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_MOVE;
+	bundle.add.destination.number = 7;
+	bundle.add.destination.peripheral = 1;
+	bundle.add.left.number = 30;
+	bundle.multiply.operation = BCM2711_QPU_MOVE;
+	bundle.multiply.destination.number = 12;
+	bundle.multiply.left.kind = BCM2711_QPU_CONSTANT;
+	bundle.multiply.left.number = 0x3f800000U;
+	decode_bundle(device, &bundle, &decoded);
+	assert(decoded.alu.add.op == V3D_QPU_A_MOV && decoded.alu.add.magic_write && decoded.alu.add.waddr == 7);
+	assert(decoded.alu.mul.op == V3D_QPU_M_MOV && decoded.sig.small_imm_c);
+	assert(decoded.alu.add.a.raddr == 30);
+
+	/* Every combination of the two ALUs' predicates and one ALU's flag push reaches the oracle's fields. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_BITS_AND;
+	bundle.add.destination.number = 6;
+	bundle.add.destination.peripheral = 1;
+	bundle.add.left.number = 3;
+	bundle.add.right.number = 4;
+	bundle.multiply.operation = BCM2711_QPU_MOVE;
+	bundle.multiply.destination.number = 9;
+	bundle.multiply.left.number = 4;
+	for (add_predicate = 0; add_predicate <= 4; add_predicate++) {
+		for (mul_predicate = 0; mul_predicate <= 4; mul_predicate++) {
+			for (push = 0; push <= 3; push++) {
+				bundle.add.predicate = add_predicate;
+				bundle.multiply.predicate = mul_predicate;
+				bundle.add.push_flags = 0;
+				bundle.multiply.push_flags = 0;
+				if (add_predicate == 0) {
+					bundle.add.push_flags = push;
+				} else if (mul_predicate == 0) {
+					bundle.multiply.push_flags = push;
+				} else if (push != 0) {
+					continue;
+				}
+
+				/* The decoded fields are the requested ones. */
+				decode_bundle(device, &bundle, &decoded);
+				assert(decoded.flags.ac == (enum v3d_qpu_cond)add_predicate);
+				assert(decoded.flags.mc == (enum v3d_qpu_cond)mul_predicate);
+				assert(decoded.flags.apf == (enum v3d_qpu_pf)bundle.add.push_flags);
+				assert(decoded.flags.mpf == (enum v3d_qpu_pf)bundle.multiply.push_flags);
+			}
+		}
+	}
+
+	/* A thread switch combines with each signal of the native table; the signal keeps its destination. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_FLOAT_ADD;
+	bundle.add.destination.number = 10;
+	bundle.add.left.number = 20;
+	bundle.add.right.number = 21;
+	bundle.thread_switch = 1;
+	bundle.signal_destination.number = 13;
+	for (index = 0; index < 6; index++) {
+		bundle.signal = combined[index];
+		decode_bundle(device, &bundle, &decoded);
+		assert(decoded.sig.thrsw);
+		assert(decoded.sig.ldunif == (combined[index] == BCM2711_QPU_SIGNAL_UNIFORM));
+		assert(decoded.sig.ldtmu == (combined[index] == BCM2711_QPU_SIGNAL_TEXTURE));
+		assert(decoded.sig.ldvary == (combined[index] == BCM2711_QPU_SIGNAL_VARYING));
+		assert(decoded.sig.ldunifrf == (combined[index] == BCM2711_QPU_SIGNAL_UNIFORM_REGISTER));
+		assert(decoded.sig.wrtmuc == (combined[index] == BCM2711_QPU_SIGNAL_TEXTURE_CONFIG));
+		addressed = v3d_qpu_sig_writes_address(device, &decoded.sig);
+		if (addressed)
+			assert(decoded.sig_addr == 13 && !decoded.sig_magic);
+	}
+
+	/* Succeeded: paired words agree with the oracle. */
+	puts("qpu71-format-host-test paired words, conditions and switch signals: PASS");
+}
+
+/* Checks the combinations a 7.1 word cannot express, each refused without touching the caller's word. */
+static void
+check_refusals(
+	void)
+{
+	struct bcm2711_qpu_bundle bundle;
+	struct bcm2711_qpu_instruction instruction;
+	uint64_t word;
+	int error;
+
+	/* Two small immediates in one word, even the same value on the same ALU. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_INTEGER_ADD;
+	bundle.add.left.kind = BCM2711_QPU_CONSTANT;
+	bundle.add.left.number = 1;
+	bundle.add.right.kind = BCM2711_QPU_CONSTANT;
+	bundle.add.right.number = 1;
+	refuse_bundle(&bundle, ENOTSUP);
+
+	/* Two small immediates on the two ALUs. */
+	bundle.add.right.kind = BCM2711_QPU_REGISTER;
+	bundle.add.right.number = 9;
+	bundle.multiply.operation = BCM2711_QPU_FLOAT_MULTIPLY;
+	bundle.multiply.left.kind = BCM2711_QPU_CONSTANT;
+	bundle.multiply.left.number = 1;
+	refuse_bundle(&bundle, ENOTSUP);
+
+	/* A small immediate beside any signal, and beside a thread switch. */
+	bundle.multiply.operation = BCM2711_QPU_IDLE;
+	bundle.signal = BCM2711_QPU_SIGNAL_VARYING;
+	refuse_bundle(&bundle, ENOTSUP);
+	bundle.signal = BCM2711_QPU_SIGNAL_TEXTURE;
+	refuse_bundle(&bundle, ENOTSUP);
+	bundle.signal = BCM2711_QPU_SIGNAL_NONE;
+	bundle.thread_switch = 1;
+	refuse_bundle(&bundle, ENOTSUP);
+
+	/* An accumulator source: 7.1 has none. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_MOVE;
+	bundle.add.left.kind = BCM2711_QPU_ACCUMULATOR;
+	bundle.add.left.number = 5;
+	refuse_bundle(&bundle, EINVAL);
+
+	/* A magic write to a reserved 7.1 address: an old accumulator or special-function address. */
+	bundle.add.left.kind = BCM2711_QPU_REGISTER;
+	bundle.add.destination.peripheral = 1;
+	bundle.add.destination.number = 3;
+	refuse_bundle(&bundle, EINVAL);
+	bundle.add.destination.number = 19;
+	refuse_bundle(&bundle, EINVAL);
+
+	/* An addressed signal beside a predicate. */
+	bundle.add.destination.peripheral = 0;
+	bundle.add.destination.number = 8;
+	bundle.add.predicate = 1;
+	bundle.signal = BCM2711_QPU_SIGNAL_UNIFORM_REGISTER;
+	refuse_bundle(&bundle, ENOTSUP);
+
+	/* Both ALUs pushing flags. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_MOVE;
+	bundle.add.push_flags = 1;
+	bundle.multiply.operation = BCM2711_QPU_MOVE;
+	bundle.multiply.push_flags = 1;
+	refuse_bundle(&bundle, ENOTSUP);
+
+	/* A switch beside an unlisted signal. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.thread_switch = 1;
+	bundle.signal = BCM2711_QPU_SIGNAL_TILE;
+	refuse_bundle(&bundle, ENOTSUP);
+
+	/* An operation in the other ALU's slot. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_FLOAT_MULTIPLY;
+	refuse_bundle(&bundle, EINVAL);
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.multiply.operation = BCM2711_QPU_FLOAT_ADD;
+	refuse_bundle(&bundle, EINVAL);
+
+	/* A float maximum of one register with itself has no native order. */
+	memset(&bundle, 0, sizeof(bundle));
+	bundle.add.operation = BCM2711_QPU_FLOAT_MAXIMUM;
+	bundle.add.left.number = 4;
+	bundle.add.right.number = 4;
+	refuse_bundle(&bundle, ENOTSUP);
+
+	/* Invalid registers and unknown operations keep the caller's word. */
+	memset(&instruction, 0, sizeof(instruction));
+	instruction.operation = BCM2711_QPU_MOVE;
+	instruction.left.number = 64;
+	word = UINT64_C(0x1122334455667788);
+	error = bcm2711_qpu_encode(&instruction, &word);
+	assert(error == EINVAL && word == UINT64_C(0x1122334455667788));
+	instruction.left.number = 0;
+	instruction.operation = (enum bcm2711_qpu_operation)UINT32_MAX;
+	error = bcm2711_qpu_encode(&instruction, &word);
+	assert(error == ENOTSUP && word == UINT64_C(0x1122334455667788));
+
+	/* Succeeded: every refusal is reported. */
+	puts("qpu71-format-host-test refusals: PASS");
+}
+
+/* Checks that one word is refused with the expected error and leaves the caller's word alone. */
+static void
+refuse_bundle(
+	const struct bcm2711_qpu_bundle *bundle,
+	int expected)
+{
+	uint64_t word;
+	int error;
+
+	/* The refusal keeps the old bits. */
+	word = UINT64_C(0x1122334455667788);
+	error = bcm2711_qpu_encode_bundle(bundle, &word);
+	if (error != expected) {
+		fprintf(stderr, "bundle: expected %d, got %d\n", expected, error);
+		assert(0);
+	}
+	assert(word == UINT64_C(0x1122334455667788));
+}
diff --git a/plan/ws283/tests/qpu71-rules.c b/plan/ws283/tests/qpu71-rules.c
new file mode 100644
index 0000000000..dbe4c3ae88
--- /dev/null
+++ b/plan/ws283/tests/qpu71-rules.c
@@ -0,0 +1,487 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The static checker of the V3D 7.1 compute program rules; see qpu71-rules.h.
+ *
+ * Rule numbers are those of WS283's design section 1.8.  Rule 13 (4.2's
+ * accumulators) does not apply to 7.1 and rule 14 (the ldunifa window
+ * length) needs the compiler's window table, which the dispatch model
+ * checks against the buffers instead.
+ */
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "broadcom/qpu/qpu_instr.h"
+#include "plan/ws283/tests/qpu71-rules.h"
+
+#define RULES_NONE 0xffffffffU
+#define RULES_QUEUE 8U
+
+/* The walk's state between words. */
+struct rules {
+	const struct v3d_device_info *device;
+	const struct qpu71_rules_program *program;
+	struct v3d_qpu_instr *words;
+	bool *target;
+	uint32_t quiet;
+	uint32_t broken;
+	uint32_t word;
+	uint32_t last_branch;
+	uint32_t last_switch;
+	uint32_t last_unifa;
+	uint32_t last_special;
+	uint32_t special_destination;
+	bool last_marked;
+	uint32_t thread_end;
+	bool multiply_open;
+	uint32_t multiply_word;
+	bool sequence_open;
+	uint32_t sequence_writes;
+	uint32_t outstanding_words;
+	uint32_t outstanding_loads;
+	uint32_t stores;
+	bool barrier_open;
+	uint32_t uniforms;
+};
+
+static void broken(struct rules *rules, uint32_t rule, const char *reason);
+static uint32_t uniform_reads(struct rules *rules, const struct v3d_qpu_instr *instruction);
+static bool writes_magic(const struct v3d_qpu_instr *instruction, uint32_t address);
+static bool writes_register(const struct v3d_qpu_instr *instruction, uint32_t address);
+static void check_branch(struct rules *rules, const struct v3d_qpu_instr *instruction);
+static void check_alu_word(struct rules *rules, const struct v3d_qpu_instr *instruction);
+static void check_block_clean(struct rules *rules, const char *where);
+static uint32_t config_words(struct rules *rules, uint32_t index);
+
+/*
+ * Checks every rule of one program.
+ */
+uint32_t
+qpu71_rules_check(
+	const struct v3d_device_info *device,
+	const struct qpu71_rules_program *program,
+	uint32_t quiet)
+{
+	struct rules rules;
+	uint64_t repacked;
+	uint32_t index;
+	int32_t target;
+	bool accepted;
+
+	/* Every word decodes and rebuilds; branch targets are found first. */
+	memset(&rules, 0, sizeof(rules));
+	rules.device = device;
+	rules.program = program;
+	rules.quiet = quiet;
+	rules.words = calloc(program->count + 1, sizeof(*rules.words));
+	rules.target = calloc(program->count + 1, sizeof(*rules.target));
+	if (rules.words == NULL || rules.target == NULL)
+		abort();
+	for (index = 0; index < program->count; index++) {
+		rules.word = index;
+		accepted = v3d_qpu_instr_unpack(device, program->code[index], &rules.words[index]);
+		if (!accepted) {
+			broken(&rules, 0, "word does not decode");
+			continue;
+		}
+		accepted = v3d_qpu_instr_pack(device, &rules.words[index], &repacked);
+		if (!accepted || repacked != program->code[index])
+			broken(&rules, 0, "word does not repack to itself");
+		if (rules.words[index].type != V3D_QPU_INSTR_TYPE_BRANCH)
+			continue;
+		target = (int32_t)index + 4 + (int32_t)rules.words[index].branch.offset / 8;
+		if (target < 0 || (uint32_t)target >= program->count) {
+			broken(&rules, 0, "branch target outside the program");
+			continue;
+		}
+		rules.target[target] = true;
+	}
+
+	/* The walk in program order. */
+	rules.last_branch = RULES_NONE;
+	rules.last_switch = RULES_NONE;
+	rules.last_unifa = RULES_NONE;
+	rules.last_special = RULES_NONE;
+	rules.thread_end = RULES_NONE;
+	for (index = 0; index < program->count; index++) {
+		rules.word = index;
+
+		/* A block starts clean: nothing of the TMU or the multiply crosses into a branch target (rules 9, 4). */
+		if (rules.target[index])
+			check_block_clean(&rules, "at a branch target");
+
+		/* The word's own rules. */
+		if (rules.words[index].type == V3D_QPU_INSTR_TYPE_BRANCH)
+			check_branch(&rules, &rules.words[index]);
+		else
+			check_alu_word(&rules, &rules.words[index]);
+		rules.uniforms += uniform_reads(&rules, &rules.words[index]);
+	}
+
+	/* The program ends two words after its thread end, with nothing outstanding (rule 5, 9). */
+	rules.word = program->count;
+	if (rules.thread_end == RULES_NONE || rules.thread_end + 3 != program->count)
+		broken(&rules, 5, "program does not end two words after a thread end");
+	check_block_clean(&rules, "at the program end");
+	if (program->count != 0 &&
+	    rules.words[program->count - 1].type == V3D_QPU_INSTR_TYPE_ALU &&
+	    rules.words[program->count - 1].alu.add.op == V3D_QPU_A_TMUWT)
+		broken(&rules, 5, "TMUWT as the last word");
+
+	/* Reports the count. */
+	free(rules.words);
+	free(rules.target);
+	return rules.broken;
+}
+
+/* Prints and counts one broken rule. */
+static void
+broken(
+	struct rules *rules,
+	uint32_t rule,
+	const char *reason)
+{
+	/* The word index names where; the rule number names which. */
+	rules->broken++;
+	if (rules->quiet == 0)
+		fprintf(stderr, "qpu71 rules: word %u: rule %u: %s\n", rules->word, rule, reason);
+}
+
+/* Counts the uniforms one word reads: its loads, its implicit loads and a branch's uniform move. */
+static uint32_t
+uniform_reads(
+	struct rules *rules,
+	const struct v3d_qpu_instr *instruction)
+{
+	uint32_t count;
+
+	/* A branch reads one when it moves the stream. */
+	(void)rules;
+	if (instruction->type == V3D_QPU_INSTR_TYPE_BRANCH)
+		return instruction->branch.ub ? 1U : 0U;
+
+	/* Loads and the magic writes that read one. */
+	count = 0;
+	if (instruction->sig.ldunif || instruction->sig.ldunifrf)
+		count++;
+	if (instruction->sig.wrtmuc)
+		count++;
+	if (instruction->alu.add.op != V3D_QPU_A_NOP && instruction->alu.add.magic_write && v3d_qpu_magic_waddr_loads_unif(instruction->alu.add.waddr))
+		count++;
+	if (instruction->alu.mul.op != V3D_QPU_M_NOP && instruction->alu.mul.magic_write && v3d_qpu_magic_waddr_loads_unif(instruction->alu.mul.waddr))
+		count++;
+	return count;
+}
+
+/* Tells whether a word writes one magic address through either ALU. */
+static bool
+writes_magic(
+	const struct v3d_qpu_instr *instruction,
+	uint32_t address)
+{
+	/* The add ALU's write. */
+	if (instruction->alu.add.op != V3D_QPU_A_NOP && instruction->alu.add.magic_write && instruction->alu.add.waddr == address)
+		return true;
+
+	/* The multiply ALU's. */
+	if (instruction->alu.mul.op != V3D_QPU_M_NOP && instruction->alu.mul.magic_write && instruction->alu.mul.waddr == address)
+		return true;
+	return false;
+}
+
+/* Tells whether a word writes one register through either ALU or a signal. */
+static bool
+writes_register(
+	const struct v3d_qpu_instr *instruction,
+	uint32_t address)
+{
+	/* The ALUs' register writes. */
+	if (instruction->alu.add.op != V3D_QPU_A_NOP && !instruction->alu.add.magic_write &&
+	    v3d_qpu_add_op_has_dst(instruction->alu.add.op) && instruction->alu.add.waddr == address)
+		return true;
+	if (instruction->alu.mul.op != V3D_QPU_M_NOP && !instruction->alu.mul.magic_write &&
+	    v3d_qpu_mul_op_has_dst(instruction->alu.mul.op) && instruction->alu.mul.waddr == address)
+		return true;
+	return false;
+}
+
+/* Checks one branch word (rules 1, 2, 3, 9, 11, 12). */
+static void
+check_branch(
+	struct rules *rules,
+	const struct v3d_qpu_instr *instruction)
+{
+	const struct qpu71_rules_program *program;
+	uint32_t target;
+	uint32_t reads;
+	uint32_t index;
+	int32_t offset;
+
+	/* No branch in another branch's three delay words or a switch's two (rules 1, 2). */
+	program = rules->program;
+	if (rules->last_branch != RULES_NONE && rules->word <= rules->last_branch + 3)
+		broken(rules, 1, "branch in another branch's delay words");
+	if (rules->last_switch != RULES_NONE && rules->word <= rules->last_switch + 2)
+		broken(rules, 2, "branch in a thread switch's delay words");
+	if (rules->last_unifa != RULES_NONE && rules->word <= rules->last_unifa + 3)
+		broken(rules, 3, "branch within three words of a unifa write");
+	if (rules->thread_end != RULES_NONE)
+		broken(rules, 5, "branch after the thread end");
+	rules->last_branch = rules->word;
+
+	/* The block ends clean (rule 9). */
+	check_block_clean(rules, "at a branch");
+
+	/* A compute program's conditional branch leaves out the lanes the CSD did not dispatch (rule 11). */
+	if (program->compute != 0 &&
+	    instruction->branch.cond != V3D_QPU_BRANCH_COND_ALWAYS &&
+	    instruction->branch.msfign != V3D_QPU_MSFIGN_P)
+		broken(rules, 11, "conditional compute branch without msfign P");
+	if (instruction->branch.bdi != V3D_QPU_BRANCH_DEST_REL)
+		broken(rules, 1, "branch target not relative");
+
+	/* A backward branch's uniform move rewinds exactly the uniforms read from its target through itself (rule 12). */
+	target = (uint32_t)((int32_t)rules->word + 4 + (int32_t)instruction->branch.offset / 8);
+	if (!instruction->branch.ub || target > rules->word || program->uniforms == NULL)
+		return;
+	reads = 0;
+	for (index = target; index <= rules->word; index++)
+		reads += uniform_reads(rules, &rules->words[index]);
+	if (rules->uniforms >= program->uniform_count) {
+		broken(rules, 12, "branch uniform beyond the stream");
+		return;
+	}
+	offset = (int32_t)program->uniforms[rules->uniforms];
+	if (offset != -4 * (int32_t)reads)
+		broken(rules, 12, "backward branch does not rewind the loop's uniforms");
+}
+
+/* Checks one ALU word (rules 1 to 10). */
+static void
+check_alu_word(
+	struct rules *rules,
+	const struct v3d_qpu_instr *instruction)
+{
+	uint32_t restricted;
+	uint32_t immediates;
+	uint32_t reads;
+	uint32_t words;
+	bool in_branch;
+	bool in_switch;
+	bool tmu_data;
+	bool tmu_address;
+	bool special;
+	bool marking;
+
+	/* What the word does. */
+	reads = uniform_reads(rules, instruction);
+	in_branch = rules->last_branch != RULES_NONE && rules->word <= rules->last_branch + 3;
+	in_switch = rules->last_switch != RULES_NONE && rules->word <= rules->last_switch + 2;
+	tmu_data = writes_magic(instruction, V3D_QPU_WADDR_TMUD);
+	tmu_address = writes_magic(instruction, V3D_QPU_WADDR_TMUA) || writes_magic(instruction, V3D_QPU_WADDR_TMUAU);
+	special = v3d_qpu_instr_is_sfu(instruction);
+
+	/* A branch's delay words: no switch, no unifa write, no uniform (rule 1). */
+	if (in_branch) {
+		if (instruction->sig.thrsw)
+			broken(rules, 1, "thread switch in a branch's delay words");
+		if (writes_magic(instruction, V3D_QPU_WADDR_UNIFA))
+			broken(rules, 1, "unifa write in a branch's delay words");
+		if (reads != 0 || instruction->sig.ldunifa || instruction->sig.ldunifarf)
+			broken(rules, 1, "uniform read in a branch's delay words");
+	}
+
+	/* The uniform address window (rule 3). */
+	if (instruction->sig.ldunifa || instruction->sig.ldunifarf) {
+		if (rules->last_unifa == RULES_NONE)
+			broken(rules, 3, "ldunifa without a unifa write");
+		else if (rules->word <= rules->last_unifa + 3)
+			broken(rules, 3, "ldunifa within three words of its unifa write");
+		if (reads != 0)
+			broken(rules, 3, "ldunifa beside another uniform read");
+	}
+	if (writes_magic(instruction, V3D_QPU_WADDR_UNIFA))
+		rules->last_unifa = rules->word;
+
+	/* The integer multiply's latch (rule 4). */
+	if (instruction->alu.mul.op == V3D_QPU_M_MULTOP) {
+		if (rules->multiply_open)
+			broken(rules, 4, "MULTOP while another's top half is unused");
+		rules->multiply_open = true;
+		rules->multiply_word = rules->word;
+	} else if (instruction->alu.mul.op == V3D_QPU_M_UMUL24) {
+		rules->multiply_open = false;
+	}
+	if (instruction->sig.thrsw && rules->multiply_open)
+		broken(rules, 4, "thread switch between MULTOP and UMUL24");
+
+	/* A special function's spacing and its result's word (rule 6). */
+	if (special) {
+		if (rules->last_special != RULES_NONE && rules->word < rules->last_special + 2)
+			broken(rules, 6, "special function too soon after another");
+		if (in_switch && !instruction->sig.thrsw)
+			broken(rules, 6, "special function in a thread switch's delay words");
+		rules->last_special = rules->word;
+		rules->special_destination = instruction->alu.add.waddr;
+	} else if (rules->last_special != RULES_NONE && rules->word == rules->last_special + 1) {
+		if (v3d71_qpu_reads_raddr(instruction, (uint8_t)rules->special_destination))
+			broken(rules, 6, "special function result read one word after it");
+		if (writes_register(instruction, rules->special_destination))
+			broken(rules, 6, "special function result overwritten as it lands");
+	}
+
+	/* One restricted unit and one small immediate per word (rules 7, 8). */
+	restricted = 0;
+	if (v3d_qpu_writes_tmu(rules->device, instruction))
+		restricted++;
+	if (special)
+		restricted++;
+	if (v3d_qpu_uses_vpm(instruction))
+		restricted++;
+	if (writes_magic(instruction, V3D_QPU_WADDR_SYNCB) || writes_magic(instruction, V3D_QPU_WADDR_SYNC) || writes_magic(instruction, V3D_QPU_WADDR_SYNCU))
+		restricted++;
+	if (restricted > 1)
+		broken(rules, 7, "more than one restricted unit in one word");
+	immediates = 0;
+	if (instruction->sig.small_imm_a || instruction->sig.small_imm_b)
+		immediates++;
+	if (instruction->sig.small_imm_c || instruction->sig.small_imm_d)
+		immediates++;
+	if (immediates > 1)
+		broken(rules, 8, "more than one small immediate in one word");
+	if (reads > 1)
+		broken(rules, 7, "more than one uniform read in one word");
+
+	/* The barrier: the TMU idle before it, a switch after it before any TMU operation (rule 10). */
+	if (writes_magic(instruction, V3D_QPU_WADDR_SYNCB)) {
+		if (rules->sequence_open || rules->outstanding_loads != 0 || rules->stores != 0)
+			broken(rules, 10, "barrier with TMU transactions outstanding");
+		rules->barrier_open = true;
+	}
+	if (rules->barrier_open && (tmu_data || tmu_address || instruction->sig.ldtmu))
+		broken(rules, 10, "TMU operation between a barrier and its switch");
+
+	/* The TMU sequence: data words, then the address; nothing else of the TMU in between (rule 9). */
+	if (tmu_data || tmu_address) {
+		rules->sequence_open = true;
+		rules->sequence_writes++;
+	}
+	if (instruction->sig.ldtmu) {
+		if (rules->sequence_open)
+			broken(rules, 9, "ldtmu inside a TMU sequence");
+		if (rules->outstanding_words == 0)
+			broken(rules, 9, "ldtmu with no outstanding lookup");
+		else
+			rules->outstanding_words--;
+		if (rules->outstanding_words == 0)
+			rules->outstanding_loads = 0;
+	}
+	if (instruction->sig.thrsw && rules->sequence_open)
+		broken(rules, 9, "thread switch inside a TMU sequence");
+	if (instruction->alu.add.op == V3D_QPU_A_TMUWT) {
+		if (rules->sequence_open)
+			broken(rules, 9, "TMUWT inside a TMU sequence");
+		rules->stores = 0;
+	}
+	if (tmu_address) {
+		if (rules->sequence_writes > 16 / rules->program->threads)
+			broken(rules, 9, "TMU sequence exceeds the input FIFO");
+		words = config_words(rules, rules->uniforms);
+		if (rules->sequence_writes > 1) {
+			rules->stores++;
+		} else {
+			rules->outstanding_words += words;
+			rules->outstanding_loads++;
+			if (rules->outstanding_words > 16 / rules->program->threads)
+				broken(rules, 9, "TMU lookups exceed the output FIFO");
+		}
+		if (rules->outstanding_loads + rules->stores > RULES_QUEUE)
+			broken(rules, 9, "more than eight TMU operations outstanding");
+		rules->sequence_open = false;
+		rules->sequence_writes = 0;
+	}
+
+	/* Thread switches: two in a row mark the last one, the next ends the thread (rules 2, 5). */
+	if (!instruction->sig.thrsw)
+		return;
+	marking = rules->last_switch != RULES_NONE && rules->last_switch + 1 == rules->word && !rules->last_marked && rules->program->single_segment == 0;
+	if (marking) {
+		rules->last_marked = true;
+		return;
+	}
+	if (in_switch)
+		broken(rules, 2, "thread switch in another switch's delay words");
+	rules->barrier_open = false;
+	if (rules->last_marked || rules->program->single_segment != 0) {
+		if (rules->thread_end != RULES_NONE)
+			broken(rules, 5, "second thread end");
+		rules->thread_end = rules->word;
+	}
+	rules->last_switch = rules->word;
+}
+
+/* Requires nothing of the TMU or the multiply to be outstanding at a block boundary (rules 4, 9). */
+static void
+check_block_clean(
+	struct rules *rules,
+	const char *where)
+{
+	char reason[96];
+
+	/* Each kind of leftover is its own finding. */
+	if (rules->sequence_open) {
+		snprintf(reason, sizeof(reason), "TMU sequence open %s", where);
+		broken(rules, 9, reason);
+	}
+	if (rules->outstanding_words != 0) {
+		snprintf(reason, sizeof(reason), "TMU lookups outstanding %s", where);
+		broken(rules, 9, reason);
+	}
+	if (rules->stores != 0) {
+		snprintf(reason, sizeof(reason), "TMU stores not waited for %s", where);
+		broken(rules, 9, reason);
+	}
+	if (rules->multiply_open) {
+		snprintf(reason, sizeof(reason), "MULTOP top half unused %s", where);
+		broken(rules, 4, reason);
+	}
+
+	/* A block's walk restarts clean, so one leftover is reported once. */
+	rules->sequence_open = false;
+	rules->sequence_writes = 0;
+	rules->outstanding_words = 0;
+	rules->outstanding_loads = 0;
+	rules->stores = 0;
+	rules->multiply_open = false;
+}
+
+/* Tells how many words a TMU address write accesses: one, or the vector its uniform configures. */
+static uint32_t
+config_words(
+	struct rules *rules,
+	uint32_t index)
+{
+	const struct v3d_qpu_instr *instruction;
+	uint32_t config;
+
+	/* A plain TMUA write is one word. */
+	instruction = &rules->words[rules->word];
+	if (!writes_magic(instruction, V3D_QPU_WADDR_TMUAU))
+		return 1;
+
+	/* Without the stream the vector length is unknown; the largest is assumed. */
+	if (rules->program->uniforms == NULL || index >= rules->program->uniform_count)
+		return 4;
+	config = rules->program->uniforms[index];
+	if (config >= 0xfffffffaU && config <= 0xfffffffcU)
+		return config - 0xfffffffaU + 2;
+	broken(rules, 9, "TMU configuration other than a regular per-pixel vector");
+	return 1;
+}
diff --git a/plan/ws283/tests/qpu71-rules.h b/plan/ws283/tests/qpu71-rules.h
new file mode 100644
index 0000000000..b518c0756d
--- /dev/null
+++ b/plan/ws283/tests/qpu71-rules.h
@@ -0,0 +1,42 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * A static checker of the V3D 7.1 compute program rules (WS283 design
+ * section 1.8), written from that list and not from Mesa's validator.
+ *
+ * The checker reads the words with the unmodified MIT Mesa decoder and
+ * walks them in program order, splitting blocks at branches and branch
+ * targets.  It complements the dispatch model: the model sees only the
+ * paths a test takes, the checker sees every word.  Each broken rule is
+ * printed with its word and counted.
+ */
+#ifndef WS283_QPU71_RULES_H
+#define WS283_QPU71_RULES_H
+
+#include <stdint.h>
+
+#include "broadcom/common/v3d_device_info.h"
+
+/* What the checker needs besides the words. */
+struct qpu71_rules_program {
+	const uint64_t *code;
+	uint32_t count;
+	/* The uniform stream, when known, so a backward branch's rewind can be checked; may be null. */
+	const uint32_t *uniforms;
+	uint32_t uniform_count;
+	/* Two or four threads (the TMU FIFO limits) and whether the first switch ends the thread. */
+	uint32_t threads;
+	uint32_t single_segment;
+	/* Set when conditional branches must ignore the lanes the CSD did not dispatch (every compute program). */
+	uint32_t compute;
+};
+
+/* Checks every rule; returns the number of broken ones, each printed with its word unless quiet. */
+uint32_t qpu71_rules_check(const struct v3d_device_info *device, const struct qpu71_rules_program *program, uint32_t quiet);
+
+#endif
diff --git a/plan/ws283/tests/shader71-host-test.c b/plan/ws283/tests/shader71-host-test.c
new file mode 100644
index 0000000000..bccb8a4c5f
--- /dev/null
+++ b/plan/ws283/tests/shader71-host-test.c
@@ -0,0 +1,2004 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The V3D 7.1 native shader compiler checked against the source program (ws279-p004).
+ *
+ * The 7.1 copy of plan/tools/v3d-qpu/shader-host-test.c: the compiler is built
+ * from the shared files and the 7.1 copies (qpu71.c, shader71-lower.c,
+ * shader71-output.c, shader71-schedule.c), and the words run on the 7.1 lane
+ * model (qpu71-machine.c).  The rest of the description is the original's.
+ *
+ *
+ * Every Keiland and app shader in the tree is compiled for each native stage
+ * and pipeline variant.  The words run on the timing model of one QPU lane
+ * (qpu-machine.c, read with the independent MIT Mesa decoder), and each
+ * output is compared, bit for bit, with an independent interpretation of the
+ * shared frontend's scalar source program over deterministic and random
+ * inputs.  The table of native program sizes is printed (WS141 p013).
+ */
+#include <assert.h>
+#include <math.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "broadcom/common/v3d_device_info.h"
+#include "broadcom/qpu/qpu_instr.h"
+#include "drivers/gpu/bcm2711/compiler/shader.h"
+#include "drivers/gpu/compiler/optimize.h"
+#include "drivers/gpu/compiler/spirv.h"
+#include <uapi/errno.h>
+#include "plan/ws279/tests/qpu71-machine.h"
+#include "userland/desktop/wayland/shaders.h"
+#include "userland/tests/mview/shaders.h"
+#include "userland/tests/vkdemo/shaders.h"
+#include "userland/tests/egltest/shaders.h"
+#include "userland/desktop/files/shaders.h"
+#include "userland/desktop/monitor/shaders.h"
+#include "userland/desktop/libbrowser/paint/shaders.h"
+#include "userland/desktop/notes/shaders.h"
+#include "userland/desktop/libkeiland/ui/shaders.h"
+#include "userland/desktop/libGL/shaders.h"
+#include "userland/desktop/terminal/shaders.h"
+#include "userland/desktop/imageview/shaders.h"
+/* The driver's own texture-copy program (vulkan-native-image.c), compiled at run time like any other. */
+#include "drivers/gpu/bcm2711/vk/meta/texture-words.inc"
+
+/* Random trials per native program, besides the deterministic Keiland ones. */
+#define RANDOM_TRIALS 96U
+
+/* One host-only bit conversion preserves exact scalar representations without aliasing violations. */
+union scalar_bits {
+	uint32_t bits;
+	float number;
+};
+
+/* One evaluation's inputs and outputs, shared by the source interpreter and the native run. */
+struct shader_inputs {
+	/* Inputs by location times four plus component. */
+	uint32_t input[64];
+	uint32_t push[64];
+	uint32_t output[68];
+	uint32_t lookups;
+	/* Varies the uniform block words between trials. */
+	uint32_t block_seed;
+};
+
+/* One vertex and fragment module pair of the tree; a module the compiler refuses is named so. */
+struct shader_pair {
+	const char *name;
+	const uint32_t *vertex;
+	size_t vertex_bytes;
+	const uint32_t *fragment;
+	size_t fragment_bytes;
+	/* Set when the native compiler is expected to refuse the fragment or the vertex module. */
+	uint32_t fragment_refused;
+	uint32_t vertex_refused;
+};
+
+/* Every module pair of the tree that the native compiler may meet. */
+static const struct shader_pair shader_pairs[] = {
+	{"kwl quad", kwl_quad_vert, sizeof(kwl_quad_vert), kwl_quad_frag, sizeof(kwl_quad_frag), 0, 0},
+	{"kwl panel", kwl_panel_vert, sizeof(kwl_panel_vert), kwl_panel_frag, sizeof(kwl_panel_frag), 0, 0},
+	{"kwl batch", kwl_batch_vert, sizeof(kwl_batch_vert), kwl_batch_frag, sizeof(kwl_batch_frag), 0, 0},
+	{"mview", mview_vertex_shader, sizeof(mview_vertex_shader), mview_fragment_shader, sizeof(mview_fragment_shader), 0, 0},
+	{"mview cutout", mview_vertex_shader, sizeof(mview_vertex_shader), mview_cutout_shader, sizeof(mview_cutout_shader), 1, 0},
+	{"mview pixel", mview_pixel_vertex_shader, sizeof(mview_pixel_vertex_shader), mview_pixel_fragment_shader, sizeof(mview_pixel_fragment_shader), 1, 0},
+	{"mview pixel cutout", mview_pixel_vertex_shader, sizeof(mview_pixel_vertex_shader), mview_pixel_cutout_shader, sizeof(mview_pixel_cutout_shader), 1, 0},
+	{"vkdemo", vkdemo_vertex_shader, sizeof(vkdemo_vertex_shader), vkdemo_fragment_shader, sizeof(vkdemo_fragment_shader), 0, 1},
+	{"egltest", egltest_scene_vert, sizeof(egltest_scene_vert), egltest_scene_frag, sizeof(egltest_scene_frag), 0, 0},
+	{"files", files_canvas_vert, sizeof(files_canvas_vert), files_canvas_frag, sizeof(files_canvas_frag), 0, 0},
+	{"monitor shape", monitor_draw_vert, sizeof(monitor_draw_vert), monitor_shape_frag, sizeof(monitor_shape_frag), 0, 0},
+	{"monitor glyph", monitor_draw_vert, sizeof(monitor_draw_vert), monitor_glyph_frag, sizeof(monitor_glyph_frag), 0, 0},
+	{"browser paint", paint_display_vert, sizeof(paint_display_vert), paint_display_frag, sizeof(paint_display_frag), 0, 0},
+	{"notes fill", notes_draw_vert, sizeof(notes_draw_vert), notes_fill_frag, sizeof(notes_fill_frag), 0, 0},
+	{"notes texture", notes_draw_vert, sizeof(notes_draw_vert), notes_texture_frag, sizeof(notes_texture_frag), 0, 0},
+	{"keiland ui", keiui_canvas_vert, sizeof(keiui_canvas_vert), keiui_canvas_frag, sizeof(keiui_canvas_frag), 0, 0},
+	{"libGL 1", fixed_vert_1, sizeof(fixed_vert_1), fixed_frag, sizeof(fixed_frag), 1, 0},
+	{"libGL 2", fixed_vert_2, sizeof(fixed_vert_2), fixed_frag, sizeof(fixed_frag), 1, 0},
+	{"libGL 4", fixed_vert_4, sizeof(fixed_vert_4), fixed_frag, sizeof(fixed_frag), 1, 0},
+	{"libGL 8", fixed_vert_8, sizeof(fixed_vert_8), fixed_frag, sizeof(fixed_frag), 1, 0},
+	{"libGL flat", fixed_flat_vert, sizeof(fixed_flat_vert), fixed_flat_frag, sizeof(fixed_flat_frag), 1, 0},
+	{"terminal", terminal_cell_vert, sizeof(terminal_cell_vert), terminal_cell_frag, sizeof(terminal_cell_frag), 0, 0},
+	{"imageview", imageview_canvas_vert, sizeof(imageview_canvas_vert), imageview_canvas_frag, sizeof(imageview_canvas_frag), 0, 0},
+	{"meta texture copy", meta_vert_words, sizeof(meta_vert_words), meta_frag_words, sizeof(meta_frag_words), 0, 0},
+};
+
+/* Allocation accounting observes actual parser/compiler cleanup without any production test control. */
+static size_t allocations_live;
+
+/* One host allocation attempt can be refused to exercise the ordinary unpublished-program unwind. */
+static size_t allocation_attempt;
+static size_t allocation_refusal;
+
+/* The random generator's state, reseeded for each program and trial. */
+static uint32_t random_state;
+
+/*
+ * The hand-built source program of the optimizer test (WS141 p013).
+ *
+ * optimizer_program() fills it from the start for each stage; it lives in
+ * static storage because the source program description only points at it.
+ */
+static struct drv_gpu_shader_ir_inst optimizer_code[192];
+static uint32_t optimizer_count;
+static uint32_t optimizer_values;
+
+/* The program and trial under test, named by a failure. */
+static const char *current_program;
+static uint32_t current_trial;
+
+static uint32_t float_bits(float number);
+static float bits_float(uint32_t bits);
+static uint32_t truth(int condition);
+static uint32_t half_bits(float number);
+static uint32_t next_random(void);
+static uint32_t random_float(void);
