--- /dev/null
+++ b/plan/ws291/tests/input-worker/host-input-worker.c
@@ -0,0 +1,601 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The host test of the zedBSD backend's input devices' thread
+ * (libkeiland-backend-zedbsd/input-zedbsd.c): backend.c, events-zedbsd.c
+ * and input-zedbsd.c on the host, with /dev/input faked by the linker's
+ * --wrap of opendir, readdir, closedir, open, ioctl and close:
+ *   event0  a keyboard (EV_KEY with KEY_A and KEY_Z), opens at once;
+ *   event4  a PS/2 mouse port without a mouse: the open waits 80 ms and
+ *           fails with EIO;
+ *   event5  a node the compositor does not keep (EV_SYN only).
+ * It checks:
+ *   - kl_backend_input_scan and every kl_backend_poll_done return in a few
+ *     milliseconds while the thread waits on event4;
+ *   - the keyboard is offered on the main thread through the poll, event5
+ *     is offered and closed by the thread, never by the main thread;
+ *   - a later scan does not open event0 (read) or event4 (refused) again,
+ *     and opens event5 again;
+ *   - kl_backend_input_devices_changed makes the next scan try event4
+ *     again; without the system's events every scan tries it;
+ *   - kl_backend_input_close is done by the thread;
+ *   - when the thread cannot start, the scan offers the devices from its
+ *     own call;
+ *   - kl_backend_close ends the thread (the sanitizers see no leak).
+ *
+ *   sh plan/ws291/tests/input-worker/run.sh [build-dir]
+ */
+
+#include "userland/desktop/libkeiland-backend/backend-private.h"
+#include "userland/desktop/libkeiland-backend/keiland-backend-evdev.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <unistd.h>
+
+/* The fake nodes. */
+#define FAKE_NODES	3U
+#define FAKE_KEYBOARD	0U
+#define FAKE_MOUSE	1U
+#define FAKE_OTHER	2U
+
+/* How long event4's open waits, and the longest a main-thread call may take (microseconds). */
+#define FAKE_MOUSE_WAIT_US	80000U
+#define MAIN_CALL_MAX_US	5000U
+
+/* The bits of a bitmap of unsigned longs. */
+#define BITS_PER_LONG	(8U * sizeof(unsigned long))
+
+/* One fake node: its name, how often it was opened and closed, and on which thread it was closed. */
+struct fake_node {
+	const char *name;
+	unsigned long node;
+	int opens;
+	int closes;
+	int closes_on_main;
+	int descriptor;
+};
+
+/* What the compositor's callbacks keep. */
+struct seat {
+	int keyboard;
+	int offers;
+	int offers_off_main;
+	char keyboard_path[KL_BACKEND_INPUT_PATH_MAX];
+};
+
+/* The real functions the wrappers call. */
+int __real_open(const char *path, int flags, ...);
+int __real_close(int descriptor);
+int __real_pthread_create(pthread_t *thread, const pthread_attr_t *attributes, void *(*start)(void *), void *argument);
+
+/* The wrappers the linker puts in place of the backend's calls. */
+DIR *__wrap_opendir(const char *path);
+struct dirent *__wrap_readdir(DIR *directory);
+int __wrap_closedir(DIR *directory);
+int __wrap_open(const char *path, int flags, ...);
+int __wrap_ioctl(int descriptor, unsigned long request, ...);
+int __wrap_close(int descriptor);
+int __wrap_pthread_create(pthread_t *thread, const pthread_attr_t *attributes, void *(*start)(void *), void *argument);
+
+static int input_known(void *data, const char *path);
+static int input_found(void *data, int descriptor, const char *path, const struct kl_backend_input_caps *caps);
+static void check(int condition, const char *what);
+static uint64_t now_us(void);
+static struct fake_node *node_by_descriptor(int descriptor);
+static void set_bit(unsigned long *bits, unsigned bit);
+static int poll_until(struct kl_backend *backend, struct seat *seat, int keyboard, uint64_t limit_us);
+static void wait_quiet(struct kl_backend *backend, struct seat *seat);
+static void reset_counts(void);
+static int fake_read(const int *field);
+static struct kl_backend *open_backend(struct seat *seat, struct kl_backend_host *host);
+
+/* The fake nodes, guarded by fake_lock (the thread and the main thread both touch them). */
+static struct fake_node fake_nodes[FAKE_NODES] = {
+	{ "event0", 0, 0, 0, 0, -1 },
+	{ "event4", 4, 0, 0, 0, -1 },
+	{ "event5", 5, 0, 0, 0, -1 },
+};
+static pthread_mutex_t fake_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* The fake directory's place in its listing, and the entry readdir returns. */
+static int fake_directory;
+static unsigned fake_cursor;
+static struct dirent fake_entry;
+
+/* The main thread, and whether pthread_create is to fail. */
+static pthread_t main_thread;
+static int create_fails;
+
+/* The longest main-thread call measured, the checks that failed and those that ran. */
+static uint64_t main_call_max_us;
+static int failures;
+static int checks;
+
+/* Runs the checks. */
+int
+main(void)
+{
+	struct kl_backend_host host;
+	struct kl_backend *backend;
+	struct seat seat;
+	int pipes[2];
+	uint64_t start;
+	uint64_t spent;
+	int found;
+	int error;
+
+	/* The main thread is the event loop's. */
+	main_thread = pthread_self();
+
+	/* A backend whose system's events are a quiet pipe, so refusals are remembered. */
+	backend = open_backend(&seat, &host);
+	error = pipe(pipes);
+	check(error == 0, "pipe");
+	(void)fcntl(pipes[0], F_SETFL, O_NONBLOCK);
+	backend->events_descriptor = pipes[0];
+
+	/* The first scan returns at once though event4 waits 80 ms. */
+	start = now_us();
+	kl_backend_input_scan(backend);
+	spent = now_us() - start;
+	check(spent < MAIN_CALL_MAX_US, "scan returns at once");
+	check(seat.keyboard == 0, "nothing offered from the scan's call");
+
+	/* The keyboard comes through the poll, every poll_done short. */
+	found = poll_until(backend, &seat, 1, 2000000U);
+	check(found, "keyboard offered through the poll");
+	check(seat.offers_off_main == 0, "offers on the main thread");
+	wait_quiet(backend, &seat);
+	check(fake_read(&fake_nodes[FAKE_KEYBOARD].opens) == 1, "event0 opened once");
+	check(fake_read(&fake_nodes[FAKE_MOUSE].opens) == 1, "event4 tried once");
+	check(fake_read(&fake_nodes[FAKE_OTHER].opens) == 1, "event5 opened once");
+	check(fake_read(&fake_nodes[FAKE_OTHER].closes) == 1, "event5 closed (not kept)");
+	check(fake_read(&fake_nodes[FAKE_OTHER].closes_on_main) == 0, "event5 closed off the main thread");
+	check(main_call_max_us < MAIN_CALL_MAX_US, "every poll_done short");
+
+	/* A second scan passes the keyboard and the refused port by. */
+	kl_backend_input_scan(backend);
+	wait_quiet(backend, &seat);
+	check(fake_read(&fake_nodes[FAKE_KEYBOARD].opens) == 1, "event0 not opened again");
+	check(fake_read(&fake_nodes[FAKE_MOUSE].opens) == 1, "event4 not tried again");
+	check(fake_read(&fake_nodes[FAKE_OTHER].opens) == 2, "event5 offered again");
+	check(seat.keyboard == 1, "one keyboard");
+
+	/* A device came or went: the port is tried again. */
+	kl_backend_input_devices_changed(backend);
+	kl_backend_input_scan(backend);
+	wait_quiet(backend, &seat);
+	check(fake_read(&fake_nodes[FAKE_MOUSE].opens) == 2, "event4 tried after a device's event");
+
+	/* Without the system's events every scan tries it. */
+	backend->events_descriptor = -1;
+	kl_backend_input_scan(backend);
+	wait_quiet(backend, &seat);
+	kl_backend_input_scan(backend);
+	wait_quiet(backend, &seat);
+	check(fake_read(&fake_nodes[FAKE_MOUSE].opens) == 4, "event4 tried at each scan without the events");
+	check(main_call_max_us < MAIN_CALL_MAX_US, "every poll_done short (later scans)");
+
+	/* The compositor gives the keyboard back: the thread closes it. */
+	kl_backend_input_close(backend, fake_read(&fake_nodes[FAKE_KEYBOARD].descriptor));
+	seat.keyboard = 0;
+	wait_quiet(backend, &seat);
+	check(fake_read(&fake_nodes[FAKE_KEYBOARD].closes) == 1, "keyboard closed");
+	check(fake_read(&fake_nodes[FAKE_KEYBOARD].closes_on_main) == 0, "keyboard closed off the main thread");
+
+	/* The backend closes; the thread ends. */
+	kl_backend_close(backend);
+	(void)__real_close(pipes[1]);
+
+	/* Without the thread the scan offers the devices from its call. */
+	reset_counts();
+	create_fails = 1;
+	backend = open_backend(&seat, &host);
+	kl_backend_input_scan(backend);
+	check(seat.keyboard == 1, "keyboard offered from the scan's call without the thread");
+	check(kl_backend_poll_count(backend) == 0, "no pipe in the poll without the thread");
+	check(fake_read(&fake_nodes[FAKE_OTHER].closes) == 1, "event5 closed in the call without the thread");
+	kl_backend_input_close(backend, fake_read(&fake_nodes[FAKE_KEYBOARD].descriptor));
+	check(fake_read(&fake_nodes[FAKE_KEYBOARD].closes) == 1, "keyboard closed in the call without the thread");
+	kl_backend_close(backend);
+
+	/* The verdict. */
+	printf("host-input-worker: %d checks, %d failed, longest main-thread call %llu us\n", checks, failures, (unsigned long long)main_call_max_us);
+	if (failures != 0) {
+		printf("host-input-worker: FAIL\n");
+		return 1;
+	}
+
+	/* Succeeded: every check held. */
+	printf("host-input-worker: PASS\n");
+	return 0;
+}
+
+/* Opens a backend whose host keeps the devices in seat. */
+static struct kl_backend *
+open_backend(
+	struct seat *seat,
+	struct kl_backend_host *host)
+{
+	struct kl_backend_options options;
+	struct kl_backend *backend;
+	int error;
+
+	/* The callbacks. */
+	memset(seat, 0, sizeof(*seat));
+	memset(host, 0, sizeof(*host));
+	memset(&options, 0, sizeof(options));
+	host->data = seat;
+	host->input_known = input_known;
+	host->input_found = input_found;
+
+	/* The backend. */
+	backend = NULL;
+	error = kl_backend_open(&options, host, &backend);
+	check(error == 0, "kl_backend_open");
+	if (error != 0)
+		exit(1);
+
+	/* Succeeded. */
+	return backend;
+}
+
+/* Polls the backend's descriptors until the keyboard count is reached or the limit passes; times each poll_done. */
+static int
+poll_until(
+	struct kl_backend *backend,
+	struct seat *seat,
+	int keyboard,
+	uint64_t limit_us)
+{
+	struct pollfd descriptors[8];
+	uint64_t start;
+	uint64_t mark;
+	uint64_t spent;
+	size_t count;
+
+	/* Each pass like the event loop's: count, fill, poll 10 ms, done. */
+	start = now_us();
+	while (now_us() - start < limit_us) {
+		count = kl_backend_poll_count(backend);
+		if (count > 8U)
+			return 0;
+		memset(descriptors, 0, sizeof(descriptors));
+		kl_backend_poll_fill(backend, descriptors);
+		(void)poll(descriptors, count, 10);
+		mark = now_us();
+		kl_backend_poll_done(backend, descriptors);
+		spent = now_us() - mark;
+		if (spent > main_call_max_us)
+			main_call_max_us = spent;
+		if (seat->keyboard >= keyboard)
+			return 1;
+	}
+
+	/* The limit passed. */
+	return 0;
+}
+
+/* Polls for a while longer than the thread's slowest scan, so everything asked is done. */
+static void
+wait_quiet(
+	struct kl_backend *backend,
+	struct seat *seat)
+{
+	/* 300 ms covers the 80 ms open with room. */
+	(void)poll_until(backend, seat, 1000, 300000U);
+}
+
+/* Forgets the counts of the fake nodes. */
+static void
+reset_counts(void)
+{
+	unsigned index;
+
+	/* Each node. */
+	for (index = 0; index < FAKE_NODES; index++) {
+		fake_nodes[index].opens = 0;
+		fake_nodes[index].closes = 0;
+		fake_nodes[index].closes_on_main = 0;
+		fake_nodes[index].descriptor = -1;
+	}
+}
+
+/* Reads a fake node's count or descriptor under the lock the thread writes it under. */
+static int
+fake_read(
+	const int *field)
+{
+	int value;
+
+	pthread_mutex_lock(&fake_lock);
+	value = *field;
+	pthread_mutex_unlock(&fake_lock);
+	return value;
+}
+
+/* The compositor reads the keyboard once it kept it. */
+static int
+input_known(
+	void *data,
+	const char *path)
+{
+	struct seat *seat;
+
+	/* Only the kept keyboard is read. */
+	seat = data;
+	if (seat->keyboard > 0 && strcmp(path, seat->keyboard_path) == 0)
+		return 1;
+	return 0;
+}
+
+/* Keeps a node with EV_KEY; anything else is left to the backend to close. */
+static int
+input_found(
+	void *data,
+	int descriptor,
+	const char *path,
+	const struct kl_backend_input_caps *caps)
+{
+	struct seat *seat;
+
+	/* Counted, and the thread noted. */
+	(void)descriptor;
+	seat = data;
+	seat->offers++;
+	if (!pthread_equal(pthread_self(), main_thread))
+		seat->offers_off_main++;
+
+	/* A keyboard is kept. */
+	if ((caps->event[0] & (1UL << EV_KEY)) == 0U)
+		return 0;
+	seat->keyboard++;
+	snprintf(seat->keyboard_path, sizeof(seat->keyboard_path), "%s", path);
+	return 1;
+}
+
+/* The fake /dev/input. */
+DIR *
+__wrap_opendir(
+	const char *path)
+{
+	/* Only /dev/input is faked. */
+	if (strcmp(path, "/dev/input") != 0) {
+		errno = ENOENT;
+		return NULL;
+	}
+
+	/* A listing from the start. */
+	fake_cursor = 0;
+	return (DIR *)&fake_directory;
+}
+
+/* The fake listing: ".", then the nodes. */
+struct dirent *
+__wrap_readdir(
+	DIR *directory)
+{
+	/* The listing ends after the nodes. */
+	if (directory != (DIR *)&fake_directory)
+		return NULL;
+	if (fake_cursor > FAKE_NODES)
+		return NULL;
+
+	/* "." first, which is no node. */
+	memset(&fake_entry, 0, sizeof(fake_entry));
+	if (fake_cursor == 0)
+		snprintf(fake_entry.d_name, sizeof(fake_entry.d_name), ".");
+	else
+		snprintf(fake_entry.d_name, sizeof(fake_entry.d_name), "%s", fake_nodes[fake_cursor - 1U].name);
+	fake_cursor++;
+	return &fake_entry;
+}
+
+/* Ends the fake listing. */
+int
+__wrap_closedir(
+	DIR *directory)
+{
+	(void)directory;
+	return 0;
+}
+
+/* Opens a fake node (a descriptor of /dev/null), event4 after its wait and with EIO. */
+int
+__wrap_open(
+	const char *path,
+	int flags,
+	...)
+{
+	struct fake_node *node;
+	unsigned index;
+	int descriptor;
+	va_list arguments;
+	int mode;
+
+	/* Anything else is the real file. */
+	if (strncmp(path, "/dev/input/", 11) != 0) {
+		va_start(arguments, flags);
+		mode = va_arg(arguments, int);
+		va_end(arguments);
+		return __real_open(path, flags, mode);
+	}
+
+	/* The node by its name. */
+	node = NULL;
+	for (index = 0; index < FAKE_NODES; index++) {
+		if (strcmp(path + 11, fake_nodes[index].name) == 0)
+			node = &fake_nodes[index];
+	}
+	if (node == NULL) {
+		errno = ENOENT;
+		return -1;
+	}
+
+	/* Counted. */
+	pthread_mutex_lock(&fake_lock);
+	node->opens++;
+	pthread_mutex_unlock(&fake_lock);
+
+	/* The port without a mouse answers only after its timeout. */
+	if (node == &fake_nodes[FAKE_MOUSE]) {
+		usleep(FAKE_MOUSE_WAIT_US);
+		errno = EIO;
+		return -1;
+	}
+
+	/* Any other node is a descriptor of /dev/null. */
+	descriptor = __real_open("/dev/null", O_RDONLY | O_CLOEXEC);
+	pthread_mutex_lock(&fake_lock);
+	node->descriptor = descriptor;
+	pthread_mutex_unlock(&fake_lock);
+	return descriptor;
+}
+
+/* Answers the capability ioctls of a fake node. */
+int
+__wrap_ioctl(
+	int descriptor,
+	unsigned long request,
+	...)
+{
+	struct fake_node *node;
+	unsigned long *bits;
+	va_list arguments;
+	unsigned number;
+	size_t size;
+
+	/* The bitmap's address. */
+	va_start(arguments, request);
+	bits = va_arg(arguments, unsigned long *);
+	va_end(arguments);
+
+	/* Only the fake nodes answer. */
+	node = node_by_descriptor(descriptor);
+	if (node == NULL || _IOC_TYPE(request) != 'E') {
+		errno = ENOTTY;
+		return -1;
+	}
+
+	/* Empty unless set below. */
+	number = _IOC_NR(request);
+	size = _IOC_SIZE(request);
+	memset(bits, 0, size);
+
+	/* EVIOCGBIT(0): the event types; EVIOCGBIT(EV_KEY): the keys. */
+	if (number == 0x20U) {
+		set_bit(bits, EV_SYN);
+		if (node == &fake_nodes[FAKE_KEYBOARD])
+			set_bit(bits, EV_KEY);
+	} else if (number == 0x20U + EV_KEY && node == &fake_nodes[FAKE_KEYBOARD]) {
+		set_bit(bits, KEY_A);
+		set_bit(bits, KEY_Z);
+	}
+
+	/* Succeeded. */
+	return (int)size;
+}
+
+/* Closes a descriptor, counting the fake nodes' closes and their thread. */
+int
+__wrap_close(
+	int descriptor)
+{
+	struct fake_node *node;
+
+	/* A fake node's close is counted. */
+	node = node_by_descriptor(descriptor);
+	if (node != NULL) {
+		pthread_mutex_lock(&fake_lock);
+		node->closes++;
+		if (pthread_equal(pthread_self(), main_thread))
+			node->closes_on_main++;
+		node->descriptor = -1;
+		pthread_mutex_unlock(&fake_lock);
+	}
+
+	/* The real close. */
+	return __real_close(descriptor);
+}
+
+/* Starts a thread, or fails when the test asks it to. */
+int
+__wrap_pthread_create(
+	pthread_t *thread,
+	const pthread_attr_t *attributes,
+	void *(*start)(void *),
+	void *argument)
+{
+	/* The failure the fallback's check asks for. */
+	if (create_fails)
+		return EAGAIN;
+
+	/* The real thread. */
+	return __real_pthread_create(thread, attributes, start, argument);
+}
+
+/* The fake node a descriptor is open on, or NULL. */
+static struct fake_node *
+node_by_descriptor(
+	int descriptor)
+{
+	struct fake_node *node;
+	unsigned index;
+
+	/* Each node's latest descriptor. */
+	node = NULL;
+	pthread_mutex_lock(&fake_lock);
+	for (index = 0; index < FAKE_NODES; index++) {
+		if (descriptor >= 0 && fake_nodes[index].descriptor == descriptor)
+			node = &fake_nodes[index];
+	}
+	pthread_mutex_unlock(&fake_lock);
+	return node;
+}
+
+/* Sets one bit of a bitmap of unsigned longs. */
+static void
+set_bit(
+	unsigned long *bits,
+	unsigned bit)
+{
+	bits[bit / BITS_PER_LONG] |= 1UL << (bit % BITS_PER_LONG);
+}
+
+/* The monotonic clock in microseconds. */
+static uint64_t
+now_us(void)
+{
+	struct timespec now;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	return (uint64_t)now.tv_sec * 1000000U + (uint64_t)now.tv_nsec / 1000U;
+}
+
+/* Counts a check and reports a failure. */
+static void
+check(
+	int condition,
+	const char *what)
+{
+	checks++;
+	if (condition)
+		return;
+	failures++;
+	printf("FAIL: %s\n", what);
+}
diff --git a/plan/ws291/tests/input-worker/run.sh b/plan/ws291/tests/input-worker/run.sh
new file mode 100644
index 0000000000..2d54ab1de9
--- /dev/null
+++ b/plan/ws291/tests/input-worker/run.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Builds and runs the host test of the zedBSD backend's input devices' thread: libkeiland-backend's backend.c, the zedBSD
+# events-zedbsd.c and input-zedbsd.c on the host, with /dev/input faked by the linker's --wrap, under the sanitizers.
+#   sh plan/ws291/tests/input-worker/run.sh [build-dir]
+# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
+set -eu
+cd "$(dirname -- "$0")/../../../.."
+out=${1:-build/ws291/host-input-worker}
+mkdir -p "$out"
+wraps="-Wl,--wrap=opendir -Wl,--wrap=readdir -Wl,--wrap=closedir -Wl,--wrap=open -Wl,--wrap=ioctl -Wl,--wrap=close -Wl,--wrap=pthread_create"
+for sanitizer in address,undefined thread; do
+	${CC:-cc} -std=gnu89 -Wall -Wextra -Werror -D_GNU_SOURCE -I. -Iinclude -fsanitize=$sanitizer -g -pthread \
+	    userland/desktop/libkeiland-backend/backend.c userland/desktop/libkeiland-backend/session/session-none.c \
