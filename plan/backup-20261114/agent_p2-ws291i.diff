@@ -0,0 +1,102 @@
+#!/bin/sh
+# ws291: the compositor whose input devices are found by the backend's own thread, on the RDNA machine, from the host
+# at the top of the tree, in one command: the compositor put in (with "deploy"; the machine's one kept as
+# /bin/wayland.p2b574 once), then
+#   1. the devices found at start-up (the compositor's KWL INPUT lines) and no KL INPUT worker failure;
+#   2. mview's stops (MVIEW HITCH, frames over 33 ms) in window mode (FIFO, 1 and 1500 copies) and game mode (mailbox,
+#      four images, 1 copy), 12 s each;
+#   3. the devices that come later: aat-input's pointer, tablet pointer and keyboard appear (the system's INPUT event,
+#      the thread's scan), and their drag, click, wheel and keys reach a client (mview's MVIEW INPUT lines); then they go
+#      (KWL INPUT_CLOSED);
+#   4. the compositor's slow passes (KWL SLOW_PASS) and its longest pass (KWL PERF main) of the whole run.
+# Long logs stay in OUT; the summary is printed.
+#   usage: plan/ws291/tests/kw2-check.sh OUT [deploy]
+# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
+set -u
+out=${1:?usage: kw2-check.sh OUT [deploy]}
+mkdir -p "$out"
+top=$(pwd)
+m=plan/tools/gpu-perf/measure.sh
+. plan/tools/gpu-perf/conf.sh
+KEY=${KEY:-$top/plan/tmp/guest/id_ed25519}
+mkdir -p "$top/build/tmp"
+ZSSHOPT="-o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ControlMaster=auto -o ControlPath=$top/build/tmp/ssh-%h -o ControlPersist=600"
+SESSION=/run/user/1000/session.log
+WAYLAND=${WAYLAND:-$PERF_BUILD/usb/bin/wayland}
+
+zs() {
+	timeout "${ZS_TIMEOUT:-60}" ssh -i "$KEY" $ZSSHOPT "root@$ip" "$@"
+}
+
+# The compositor put in, the machine's own kept once.
+if [ "${2:-}" = deploy ]; then
+	ip=$(sh "$m" zedbsd) || { echo "kw2: zedBSD not reached"; exit 1; }
+	zs "[ -f /bin/wayland.p2b574 ] || cp /bin/wayland /bin/wayland.p2b574; sync" || exit 1
+	timeout 1500 sh "$m" deploy "/bin/wayland=$WAYLAND" > "$out/deploy.out" 2>&1 || { tail -3 "$out/deploy.out"; echo "kw2: deploy failed"; exit 1; }
+fi
+ip=$(sh "$m" zedbsd) || { echo "kw2: zedBSD not reached"; exit 1; }
+here=$(wc -c < "$WAYLAND")
+there=$(zs "wc -c < /bin/wayland")
+echo "kw2: /bin/wayland bytes $there (build $here)"
+
+# 1. The devices of the start-up.
+zs "grep -E 'KWL INPUT|KL INPUT|KL EVENTS|KWL READY' $SESSION" > "$out/boot-input.txt"
+echo "kw2: start-up devices: $(grep -c 'KWL INPUT device' "$out/boot-input.txt"), worker failures: $(grep -c 'KL INPUT worker' "$out/boot-input.txt")"
+grep 'KWL INPUT device' "$out/boot-input.txt" | sed 's/^/  /'
+
+# 2. mview's stops (KW2_STEPS=hotplug leaves them out).
+for run in "win1|--spin=12" "win1500|--spin=12 --copies=1500" "game1|--spin=12 --content=game --present=mailbox --images=4"; do
+	[ "${KW2_STEPS:-all}" = hotplug ] && break
+	name=${run%%|*}
+	options=${run#*|}
+	timeout 300 sh "$m" mview "$out/$name" $options > "$out/$name.out" 2>&1
+	spin=$(grep -m1 'MVIEW SPIN' "$out/$name/mview.log" 2>/dev/null | grep -o 'fps=[0-9.]*')
+	hitches=$(grep -h 'MVIEW HITCHES' "$out/$name/mview.log" 2>/dev/null | tail -1 | grep -o 'hitches=[0-9]*')
+	frames=$(grep -h 'MVIEW HITCH run' "$out/$name/mview.log" 2>/dev/null | sed 's/.*frame=\([0-9]*\) ms=\([0-9.]*\).*/\1:\2/' | tr '\n' ' ')
+	echo "kw2: $name $spin $hitches [$frames]"
+done
+
+# 3. The devices that come later, and their input in a client: the script runs on its own on zedBSD (its sshd leaves
+# long sessions stuck now and then, BUG-346) and its output is fetched when it is done.
+zs "cat > /tmp/kw2.sh && rm -f /tmp/kw2.done /tmp/kw2.out && { (sh /tmp/kw2.sh > /tmp/kw2.out 2>&1; echo \$? > /tmp/kw2.done) > /dev/null 2>&1 < /dev/null & }" <<'EOS'
+S=/run/user/1000/session.log
+/bin/aat-input stop > /dev/null 2>&1
+sleep 2
+n=$(wc -l < $S)
+rm -f /tmp/kw2-mview.log
+su kei -c 'env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 /bin/mview --token=kw2 --timeout-s=20' > /tmp/kw2-mview.log 2>&1 < /dev/null &
+sleep 3
+/bin/aat-input start --width 1920 --height 1080 > /tmp/kw2-aat.out 2>&1
+tail -1 /tmp/kw2-aat.out
+sleep 3
+/bin/aat-input move-to 400 300
+/bin/aat-input move-to 900 600
+/bin/aat-input click 960 540
+/bin/aat-input key left
+/bin/aat-input key equal
+/bin/aat-input drag 700 400 900 500 5
+/bin/aat-input wheel 1
+sleep 2
+/bin/aat-input stop > /tmp/kw2-aat.out 2>&1
+tail -1 /tmp/kw2-aat.out
+sleep 2
+wait
+echo "== compositor"
+tail -n +$n $S | grep -E 'KWL INPUT|KWL EVENT|KL INPUT|KWL CURSOR shown'
+echo "== client"
+grep -c 'MVIEW INPUT run=kw2 kind=motion' /tmp/kw2-mview.log | sed 's/^/motion /'
+grep -c 'MVIEW INPUT run=kw2 kind=button' /tmp/kw2-mview.log | sed 's/^/button /'
+grep -c 'MVIEW INPUT run=kw2 kind=axis' /tmp/kw2-mview.log | sed 's/^/axis /'
+grep 'MVIEW INPUT run=kw2 kind=key' /tmp/kw2-mview.log | head -6
+EOS
+end=$(($(date +%s) + 120))
+while [ "$(date +%s)" -lt $end ]; do
+	sleep 3
+	ZS_TIMEOUT=15 zs "test -f /tmp/kw2.done" < /dev/null 2> /dev/null && break
+done
+zs "cat /tmp/kw2.out" > "$out/hotplug.txt" 2>&1 < /dev/null
+echo "kw2: hotplug: attached $(grep -c 'KWL INPUT device' "$out/hotplug.txt"), closed $(grep -c 'KWL INPUT_CLOSED' "$out/hotplug.txt"), $(grep -E '^(motion|button|axis) ' "$out/hotplug.txt" | tr '\n' ' ')keys $(grep -c 'MVIEW INPUT run=kw2 kind=key' "$out/hotplug.txt")"
+
+# 4. The compositor's passes over the whole run.
+zs "grep -E 'KWL SLOW_PASS|KWL PERF (main|pass)' $SESSION" > "$out/passes.txt"
+echo "kw2: slow passes $(grep -c 'KWL SLOW_PASS' "$out/passes.txt"); longest pass of the last PERF windows: $(grep 'KWL PERF pass' "$out/passes.txt" | grep -o 'pass_max_us=[0-9]*' | tail -5 | tr '\n' ' ')"
