+	error = pthread_cond_init(&worker->asked, NULL);
+	if (error != 0) {
+		printf("KL INPUT worker errno=%d\n", error);
+		pthread_mutex_destroy(&worker->lock);
+		free(worker);
+		return NULL;
+	}
