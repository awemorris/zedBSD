+static void
+known_snapshot(
+	struct kl_backend *backend,
+	struct kl_backend_input_worker *worker)
+{
+	uint64_t seen[INPUT_NODE_WORDS];
+	uint64_t known[INPUT_NODE_WORDS];
+	char path[KL_BACKEND_INPUT_PATH_MAX];
+	unsigned long node;
+	unsigned word;
+	unsigned refusals_kept;
+	int length;
+	int open_already;
