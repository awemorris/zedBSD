+/* Lists /dev/input and opens every eventN neither read, queued nor refused (the thread's side). */
+static void
+scan_directory(
+	struct kl_backend_input_worker *worker)
+{
+	DIR *directory;
+	struct dirent *entry;
+	char path[KL_BACKEND_INPUT_PATH_MAX];
+	uint64_t seen[INPUT_NODE_WORDS];
+	unsigned long node;
+	unsigned refusals_kept;
+	int length;
+	int valid;
+	int passed;
+
+	/*
+	 * Takes the scan asked.  Refusals are forgotten once a device came or
+	 * went, and when the system's events are no longer heard (nothing
+	 * would tell when to try again).
+	 */
+	pthread_mutex_lock(&worker->lock);
