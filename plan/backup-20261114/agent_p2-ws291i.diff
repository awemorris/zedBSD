+	/* Made once. */
+	if (backend->input_worker != NULL)
+		return backend->input_worker;
+
+	/* The state, with nothing asked, known or queued. */
+	worker = calloc(1, sizeof(*worker));
+	if (worker == NULL) {
+		printf("KL INPUT worker errno=%d\n", ENOMEM);
+		return NULL;
+	}
