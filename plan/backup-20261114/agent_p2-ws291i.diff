+	memset(known, 0, sizeof(known));
+	for (node = 0; node < INPUT_NODES; node++) {
+		/* A node not listed is not asked about. */
+		if (!node_marked(seen, node))
+			continue;
+
+		/* The compositor knows the node by its path. */
+		length = snprintf(path, sizeof(path), "%s/event%lu", INPUT_DIRECTORY, node);
+		if (length < 0 || (size_t)length >= sizeof(path))
+			continue;
+
+		/* A node the compositor already reads is left alone. */
+		open_already = 0;
+		if (backend->host.input_known != NULL)
+			open_already = backend->host.input_known(backend->host.data, path);
+		if (open_already)
+			node_mark(known, node);
+	}
+
+	/* The refusals are remembered only where the system's events tell when to forget them. */
+	refusals_kept = 0U;
+	if (backend->events_descriptor >= 0)
+		refusals_kept = 1U;
+
+	/* The scan, with what the compositor reads; scans asked meanwhile are one. */
+	pthread_mutex_lock(&worker->lock);
+
+	memcpy(worker->known, known, sizeof(known));
+	worker->refusals_kept = refusals_kept;
+	worker->scan_asked = 1U;
+	pthread_cond_signal(&worker->asked);
+
+	pthread_mutex_unlock(&worker->lock);
+}
