+	worker->scan_asked = 0U;
+	refusals_kept = worker->refusals_kept;
+	if (worker->forget_refused || !refusals_kept) {
+		memset(worker->refused, 0, sizeof(worker->refused));
+		worker->forget_refused = 0U;
+	}
