+/* Gives the column an OLED panel's X lands on, its range carried beyond the window to the output's edges as touch.c does. */
+static int32_t
+oled_column(
+	int32_t value)
+{
+	struct kwl_cursor_axis axis;
+	int64_t span;
+	int64_t width;
+
+	/* The range per thousandth of the window, carried to both of the output's edges. */
+	span = OLED_X_MAX;
+	width = OLED_WINDOW_RIGHT - OLED_WINDOW_LEFT;
+	axis.value = value;
+	axis.minimum = (int32_t)(0 - span * OLED_WINDOW_LEFT / width);
+	axis.maximum = (int32_t)(OLED_X_MAX + span * (OLED_WINDOW_WHOLE - OLED_WINDOW_RIGHT) / width);
+
+	/* Succeeded: the column, in whole pixels. */
+	return scale_axis(&axis, OUTPUT_WIDTH) / 256;
+}
+
+/* Gives the column so many thousandths of the output's width across. */
+static int32_t
+window_column(
+	int32_t thousandths)
+{
+	/* Succeeded: the column, rounding down. */
+	return (int32_t)((int64_t)(OUTPUT_WIDTH - 1) * thousandths / OLED_WINDOW_WHOLE);
+}
