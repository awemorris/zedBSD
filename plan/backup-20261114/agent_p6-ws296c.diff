+/* Reports one collected usage, with its page attached. */
+static int
+usage_value(
+	const struct hid_global_state *global,
+	const uint8_t *data,
+	size_t size,
+	uint32_t *result)
+{
+	uint32_t raw;
+
+	/* Refuses a usage item whose data is not one, two or four bytes long. */
+	if (size != 1U && size != 2U && size != 4U)
+		return EINVAL;
+
+	/* A four-byte usage names its own page in its upper half. */
+	raw = item_unsigned(data, size);
+	if (size == 4U) {
+		*result = raw;
+
+		/* Succeeded: the usage carries its own page. */
+		return 0;
+	}
+
+	/* Refuses a usage page that does not fit in the upper half of a usage. */
+	if (global->usage_page > UINT16_MAX)
+		return EOPNOTSUPP;
+
+	/* Attaches the usage page in force to the short usage. */
+	*result = (global->usage_page << 16U) | raw;
+
+	/* Succeeded: the usage carries the page in force. */
+	return 0;
+}
