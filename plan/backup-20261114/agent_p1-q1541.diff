+ * word; copied from the device address source otherwise.
+ */
+static int
+copy_or_write(
+	struct powervr_data_load *loads,
+	uint32_t room,
+	uint32_t *count,
+	uint32_t shared,
+	uint32_t words,
+	uint64_t source,
+	const uint8_t *bytes)
+{
+	uint32_t values[POWERVR_DATA_INLINE_WORDS + 1U];
+	uint32_t index;
+	const uint8_t *at;
+
+	/* A copy from memory when the words cannot be written. */
+	if (bytes == NULL || words == 0 || words > POWERVR_DATA_INLINE_WORDS || *count + words > room)
