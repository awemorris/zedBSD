+	/* The flat quad on the LINEAR target. */
+	status = linear_perf_case(run, PERF_FLAT);
+	if (status != VK_SUCCESS)
+		return status;
+
+	/* Succeeded: the case ran. */
+	return VK_SUCCESS;
+}
+
+/* perf-texture-linear: perf-texture on a LINEAR target. */
+static VkResult
+case_perf_texture_linear(
+	struct vkmatrix *run)
+{
