+
+	/* The textured quad on the LINEAR target. */
+	status = linear_perf_case(run, PERF_TEXTURE);
+	if (status != VK_SUCCESS)
+		return status;
+
+	/* Succeeded: the case ran. */
+	return VK_SUCCESS;
+}
+
+/* perf-clear-linear: perf-clear on a LINEAR target. */
+static VkResult
+case_perf_clear_linear(
