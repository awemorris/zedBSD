+/* Runs a perf case on a LINEAR 1920x1080 target (perf_tiling), then puts the tiling back. */
+static VkResult
+linear_perf_case(
+	struct vkmatrix *run,
+	int kind)
+{
+	VkResult status;
+
+	/* The case on the LINEAR target. */
+	perf_tiling = VK_IMAGE_TILING_LINEAR;
+	status = perf_case(run, kind);
+	perf_tiling = VK_IMAGE_TILING_OPTIMAL;
+	if (status != VK_SUCCESS)
+		return status;
+
+	/* Succeeded: the timing is printed. */
+	return VK_SUCCESS;
+}
