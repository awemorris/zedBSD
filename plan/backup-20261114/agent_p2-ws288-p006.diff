@@ -50,6 +50,32 @@
  */
 #define DRV_ZYNQ_DEVCFG_SYNC_SEARCH		4096U
 
+/* How many block drivers can be registered with the device. */
+#define DRV_ZYNQ_PL_BLOCK_MAX			4U
+
+/*
+ * One kernel driver of a block the programmable logic may hold, found by
+ * the first word of the block's window.
+ *
+ * The device calls attach when an enabled logic's window starts with
+ * magic, with the device's lock held: the driver takes the window (mapped
+ * as device memory), its physical address and size, and the interrupt,
+ * whose handler the device has removed so that the driver installs its
+ * own.  A nonzero return leaves the block to /dev/fpga0.  Before the logic
+ * is written again or disabled the device asks busy (nonzero refuses:
+ * the driver's device is in use), then detach, which quiets the block,
+ * withdraws the driver's device and removes its interrupt handler; EBUSY
+ * from detach means the withdrawal waits for an open to close and is
+ * asked again.  The table is borrowed for the life of the system.
+ */
+struct drv_zynq_pl_block {
+	const char *name;
+	uint32_t magic;
+	int (*attach)(volatile uint8_t *window, uint64_t window_physical, size_t window_bytes, int irq);
+	int (*busy)(void);
+	int (*detach)(void);
+};
+
 /*
