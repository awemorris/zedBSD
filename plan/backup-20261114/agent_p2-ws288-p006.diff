index 0000000000..7cee743ef3
--- /dev/null
+++ b/src/drivers/gpu/ghci/check.c
@@ -0,0 +1,647 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The GHCI driver's word arithmetic: fences, the ring's room, the
+ * extended capability list, the blitter's packets and the check of a
+ * native command stream (ghci-check.h).  Nothing here touches the kernel
+ * or the hardware.
+ *
+ * Values referenced: amaterrace-gpu docs/ghci.md (the GHCI 1.0 draft)
+ * sections 5 (the ring), 6 (fences), 8 (the state register file) and 9
+ * (the packet envelope and the class N micro-operations), through the
+ * copies hcr.h and packets.h.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <uapi/errno.h>
+#include <uapi/gpu-op.h>
+
+#include "ghci-check.h"
+#include "hcr.h"
+#include "packets.h"
+
+/* The words of a native command's head: the number, the flags and the packet count. */
+#define NATIVE_HEAD_DWORDS		3U
+
+/* The state register file's size, and the parts of it that hold addresses. */
+#define STATE_COUNT			512U
+#define STATE_VF_INDEX_BASE		0x021U
+#define STATE_VF_ATTR_BASE_FIRST	0x030U
+#define STATE_VF_ATTRS			16U
+#define STATE_ROP_RT_BASE		0x070U
+#define STATE_ROP_DS_BASE		0x074U
+#define STATE_TU_FIRST			0x090U
+#define STATE_TU_SLOTS			16U
+#define STATE_TU_SLOT_WORDS		16U
+#define STATE_PROGRAM_VS_BASE		0x190U
+#define STATE_PROGRAM_FS_BASE		0x192U
+#define STATE_PROGRAM_CS_BASE		0x194U
+#define STATE_PROGRAM_CONST_BASE	0x196U
+
+/* The flags each checked micro-operation may carry. */
+#define BLIT_FLAGS			0x01U
+#define DISPATCH_FLAGS			0x02U
+#define FENCE_FLAGS			0x01U
+#define INVALIDATE_FLAGS		0x0fU
+
+/* The constant regions LOAD_CONST may fill, and the most words of one load. */
+#define CONST_REGIONS			4U
+#define CONST_WORDS_MAX			0x00100000U
+
+/* The fields of a packet's first dword. */
+#define PACKET_OP(header)		(((header) >> 24) & 0x3fU)
+#define PACKET_FLAGS(header)		(((header) >> 8) & 0xffU)
+#define PACKET_PAYLOAD(header)		((header) & 0xffU)
+
+/* The number of state words one blitter operation writes. */
+#define BLIT_STATE_WORDS		11U
+
+static int check_packet(uint32_t header, const uint32_t *payload, const struct ghci_native_check *check);
+static int check_set_reg(const uint32_t *payload, uint32_t count, const struct ghci_native_check *check);
+static int check_owned(const struct ghci_native_check *check, uint32_t address, uint32_t bytes, uint32_t alignment);
+
+/*
+ * Reports whether a fence value in memory has reached a value.
+ */
+int
+ghci_fence_passed(
+	uint32_t memory,
+	uint32_t value)
+{
+	int32_t distance;
+
+	/* The values are a circle: memory is past value when it is less than half a turn ahead. */
+	distance = (int32_t)(memory - value);
+	if (distance >= 0)
+		return 1;
+
+	/* Succeeded: the fence has not been reached. */
+	return 0;
+}
+
+/*
+ * Plans where the next need dwords go in the ring.
+ */
+int
+ghci_ring_plan(
+	uint32_t wptr,
+	uint32_t rptr,
+	uint32_t ring_dwords,
+	uint32_t need,
+	uint32_t *pad)
+{
+	uint32_t free_dwords;
+	uint32_t to_end;
+	uint32_t padding;
+
+	/* Refuses a ring position outside the ring, and a request that could never fit. */
+	if (ring_dwords == 0 || wptr >= ring_dwords || rptr >= ring_dwords)
+		return EINVAL;
+	if (need == 0 || need >= ring_dwords)
+		return EINVAL;
+
+	/* The room is the distance back to the reader, less the one dword the ring leaves unused. */
+	free_dwords = (rptr + ring_dwords - wptr - 1U) % ring_dwords;
+
+	/* A run of packets never crosses the end: the rest is padded when it does not hold them. */
+	to_end = ring_dwords - wptr;
+	padding = 0;
+	if (need > to_end)
+		padding = to_end;
+
+	/* A request that needs the padding as well must fit after it at the start. */
+	if (padding != 0 && need >= ring_dwords - 1U)
+		return EINVAL;
+
+	/* Waits for the reader while the room is short. */
+	if (free_dwords < padding + need)
+		return EAGAIN;
+
+	/* Succeeded: the padding (if any) and the packets fit. */
+	*pad = padding;
+	return 0;
+}
+
+/*
+ * Walks the extended capability list for the entry of an id.
+ */
+int
+ghci_extcap_find(
+	uint32_t (*read)(void *context, uint32_t offset),
+	void *context,
+	uint32_t first,
+	uint32_t window_bytes,
+	uint32_t id,
+	uint32_t *registers,
+	uint32_t *version)
+{
+	uint32_t entry;
+	uint32_t word;
+	uint32_t next;
+	unsigned walked;
+
+	/* A list that starts nowhere has no entries. */
+	if (first == 0)
+		return ENOENT;
+
+	/* Follows the entries, a bounded number of them, inside the window. */
+	entry = first;
+	for (walked = 0; walked < GHCI_EXTCAP_MAX; walked++) {
+		/* Refuses an entry that is not two whole words of the window. */
+		if ((entry % 4U) != 0 || entry > window_bytes - 8U || window_bytes < 8U)
+			return EINVAL;
+
+		/* The entry's first word: its id, version and the distance to the next. */
+		word = read(context, entry);
+
+		/* The entry asked for: its registers' offset is the second word. */
+		if (GHCI_XCAP_ID(word) == id) {
+			*registers = read(context, entry + 4U);
+			*version = GHCI_XCAP_VERSION(word);
+			return 0;
+		}
+
+		/* The last entry ends the list. */
+		next = GHCI_XCAP_NEXT(word);
+		if (next == 0)
+			return ENOENT;
+
+		/* Moves on, refusing a step that leaves the window. */
+		if (next > (window_bytes - entry) / 4U)
+			return EINVAL;
+		entry += next * 4U;
+	}
+
+	/* Failed: a list that does not end within its bound. */
+	return EINVAL;
+}
+
+/*
+ * Starts an allocator over [base, limit) with the caller's table.
+ */
+void
+ghci_range_init(
+	struct ghci_range_map *map,
+	uint32_t base,
+	uint32_t limit,
+	struct ghci_range_extent *extents,
+	unsigned capacity)
+{
+	/* The range and its empty table. */
+	map->base = base;
+	map->limit = limit;
+	map->extents = extents;
+	map->count = 0;
+	map->capacity = capacity;
+}
+
+/*
+ * Takes the first aligned run of addresses that fits.
+ */
+int
+ghci_range_alloc(
+	struct ghci_range_map *map,
+	uint32_t bytes,
+	uint32_t alignment,
+	uint32_t *address)
+{
+	uint64_t candidate;
+	uint64_t gap_end;
+	unsigned index;
+	unsigned slot;
+
+	/* Refuses an empty run and an alignment that is not a power of two. */
+	if (bytes == 0 || alignment == 0 || (alignment & (alignment - 1U)) != 0)
+		return EINVAL;
+
+	/* Refuses a request when the table cannot record another extent. */
+	if (map->count >= map->capacity)
+		return ENOSPC;
+
+	/*
+	 * Tries each gap in address order: before the first extent, between
+	 * two, after the last.  slot is the index the new extent takes.
+	 */
+	candidate = map->base;
+	for (slot = 0; slot <= map->count; slot++) {
+		/* The gap ends at the next extent, or at the range's limit. */
+		gap_end = map->limit;
+		if (slot < map->count)
+			gap_end = map->extents[slot].address;
+
+		/* Aligns the start of the gap. */
+		candidate = (candidate + alignment - 1U) & ~((uint64_t)alignment - 1U);
+
+		/* The first gap that holds the run takes it. */
+		if (candidate + bytes <= gap_end)
+			break;
+
+		/* The next gap starts after this extent. */
+		if (slot < map->count)
+			candidate = (uint64_t)map->extents[slot].address + map->extents[slot].bytes;
+	}
+
+	/* Reports a range with no gap large enough. */
+	if (slot > map->count)
+		return ENOMEM;
+
+	/* Opens the slot by moving the later extents up one. */
+	for (index = map->count; index > slot; index--)
+		map->extents[index] = map->extents[index - 1U];
+
+	/* Records the new extent. */
+	map->extents[slot].address = (uint32_t)candidate;
+	map->extents[slot].bytes = bytes;
+	map->count++;
+
+	/* Succeeded: the run is the caller's. */
+	*address = (uint32_t)candidate;
+	return 0;
+}
+
+/*
+ * Gives back the extent that starts at address.
+ */
+int
+ghci_range_free(
+	struct ghci_range_map *map,
+	uint32_t address)
+{
+	unsigned index;
+	unsigned found;
+
+	/* Finds the extent. */
+	found = map->count;
+	for (index = 0; index < map->count; index++) {
+		/* An extent is named by its first address. */
+		if (map->extents[index].address == address) {
+			found = index;
+			break;
+		}
+	}
+
+	/* Reports an address that starts no extent. */
+	if (found == map->count)
+		return ENOENT;
+
+	/* Closes the hole by moving the later extents down one. */
+	for (index = found; index + 1U < map->count; index++)
+		map->extents[index] = map->extents[index + 1U];
+	map->count--;
+
+	/* Succeeded: the run is free. */
+	return 0;
+}
+
+/*
+ * Reports the bytes of the range still free.
+ */
+uint32_t
+ghci_range_free_bytes(
+	const struct ghci_range_map *map)
+{
+	uint32_t used;
+	unsigned index;
+
+	/* Adds up the extents in use. */
+	used = 0;
+	for (index = 0; index < map->count; index++)
+		used += map->extents[index].bytes;
+
+	/* Succeeded: the rest of the range. */
+	return (map->limit - map->base) - used;
+}
+
+/*
+ * Writes the packets of one blitter operation.
+ */
+int
+ghci_state_blit(
+	const struct ghci_blit *blit,
+	uint32_t tag,
+	uint32_t *out,
+	uint32_t capacity,
+	uint32_t *dwords)
+{
+	uint32_t values[BLIT_STATE_WORDS];
+	uint32_t needed;
+	uint32_t index;
+
+	/* One SET_REG of every state word and one BLIT, which ends when the blit has. */
+	needed = 1U + 2U * BLIT_STATE_WORDS + 1U;
+	if (capacity < needed)
+		return ENOSPC;
+
+	/* The state words in their register order. */
+	values[0] = blit->op;
+	values[1] = blit->dst_base;
+	values[2] = blit->dst_stride;
+	values[3] = blit->src_base;
+	values[4] = blit->src_stride;
+	values[5] = GHCI_XY(blit->dst_x, blit->dst_y);
+	values[6] = GHCI_XY(blit->src_x, blit->src_y);
+	values[7] = GHCI_XY(blit->width, blit->height);
+	values[8] = blit->color;
+	values[9] = 0;
+	values[10] = 0;
+
+	/* The SET_REG header and its (index, value) pairs. */
+	out[0] = GHCI_PKT_N(GHCI_PKT_CLASS_STD, GHCI_OP_SET_REG, tag, 0, 2U * BLIT_STATE_WORDS);
+	for (index = 0; index < BLIT_STATE_WORDS; index++) {
+		out[1U + 2U * index] = GHCI_S_BLT + index;
+		out[2U + 2U * index] = values[index];
+	}
+
+	/* The BLIT. */
+	out[needed - 1U] = GHCI_PKT_N(GHCI_PKT_CLASS_STD, GHCI_OP_BLIT, tag, 0, 0);
+
+	/* Succeeded: the packets are written. */
+	*dwords = needed;
+	return 0;
+}
+
+/*
+ * Reports whether a state register holds a GPU address.
+ */
+int
+ghci_state_is_address(
+	uint32_t index)
+{
+	/* The blitter's destination and source. */
+	if (index == GHCI_S_BLT_DST_BASE || index == GHCI_S_BLT_SRC_BASE)
+		return 1;
+
+	/* The vertex fetcher's index buffer and attribute bases (every other word). */
+	if (index == STATE_VF_INDEX_BASE)
+		return 1;
+	if (index >= STATE_VF_ATTR_BASE_FIRST &&
+	    index < STATE_VF_ATTR_BASE_FIRST + 2U * STATE_VF_ATTRS &&
+	    ((index - STATE_VF_ATTR_BASE_FIRST) % 2U) == 0)
+		return 1;
+
+	/* The render target and the depth and stencil buffer. */
+	if (index == STATE_ROP_RT_BASE || index == STATE_ROP_DS_BASE)
+		return 1;
+
+	/* Each texture slot's first word. */
+	if (index >= STATE_TU_FIRST &&
+	    index < STATE_TU_FIRST + STATE_TU_SLOTS * STATE_TU_SLOT_WORDS &&
+	    ((index - STATE_TU_FIRST) % STATE_TU_SLOT_WORDS) == 0)
+		return 1;
+
+	/* The programs and the constant region. */
+	if (index == STATE_PROGRAM_VS_BASE || index == STATE_PROGRAM_FS_BASE)
+		return 1;
+	if (index == STATE_PROGRAM_CS_BASE || index == STATE_PROGRAM_CONST_BASE)
+		return 1;
+
+	/* Succeeded: the register holds no address. */
+	return 0;
+}
+
+/*
+ * Checks a native command and copies its packets with the caller's tag.
+ */
+int
+ghci_native_prepare(
+	const uint32_t *stream,
+	uint32_t stream_dwords,
+	const struct ghci_native_check *check,
+	uint32_t *out,
+	uint32_t capacity,
+	uint32_t *dwords)
+{
+	uint32_t position;
+	uint32_t packets;
+	uint32_t header;
+	uint32_t length;
+	uint32_t written;
+	uint32_t index;
+	int error;
+
+	/* The head: the command's number, no flags, and a bounded count of packets. */
+	if (stream_dwords < NATIVE_HEAD_DWORDS + 1U)
+		return EINVAL;
+	if (stream[0] != GPU_OP_GHCI_NATIVE || stream[1] != 0)
+		return EINVAL;
+	packets = stream[2];
+	if (packets == 0 || packets > GHCI_NATIVE_PACKETS_MAX)
+		return EINVAL;
+
+	/* Checks and copies each packet in turn. */
+	position = NATIVE_HEAD_DWORDS;
+	written = 0;
+	for (index = 0; index < packets; index++) {
+		/* The packet's header, and its payload, which must be in the stream. */
+		if (position >= stream_dwords)
+			return EINVAL;
+		header = stream[position];
+		length = 1U + PACKET_PAYLOAD(header);
+		if (length > stream_dwords - position)
+			return EINVAL;
+
+		/* The micro-operation and its operands. */
+		error = check_packet(header, &stream[position + 1U], check);
+		if (error != 0)
+			return error;
+
+		/* Refuses packets past the room the caller gave. */
+		if (length > capacity - written)
+			return E2BIG;
+
+		/* The copy carries the session's tag in place of the caller's. */
+		out[written] = (header & ~0x00ff0000U) | ((check->tag & 0xffU) << 16);
+		for (length--; length != 0; length--) {
+			out[written + 1U] = stream[position + 1U];
+			written++;
+			position++;
+		}
+		written++;
+		position++;
+	}
+
+	/* Refuses words after the last packet: the count and the stream disagree. */
+	if (position != stream_dwords)
+		return EINVAL;
+
+	/* Succeeded: every packet is checked and copied. */
+	*dwords = written;
+	return 0;
+}
+
+/*
+ * Writes the driver's fence packet.
+ */
+void
+ghci_fence_packet(
+	uint32_t tag,
+	uint32_t address,
+	uint32_t value,
+	uint32_t *out)
+{
+	/* A complete fence that raises the fence interrupt once it is written. */
+	out[0] = GHCI_PKT_N(GHCI_PKT_CLASS_STD, GHCI_OP_FENCE, tag, GHCI_FENCE_IRQ, 2U);
+	out[1] = address;
+	out[2] = value;
+}
+
+/* Checks one packet of a native command: its class, operation, length, flags and addresses. */
+static int
+check_packet(
+	uint32_t header,
+	const uint32_t *payload,
+	const struct ghci_native_check *check)
+{
+	uint32_t op;
+	uint32_t flags;
+	uint32_t count;
+	int error;
+
+	/* Only the standard micro-operations are taken. */
+	if (GHCI_PKT_GET_CLASS(header) != GHCI_PKT_CLASS_STD)
+		return EINVAL;
+	op = PACKET_OP(header);
+	flags = PACKET_FLAGS(header);
+	count = PACKET_PAYLOAD(header);
+
+	/* Selects the rules of the operation. */
+	switch (op) {
+	case GHCI_OP_NOP:
+		/* Skipped words of any number, and no flags. */
+		if (flags != 0)
+			return EINVAL;
+		break;
+	case GHCI_OP_SET_REG:
+		/* Pairs of a register and a value. */
+		if (flags != 0 || count == 0 || (count % 2U) != 0)
+			return EINVAL;
+		error = check_set_reg(payload, count / 2U, check);
+		if (error != 0)
+			return error;
+		break;
+	case GHCI_OP_BLIT:
+		/* No operands; the flag says whether the sequencer waits. */
+		if (count != 0 || (flags & ~BLIT_FLAGS) != 0)
+			return EINVAL;
+		break;
+	case GHCI_OP_DRAW:
+	case GHCI_OP_LOAD_PROGRAM:
+		/* DRAW has no operands, LOAD_PROGRAM one (the stage); neither has flags. */
+		if (flags != 0)
+			return EINVAL;
+		if (op == GHCI_OP_DRAW && count != 0)
+			return EINVAL;
+		if (op == GHCI_OP_LOAD_PROGRAM && count != 1U)
+			return EINVAL;
+		break;
+	case GHCI_OP_DISPATCH:
+		/* The three group counts; the flag that gives the dispatch the systolic array. */
+		if (count != 3U || (flags & ~DISPATCH_FLAGS) != 0)
+			return EINVAL;
+		break;
+	case GHCI_OP_FENCE:
+		/* The address and the value; the word is the session's. */
+		if (count != 2U || (flags & ~FENCE_FLAGS) != 0)
+			return EINVAL;
+		error = check_owned(check, payload[0], 4U, 4U);
+		if (error != 0)
+			return error;
+		break;
+	case GHCI_OP_WAIT_IDLE:
+		/* No operands; the flags are a mask of the blocks waited for. */
+		if (count != 0)
+			return EINVAL;
+		break;
+	case GHCI_OP_LOAD_CONST:
+		/* The region, the address and the words, all in the session's memory. */
+		if (count != 3U || flags != 0)
+			return EINVAL;
+		if (payload[0] >= CONST_REGIONS || payload[2] == 0 || payload[2] > CONST_WORDS_MAX)
+			return EINVAL;
+		error = check_owned(check, payload[1], payload[2] * 4U, 4U);
+		if (error != 0)
+			return error;
+		break;
+	case GHCI_OP_INVALIDATE:
+		/* No operands; the flags name the caches. */
+		if (count != 0 || (flags & ~INVALIDATE_FLAGS) != 0)
+			return EINVAL;
+		break;
+	case GHCI_OP_RESULT:
+		/* The address of two words, the status and the auxiliary word. */
+		if (count != 3U || flags != 0)
+			return EINVAL;
+		error = check_owned(check, payload[0], 8U, 8U);
+		if (error != 0)
+			return error;
+		break;
+	default:
+		/* WAIT_FENCE, PERF_RESET, WAIT_VSYNC and the reserved numbers are refused. */
+		return EINVAL;
+	}
+
+	/* Succeeded: the packet is one a test may send. */
+	return 0;
+}
+
+/* Checks the (register, value) pairs of a SET_REG: registers of the file, addresses the session's. */
+static int
+check_set_reg(
+	const uint32_t *payload,
+	uint32_t count,
+	const struct ghci_native_check *check)
+{
+	uint32_t index;
+	uint32_t pair;
+	int is_address;
+	int error;
+
+	/* Each pair in turn. */
+	for (pair = 0; pair < count; pair++) {
+		/* The register must be one of the file's. */
+		index = payload[2U * pair];
+		if (index >= STATE_COUNT)
+			return EINVAL;
+
+		/* A register that holds an address takes only the session's memory. */
+		is_address = ghci_state_is_address(index);
+		if (is_address) {
+			error = check_owned(check, payload[2U * pair + 1U], 1U, 1U);
+			if (error != 0)
+				return error;
+		}
+	}
+
+	/* Succeeded: every pair may be written. */
+	return 0;
+}
+
+/* Checks that a run of GPU addresses is aligned and inside the session's memory. */
+static int
+check_owned(
+	const struct ghci_native_check *check,
+	uint32_t address,
+	uint32_t bytes,
+	uint32_t alignment)
+{
+	int owned;
+
+	/* Refuses a misaligned address. */
+	if ((address % alignment) != 0)
+		return EINVAL;
+
+	/* Asks the caller whether the session owns the run. */
+	owned = check->owned(check->context, address, bytes);
+	if (!owned)
+		return EINVAL;
+
+	/* Succeeded: the run is the session's. */
+	return 0;
+}
diff --git a/src/drivers/gpu/ghci/ghci-check.h b/src/drivers/gpu/ghci/ghci-check.h
new file mode 100644
index 0000000000..031195abd5
--- /dev/null
+++ b/src/drivers/gpu/ghci/ghci-check.h
@@ -0,0 +1,155 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The parts of the GHCI driver that are pure arithmetic on words: the
+ * fence comparison, the ring's space and padding, the walk of the
+ * extended capability list, the allocator of GPU addresses, the
+ * blitter's state packets and the check of a native command stream.
+ * They depend on nothing of the kernel, so that a host test
+ * (tests/ghci-host-test.c) runs them as the kernel does.
+ */
+
+#ifndef DRIVERS_GPU_GHCI_CHECK_H
+#define DRIVERS_GPU_GHCI_CHECK_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* The most entries of the extended capability list that are walked. */
+#define GHCI_EXTCAP_MAX			32U
+
+/* The most class N packets one native command carries. */
+#define GHCI_NATIVE_PACKETS_MAX		1024U
+
+/* The dwords the driver's own fence packet takes: the header, the address and the value. */
+#define GHCI_FENCE_PACKET_DWORDS	3U
+
+/*
+ * One extent of GPU addresses in use, kept sorted by address in the
+ * allocator's table.
+ */
+struct ghci_range_extent {
+	uint32_t address;
+	uint32_t bytes;
+};
+
+/*
+ * The allocator of a range of GPU addresses: first fit over a table of
+ * the extents in use, sorted by address.  The table is the caller's and
+ * lives as long as the allocator; the allocator holds no lock, its owner
+ * serializes every call.
+ */
+struct ghci_range_map {
+	uint32_t base;
+	uint32_t limit;
+	struct ghci_range_extent *extents;
+	unsigned count;
+	unsigned capacity;
+};
+
+/*
+ * What the check of a native command needs from its caller: whether a
+ * range of GPU addresses lies inside memory the submitting session owns
+ * (owned returns 1 when it does), and the job tag every packet is given.
+ */
+struct ghci_native_check {
+	int (*owned)(void *context, uint32_t address, uint32_t bytes);
+	void *context;
+	uint32_t tag;
+};
+
+/*
+ * One rectangle operation of the blitter, in the words of its state
+ * (STATE[0x000..0x00A]).  Coordinates are pixels, strides bytes.
+ */
+struct ghci_blit {
+	uint32_t op;
+	uint32_t dst_base;
+	uint32_t dst_stride;
+	uint32_t src_base;
+	uint32_t src_stride;
+	uint32_t dst_x;
+	uint32_t dst_y;
+	uint32_t src_x;
+	uint32_t src_y;
+	uint32_t width;
+	uint32_t height;
+	uint32_t color;
+};
+
+/*
+ * Reports whether a fence value in memory has reached a value, with the
+ * 32-bit wrap: 1 when it has.
+ */
+int ghci_fence_passed(uint32_t memory, uint32_t value);
+
+/*
+ * Plans where the next need dwords go in the ring: pad says how many
+ * dwords of padding come first (0, or the rest of the ring up to its end,
+ * which a padding packet fills).  Returns 0, EAGAIN while the ring has no
+ * room yet, or EINVAL for a request no ring of this size can take.
+ */
+int ghci_ring_plan(uint32_t wptr, uint32_t rptr, uint32_t ring_dwords, uint32_t need, uint32_t *pad);
+
+/*
+ * Walks the extended capability list from its first entry for the entry
+ * of an id, reading the window's words through read.  Returns 0 with the
+ * entry's register offset and version, ENOENT without such an entry, or
+ * EINVAL for a list that leaves the window or does not end.
+ */
+int ghci_extcap_find(uint32_t (*read)(void *context, uint32_t offset), void *context, uint32_t first, uint32_t window_bytes, uint32_t id, uint32_t *registers, uint32_t *version);
+
+/*
+ * Starts an allocator over [base, limit) with the caller's table.
+ */
+void ghci_range_init(struct ghci_range_map *map, uint32_t base, uint32_t limit, struct ghci_range_extent *extents, unsigned capacity);
+
+/*
+ * Takes bytes of addresses aligned to alignment (a power of two), the
+ * first that fit.  Returns 0 with the address, ENOMEM when nothing fits,
+ * ENOSPC when the table is full, or EINVAL for a bad request.
+ */
+int ghci_range_alloc(struct ghci_range_map *map, uint32_t bytes, uint32_t alignment, uint32_t *address);
+
+/*
+ * Gives back the extent that starts at address.  Returns 0 or ENOENT.
+ */
+int ghci_range_free(struct ghci_range_map *map, uint32_t address);
+
+/*
+ * Reports the bytes of the range still free.
+ */
+uint32_t ghci_range_free_bytes(const struct ghci_range_map *map);
+
+/*
+ * Writes the packets of one blitter operation: a SET_REG of its state and
+ * a BLIT.  Returns 0 with the dwords written, or ENOSPC when they do not
+ * fit in capacity.
+ */
+int ghci_state_blit(const struct ghci_blit *blit, uint32_t tag, uint32_t *out, uint32_t capacity, uint32_t *dwords);
+
+/*
+ * Reports whether a state register holds a GPU address: 1 when it does.
+ */
+int ghci_state_is_address(uint32_t index);
+
+/*
+ * Checks a GPU_OP_GHCI_NATIVE command ([u32 number][u32 flags][u32
+ * count][count class N packets]) and copies its packets to out with the
+ * caller's job tag.  Returns 0 with the dwords written, E2BIG when they
+ * do not fit in capacity, or EINVAL for anything the check refuses.
+ */
+int ghci_native_prepare(const uint32_t *stream, uint32_t stream_dwords, const struct ghci_native_check *check, uint32_t *out, uint32_t capacity, uint32_t *dwords);
+
+/*
+ * Writes the driver's fence packet: a FENCE of value to address that
+ * raises the fence interrupt.  out holds GHCI_FENCE_PACKET_DWORDS.
+ */
+void ghci_fence_packet(uint32_t tag, uint32_t address, uint32_t value, uint32_t *out);
+
+#endif
diff --git a/src/drivers/gpu/ghci/ghci.h b/src/drivers/gpu/ghci/ghci.h
new file mode 100644
index 0000000000..856f84f270
--- /dev/null
+++ b/src/drivers/gpu/ghci/ghci.h
@@ -0,0 +1,347 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The generic driver of a GPU with the GPU Host Controller Interface
+ * (GHCI 1.0, amaterrace-gpu docs/ghci.md): the device, its sessions and
+ * allocations, and the parts the driver's files share.
+ *
+ * One window of host control registers is one device.  A window whose
+ * CAPS has the command processor ([0]) is a GPU device: a ring, a fence
+ * page, GPU memory for the sessions, /dev/gpuN named
+ * "ghci:<vendor>:<device>".  A window with only a display controller
+ * (CAPS [3], the ZYBO's display bitstream) is a display device,
+ * "ghci-dc:<vendor>:<device>", whose sessions draw into memory of the
+ * same pool and present it.  The board glue (zybo-attach.c) hands the
+ * window, its interrupt and the memory pool to ghci_attach().
+ *
+ * The board has one window, so there is one device, kept in a static
+ * structure for the life of the system: a later attach (another
+ * bitstream) reuses it after the earlier device has been withdrawn.
+ */
+
+#ifndef DRIVERS_GPU_GHCI_H
+#define DRIVERS_GPU_GHCI_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <drivers/gpu/gpu.h>
+#include <kern/lock.h>
+#include <kern/waitq.h>
+
+#include "ghci-check.h"
+
+/* The kinds of device a window is. */
+#define GHCI_KIND_NONE			0
+#define GHCI_KIND_GPU			1
+#define GHCI_KIND_DISPLAY		2
+
+/* The job tags of sessions (1 to 255; 0 is the driver's own work). */
+#define GHCI_TAG_DRIVER			0U
+#define GHCI_TAG_MAX			255U
+#define GHCI_TAG_WORDS			8U
+
+/* The GPU's memory is handed out in pages, and the ring and the fence page are the driver's. */
+#define GHCI_PAGE_BYTES			4096U
+#define GHCI_RING_SIZE_LOG2		16U
+#define GHCI_RING_BYTES			(1U << GHCI_RING_SIZE_LOG2)
+#define GHCI_FENCE_PAGE_BYTES		GHCI_PAGE_BYTES
+
+/* The most allocations the pool records, and the most one session holds. */
+#define GHCI_EXTENTS_MAX		1024U
+#define GHCI_SESSION_RESOURCES		256U
+
+/* How long the driver waits for the hardware: a reset, a ring's room, a fence at close. */
+#define GHCI_RESET_WAIT_MS		1000U
+#define GHCI_RING_WAIT_MS		1000U
+#define GHCI_FENCE_WAIT_MS		2000U
+
+struct ghci_device;
+struct ghci_session;
+
+/*
+ * The window and memory the board glue hands to ghci_attach(): the host
+ * control registers (mapped as device memory, physical address and size),
+ * the interrupt, and the pool of memory the GPU reaches (its GPU address,
+ * the processor's physical address of it and an uncached kernel view).
+ * The board keeps all of them until ghci_detach() has returned 0.
+ */
+struct ghci_window {
+	volatile uint8_t *registers;
+	uint64_t registers_physical;
+	size_t registers_bytes;
+	int irq;
+	uint32_t pool_gpu;
+	uint64_t pool_physical;
+	uint32_t pool_bytes;
+	uint8_t *pool_view;
+};
+
+/*
+ * One allocation of the pool: a session's resource, or memory the device
+ * keeps for itself (the ring, the fence page, the display's frames).
+ *
+ * A session's allocation sits on the session's list until it is
+ * destroyed; then, if the GPU may still use it (the session's last fence
+ * has not passed), it moves to the device's deferred list with that fence
+ * until the service thread gives it back.  The device's lock protects
+ * both lists and every field.
+ */
+struct ghci_allocation {
+	struct ghci_allocation *next;
+	struct ghci_session *session;
+	uint32_t gpu_address;
+	uint32_t bytes;
+	uint32_t fence;
+	int blob;
+};
+
+/*
+ * One open of the device.
+ *
+ * tag is the session's job tag, written into every packet it submits.
+ * outstanding says last_fence (the fence after its newest submission) may
+ * not have passed yet; it is cleared once seen passed, so an old value is
+ * never compared after the 32-bit circle has turned.  The device's lock
+ * protects the fields; the list of allocations is the session's.
+ */
+struct ghci_session {
+	struct ghci_device *device;
+	struct ghci_allocation *allocations;
+	unsigned allocation_count;
+	uint32_t tag;
+	uint32_t last_fence;
+	int outstanding;
+};
+
+/*
+ * The display controller's state of a display device (display/display.c):
+ * the controller's registers, the lease, the mode shown, the two frames
+ * the driver copies sessions' storage into, and the interrupt's count.
+ *
+ * The device's lock protects everything but the interrupt's fields, which
+ * irq_lock of the device protects: frames counts vsyncs, flips counts
+ * completed flips; flip_wake wakes a present waiting for its flip.
+ */
+struct ghci_display {
+	uint32_t registers;
+	uint32_t dc_id;
+	uint32_t dc_version;
+	uint32_t dc_caps;
+	struct ghci_session *owner;
+	uint64_t lease;
+	uint64_t next_lease;
+	uint64_t sequence;
+	uint64_t shown_time_ns;
+	uint32_t width;
+	uint32_t height;
+	uint32_t format;
+	int enabled;
+	struct ghci_allocation *frame[2];
+	unsigned back;
+	uint64_t frames;
+	uint64_t flips;
+	uint32_t underflows;
+	struct wait_queue flip_wake;
+};
+
+/*
+ * The device.
+ *
+ * lock (a mutex) serializes the sessions, the pool, the lists of
+ * allocations, the display and the registration; cp_lock (a mutex, taken
+ * after lock) serializes the ring and the reset.  irq_lock (a spinlock,
+ * taken from the interrupt) protects completed, the fault's record,
+ * service_work, irq_live and the display's interrupt fields.
+ *
+ * kind is GHCI_KIND_NONE while no window is attached.  withdrawing says a
+ * detach has begun: opens are refused, the hardware is quiet, and only
+ * drv_gpu_unregister() remains.  lost says the hardware did not come back
+ * from a reset: every submission fails until the window is detached.
+ */
+struct ghci_device {
+	struct mutex lock;
+	struct mutex cp_lock;
+	struct spinlock irq_lock;
+	struct wait_queue fence_wake;
+	struct wait_queue service_wake;
+	int initialized;
+
+	int kind;
+	int withdrawing;
+	int lost;
+	struct ghci_window window;
+	struct drv_gpu_device *gpu;
+	char name[32];
+
+	uint32_t version;
+	uint32_t vendor_id;
+	uint32_t device_id;
+	uint32_t isa_id;
+	uint32_t device_version;
+	uint32_t caps;
+	uint32_t caps2;
+	uint32_t gclk_hz;
+
+	unsigned sessions;
+	uint32_t tags[GHCI_TAG_WORDS];
+
+	struct ghci_range_map pool;
+	struct ghci_range_extent extents[GHCI_EXTENTS_MAX];
+	struct ghci_allocation *deferred;
+
+	struct ghci_allocation *ring;
+	uint32_t ring_dwords;
+	uint32_t wptr;
+	struct ghci_allocation *fence_page;
+	uint32_t fence_issued;
+	int cp_running;
+
+	uint32_t completed;
+	int irq_live;
+	int fault_pending;
+	uint32_t fault_info;
+	uint32_t fault_address;
+	unsigned service_work;
+
+	struct ghci_display display;
+};
+
+/* The work the service thread is woken for (service_work). */
+#define GHCI_WORK_RECLAIM		1U
+#define GHCI_WORK_RECOVER		2U
+
+/*
+ * Attaches the device to a window the board glue found GHCI_MAGIC in.
+ * Returns 0, or why the window is not taken (it then stays the board's).
+ */
+int ghci_attach(const struct ghci_window *window);
+
+/*
+ * Reports whether the attached device is in use (an open is not closed):
+ * 1 when it is.
+ */
+int ghci_busy(void);
+
+/*
+ * Quiets the attached device's hardware and withdraws its node.  Returns
+ * 0, or EBUSY while an open still has to close (asked again later).
+ */
+int ghci_detach(void);
+
+/* Reads one host control register of the device's window. */
+uint32_t ghci_read(struct ghci_device *device, uint32_t offset);
+
+/* Writes one host control register of the device's window. */
+void ghci_write(struct ghci_device *device, uint32_t offset, uint32_t value);
+
+/* Sleeps about the given milliseconds. */
+void ghci_sleep_ms(unsigned milliseconds);
+
+/*
+ * The command processor (cp.c).
+ */
+
+/* Starts the command processor: reset, aperture, ring, fence page, interrupt, RUN. */
+int ghci_cp_start(struct ghci_device *device);
+
+/* Waits for the driver's last fence and halts the command processor for the detach. */
+void ghci_cp_stop(struct ghci_device *device);
+
+/*
+ * Writes packets into the ring for a session (NULL: the driver's own
+ * work), followed by the driver's fence, and rings the doorbell.  The
+ * device's lock is held.  Returns 0 with the fence's value, or why the
+ * packets were not written.
+ */
+int ghci_cp_submit(struct ghci_device *device, struct ghci_session *session, const uint32_t *packets, uint32_t dwords, uint32_t *fence);
+
+/* Waits a bounded time for a fence value.  Returns 0, ETIMEDOUT or EIO. */
+int ghci_cp_wait(struct ghci_device *device, uint32_t fence, unsigned milliseconds);
+
+/* Reports whether a fence value has passed: 1 when it has. */
+int ghci_cp_passed(struct ghci_device *device, uint32_t fence);
+
+/* Resets the command processor and completes every fence; cp_lock is not held. */
+void ghci_cp_recover(struct ghci_device *device, const char *reason);
+
+/* Wakes the service thread for some work. */
+void ghci_service_wake(struct ghci_device *device, unsigned work);
+
+/* Starts the service thread once for the life of the system. */
+int ghci_service_start(struct ghci_device *device);
+
+/*
+ * The memory (memory.c).  The device's lock is held for every call.
+ */
+
+/* Starts the pool over the window's memory. */
+void ghci_memory_init(struct ghci_device *device);
+
+/* Takes memory the device keeps for itself (never a session's). */
+int ghci_memory_device_alloc(struct ghci_device *device, uint32_t bytes, struct ghci_allocation **result);
+
+/* Gives back memory the device kept for itself. */
+void ghci_memory_device_free(struct ghci_device *device, struct ghci_allocation *allocation);
+
+/* Takes zeroed memory for a session's resource. */
+int ghci_memory_create(struct ghci_device *device, struct ghci_session *session, uint64_t bytes, int blob, struct ghci_allocation **result);
+
+/* Gives back a session's resource now, or once the GPU is done with it. */
+void ghci_memory_destroy(struct ghci_device *device, struct ghci_allocation *allocation);
+
+/* Gives back every deferred allocation whose fence has passed. */
+void ghci_memory_reclaim(struct ghci_device *device);
+
+/* Reports whether a run of GPU addresses lies inside one of a session's allocations: 1 when it does. */
+int ghci_memory_owned(struct ghci_session *session, uint32_t address, uint32_t bytes);
+
+/* Reports the kernel's view of a GPU address of the pool. */
+uint8_t *ghci_memory_view(struct ghci_device *device, uint32_t gpu_address);
+
+/* Reports whether a session's last submission has passed (and forgets it then): 1 when it has. */
+int ghci_session_idle(struct ghci_device *device, struct ghci_session *session);
+
+/*
+ * The blitter (blit.c).  The device's lock is held.
+ */
+
+/* Fills a run of GPU memory with a 32-bit value through the blitter and waits for it. */
+int ghci_blit_fill(struct ghci_device *device, uint32_t gpu_address, uint32_t bytes, uint32_t value);
+
+/*
+ * The display device (display/display.c).
+ */
+
+/* The display operations of a display device. */
+extern const struct drv_gpu_display_ops ghci_display_ops;
+
+/* Starts the display controller of a display device; the device's lock is held. */
+int ghci_display_attach(struct ghci_device *device, uint32_t registers);
+
+/* Turns the display controller off for the detach; the device's lock is held. */
+void ghci_display_detach(struct ghci_device *device);
+
+/* Ends a closing session's lease; the device's lock is held. */
+void ghci_display_session_close(struct ghci_device *device, struct ghci_session *session);
+
+/* Serves the display controller's interrupt. */
+void ghci_display_interrupt(struct ghci_device *device);
+
+/*
+ * The native command of the test kernels (native.c, CONFIG_GHCI_NATIVE).
+ */
+
+/*
+ * Checks and submits a GPU_OP_GHCI_NATIVE command from root.  Weak: a
+ * kernel without CONFIG_GHCI_NATIVE has none, and its GPU device does
+ * not advertise GPU_CAP_COMMAND.
+ */
+extern int ghci_native_command(struct ghci_device *device, struct ghci_session *session, const void *stream, uint32_t bytes) __attribute__((weak));
+
+#endif
diff --git a/src/drivers/gpu/ghci/hcr.h b/src/drivers/gpu/ghci/hcr.h
new file mode 100644
index 0000000000..c932930e60
--- /dev/null
+++ b/src/drivers/gpu/ghci/hcr.h
@@ -0,0 +1,263 @@
+/*
+ * Copied from amaterrace-gpu 903f861 include/ghci_regs.h (the GHCI 1.0
+ * draft, the original is the authority): do not edit here, copy again.
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * Amaterrace GPU
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * ghci_regs.h: the GHCI 1.0 host control registers (docs/ghci.md, draft).
+ * An OS driver copies this file; it has no dependency but the C integer
+ * constants.  include/ghci_regs.vh holds the same values for the RTL.
+ */
+
+#ifndef GHCI_REGS_H
+#define GHCI_REGS_H
+
+#define GHCI_MAGIC_VALUE 0x47484349u /* "GHCI" */
+#define GHCI_VERSION_MAJOR 1u
+#define GHCI_VERSION_MINOR 0u
+
+/* FourCCs as read from the ID registers (the first letter in bits 31:24). */
+#define GHCI_FOURCC(a, b, c, d) \
+	(((unsigned)(a) << 24) | ((unsigned)(b) << 16) | ((unsigned)(c) << 8) | (unsigned)(d))
+
+/* Host control register offsets (bytes). */
+#define GHCI_MAGIC 0x000u
+#define GHCI_VERSION 0x004u
+#define GHCI_VENDOR_ID 0x008u
+#define GHCI_DEVICE_ID 0x00Cu
+#define GHCI_ISA_ID 0x010u
+#define GHCI_DEVICE_VERSION 0x014u
+#define GHCI_EXTCAP 0x018u
+#define GHCI_GCLK_HZ 0x01Cu
+#define GHCI_CAPS 0x020u
+#define GHCI_CAPS2 0x024u
+#define GHCI_SCRATCH 0x028u
+#define GHCI_COUNTER 0x02Cu
+#define GHCI_CTRL 0x030u
+#define GHCI_STATUS 0x034u
+#define GHCI_IRQ_STATUS 0x038u
+#define GHCI_IRQ_ENABLE 0x03Cu
+#define GHCI_IRQ_SET 0x040u
+#define GHCI_WDT_CYCLES 0x044u
+#define GHCI_RING_BASE 0x050u
+#define GHCI_RING_SIZE 0x054u
+#define GHCI_RING_WPTR 0x058u
+#define GHCI_RING_RPTR 0x05Cu
+#define GHCI_APERTURE_BASE 0x060u
+#define GHCI_APERTURE_LIMIT 0x064u
+#define GHCI_FAULT_ADDR 0x068u
+#define GHCI_FAULT_INFO 0x06Cu
+#define GHCI_FENCE_LAST 0x070u
+#define GHCI_PERF(n) (0x080u + 4u * (n))
+#define GHCI_PERF_CTRL 0x090u
+#define GHCI_DBG_ADDR 0x0A0u
+#define GHCI_DBG_DATA 0x0A4u
+#define GHCI_DBG_STATUS 0x0A8u
+#define GHCI_CPFW_CTRL 0x120u /* the CPFW capability (id 6), p017 */
+#define GHCI_CPFW_STATUS 0x124u
+#define GHCI_CPFW_IBASE 0x128u
+#define GHCI_CPFW_IWORDS 0x12Cu
+#define GHCI_CPFW_DBASE 0x130u
+#define GHCI_CPFW_DWORDS 0x134u
+#define GHCI_CPFW_VERSION 0x138u
+#define GHCI_CPFW_MBOX(n) (0x150u + 4u * (n)) /* n = 0..3, after SA's 0x140-0x14F */
+#define GHCI_KICK 0xF00u
+#define GHCI_STATE(i) (0x1000u + 4u * (i))
+#define GHCI_STATE_COUNT 512u
+
+/* CPFW_CTRL and CPFW_STATUS. */
+#define GHCI_CPFW_CTRL_LOAD (1u << 0)
+#define GHCI_CPFW_CTRL_RUN (1u << 1)
+#define GHCI_CPFW_CTRL_HALT (1u << 2)
+#define GHCI_CPFW_STATUS_READY (1u << 0)
+#define GHCI_CPFW_STATUS_FAULT (1u << 1)
+#define GHCI_CPFW_STATUS_ALIVE (1u << 2)
+#define GHCI_CPFW_STATUS_STATE(s) (((s) >> 8) & 0xFFu)
+
+/* CAPS. */
+#define GHCI_CAPS_CP (1u << 0)
+#define GHCI_CAPS_BLT (1u << 1)
+#define GHCI_CAPS_SHADER (1u << 2)
+#define GHCI_CAPS_DISP (1u << 3)
+#define GHCI_CAPS_LANES_LOG2(c) (((c) >> 4) & 0xFu)
+#define GHCI_CAPS_TU_BILINEAR (1u << 8)
+#define GHCI_CAPS_ROP_STENCIL (1u << 9)
+#define GHCI_CAPS_WAIT_VSYNC (1u << 10)
+#define GHCI_CAPS_TILE4X4 (1u << 11)
+#define GHCI_CAPS_STATE_VERSION(c) (((c) >> 12) & 0xFu)
+#define GHCI_CAPS_MMU (1u << 16)
+#define GHCI_CAPS_LINE_LOG2(c) (((c) >> 20) & 0xFu)
+
+/* CAPS2. */
+#define GHCI_CAPS2_QUEUES(c) ((c) & 0xFFu)
+#define GHCI_CAPS2_LDS_KIB(c) (((c) >> 8) & 0xFFu)
+#define GHCI_CAPS2_CONST_WORDS(c) ((((c) >> 16) & 0xFFu) * 16u)
+#define GHCI_CAPS2_TEX_SLOTS(c) ((((c) >> 24) & 0xFu) * 4u)
+#define GHCI_CAPS2_ATTRS(c) ((((c) >> 28) & 0xFu) * 4u)
+
+/* CTRL. */
+#define GHCI_CTRL_RUN (1u << 0)
+#define GHCI_CTRL_RESET (1u << 1)
+#define GHCI_CTRL_HALT (1u << 2)
+#define GHCI_CTRL_STEP (1u << 3)
+#define GHCI_CTRL_WDT_EN (1u << 4)
+
+/* STATUS. */
+#define GHCI_STATUS_CP_BUSY (1u << 0)
+#define GHCI_STATUS_BLT_BUSY (1u << 1)
+#define GHCI_STATUS_VF_BUSY (1u << 2)
+#define GHCI_STATUS_RX_BUSY (1u << 3)
+#define GHCI_STATUS_ROP_BUSY (1u << 4)
+#define GHCI_STATUS_TU_BUSY (1u << 5)
+#define GHCI_STATUS_SU_BUSY (1u << 6)
+#define GHCI_STATUS_AXI_IDLE (1u << 8)
+#define GHCI_STATUS_FAULT (1u << 9)
+#define GHCI_STATUS_HALTED (1u << 10)
+#define GHCI_STATUS_RING_EMPTY (1u << 11)
+#define GHCI_STATUS_MEM_READY (1u << 12)
+#define GHCI_STATUS_AXI_STUCK (1u << 13)
+#define GHCI_STATUS_QUIESCED (1u << 14)
+#define GHCI_STATUS_STATE(s) (((s) >> 16) & 0xFu)
+
+/* CP states (STATUS[19:16]). */
+#define GHCI_ST_IDLE 0u
+#define GHCI_ST_RUNNING 1u
+#define GHCI_ST_HALTING 2u
+#define GHCI_ST_HALTED 3u
+#define GHCI_ST_FAULTED 4u
+#define GHCI_ST_RESETTING 5u
+
+/* IRQ_STATUS, IRQ_ENABLE, IRQ_SET. */
+#define GHCI_IRQ_FENCE (1u << 0)
+#define GHCI_IRQ_FAULT (1u << 1)
+#define GHCI_IRQ_RING_EMPTY (1u << 2)
+#define GHCI_IRQ_WATCHDOG (1u << 3)
+#define GHCI_IRQ_DBG_DONE (1u << 4)
+#define GHCI_IRQ_SOFT (1u << 5)
+#define GHCI_IRQ_HALTED (1u << 6)
+#define GHCI_IRQ_RESULT (1u << 7)
+#define GHCI_IRQ_RETIRE (1u << 8)
+
+/* FAULT_INFO. */
+#define GHCI_FAULT_CLIENT(f) ((f) & 0xFFu)
+#define GHCI_FAULT_WRITE (1u << 8)
+#define GHCI_FAULT_KIND(f) (((f) >> 12) & 0xFu)
+#define GHCI_FAULT_BLOCK(f) (((f) >> 16) & 0xFFu)
+#define GHCI_FAULT_JOB_TAG(f) (((f) >> 24) & 0xFFu)
+#define GHCI_FAULT_APERTURE 1u
+#define GHCI_FAULT_OPCODE 2u
+#define GHCI_FAULT_RING 3u
+#define GHCI_FAULT_WATCHDOG 4u
+#define GHCI_FAULT_AXI 5u
+#define GHCI_FAULT_KICK 6u
+#define GHCI_FAULT_LOCKED 7u
+
+/* DBG_STATUS. */
+#define GHCI_DBG_BUSY (1u << 0)
+#define GHCI_DBG_ERROR (1u << 1)
+
+/* KICK. */
+#define GHCI_KICK_BLIT (1u << 0)
+#define GHCI_KICK_DRAW (1u << 1)
+#define GHCI_KICK_DISPATCH (1u << 2)
+
+/* Extended capabilities: entry word 0 and the IDs. */
+#define GHCI_XCAP_ID(w) ((w) & 0xFFu)
+#define GHCI_XCAP_VERSION(w) (((w) >> 8) & 0xFFu)
+#define GHCI_XCAP_NEXT(w) (((w) >> 16) & 0xFFFFu)
+#define GHCI_XCAP_DISP 1u
+#define GHCI_XCAP_DBG 2u
+#define GHCI_XCAP_PERF 3u
+#define GHCI_XCAP_VEND 4u
+#define GHCI_XCAP_MMU 5u
+
+/*
+ * The PERF capability's registers (from its register offset): PERF_SRCn
+ * says what PERFn counts: a STATUS busy bit number (0 CP .. 6 SU), the
+ * memory (cycles with accesses outstanding) or nothing.
+ */
+#define GHCI_PERF_SRC(n) (4u * (n))
+#define GHCI_PERF_SRC_MEM 8u
+#define GHCI_PERF_SRC_NONE 0xFFu
+
+/*
+ * State register file.  Only the BLT range is defined in this draft; the
+ * other ranges follow the command set of design v3 (docs/ghci.md).
+ */
+#define GHCI_S_BLT 0x000u
+#define GHCI_S_VENDOR 0x1E0u
+
+/* BLT. */
+#define GHCI_S_BLT_OP (GHCI_S_BLT + 0u)
+#define GHCI_S_BLT_DST_BASE (GHCI_S_BLT + 1u)
+#define GHCI_S_BLT_DST_STRIDE (GHCI_S_BLT + 2u)
+#define GHCI_S_BLT_SRC_BASE (GHCI_S_BLT + 3u)
+#define GHCI_S_BLT_SRC_STRIDE (GHCI_S_BLT + 4u)
+#define GHCI_S_BLT_DST_XY (GHCI_S_BLT + 5u)
+#define GHCI_S_BLT_SRC_XY (GHCI_S_BLT + 6u)
+#define GHCI_S_BLT_SIZE (GHCI_S_BLT + 7u)
+#define GHCI_S_BLT_COLOR (GHCI_S_BLT + 8u)
+#define GHCI_S_BLT_CLIP_MIN (GHCI_S_BLT + 9u)
+#define GHCI_S_BLT_CLIP_MAX (GHCI_S_BLT + 10u)
+#define GHCI_BLT_FILL 0u
+#define GHCI_BLT_COPY 1u
+#define GHCI_BLT_TILE 2u
+#define GHCI_BLT_UNTILE 3u
+#define GHCI_BLT_BLEND_OVER (1u << 4)
+#define GHCI_BLT_BPP16 (1u << 8)
+#define GHCI_BLT_REVERSE (1u << 12)
+#define GHCI_XY(x, y) (((unsigned)(y) << 16) | ((unsigned)(x) & 0xFFFFu))
+
+/* The display controller's registers (DISP capability, docs/ghci.md
+ * section 12): offsets from the capability's register offset. */
+#define GHCI_DC_ID_VALUE 0x41544443u /* "ATDC" */
+#define GHCI_DC_ID 0x00u
+#define GHCI_DC_VERSION 0x04u
+#define GHCI_DC_CAPS 0x08u
+#define GHCI_DC_CTRL 0x10u
+#define GHCI_DC_STATUS 0x14u
+#define GHCI_DC_IRQ_STATUS 0x18u
+#define GHCI_DC_IRQ_ENABLE 0x1Cu
+#define GHCI_DC_FB_BASE 0x20u
+#define GHCI_DC_FB_NEXT 0x24u
+#define GHCI_DC_FB_STRIDE 0x28u
+#define GHCI_DC_FB_SIZE 0x2Cu
+#define GHCI_DC_H_ACTIVE 0x30u
+#define GHCI_DC_H_FP 0x34u
+#define GHCI_DC_H_SYNC 0x38u
+#define GHCI_DC_H_BP 0x3Cu
+#define GHCI_DC_V_ACTIVE 0x40u
+#define GHCI_DC_V_FP 0x44u
+#define GHCI_DC_V_SYNC 0x48u
+#define GHCI_DC_V_BP 0x4Cu
+#define GHCI_DC_SYNC_POL 0x50u
+#define GHCI_DC_FRAME_COUNT 0x54u
+#define GHCI_DC_PCLK_SEL 0x58u
+#define GHCI_DC_I2C_CTRL 0x60u
+#define GHCI_DC_I2C_DATA 0x64u
+#define GHCI_DC_I2C_STATUS 0x68u
+#define GHCI_DC_SCAN_SUM 0x70u /* Amaterrace: sum of the last frame's pixel words */
+#define GHCI_DC_SCAN_WORDS 0x74u /* Amaterrace: pixel words of the last frame */
+#define GHCI_DC_STANDALONE_DISP 0x200u /* DISP of a DC-only window */
+#define GHCI_DC_CTRL_ENABLE (1u << 0)
+#define GHCI_DC_CTRL_RESET (1u << 1)
+#define GHCI_DC_CTRL_TEST_PATTERN (1u << 2)
+#define GHCI_DC_CTRL_FORMAT(f) (((unsigned)(f) & 3u) << 4)
+#define GHCI_DC_CTRL_OUTPUT_HDMI (1u << 6)
+#define GHCI_DC_FMT_BGRA8 0u
+#define GHCI_DC_FMT_RGBA8 1u
+#define GHCI_DC_FMT_RGB565 2u
+#define GHCI_DC_IRQ_VSYNC (1u << 0)
+#define GHCI_DC_IRQ_UNDERFLOW (1u << 1)
+#define GHCI_DC_IRQ_FLIP_DONE (1u << 2)
+
+#endif /* GHCI_REGS_H */
diff --git a/src/drivers/gpu/ghci/packets.h b/src/drivers/gpu/ghci/packets.h
new file mode 100644
index 0000000000..052e4b90bc
--- /dev/null
+++ b/src/drivers/gpu/ghci/packets.h
@@ -0,0 +1,67 @@
+/*
+ * Copied from amaterrace-gpu 903f861 include/ghci_packets.h (the GHCI 1.0
+ * draft, the original is the authority): do not edit here, copy again.
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * Amaterrace GPU
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * ghci_packets.h: the GHCI command ring's packet envelope (version 3) and
+ * the class N micro-operations (docs/ghci.md section 9).  Class V packets
+ * carry zedBSD's GPU command protocol (gpu-op) for the CP's firmware.
+ */
+
+#ifndef GHCI_PACKETS_H
+#define GHCI_PACKETS_H
+
+/*
+ * dword0: [31:30] class, [29:24] op (class N), [23:16] job tag,
+ * class N: [15:8] flags, [7:0] payload dwords; class V and padding:
+ * [15:0] dwords after the header.
+ */
+#define GHCI_PKT_CLASS_STD 0u	/* class N, standard micro-ops */
+#define GHCI_PKT_CLASS_VENDOR 1u	/* class N, vendor micro-ops */
+#define GHCI_PKT_CLASS_V 2u	/* a gpu-op for the firmware */
+#define GHCI_PKT_CLASS_PAD 3u	/* padding: skipped */
+#define GHCI_PKT_N(cls, op, tag, flags, n) \
+	((unsigned)(cls) << 30 | ((unsigned)(op) & 0x3Fu) << 24 | ((unsigned)(tag) & 0xFFu) << 16 | \
+	    ((unsigned)(flags) & 0xFFu) << 8 | ((unsigned)(n) & 0xFFu))
+#define GHCI_PKT_V(tag, n) (GHCI_PKT_CLASS_V << 30 | ((unsigned)(tag) & 0xFFu) << 16 | \
+	((unsigned)(n) & 0xFFFFu))
+#define GHCI_PKT_PAD(n) (GHCI_PKT_CLASS_PAD << 30 | ((unsigned)(n) & 0xFFFFu))
+#define GHCI_PKT_GET_CLASS(d) ((d) >> 30)
+#define GHCI_PKT_GET_TAG(d) (((d) >> 16) & 0xFFu)
+
+/* Standard micro-ops (class 0) and their payload dwords. */
+#define GHCI_OP_NOP 0u	/* n: skipped */
+#define GHCI_OP_SET_REG 1u	/* (index, value) pairs */
+#define GHCI_OP_BLIT 2u	/* 0; flags[0]: wait for the end */
+#define GHCI_OP_DRAW 3u	/* 0 */
+#define GHCI_OP_DISPATCH 4u	/* 3: gx, gy, gz */
+#define GHCI_OP_FENCE 5u	/* 2: addr, value; flags[0]: IRQ */
+#define GHCI_OP_WAIT_IDLE 6u	/* 0; flags: STATUS busy-bit mask, 0 = all */
+#define GHCI_OP_LOAD_CONST 7u	/* 3: region, addr, words */
+#define GHCI_OP_LOAD_PROGRAM 8u	/* 1: stage */
+#define GHCI_OP_WAIT_FENCE 9u	/* 2: addr, value */
+#define GHCI_OP_PERF_RESET 10u	/* 0 */
+#define GHCI_OP_WAIT_VSYNC 11u	/* 0 */
+#define GHCI_OP_INVALIDATE 12u	/* 0; flags: [0] D$ [1] T$ [2] constants [3] I$ */
+#define GHCI_OP_RESULT 13u	/* 3: addr, status, aux */
+#define GHCI_FENCE_IRQ 0x01u	/* FENCE flags */
+#define GHCI_BLIT_WAIT 0x01u	/* BLIT flags */
+
+/* Amaterrace's vendor micro-ops (class 1). */
+#define ATG_VOP_DRAW_RAW 0u	/* 9: three vertices x, y, z */
+#define ATG_VOP_DBG_MARK 1u	/* 1: STATE[0x1FF] = payload */
+
+/* Fence values are 32 bits and compare with wrap-around. */
+#define GHCI_FENCE_PASSED(mem, value) ((int)((unsigned)(mem) - (unsigned)(value)) >= 0)
+
+#endif /* GHCI_PACKETS_H */
diff --git a/src/drivers/platform/zybo/pl-memory.c b/src/drivers/platform/zybo/pl-memory.c
new file mode 100644
index 0000000000..c9fcd3ddd2
--- /dev/null
+++ b/src/drivers/platform/zybo/pl-memory.c
@@ -0,0 +1,251 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The memory of the programmable logic's blocks on the ZYBO.
+ *
+ * The board's device tree (plan/ws288/tests/zybo-gpu-sd.dts) reserves the
+ * top 64 MiB of DDR for the GPU in the logic: a child of /reserved-memory,
+ * no-map, which the HAL takes out of the page allocator.  The node is
+ * found by its compatible string "amaterrace,gpu-memory", or else by its
+ * name gpu@<address>.  The range is mapped once through
+ * kern_pmem_map_uncached(), a Normal non-cacheable view: the blocks'
+ * memory accesses do not snoop the processor's caches, and on armv7 a
+ * device mapping of RAM would hand back the cached direct map instead.
+ * The view is kept for the life of the system, so the GPU's driver and
+ * the display controller's, whichever bitstream is loaded, borrow the
+ * same memory.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <drivers/generic/fdt.h>
+#include <drivers/platform/zybo/pl-memory.h>
+#include <hal/hal.h>
+#include <kern/kcrt.h>
+#include <kern/klog.h>
+#include <kern/pmem.h>
+#include <uapi/errno.h>
+
+/* The compatible string of the reserved node, and the prefix of its name. */
+#define PL_MEMORY_COMPATIBLE		"amaterrace,gpu-memory"
+#define PL_MEMORY_NAME_PREFIX		"gpu@"
+#define PL_MEMORY_PARENT_NAME		"reserved-memory"
+
+/* How much of the device tree is read: the board's is a few KiB. */
+#define PL_MEMORY_FDT_LIMIT		(256U * 1024U)
+
+/* The view's granule, the page. */
+#define PL_MEMORY_PAGE_BYTES		4096U
+
+/*
+ * The reserved range and its view, filled once by drv_zybo_pl_memory_init()
+ * on the boot path before any block can be attached, and read without a
+ * lock afterwards.  found is zero while there is none.
+ */
+static struct drv_zybo_pl_memory pl_memory;
+static int pl_memory_found;
+
+static int find_node(const struct drv_fdt *fdt, uint32_t *node);
+static int find_child_named(const struct drv_fdt *fdt, uint32_t parent, const char *name, int prefix, uint32_t *child);
+static int node_name_matches(const struct drv_fdt *fdt, uint32_t node, const char *name, int prefix);
+
+/*
+ * Finds the reserved range in the device tree and maps it uncached.
+ */
+int
+drv_zybo_pl_memory_init(
+	void)
+{
+	const uint64_t *fdt_range;
+	struct drv_fdt fdt;
+	struct kern_pmem run;
+	const void *blob;
+	uint64_t address;
+	uint64_t size;
+	uint32_t node;
+	void *mapped;
+	int error;
+
+	/* Finds the device tree the loader passed. */
+	fdt_range = hal_get_arch_handoff("armv7.fdt");
+	if (fdt_range == NULL)
+		return ENOENT;
+	blob = kern_pmem_to_kernel((hal_physaddr_t)fdt_range[0]);
+	if (blob == NULL)
+		return ENOENT;
+
+	/* Opens the tree before searching it. */
+	error = drv_fdt_open(&fdt, blob, PL_MEMORY_FDT_LIMIT);
+	if (error != 0)
+		return error;
+
+	/* Finds the reserved node; a tree without one leaves the blocks without memory. */
+	error = find_node(&fdt, &node);
+	if (error != 0) {
+		kern_logf("pl-memory: the device tree reserves no memory for the logic\n");
+		return ENOENT;
+	}
+
+	/* Reads the range; reserved-memory's ranges are the identity. */
+	error = drv_fdt_reg(&fdt, node, 0, &address, &size);
+	if (error != 0)
+		return error;
+
+	/* The view takes whole pages of the 32-bit physical space. */
+	if ((address % PL_MEMORY_PAGE_BYTES) != 0 || (size % PL_MEMORY_PAGE_BYTES) != 0)
+		return EINVAL;
+	if (size == 0 || address > 0xffffffffULL || size > 0x100000000ULL - address)
+		return EINVAL;
+
+	/* Maps the range uncached, once for the life of the system. */
+	run.paddr = (hal_physaddr_t)address;
+	run.size = (size_t)size;
+	error = kern_pmem_map_uncached(&run, &mapped);
+	if (error != 0) {
+		kern_logf("pl-memory: %llx+%llx not mapped (%d)\n",
+			  (unsigned long long)address,
+			  (unsigned long long)size,
+			  error);
+		return error;
+	}
+
+	/* Publishes the range to the blocks' drivers. */
+	pl_memory.physical = address;
+	pl_memory.bytes = size;
+	pl_memory.mapped = mapped;
+	pl_memory_found = 1;
+	kern_logf("pl-memory: %llu MiB at %llx for the logic's blocks\n",
+		  (unsigned long long)(size >> 20),
+		  (unsigned long long)address);
+
+	/* Succeeded: the range is reachable. */
+	return 0;
+}
+
+/*
+ * Copies out the reserved range.
+ */
+int
+drv_zybo_pl_memory_get(
+	struct drv_zybo_pl_memory *memory)
+{
+	/* Refuses a missing destination. */
+	if (memory == NULL)
+		return EINVAL;
+
+	/* A board without the reservation has no range to give. */
+	if (!pl_memory_found)
+		return ENODEV;
+
+	/* Succeeded: the caller has the range and its view. */
+	*memory = pl_memory;
+	return 0;
+}
+
+/*
+ * Finds the reserved node: by its compatible string, or by its name under
+ * /reserved-memory.
+ */
+static int
+find_node(
+	const struct drv_fdt *fdt,
+	uint32_t *node)
+{
+	uint32_t parent;
+	int error;
+
+	/* The compatible string names the node wherever it is. */
+	error = drv_fdt_find_compatible(fdt, PL_MEMORY_COMPATIBLE, DRV_FDT_NO_NODE, node);
+	if (error == 0)
+		return 0;
+
+	/* Else /reserved-memory, a child of the root (the first node of the structure). */
+	error = find_child_named(fdt, fdt->structure_offset, PL_MEMORY_PARENT_NAME, 0, &parent);
+	if (error != 0)
+		return error;
+
+	/* And its child gpu@... */
+	error = find_child_named(fdt, parent, PL_MEMORY_NAME_PREFIX, 1, node);
+	if (error != 0)
+		return error;
+
+	/* Succeeded: the node is found. */
+	return 0;
+}
+
+/* Finds a child of a node by its name, or by the start of its name. */
+static int
+find_child_named(
+	const struct drv_fdt *fdt,
+	uint32_t parent,
+	const char *name,
+	int prefix,
+	uint32_t *child)
+{
+	uint32_t candidate;
+	int matches;
+	int error;
+
+	/* Walks the children in order. */
+	candidate = DRV_FDT_NO_NODE;
+	for (;;) {
+		error = drv_fdt_child(fdt, parent, candidate, &candidate);
+		if (error != 0)
+			return ENOENT;
+
+		/* The first child of the name is the answer. */
+		matches = node_name_matches(fdt, candidate, name, prefix);
+		if (matches)
+			break;
+	}
