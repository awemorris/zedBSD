+/*
+ * Reports whether a node's name is the one asked for (or starts with it):
+ * 1 when it is.  The name follows the begin-node token in the structure.
+ */
+static int
+node_name_matches(
+	const struct drv_fdt *fdt,
+	uint32_t node,
+	const char *name,
+	int prefix)
+{
+	const char *text;
+	size_t length;
+	size_t limit;
+	int differ;
