diff --git a/include/uapi/fpga.h b/include/uapi/fpga.h
index 0dba15173d..d34091e4cc 100644
--- a/include/uapi/fpga.h
+++ b/include/uapi/fpga.h
@@ -35,6 +35,7 @@
 #define FPGA_STATUS_ENABLED		0x00000004U	/* level shifters open, resets released, window usable */
 #define FPGA_STATUS_PROGRAMMING		0x00000008U	/* a bitstream is being written */
 #define FPGA_STATUS_EMULATED		0x00000010U	/* the emulator's model: the waits on the logic were skipped */
+#define FPGA_STATUS_ATTACHED		0x00000020U	/* a kernel driver holds the block (writes and waits refused) */
 
 /* What fpga_status.error says of the last FPGA_PROGRAM: 0, or an errno. */
 
@@ -87,4 +88,17 @@ struct fpga_irq_wait {
 #define FPGA_REG_WRITE		_IOW(KERN_FPGA_IOC_GROUP, 5, struct fpga_reg)
 #define FPGA_IRQ_WAIT		_IOWR(KERN_FPGA_IOC_GROUP, 6, struct fpga_irq_wait)
 
+/*
+ * A kernel driver of the block the logic holds (the GPU's, WS288) takes
+ * the block when the logic is enabled and its window's first word names
+ * the driver.  While it holds the block, FPGA_REG_WRITE and FPGA_IRQ_WAIT
+ * answer EBUSY (FPGA_REG_READ still reads), and FPGA_PROGRAM and
+ * FPGA_DISABLE first give the block back, which they cannot while the
+ * driver's device is open (EBUSY).  FPGA_BLOCK_DETACH gives the block
+ * back and leaves the logic enabled, for a test that drives the registers
+ * itself; FPGA_BLOCK_ATTACH offers an enabled logic to the drivers again.
+ */
+#define FPGA_BLOCK_DETACH	_IO(KERN_FPGA_IOC_GROUP, 7)
+#define FPGA_BLOCK_ATTACH	_IO(KERN_FPGA_IOC_GROUP, 8)
+
 #endif
