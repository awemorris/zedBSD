@@ -57,6 +83,12 @@
  */
 int drv_zynq_devcfg_attach(void);
 
+/*
+ * Registers a driver of a block the logic may hold.  Returns 0, ENODEV
+ * when /dev/fpga0 did not start, or ENOSPC when the table is full.
+ */
+int drv_zynq_pl_block_register(const struct drv_zynq_pl_block *block);
