+	/* The name starts four bytes after the token. */
+	if (node > fdt->size || fdt->size - node < 5U)
+		return 0;
+	text = (const char *)fdt->blob + node + 4U;
+	limit = fdt->size - node - 4U;
+
+	/* Measures the name, which must end inside the blob. */
+	length = 0;
+	while (length < limit && text[length] != '\0')
+		length++;
+	if (length == limit)
+		return 0;
+
+	/* A prefix match needs only the start; a whole match the same length. */
+	differ = kern_strncmp(text, name, kern_strlen(name));
+	if (differ != 0)
+		return 0;
+	if (!prefix && length != kern_strlen(name))
+		return 0;
+
+	/* Succeeded: the name is the one asked for. */
+	return 1;
+}
