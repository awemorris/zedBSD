+++ b/include/drivers/platform/zybo/pl-memory.h
@@ -0,0 +1,44 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The memory of the programmable logic's blocks on the ZYBO: the range of
+ * DDR the board's device tree reserves for them (/reserved-memory, the
+ * node gpu@... or the one compatible with "amaterrace,gpu-memory"), which
+ * the kernel's page allocator never hands out.  The kernel reaches it only
+ * through one uncached view, made once at boot and kept for the life of
+ * the system: a block written into the logic later finds the same memory,
+ * whichever driver holds the block.
+ */
+
+#ifndef KERN_DRIVERS_PLATFORM_ZYBO_PL_MEMORY_H
+#define KERN_DRIVERS_PLATFORM_ZYBO_PL_MEMORY_H
+
+#include <stdint.h>
+
+/*
+ * The reserved range: its physical address (the address the blocks use),
+ * its size, and the kernel's uncached view of it.
+ */
+struct drv_zybo_pl_memory {
+	uint64_t physical;
+	uint64_t bytes;
+	void *mapped;
+};
+
+/*
+ * Finds the reserved range in the device tree and maps it uncached.
+ * Returns 0, ENOENT when the tree reserves none, or why the view failed.
+ */
+int drv_zybo_pl_memory_init(void);
+
+/*
+ * Copies out the reserved range.  Returns 0, or ENODEV when there is none.
+ */
+int drv_zybo_pl_memory_get(struct drv_zybo_pl_memory *memory);
+
+#endif
