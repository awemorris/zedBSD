diff --git a/userland/tests/gsbase-probe.c b/userland/tests/gsbase-probe.c
new file mode 100644
index 0000000000..1dc0667301
--- /dev/null
+++ b/userland/tests/gsbase-probe.c
@@ -0,0 +1,676 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The user GS base probe (ws080-p002).
+ *
+ * Sets a thread's GS base with thread_self(SET_GSBASE) and checks that the
+ * value survives every way into and out of the kernel: system calls by
+ * SYSCALL and by the interrupt gate, faults turned into signals, the timer
+ * interrupting a spin, thread switches, fork, a single step and a data
+ * watchpoint taken under ptrace.  It also checks that exec starts with no
+ * GS base, that thread_create gives a new thread its first one, and that a
+ * kernel address is refused everywhere a user GS base can be written.
+ *
+ * Each check prints GSBASE:<name>:PASS or GSBASE:<name>:FAIL:<detail>; the
+ * last line is GSBASE:ALL:PASS (exit 0) or GSBASE:ALL:FAIL (exit 1).  An
+ * operator may send the guest NMIs (QEMU monitor "nmi") while the spin runs.
+ */
+
+#include <errno.h>
+#include <pthread.h>
+#include <setjmp.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/ptrace.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <uapi/reg.h>
+#include <uapi/syscall.h>
+#include <uapi/thread.h>
+
+#define GSBASE_MARKER_MAIN	0x6773626173656d61ULL
+#define GSBASE_MARKER_LEFT	0x6773626173656c65ULL
+#define GSBASE_MARKER_RIGHT	0x6773626173657269ULL
+#define GSBASE_MARKER_NEW	0x677362617365ee77ULL
+#define GSBASE_SWITCH_ROUNDS	1000000UL
+#define GSBASE_SPIN_ROUNDS	200000000UL
+#define GSBASE_SYSCALL_ROUNDS	100000UL
+#define GSBASE_KERNEL_ADDRESS	0xffff800000000000ULL
+#define GSBASE_NONCANONICAL	0x0000800000000000ULL
+#define GSBASE_THREAD_STACK	65536U
+#define GSBASE_STEP_COUNT	8
+
+/*
+ * What a GS base points at in this probe: a marker read at %gs:0 and a
+ * scratch word written at %gs:8 (the data watchpoint watches it).
+ */
+struct gsbase_block {
+	uint64_t marker;
+	uint64_t scratch;
+};
+
+/*
+ * One thread of the switch test: the block its GS base points at and what
+ * it found.
+ */
+struct gsbase_switcher {
+	struct gsbase_block block;
+	unsigned long mismatches;
+	int set_error;
+};
+
+/*
+ * The GS blocks of the main thread and of the raw thread.  They live for
+ * the whole run; a forked child sees them at the same addresses.
+ */
+static struct gsbase_block gsbase_main_block;
+static struct gsbase_block gsbase_new_block;
+
+/*
+ * What the raw thread read through GS, and whether it has run.  The main
+ * thread spins on the flag; the raw thread exits right after setting it.
+ */
+static volatile uint64_t gsbase_new_seen;
+static volatile int gsbase_new_done;
+
+/*
+ * Where a signal handler resumes the main thread, and what the handler
+ * read through GS.  Only the signal tests use them, one at a time.
+ */
+static sigjmp_buf gsbase_signal_return;
+static volatile uint64_t gsbase_handler_seen;
+
+/* The number of failed checks; the exit status follows it. */
+static unsigned gsbase_failures;
+
+intptr_t __syscall6(uint32_t number, uintptr_t a, uintptr_t b, uintptr_t c, uintptr_t d, uintptr_t e, uintptr_t f);
+
+/*
+ * The raw thread's entry: no C library state, so it reads GS, publishes
+ * what it saw and leaves by thread_exit (110) itself.
+ */
+void gsbase_new_thread_entry(void);
+__asm__(
+	".text\n"
+	".globl gsbase_new_thread_entry\n"
+	"gsbase_new_thread_entry:\n"
+	"\tmovq %gs:0, %rax\n"
+	"\tmovq %rax, gsbase_new_seen(%rip)\n"
+	"\tmovl $1, gsbase_new_done(%rip)\n"
+	"\tmovl $110, %eax\n"
+	"\txorl %ebx, %ebx\n"
+	"\tsyscall\n"
+	"\tud2\n");
+
+static uint64_t gsbase_read_marker(void);
+static void gsbase_write_scratch(uint64_t value);
+static intptr_t gsbase_set(uintptr_t value);
+static intptr_t gsbase_get(void);
+static void gsbase_report(const char *name, int passed, const char *detail);
+static void gsbase_test_set_get(void);
+static void gsbase_test_syscalls(void);
+static void gsbase_signal_handler(int signal_number);
+static void gsbase_test_one_signal(const char *name, int signal_number, int kind);
+static void gsbase_test_signals(void);
+static void gsbase_test_spin(void);
+static void *gsbase_switcher_main(void *argument);
+static void gsbase_test_switches(void);
+static void gsbase_test_fork(void);
+static void gsbase_test_exec(const char *self);
+static void gsbase_test_reject(void);
+static void gsbase_test_thread_create(void);
+static void gsbase_traced_child(void);
+static void gsbase_test_ptrace(void);
+
+/*
+ * Runs every check, or reports the GS base of an execed image.
+ */
+int
+main(
+	int argc,
+	char *argv[])
+{
+	intptr_t inherited;
+
+	/* The image exec started reports the GS base it began with. */
+	if (argc == 2 && strcmp(argv[1], "--exec-child") == 0) {
+		inherited = gsbase_get();
+		if (inherited != 0)
+			return 1;
+
+		/* Succeeded: exec cleared the GS base. */
+		return 0;
+	}
+
+	/* Runs the checks, each independent of the others' outcome. */
+	gsbase_test_set_get();
+	gsbase_test_syscalls();
+	gsbase_test_signals();
+	gsbase_test_spin();
+	gsbase_test_switches();
+	gsbase_test_fork();
+	gsbase_test_exec(argv[0]);
+	gsbase_test_reject();
+	gsbase_test_thread_create();
+	gsbase_test_ptrace();
+
+	/* Reports a failed run. */
+	if (gsbase_failures != 0) {
+		printf("GSBASE:ALL:FAIL\n");
+		return 1;
+	}
+
+	/* Succeeded: every check passed. */
+	printf("GSBASE:ALL:PASS\n");
+	return 0;
+}
+
+/* Reads the marker at %gs:0. */
+static uint64_t
+gsbase_read_marker(
+	void)
+{
+	uint64_t marker;
+
+	/* Loads through the GS segment. */
+	__asm__ volatile("movq %%gs:0, %0" : "=r"(marker) : : "memory");
+
+	/* Reports the marker. */
+	return marker;
+}
+
+/* Writes the scratch word at %gs:8. */
+static void
+gsbase_write_scratch(
+	uint64_t value)
+{
+	/* Stores through the GS segment. */
+	__asm__ volatile("movq %0, %%gs:8" : : "r"(value) : "memory");
+}
+
+/* Sets the calling thread's GS base; reports 0 or a negative errno. */
+static intptr_t
+gsbase_set(
+	uintptr_t value)
+{
+	intptr_t error;
+
+	/* Asks the kernel through thread_self. */
+	error = __syscall6(KERN_SYS_thread_self, KERN_THREAD_SELF_SET_GSBASE, value, 0, 0, 0, 0);
+
+	/* Reports the kernel's answer. */
+	return error;
+}
+
+/* Reports the calling thread's GS base, or a negative errno. */
+static intptr_t
+gsbase_get(
+	void)
+{
+	intptr_t value;
+
+	/* Asks the kernel through thread_self. */
+	value = __syscall6(KERN_SYS_thread_self, KERN_THREAD_SELF_GET_GSBASE, 0, 0, 0, 0, 0);
+
+	/* Reports the kernel's answer. */
+	return value;
+}
+
+/* Prints one check's outcome and counts a failure. */
+static void
+gsbase_report(
+	const char *name,
+	int passed,
+	const char *detail)
+{
+	/* A passed check prints only its name. */
+	if (passed) {
+		printf("GSBASE:%s:PASS\n", name);
+		fflush(stdout);
+		return;
+	}
+
+	/* A failed check says why. */
+	gsbase_failures++;
+	printf("GSBASE:%s:FAIL:%s\n", name, detail);
+	fflush(stdout);
+}
+
+/* Sets the main thread's GS base and reads it back both ways. */
+static void
+gsbase_test_set_get(
+	void)
+{
+	intptr_t error;
+	intptr_t value;
+	uint64_t marker;
+
+	/* Points GS at the main block. */
+	gsbase_main_block.marker = GSBASE_MARKER_MAIN;
+	error = gsbase_set((uintptr_t)&gsbase_main_block);
+	if (error != 0) {
+		gsbase_report("set", 0, "thread_self(SET_GSBASE) refused a user address");
+		return;
+	}
+
+	gsbase_report("set", 1, "");
+
+	/* Reads the base back from the kernel. */
+	value = gsbase_get();
+	gsbase_report("get", value == (intptr_t)&gsbase_main_block, "GET_GSBASE differs from the value set");
+
+	/* Reads the marker through the segment. */
+	marker = gsbase_read_marker();
+	gsbase_report("read", marker == GSBASE_MARKER_MAIN, "%gs:0 is not the marker");
+}
+
+/* Enters the kernel many times by both system call paths. */
+static void
+gsbase_test_syscalls(
+	void)
+{
+	unsigned long round;
+	unsigned long mismatches;
+	long pid;
+
+	/* Calls getpid by SYSCALL and checks GS after each return. */
+	mismatches = 0;
+	for (round = 0; round < GSBASE_SYSCALL_ROUNDS; round++) {
+		(void)getpid();
+		if (gsbase_read_marker() != GSBASE_MARKER_MAIN)
+			mismatches++;
+	}
+
+	gsbase_report("syscall", mismatches == 0, "GS changed across SYSCALL");
+
+	/* Calls getpid through the interrupt gate and checks GS after each. */
+	mismatches = 0;
+	for (round = 0; round < GSBASE_SYSCALL_ROUNDS; round++) {
+		__asm__ volatile("int $0xc2"
+				 : "=a"(pid)
+				 : "a"((long)KERN_SYS_getpid)
+				 : "memory");
+		if (gsbase_read_marker() != GSBASE_MARKER_MAIN)
+			mismatches++;
+	}
+
+	gsbase_report("int-gate", mismatches == 0, "GS changed across the interrupt gate");
+}
+
+/* Records GS in a handler and resumes the test that raised the signal. */
+static void
+gsbase_signal_handler(
+	int signal_number)
+{
+	(void)signal_number;
+
+	/* Records what the handler reads through GS. */
+	gsbase_handler_seen = gsbase_read_marker();
+
+	/* Returns to the test past the faulting instruction. */
+	siglongjmp(gsbase_signal_return, 1);
+}
+
+/* Raises one fault kind, then checks GS in the handler and after it. */
+static void
+gsbase_test_one_signal(
+	const char *name,
+	int signal_number,
+	int kind)
+{
+	struct sigaction action;
+	struct sigaction previous;
+	int resumed;
+
+	/* Installs the handler for this signal. */
+	memset(&action, 0, sizeof(action));
+	action.sa_handler = gsbase_signal_handler;
+	sigemptyset(&action.sa_mask);
+	sigaction(signal_number, &action, &previous);
+	gsbase_handler_seen = 0;
+
+	/* Raises the fault; the handler comes back here with 1. */
+	resumed = sigsetjmp(gsbase_signal_return, 1);
+	if (resumed == 0) {
+		if (kind == 0)
+			*(volatile int *)16 = 1;
+		else if (kind == 1)
+			__asm__ volatile("ud2");
+		else
+			__asm__ volatile("int3");
+	}
+
+	/* Restores the previous disposition. */
+	sigaction(signal_number, &previous, NULL);
+
+	/* Checks the handler's view and the view after it returned. */
+	if (gsbase_handler_seen != GSBASE_MARKER_MAIN) {
+		gsbase_report(name, 0, "the handler did not see the GS base");
+		return;
+	}
+
+	gsbase_report(name, gsbase_read_marker() == GSBASE_MARKER_MAIN, "GS changed after the handler");
+}
+
+/* Checks GS across a page fault, an invalid opcode and a breakpoint. */
+static void
+gsbase_test_signals(
+	void)
+{
+	/* A user #PF delivered as SIGSEGV. */
+	gsbase_test_one_signal("page-fault", SIGSEGV, 0);
+
+	/* A user #UD delivered as SIGILL. */
+	gsbase_test_one_signal("invalid-opcode", SIGILL, 1);
+
+	/* A user #BP delivered as SIGTRAP. */
+	gsbase_test_one_signal("breakpoint", SIGTRAP, 2);
+}
+
+/* Spins long enough for timer interrupts (and an operator's NMIs). */
+static void
+gsbase_test_spin(
+	void)
+{
+	unsigned long round;
+	unsigned long mismatches;
+
+	/* Reads GS in a tight loop that interrupts break into. */
+	mismatches = 0;
+	for (round = 0; round < GSBASE_SPIN_ROUNDS; round++) {
+		if (gsbase_read_marker() != GSBASE_MARKER_MAIN)
+			mismatches++;
+	}
+
+	gsbase_report("spin", mismatches == 0, "GS changed under interrupts");
+}
+
+/* Runs one switcher thread: its own GS base, read across many yields. */
+static void *
+gsbase_switcher_main(
+	void *argument)
+{
+	struct gsbase_switcher *switcher;
+	unsigned long round;
+	intptr_t error;
+
+	switcher = argument;
+
+	/* Points this thread's GS at its own block. */
+	error = gsbase_set((uintptr_t)&switcher->block);
+	if (error != 0) {
+		switcher->set_error = 1;
+		return NULL;
+	}
+
+	/* Reads the marker, giving the processor away now and then. */
+	for (round = 0; round < GSBASE_SWITCH_ROUNDS; round++) {
+		if (gsbase_read_marker() != switcher->block.marker)
+			switcher->mismatches++;
+		if ((round & 1023UL) == 0)
+			sched_yield();
+	}
+
+	/* Succeeded: the counts are in the switcher. */
+	return NULL;
+}
+
+/* Runs two threads with different GS bases side by side. */
+static void
+gsbase_test_switches(
+	void)
+{
+	static struct gsbase_switcher left;
+	static struct gsbase_switcher right;
+	pthread_t left_thread;
+	pthread_t right_thread;
+	int error;
+
+	/* Gives each thread its own marker. */
+	memset(&left, 0, sizeof(left));
+	memset(&right, 0, sizeof(right));
+	left.block.marker = GSBASE_MARKER_LEFT;
+	right.block.marker = GSBASE_MARKER_RIGHT;
+
+	/* Starts both threads. */
+	error = pthread_create(&left_thread, NULL, gsbase_switcher_main, &left);
+	if (error != 0) {
+		gsbase_report("switch", 0, "pthread_create failed");
+		return;
+	}
+
+	error = pthread_create(&right_thread, NULL, gsbase_switcher_main, &right);
+	if (error != 0) {
+		pthread_join(left_thread, NULL);
+		gsbase_report("switch", 0, "pthread_create failed");
+		return;
+	}
+
+	/* Waits for both and judges what they saw, and that main kept its own. */
+	pthread_join(left_thread, NULL);
+	pthread_join(right_thread, NULL);
+	if (left.set_error || right.set_error) {
+		gsbase_report("switch", 0, "a thread could not set its GS base");
+		return;
+	}
+
+	gsbase_report("switch", left.mismatches == 0 && right.mismatches == 0, "a thread read another thread's GS");
+	gsbase_report("switch-main", gsbase_read_marker() == GSBASE_MARKER_MAIN, "the main thread lost its GS base");
+}
+
+/* Checks that a forked child starts with the parent's GS base. */
+static void
+gsbase_test_fork(
+	void)
+{
+	pid_t child;
+	int status;
+
+	/* The child judges its own GS and reports it in the exit status. */
+	child = fork();
+	if (child < 0) {
+		gsbase_report("fork", 0, "fork failed");
+		return;
+	}
+
+	if (child == 0) {
+		if (gsbase_read_marker() != GSBASE_MARKER_MAIN)
+			_exit(1);
+		if (gsbase_get() != (intptr_t)&gsbase_main_block)
+			_exit(2);
+		_exit(0);
+	}
+
+	/* Collects the child's verdict. */
+	waitpid(child, &status, 0);
+	gsbase_report("fork", WIFEXITED(status) && WEXITSTATUS(status) == 0, "the child did not inherit the GS base");
+}
+
+/* Checks that exec starts the new image without a GS base. */
+static void
+gsbase_test_exec(
+	const char *self)
+{
+	pid_t child;
+	int status;
+
+	/* The child execs this program, which reports its GS base. */
+	child = fork();
+	if (child < 0) {
+		gsbase_report("exec", 0, "fork failed");
+		return;
+	}
+
+	if (child == 0) {
+		execl(self, self, "--exec-child", (char *)NULL);
+		_exit(3);
+	}
+
+	/* Collects the execed image's verdict. */
+	waitpid(child, &status, 0);
+	gsbase_report("exec", WIFEXITED(status) && WEXITSTATUS(status) == 0, "exec kept a GS base");
+}
+
+/* Checks that kernel and non-canonical addresses are refused. */
+static void
+gsbase_test_reject(
+	void)
+{
+	intptr_t error;
+
+	/* An upper-half address would pass for the per-CPU state. */
+	error = gsbase_set((uintptr_t)GSBASE_KERNEL_ADDRESS);
+	gsbase_report("reject-kernel", error == -EINVAL, "a kernel address was accepted");
+
+	/* A non-canonical address is no address at all. */
+	error = gsbase_set((uintptr_t)GSBASE_NONCANONICAL);
+	gsbase_report("reject-noncanonical", error == -EINVAL, "a non-canonical address was accepted");
+
+	/* The refusals left the base alone. */
+	gsbase_report("reject-kept", gsbase_read_marker() == GSBASE_MARKER_MAIN, "a refused value changed the GS base");
+}
+
+/* Checks thread_create's first GS base on a thread with no C library state. */
+static void
+gsbase_test_thread_create(
+	void)
+{
+	void *stack;
+	uintptr_t stack_top;
+	unsigned long spins;
+	intptr_t error;
+	int tid;
+
+	/* Maps the raw thread's stack. */
+	stack = mmap(NULL, GSBASE_THREAD_STACK, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if (stack == MAP_FAILED) {
+		gsbase_report("thread-create", 0, "mmap failed");
+		return;
+	}
+
+	/* A kernel address as the first GS base is refused before the thread runs. */
+	stack_top = ((uintptr_t)stack + GSBASE_THREAD_STACK) & ~(uintptr_t)15U;
+	error = __syscall6(KERN_SYS_thread_create, (uintptr_t)gsbase_new_thread_entry, stack_top, 0, 0, (uintptr_t)GSBASE_KERNEL_ADDRESS, (uintptr_t)&tid);
+	gsbase_report("thread-create-reject", error == -EINVAL, "a kernel address was accepted");
+
+	/* Starts the raw thread with its own block. */
+	gsbase_new_block.marker = GSBASE_MARKER_NEW;
+	error = __syscall6(KERN_SYS_thread_create, (uintptr_t)gsbase_new_thread_entry, stack_top, 0, 0, (uintptr_t)&gsbase_new_block, (uintptr_t)&tid);
+	if (error != 0) {
+		gsbase_report("thread-create", 0, "thread_create refused a user GS base");
+		return;
+	}
+
+	/* Waits for the raw thread's report. */
+	for (spins = 0; spins < 100000000UL && !gsbase_new_done; spins++)
+		sched_yield();
+
+	gsbase_report("thread-create", gsbase_new_done && gsbase_new_seen == GSBASE_MARKER_NEW, "the new thread did not start with its GS base");
+	gsbase_report("thread-create-main", gsbase_read_marker() == GSBASE_MARKER_MAIN, "the creator's GS base changed");
+}
+
+/* Runs the traced child: stops, writes the watched word, then checks GS. */
+static void
+gsbase_traced_child(
+	void)
+{
+	int step;
+
+	/* Becomes traced and stops for the tracer's setup. */
+	ptrace(PT_TRACE_ME, 0, NULL, 0);
+	raise(SIGSTOP);
+
+	/* The write the data watchpoint catches. */
+	gsbase_write_scratch(1);
+
+	/* A few instructions the tracer single-steps through. */
+	for (step = 0; step < GSBASE_STEP_COUNT; step++)
+		gsbase_write_scratch((uint64_t)step);
+
+	/* Reports whether GS survived the debug exceptions. */
+	if (gsbase_read_marker() != GSBASE_MARKER_MAIN)
+		_exit(1);
+	_exit(0);
+}
+
+/* Checks GS under ptrace: registers, debug points, single steps. */
+static void
+gsbase_test_ptrace(
+	void)
+{
+	struct ptrace_debug_points points;
+	struct reg registers;
+	pid_t child;
+	int status;
+	int error;
+	int step;
+
+	/* Starts the child that the rest of the test traces. */
+	child = fork();
+	if (child < 0) {
+		gsbase_report("ptrace", 0, "fork failed");
+		return;
+	}
+
+	if (child == 0)
+		gsbase_traced_child();
+
+	/* Waits for the child's own stop. */
+	waitpid(child, &status, 0);
+	if (!WIFSTOPPED(status)) {
+		gsbase_report("ptrace", 0, "the child did not stop");
+		return;
+	}
+
+	/* The tracer sees the child's GS base among its registers. */
+	error = ptrace(PT_GETREGS, child, &registers, 0);
+	gsbase_report("ptrace-getregs", error == 0 && registers.r_gs_base == (uint64_t)(uintptr_t)&gsbase_main_block, "PT_GETREGS did not report the GS base");
+
+	/* A kernel address is refused as a GS base by PT_SETREGS. */
+	registers.r_gs_base = GSBASE_KERNEL_ADDRESS;
+	error = ptrace(PT_SETREGS, child, &registers, 0);
+	gsbase_report("ptrace-setregs-reject", error == -1, "PT_SETREGS accepted a kernel GS base");
+
+	/* A debug point on a kernel address is refused. */
+	memset(&points, 0, sizeof(points));
+	points.pdps_count = 1;
+	points.pdps_point[0].pdp_address = (uintptr_t)GSBASE_KERNEL_ADDRESS;
+	points.pdps_point[0].pdp_length = 8;
+	points.pdps_point[0].pdp_kind = PTRACE_DEBUG_WRITE;
+	error = ptrace(PT_SET_DEBUG_POINTS, child, &points, 0);
+	gsbase_report("debug-point-kernel-reject", error == -1, "a kernel debug point was accepted");
+
+	/* A write point on the child's scratch word is accepted. */
+	points.pdps_point[0].pdp_address = (uintptr_t)&gsbase_main_block.scratch;
+	error = ptrace(PT_SET_DEBUG_POINTS, child, &points, 0);
+	gsbase_report("debug-point-user", error == 0, "a user debug point was refused");
+
+	/* Runs the child into the watchpoint (a #DB from ring three). */
+	ptrace(PT_CONTINUE, child, (void *)1, 0);
+	waitpid(child, &status, 0);
+	gsbase_report("watchpoint-stop", WIFSTOPPED(status) && WSTOPSIG(status) == SIGTRAP, "the watchpoint did not stop the child");
+
+	/* Clears the point and single-steps (more #DB from ring three). */
+	points.pdps_count = 0;
+	ptrace(PT_SET_DEBUG_POINTS, child, &points, 0);
+	for (step = 0; step < GSBASE_STEP_COUNT; step++) {
+		ptrace(PT_STEP, child, (void *)1, 0);
+		waitpid(child, &status, 0);
+		if (!WIFSTOPPED(status))
+			break;
+	}
+
+	/* Lets the child finish and judge its GS. */
+	ptrace(PT_CONTINUE, child, (void *)1, 0);
+	waitpid(child, &status, 0);
+	gsbase_report("ptrace-child", WIFEXITED(status) && WEXITSTATUS(status) == 0, "the child's GS did not survive the debug exceptions");
+}
