+/*
+ * Reports whether the firmware forbids the operating system to enable
+ * PCI Express ASPM (the FADT's boot architecture flag PCIe ASPM
+ * Controls).  Returns 1 or 0; a FADT too short for the flags forbids
+ * nothing.
+ */
+int
+drv_acpi_pcie_aspm_forbidden(void)
+{
+	const uint8_t *fadt;
+	uint32_t flags;
+
+	/* A FADT long enough to have the boot architecture flags. */
+	fadt = firmware.fadt;
+	if (fadt == NULL || firmware.fadt_length < FADT_BOOT_ARCH_OFFSET + 2U)
+		return 0;
+
+	/* The flags, little-endian. */
+	flags = (uint32_t)fadt[FADT_BOOT_ARCH_OFFSET];
+	flags |= (uint32_t)fadt[FADT_BOOT_ARCH_OFFSET + 1U] << 8;
+
+	/* The bit that forbids ASPM. */
+	if ((flags & FADT_BOOT_ARCH_NO_ASPM) == 0U)
+		return 0;
+
+	/* Succeeded: the firmware keeps ASPM to itself. */
+	return 1;
+}
