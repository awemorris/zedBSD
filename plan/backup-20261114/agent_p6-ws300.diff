+/*
+ * Gives the controller its table of autonomous power state transitions,
+ * after a probe, a recovery or a resume reset it.
+ *
+ * It runs only when the boot line asks for it (NVME_TOKEN_APST_ON).  The
+ * table sends an idle controller into its non-operational states
+ * (drv_nvme_apst_build()); a controller with nowhere to go is told to
+ * make none.  A failure is logged and the controller runs on without: the
+ * transitions save power and do not change what a request does.  report
+ * logs the power states and the table once, at the probe.
+ */
+static void
+nvme_apst_apply(
+	struct nvme_controller *controller,
+	int recovery_command,
+	int report)
+{
+	struct drv_nvme_apst_summary summary;
+	struct drv_nvme_command command;
+	const char *line;
+	int enable;
+	int built;
+	int wanted;
+	int error;
+
+	/* Leaves the controller as its firmware set it unless the boot line asks for the table. */
+	wanted = 0;
+	line = kern_boot_handoff("boot.command-line");
+	if (line != NULL)
+		wanted = kern_boot_parameters_token_present(line, NVME_TOKEN_APST_ON);
+	if (!wanted)
+		return;
+
+	/* A controller without the feature, or without the page, keeps whatever it does. */
+	if (!controller->power_profile.apst_supported || controller->apst_dma.address == NULL)
+		return;
+
+	/* Builds the table; a controller with nowhere to go is told to make no move. */
+	error = drv_nvme_apst_build(&controller->power_profile, DRV_NVME_APST_LATENCY_LIMIT_US, controller->apst_dma.address, controller->apst_dma.size, &summary);
+	enable = 0;
+	if (error == 0 && summary.transitions != 0)
+		enable = 1;
+
+	/* Builds the command over the table. */
+	built = drv_nvme_apst_command(&command, 0, enable, controller->apst_dma.device_address);
+	if (!built)
+		return;
+	kern_io_write_barrier();
+
+	/* Sends it; a refusal leaves the controller as it was. */
+	error = nvme_admin_execute_mode(controller, &command, NULL, recovery_command);
+	if (error != 0) {
+		kern_logf("nvme: autonomous power state transitions not set (%d)\n", error);
+		return;
+	}
+
+	/* Reports the states and the table once. */
+	if (report)
+		nvme_power_log(controller, &summary, enable);
+}
+
+/* Logs the non-operational power states and the moves the table makes. */
+static void
+nvme_power_log(
+	const struct nvme_controller *controller,
+	const struct drv_nvme_apst_summary *summary,
+	int enabled)
+{
+	const struct drv_nvme_power_state *state;
+	unsigned index;
+
+	/* One line for the controller. */
+	kern_logf("nvme: %u power states, autonomous transitions %s\n", controller->power_profile.count, enabled ? "on" : "off");
+
+	/* One line for each non-operational state: its power and its latencies. */
+	for (index = 0; index < controller->power_profile.count; index++) {
+		state = &controller->power_profile.states[index];
+		if (!state->non_operational)
+			continue;
+		kern_logf("nvme: ps%u non-operational %u.%04u W entry %u us exit %u us\n",
+			  index,
+			  state->max_power_tenth_mw / 10000U,
+			  state->max_power_tenth_mw % 10000U,
+			  state->entry_latency_us,
+			  state->exit_latency_us);
+	}
+
+	/* Nothing more when the table moves nowhere. */
+	if (!enabled)
+		return;
+
+	/* One line for each move: from which state, to which, after how long. */
+	for (index = 0; index < controller->power_profile.count; index++) {
+		if (summary->target[index] == index)
+			continue;
+		kern_logf("nvme: ps%u to ps%u after %u ms idle\n", index, (unsigned)summary->target[index], summary->idle_ms[index]);
+	}
+}
+
+/*
+ * Has the controller stop using its Host Memory Buffer before it is shut
+ * down, keeping the memory for the Memory Return of nvme_hmb_reenable().
+ *
+ * A controller that refuses goes on with the buffer, which the shutdown
+ * and the disable after it end; that is no failure.  A command that goes
+ * unanswered reports ETIMEDOUT and leaves the buffer unknown, so that the
+ * memory is held until the controller is reset.
+ *
+ * Procedure referenced: NVM Express Base Specification 2.0e, section 8.9
+ * (the host disables the Host Memory Buffer before a shutdown);
+ * FreeBSD 15.0 sys/dev/nvme/nvme_ctrlr.c (the suspend disables the buffer
+ * before the shutdown).
+ */
+static int
+nvme_hmb_disable(
+	struct nvme_controller *controller)
+{
+	struct drv_nvme_command command;
+	int built;
+	int error;
+
+	/* A controller that does not use a buffer has nothing to give back. */
+	if (controller->hmb_state != NVME_HMB_ENABLED)
+		return 0;
+
+	/* Builds the command with the enable clear. */
+	built = drv_nvme_set_hmb_command(&command, 0, 0, 0, 0, 0, 0);
+	if (!built)
+		return EINVAL;
+	kern_io_write_barrier();
+
+	/* Sends it; an answered refusal leaves the buffer as it was. */
+	error = nvme_admin_execute(controller, &command, NULL);
+	if (error == ETIMEDOUT) {
+		controller->hmb_state = NVME_HMB_UNKNOWN;
+		kern_logf("nvme: host memory buffer disable timed out\n");
+		return ETIMEDOUT;
+	}
+	if (error != 0) {
+		kern_logf("nvme: host memory buffer disable refused (%d); shutting down with it\n", error);
+		return 0;
+	}
+
+	/* The controller no longer uses the buffer; the memory stays for the resume. */
+	controller->hmb_state = NVME_HMB_READY;
+
+	/* Succeeded: the buffer is the host's again. */
+	return 0;
+}
