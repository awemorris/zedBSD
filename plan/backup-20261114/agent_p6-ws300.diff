diff --git a/src/drivers/pci/pci-link-plan.c b/src/drivers/pci/pci-link-plan.c
new file mode 100644
index 0000000000..9ae3f94075
--- /dev/null
+++ b/src/drivers/pci/pci-link-plan.c
@@ -0,0 +1,402 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The hardware-free half of a PCI Express link's power management.
+ *
+ * It decides, from what the port above a link and the function below it
+ * report, which of ASPM L1, the L1 PM Substates and LTR the link may use,
+ * and the values the substates need.  It reads and writes no register, so
+ * a host test compiles this file as it is.
+ */
+
+#include <drivers/pci/pci-link-plan.h>
+#include <uapi/errno.h>
+
+#include <stddef.h>
+
+/*
+ * The upper bound, in microseconds, of each L1 exit latency code of the
+ * Link Capabilities register and of each acceptable latency code of the
+ * Device Capabilities register; code 7 is "more than 64" in the first and
+ * "no limit" in the second, which LATENCY_UNBOUNDED stands for.
+ *
+ * Values referenced: PCI Express Base Specification Revision 4.0, sections
+ * 7.5.3.3 (Endpoint L1 Acceptable Latency) and 7.5.3.6 (L1 Exit Latency).
+ */
+#define LATENCY_CODE_UNBOUNDED	7U
+#define LATENCY_UNBOUNDED	0xffffffffU
+
+/*
+ * The time a link needs beyond the common-mode restore time and the
+ * power-on time before L1.2 is worth entering, in microseconds; the LTR
+ * threshold is their sum.
+ *
+ * Value referenced: Linux 6.12 drivers/pci/pcie/aspm.c (the 2 us and 4 us
+ * terms of the L1.2 threshold), which gives the threshold the 5330's
+ * firmware-free link is left with under Debian (616448 ns for 110 us and
+ * 500 us).
+ */
+#define THRESHOLD_MARGIN_US	6U
+
+/* The largest value the 10-bit LTR threshold field holds. */
+#define THRESHOLD_VALUE_MAX	1023U
+
+/* The number of LTR threshold scales: 1, 32, 1024, 32768, 1048576 and 33554432 ns. */
+#define THRESHOLD_SCALES	6U
+
+/* Each scale is 32 times the one before it. */
+#define THRESHOLD_SCALE_STEP	32U
+
+/*
+ * The microseconds of each T_POWER_ON scale code: 2, 10 and 100; code 3 is
+ * reserved.
+ *
+ * Values referenced: PCI Express Base Specification Revision 4.0, section
+ * 7.8.3.2 (Port T_POWER_ON Scale).
+ */
+#define POWER_ON_SCALE_2US	0U
+#define POWER_ON_SCALE_10US	1U
+#define POWER_ON_SCALE_100US	2U
+
+static uint32_t latency_bound(uint32_t code);
+static void plan_aspm(const struct drv_pci_link_end *port, const struct drv_pci_link_end *function, struct drv_pci_link_plan *plan);
+static void plan_ltr(const struct drv_pci_link_end *port, const struct drv_pci_link_end *function, struct drv_pci_link_plan *plan);
+static int plan_l1ss(const struct drv_pci_link_end *port, const struct drv_pci_link_end *function, struct drv_pci_link_plan *plan);
+static uint32_t end_power_on_us(const struct drv_pci_link_end *end);
+
+/*
+ * Decides what a link may use and the values its substates need.
+ *
+ * port is the end above the link (a root port or a switch's downstream
+ * port), function the end below it.  It reports EINVAL for a missing
+ * argument and ERANGE when the LTR threshold cannot be encoded; the plan
+ * then enables nothing.
+ */
+int
+drv_pci_link_plan_make(
+	const struct drv_pci_link_end *port,
+	const struct drv_pci_link_end *function,
+	struct drv_pci_link_plan *plan)
+{
+	int error;
+
+	/* Refuses a missing end or nowhere to write the plan. */
+	if (port == NULL || function == NULL || plan == NULL)
+		return EINVAL;
+
+	/* Starts from a plan that enables nothing. */
+	plan->aspm_l1 = 0;
+	plan->ltr = 0;
+	plan->ltr_latency_write = 0;
+	plan->ltr_latency = 0;
+	plan->l1ss_enable = 0;
+	plan->port_control1 = 0;
+	plan->function_control1 = 0;
+	plan->control2 = 0;
+	plan->threshold_ns = 0;
+	plan->aspm_reasons = 0;
+
+	/* Decides ASPM L1, which the ASPM substates depend on. */
+	plan_aspm(port, function, plan);
+
+	/* Decides LTR, which ASPM L1.2 depends on. */
+	plan_ltr(port, function, plan);
+
+	/* Decides the substates and their values. */
+	error = plan_l1ss(port, function, plan);
+	if (error != 0) {
+		/* A threshold that cannot be encoded leaves the substates off. */
+		plan->l1ss_enable = 0;
+		plan->port_control1 = 0;
+		plan->function_control1 = 0;
+		plan->control2 = 0;
+		plan->threshold_ns = 0;
+		return error;
+	}
+
+	/* Succeeded: the plan says what the link may use. */
+	return 0;
+}
+
+/*
+ * Encodes an LTR threshold in the fields of L1 PM Substates Control 1.
+ *
+ * It picks the finest scale whose value fits ten bits, rounding up, so
+ * the encoded threshold is never below the one asked for; field receives
+ * the value and the scale in place, encoded_nanoseconds what they stand
+ * for.  It reports ERANGE for a threshold beyond the largest scale.
+ */
+int
+drv_pci_link_threshold_encode(
+	uint32_t nanoseconds,
+	uint32_t *field,
+	uint32_t *encoded_nanoseconds)
+{
+	uint64_t unit;
+	uint64_t value;
+	uint32_t scale;
+
+	/* Refuses nowhere to write. */
+	if (field == NULL || encoded_nanoseconds == NULL)
+		return EINVAL;
+
+	/* Tries each scale from the finest, until the value fits. */
+	unit = 1U;
+	for (scale = 0; scale < THRESHOLD_SCALES; scale++) {
+		/* Rounds the threshold up to whole units of this scale. */
+		value = ((uint64_t)nanoseconds + unit - 1U) / unit;
+		if (value <= THRESHOLD_VALUE_MAX)
+			break;
+
+		/* The next scale is 32 times coarser. */
+		unit *= THRESHOLD_SCALE_STEP;
+	}
+
+	/* Refuses a threshold no scale holds. */
+	if (scale == THRESHOLD_SCALES)
+		return ERANGE;
+
+	/* Refuses a threshold whose encoding overflows what the caller is told. */
+	if (value * unit > 0xffffffffU)
+		return ERANGE;
+
+	/* Places the value and the scale where Control 1 holds them. */
+	*field = ((uint32_t)value << DRV_PCI_LINK_L1SS_THRESHOLD_VALUE_SHIFT) |
+	    (scale << DRV_PCI_LINK_L1SS_THRESHOLD_SCALE_SHIFT);
+	*encoded_nanoseconds = (uint32_t)(value * unit);
+
+	/* Succeeded: the threshold is encoded. */
+	return 0;
+}
+
+/*
+ * Reports the microseconds a T_POWER_ON scale code and value stand for;
+ * the reserved scale code stands for none.
+ */
+uint32_t
+drv_pci_link_power_on_us(
+	uint32_t scale,
+	uint32_t value)
+{
+	/* Multiplies the value by the scale's unit. */
+	switch (scale) {
+	case POWER_ON_SCALE_2US:
+		return value * 2U;
+	case POWER_ON_SCALE_10US:
+		return value * 10U;
+	case POWER_ON_SCALE_100US:
+		return value * 100U;
+	default:
+		break;
+	}
+
+	/* The reserved scale: no time the plan can use. */
+	return 0;
+}
+
+/* Reports the upper bound in microseconds of a latency code. */
+static uint32_t
+latency_bound(
+	uint32_t code)
+{
+	/* The last code has no bound. */
+	if (code >= LATENCY_CODE_UNBOUNDED)
+		return LATENCY_UNBOUNDED;
+
+	/* Code n stands for less than 2 to the n microseconds. */
+	return 1U << code;
+}
+
+/*
+ * Decides ASPM L1: both ends must support it and share a common clock,
+ * and the slower end's exit must be within what the function accepts.
+ */
+static void
+plan_aspm(
+	const struct drv_pci_link_end *port,
+	const struct drv_pci_link_end *function,
+	struct drv_pci_link_plan *plan)
+{
+	uint32_t port_exit;
+	uint32_t function_exit;
+	uint32_t exit_code;
+	uint32_t accepted_code;
+	uint32_t exit_bound;
+	uint32_t accepted_bound;
+
+	/*
+	 * A link without a common clock reports exit latencies for a separate
+	 * clock that this plan does not reconfigure, so it is left alone.
+	 */
+	if ((port->link_control & DRV_PCI_LINK_LNKCTL_COMMON_CLOCK) == 0)
+		plan->aspm_reasons |= DRV_PCI_LINK_NO_COMMON_CLOCK;
+	else if ((function->link_control & DRV_PCI_LINK_LNKCTL_COMMON_CLOCK) == 0)
+		plan->aspm_reasons |= DRV_PCI_LINK_NO_COMMON_CLOCK;
+
+	/* Both ends must support L1. */
+	if ((port->link_capabilities & DRV_PCI_LINK_LNKCAP_ASPM_L1) == 0)
+		plan->aspm_reasons |= DRV_PCI_LINK_NO_L1;
+	else if ((function->link_capabilities & DRV_PCI_LINK_LNKCAP_ASPM_L1) == 0)
+		plan->aspm_reasons |= DRV_PCI_LINK_NO_L1;
+
+	/* Takes the slower of the two ends' exits. */
+	port_exit = (port->link_capabilities >> DRV_PCI_LINK_LNKCAP_L1_EXIT_SHIFT) & DRV_PCI_LINK_LNKCAP_L1_EXIT_MASK;
+	function_exit = (function->link_capabilities >> DRV_PCI_LINK_LNKCAP_L1_EXIT_SHIFT) & DRV_PCI_LINK_LNKCAP_L1_EXIT_MASK;
+	exit_code = port_exit;
+	if (function_exit > exit_code)
+		exit_code = function_exit;
+
+	/* Compares it with what the function accepts; "no limit" accepts any. */
+	accepted_code = (function->device_capabilities >> DRV_PCI_LINK_DEVCAP_L1_ACCEPTABLE_SHIFT) & DRV_PCI_LINK_DEVCAP_L1_ACCEPTABLE_MASK;
+	exit_bound = latency_bound(exit_code);
+	accepted_bound = latency_bound(accepted_code);
+	if (accepted_bound != LATENCY_UNBOUNDED && exit_bound > accepted_bound)
+		plan->aspm_reasons |= DRV_PCI_LINK_L1_TOO_SLOW;
+
+	/* L1 is enabled when nothing stood against it. */
+	if (plan->aspm_reasons == 0)
+		plan->aspm_l1 = 1;
+}
+
+/*
+ * Decides LTR: both ends must support it.  A function that reports no
+ * maximum latency at all is given one, since a zero maximum would hold
+ * its reports at zero and keep the platform out of its deep states.
+ */
+static void
+plan_ltr(
+	const struct drv_pci_link_end *port,
+	const struct drv_pci_link_end *function,
+	struct drv_pci_link_plan *plan)
+{
+	/* Leaves LTR off unless both ends support it. */
+	if ((port->device_capabilities2 & DRV_PCI_LINK_DEVCAP2_LTR) == 0)
+		return;
+	if ((function->device_capabilities2 & DRV_PCI_LINK_DEVCAP2_LTR) == 0)
+		return;
+
+	/* ltr makes the driver set the enable at the port, then at the function. */
+	plan->ltr = 1;
+
+	/* Gives a function with the capability but no latency the default one. */
+	if (function->has_ltr &&
+	    function->ltr_max_snoop == 0 &&
+	    function->ltr_max_no_snoop == 0) {
+		plan->ltr_latency_write = 1;
+		plan->ltr_latency = DRV_PCI_LINK_LTR_DEFAULT_LATENCY;
+	}
+}
+
+/*
+ * Decides the L1 PM Substates: the enables both ends support, the ASPM
+ * ones only with ASPM L1 and ASPM L1.2 only with LTR, and the common-mode
+ * restore time, the power-on time and the LTR threshold.
+ */
+static int
+plan_l1ss(
+	const struct drv_pci_link_end *port,
+	const struct drv_pci_link_end *function,
+	struct drv_pci_link_plan *plan)
+{
+	const struct drv_pci_link_end *slower;
+	uint32_t enable;
+	uint32_t port_restore;
+	uint32_t function_restore;
+	uint32_t restore;
+	uint32_t port_power_on;
+	uint32_t function_power_on;
+	uint32_t power_on;
+	uint32_t scale;
+	uint32_t value;
+	uint32_t threshold_field;
+	uint32_t threshold_ns;
+	int error;
+
+	/* Leaves the substates off unless both ends have them. */
+	if (!port->has_l1ss || !function->has_l1ss)
+		return 0;
+	if ((port->l1ss_capabilities & DRV_PCI_LINK_L1SS_SUPPORTED) == 0)
+		return 0;
+	if ((function->l1ss_capabilities & DRV_PCI_LINK_L1SS_SUPPORTED) == 0)
+		return 0;
+
+	/* Takes the substates both ends support. */
+	enable = port->l1ss_capabilities & function->l1ss_capabilities & DRV_PCI_LINK_L1SS_ENABLE_MASK;
+
+	/* The ASPM substates are substates of ASPM L1. */
+	if (!plan->aspm_l1)
+		enable &= ~(DRV_PCI_LINK_L1SS_ASPM_L12 | DRV_PCI_LINK_L1SS_ASPM_L11);
+
+	/* ASPM L1.2 is entered on the reported latency, so it needs LTR. */
+	if (!plan->ltr)
+		enable &= ~DRV_PCI_LINK_L1SS_ASPM_L12;
+
+	/* Nothing left to enable needs no values. */
+	if (enable == 0)
+		return 0;
+
+	/* Takes the longer of the two common-mode restore times. */
+	port_restore = (port->l1ss_capabilities >> DRV_PCI_LINK_L1SS_CMRT_SHIFT) & DRV_PCI_LINK_L1SS_CMRT_MASK;
+	function_restore = (function->l1ss_capabilities >> DRV_PCI_LINK_L1SS_CMRT_SHIFT) & DRV_PCI_LINK_L1SS_CMRT_MASK;
+	restore = port_restore;
+	if (function_restore > restore)
+		restore = function_restore;
+
+	/* Takes the longer of the two power-on times, in the scale of the end that has it. */
+	port_power_on = end_power_on_us(port);
+	function_power_on = end_power_on_us(function);
+
+	/*
+	 * An end that reports a reserved scale, or no time at all (as a
+	 * register read back as all ones does), cannot be timed: the
+	 * substates stay off.
+	 */
+	if (port_power_on == 0 || function_power_on == 0)
+		return 0;
+	slower = port;
+	power_on = port_power_on;
+	if (function_power_on > power_on) {
+		slower = function;
+		power_on = function_power_on;
+	}
+	scale = (slower->l1ss_capabilities >> DRV_PCI_LINK_L1SS_POWER_ON_SCALE_SHIFT) & DRV_PCI_LINK_L1SS_POWER_ON_SCALE_MASK;
+	value = (slower->l1ss_capabilities >> DRV_PCI_LINK_L1SS_POWER_ON_VALUE_SHIFT) & DRV_PCI_LINK_L1SS_POWER_ON_VALUE_MASK;
+
+	/* Encodes the threshold the link enters L1.2 above. */
+	threshold_ns = (restore + power_on + THRESHOLD_MARGIN_US) * 1000U;
+	error = drv_pci_link_threshold_encode(threshold_ns, &threshold_field, &plan->threshold_ns);
+	if (error != 0)
+		return error;
+
+	/* Publishes the enables and the values for both ends. */
+	plan->l1ss_enable = enable;
+	plan->control2 = scale | (value << DRV_PCI_LINK_L1SS_CONTROL2_VALUE_SHIFT);
+	plan->port_control1 = threshold_field | (restore << DRV_PCI_LINK_L1SS_CMRT_SHIFT);
+	plan->function_control1 = threshold_field;
+
+	/* Succeeded: the substates have their values. */
+	return 0;
+}
+
+/* Reports the power-on time an end needs, in microseconds. */
+static uint32_t
+end_power_on_us(
+	const struct drv_pci_link_end *end)
+{
+	uint32_t scale;
+	uint32_t value;
+	uint32_t microseconds;
+
+	/* Reads the scale and the value and multiplies them. */
+	scale = (end->l1ss_capabilities >> DRV_PCI_LINK_L1SS_POWER_ON_SCALE_SHIFT) & DRV_PCI_LINK_L1SS_POWER_ON_SCALE_MASK;
+	value = (end->l1ss_capabilities >> DRV_PCI_LINK_L1SS_POWER_ON_VALUE_SHIFT) & DRV_PCI_LINK_L1SS_POWER_ON_VALUE_MASK;
+	microseconds = drv_pci_link_power_on_us(scale, value);
+
+	/* Reports the time. */
+	return microseconds;
+}
diff --git a/src/drivers/pci/pci-nvme-power.c b/src/drivers/pci/pci-nvme-power.c
new file mode 100644
index 0000000000..aed8295e47
--- /dev/null
+++ b/src/drivers/pci/pci-nvme-power.c
@@ -0,0 +1,333 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The hardware-free half of an NVMe controller's power states.
+ *
+ * It reads the power state descriptors a controller reports, decides
+ * which non-operational states an idle controller may fall into on its
+ * own and after how long, and builds the table and the command that tell
+ * the controller so.  It reads and writes no register, so a host test
+ * compiles this file as it is.
+ */
+
+#include <drivers/pci/pci-nvme-power.h>
+#include <uapi/errno.h>
+
+#include <stddef.h>
+
+/*
+ * Where Identify Controller keeps the number of power states (0-based),
+ * the Autonomous Power State Transition attributes and the first power
+ * state descriptor, and the size of a descriptor.
+ *
+ * Values referenced: NVM Express Base Specification 2.0e, Figure 280
+ * (NPSS at byte 263, APSTA at byte 265 bit 0, the power state descriptors
+ * from byte 2048).
+ */
+#define IDENTIFY_NPSS			263U
+#define IDENTIFY_APSTA			265U
+#define IDENTIFY_APSTA_SUPPORTED	0x01U
+#define IDENTIFY_PSD_FIRST		2048U
+#define IDENTIFY_PSD_BYTES		32U
+
+/*
+ * The fields of a power state descriptor: the maximum power (bytes 1:0),
+ * the byte holding the Max Power Scale (bit 0: the power counts 0.0001 W
+ * rather than 0.01 W) and Non-Operational State (bit 1), and the entry and
+ * exit latencies in microseconds.
+ *
+ * Values referenced: NVM Express Base Specification 2.0e, Figure 281
+ * (Power State Descriptor Data Structure: MP, MXPS, NOPS, ENLAT, EXLAT).
+ */
+#define PSD_MAX_POWER			0U
+#define PSD_FLAGS			3U
+#define PSD_FLAG_MAX_POWER_SCALE	0x01U
+#define PSD_FLAG_NON_OPERATIONAL	0x02U
+#define PSD_ENTRY_LATENCY		4U
+#define PSD_EXIT_LATENCY		8U
+
+/* How many 0.0001 W one unit of the coarse maximum power, 0.01 W, is. */
+#define POWER_COARSE_UNIT		100U
+
+/*
+ * The fields of a table entry: the state to move to (bits 7:3) and the
+ * idle time before the move, in milliseconds (bits 31:8).
+ *
+ * Values referenced: NVM Express Base Specification 2.0e, Figure 334
+ * (Autonomous Power State Transition Data Structure: ITPS, ITPT).
+ */
+#define APST_TARGET_SHIFT		3U
+#define APST_IDLE_SHIFT			8U
+
+/*
+ * How long a controller stays idle before moving to a state, in two
+ * steps: 100 milliseconds into a state it enters and leaves within 15
+ * milliseconds, and 2000 milliseconds into a slower one.  These are the
+ * values the 5330's Debian runs its KIOXIA BG5 with (PS3 after 100 ms,
+ * PS4 after 2000 ms).
+ *
+ * Values referenced: Linux 6.19 drivers/nvme/host/core.c (the module
+ * parameters apst_primary_timeout_ms 100, apst_secondary_timeout_ms 2000
+ * and apst_primary_latency_tol_us 15000, as the 5330's Debian reports
+ * them under /sys/module/nvme_core/parameters).
+ */
+#define APST_PRIMARY_IDLE_MS		100U
+#define APST_SECONDARY_IDLE_MS		2000U
+#define APST_PRIMARY_LATENCY_US		15000U
+
+static int state_usable(const struct drv_nvme_power_state *state, const struct drv_nvme_power_state *from, uint32_t latency_limit_us);
+static uint32_t state_idle_ms(const struct drv_nvme_power_state *state);
+static void store_le64(uint8_t *bytes, uint64_t value);
+
+/*
+ * Reads the power states and the Autonomous Power State Transition
+ * support from an Identify Controller page.
+ *
+ * It reports EINVAL for a missing argument and a page too short for the
+ * descriptors it announces.
+ */
+int
+drv_nvme_power_parse(
+	const uint8_t *identify,
+	size_t size,
+	struct drv_nvme_power_profile *profile)
+{
+	const uint8_t *descriptor;
+	struct drv_nvme_power_state *state;
+	unsigned count;
+	unsigned index;
+	uint32_t max_power;
+
+	/* Refuses a missing page or nowhere to write. */
+	if (identify == NULL || profile == NULL)
+		return EINVAL;
+
+	/* Refuses a page without the fields before the descriptors. */
+	if (size <= IDENTIFY_APSTA)
+		return EINVAL;
+
+	/* Counts the states: NPSS is the number of the last one. */
+	count = (unsigned)identify[IDENTIFY_NPSS] + 1U;
+	if (count > DRV_NVME_POWER_STATES_MAX)
+		count = DRV_NVME_POWER_STATES_MAX;
+
+	/* Refuses a page that ends before the last descriptor. */
+	if (size < IDENTIFY_PSD_FIRST + (size_t)count * IDENTIFY_PSD_BYTES)
+		return EINVAL;
+
+	/* Starts with nothing known. */
+	profile->count = count;
+	profile->apst_supported = 0;
+	if ((identify[IDENTIFY_APSTA] & IDENTIFY_APSTA_SUPPORTED) != 0)
+		profile->apst_supported = 1;
+
+	/* Reads each descriptor. */
+	for (index = 0; index < DRV_NVME_POWER_STATES_MAX; index++) {
+		/* A state past the last one stays empty. */
+		state = &profile->states[index];
+		state->max_power_tenth_mw = 0;
+		state->non_operational = 0;
+		state->entry_latency_us = 0;
+		state->exit_latency_us = 0;
+		if (index >= count)
+			continue;
+
+		/* Reads the maximum power in 0.0001 W, whichever scale the descriptor uses. */
+		descriptor = identify + IDENTIFY_PSD_FIRST + (size_t)index * IDENTIFY_PSD_BYTES;
+		max_power = drv_nvme_load_le16(descriptor + PSD_MAX_POWER);
+		if ((descriptor[PSD_FLAGS] & PSD_FLAG_MAX_POWER_SCALE) == 0)
+			max_power *= POWER_COARSE_UNIT;
+		state->max_power_tenth_mw = max_power;
+
+		/* A non-operational state processes no I/O; an I/O sends the controller back. */
+		if ((descriptor[PSD_FLAGS] & PSD_FLAG_NON_OPERATIONAL) != 0)
+			state->non_operational = 1;
+
+		/* Reads the times to enter and to leave the state. */
+		state->entry_latency_us = drv_nvme_load_le32(descriptor + PSD_ENTRY_LATENCY);
+		state->exit_latency_us = drv_nvme_load_le32(descriptor + PSD_EXIT_LATENCY);
+	}
+
+	/* Succeeded: the profile holds the controller's states. */
+	return 0;
+}
+
+/*
+ * Builds the table of Autonomous Power State Transition.
+ *
+ * Each state moves, after its idle time, to the first state numbered
+ * above it that is non-operational, reports its latencies, takes no more
+ * than latency_limit_us to enter and leave, and draws no more power;
+ * table (at least DRV_NVME_APST_TABLE_BYTES) receives the entries and
+ * summary what they say.  It reports EINVAL for a missing argument and
+ * ENOTSUP for a controller without the feature.
+ */
+int
+drv_nvme_apst_build(
+	const struct drv_nvme_power_profile *profile,
+	uint32_t latency_limit_us,
+	uint8_t *table,
+	size_t size,
+	struct drv_nvme_apst_summary *summary)
+{
+	const struct drv_nvme_power_state *from;
+	const struct drv_nvme_power_state *target;
+	unsigned index;
+	unsigned byte;
+	unsigned candidate;
+	uint32_t idle_ms;
+	uint64_t entry;
+	int usable;
+
+	/* Refuses a missing argument and a table too small. */
+	if (profile == NULL || table == NULL || summary == NULL)
+		return EINVAL;
+	if (size < DRV_NVME_APST_TABLE_BYTES || profile->count > DRV_NVME_POWER_STATES_MAX)
+		return EINVAL;
+
+	/* Starts with every state staying where it is. */
+	for (byte = 0; byte < DRV_NVME_APST_TABLE_BYTES; byte++)
+		table[byte] = 0;
+	summary->transitions = 0;
+	for (index = 0; index < DRV_NVME_POWER_STATES_MAX; index++) {
+		summary->target[index] = (uint8_t)index;
+		summary->idle_ms[index] = 0;
+	}
+
+	/* Refuses a controller that does not move on its own. */
+	if (!profile->apst_supported)
+		return ENOTSUP;
+
+	/* Gives each state the first deeper state it may move to. */
+	for (index = 0; index < profile->count; index++) {
+		/* Looks for the target above the state. */
+		from = &profile->states[index];
+		target = NULL;
+		for (candidate = index + 1U; candidate < profile->count; candidate++) {
+			/* Takes the first state the move may go to. */
+			usable = state_usable(&profile->states[candidate], from, latency_limit_us);
+			if (usable) {
+				target = &profile->states[candidate];
+				break;
+			}
+		}
+
+		/* A state with nowhere to go keeps an empty entry. */
+		if (target == NULL)
+			continue;
+
+		/* Writes the entry: the target and the idle time before the move. */
+		idle_ms = state_idle_ms(target);
+		entry = ((uint64_t)candidate << APST_TARGET_SHIFT) | ((uint64_t)idle_ms << APST_IDLE_SHIFT);
+		store_le64(table + (size_t)index * DRV_NVME_APST_ENTRY_BYTES, entry);
+
+		/* Records the move for the log. */
+		summary->target[index] = (uint8_t)candidate;
+		summary->idle_ms[index] = idle_ms;
+		summary->transitions++;
+	}
+
+	/* Succeeded: the table holds every move the controller may make. */
+	return 0;
+}
+
+/*
+ * Builds the Set Features command that gives the controller the table at
+ * table and enables or disables its transitions.
+ *
+ * The table is transferred in both cases.  It reports false for a missing
+ * command or a table without an address.
+ */
+int
+drv_nvme_apst_command(
+	struct drv_nvme_command *command,
+	uint16_t command_id,
+	int enable,
+	uint64_t table)
+{
+	/* Refuses nowhere to build and no table to point at. */
+	if (command == NULL || table == 0)
+		return 0;
+
+	/* Builds the command over the table. */
+	drv_nvme_command_clear(command);
+	command->cdw0 = DRV_NVME_ADMIN_SET_FEATURES | ((uint32_t)command_id << 16);
+	command->prp1 = table;
+	command->cdw10 = DRV_NVME_FEATURE_APST;
+	command->cdw11 = 0;
+	if (enable)
+		command->cdw11 = DRV_NVME_APST_ENABLE;
+
+	/* Succeeded: the command is ready. */
+	return 1;
+}
+
+/*
+ * Reports whether a move from one state into another may be made: the
+ * target processes no I/O, reports how long the move takes, stays within
+ * the limit and draws no more power than the state left.
+ */
+static int
+state_usable(
+	const struct drv_nvme_power_state *state,
+	const struct drv_nvme_power_state *from,
+	uint32_t latency_limit_us)
+{
+	uint64_t latency;
+
+	/* Only a non-operational state is a target. */
+	if (!state->non_operational)
+		return 0;
+
+	/* A state whose latencies are not reported cannot be weighed. */
+	if (state->entry_latency_us == 0)
+		return 0;
+	if (state->exit_latency_us == 0)
+		return 0;
+
+	/* A state slower than the limit to enter and leave is not used. */
+	latency = (uint64_t)state->entry_latency_us + state->exit_latency_us;
+	if (latency > latency_limit_us)
+		return 0;
+
+	/* A state that may draw more than the one left is no saving; an unreported power is no objection. */
+	if (from->max_power_tenth_mw != 0 && state->max_power_tenth_mw > from->max_power_tenth_mw)
+		return 0;
+
+	/* Reports a state the move may go to. */
+	return 1;
+}
+
+/* Reports how long a controller stays idle before moving into a state, in milliseconds. */
+static uint32_t
+state_idle_ms(
+	const struct drv_nvme_power_state *state)
+{
+	uint64_t latency_us;
+
+	/* A state quick to enter and leave is entered after the short idle time. */
+	latency_us = (uint64_t)state->entry_latency_us + state->exit_latency_us;
+	if (latency_us <= APST_PRIMARY_LATENCY_US)
+		return APST_PRIMARY_IDLE_MS;
+
+	/* A slower one after the long idle time. */
+	return APST_SECONDARY_IDLE_MS;
+}
+
+/* Stores a 64-bit value little-endian. */
+static void
+store_le64(
+	uint8_t *bytes,
+	uint64_t value)
+{
+	unsigned index;
+
+	/* Stores the bytes from the least significant. */
+	for (index = 0; index < 8U; index++)
+		bytes[index] = (uint8_t)(value >> (index * 8U));
+}
