+/*
+ * Waits, when the port was reset or its link is down, for the link to
+ * come up and then for the first function behind it to answer its
+ * configuration space (neither all ones nor the vendor 0001h of a
+ * function still starting).
+ *
+ * It reports ETIMEDOUT for a link or a function that did not come within
+ * the bound; a port that cannot report its link waits the link's whole
+ * bound.
+ */
+static int
+vmd_port_wait_ready(
+	struct vmd_port_power *port,
+	int reset)
+{
+	struct drv_pci_device *function;
+	struct drv_pci_bus *below;
+	uint64_t deadline;
+	uint16_t status;
+	uint16_t vendor;
+	int ready;
+	int wait;
+	int error;
+
+	/* A link the port reports down needs the wait as a reset does. */
+	wait = reset;
+	if (port->reports_link && port->pcie_offset != 0) {
+		status = 0;
+		(void)drv_pci_device_config_read16(port->device, port->pcie_offset + VMD_PCIE_LINK_STATUS, &status);
+		if ((status & VMD_PCIE_LINK_ACTIVE) == 0)
+			wait = 1;
+	}
+
+	/* A port whose link stayed up has nothing to wait for. */
+	if (!wait)
+		return 0;
+
+	/* Waits for the link. */
+	error = vmd_port_wait_link(port);
+	if (error != 0)
+		return error;
+
+	/* Finds the first function behind the port; without one there is nothing more to wait for. */
+	function = NULL;
+	below = drv_pci_device_subordinate_bus(port->device);
+	if (below != NULL)
+		(void)drv_pci_bus_foreach_device(below, vmd_first_function, &function);
+	if (function == NULL)
+		return 0;
+
+	/* Polls its vendor until it answers, or the bound passes. */
+	deadline = sched_ticks() + kern_ms_to_ticks(VMD_FUNCTION_READY_MS);
+	ready = 0;
+	while (!ready) {
+		/* Reads the vendor; a real one ends the wait. */
+		vendor = 0xffffU;
+		(void)drv_pci_device_config_read16(function, 0x00U, &vendor);
+		if (vendor != 0xffffU && vendor != VMD_VENDOR_STARTING) {
+			ready = 1;
+			break;
+		}
+
+		/* Gives up past the bound. */
+		if (sched_ticks() >= deadline)
+			break;
+
+		/* Lets the function start a while. */
+		kern_usleep_range(VMD_LINK_POLL_US, VMD_LINK_POLL_US);
+	}
+
+	/* Reports a function that did not answer. */
+	if (!ready)
+		return ETIMEDOUT;
+
+	/* Succeeded: the function behind the port answers. */
+	return 0;
+}
+
+/*
+ * Waits for a port's link to come up, then for the function behind it.
+ *
+ * It reports ETIMEDOUT for a link that did not come up within the bound;
+ * a port that cannot report its link waits the whole bound.
+ */
+static int
+vmd_port_wait_link(
+	struct vmd_port_power *port)
+{
+	uint64_t deadline;
+	uint16_t status;
+	int up;
+	int error;
+
+	/* A port that cannot report its link is given the whole bound. */
+	if (!port->reports_link || port->pcie_offset == 0) {
+		sched_sleep(sched_ticks() + kern_ms_to_ticks(VMD_LINK_UP_MS));
+		return 0;
+	}
+
+	/* Polls the link status until the data link layer is up, or the bound passes. */
+	deadline = sched_ticks() + kern_ms_to_ticks(VMD_LINK_UP_MS);
+	up = 0;
+	while (!up) {
+		/* Reads the status; a link that answers active ends the wait. */
+		status = 0;
+		error = drv_pci_device_config_read16(port->device, port->pcie_offset + VMD_PCIE_LINK_STATUS, &status);
+		if (error == 0 && (status & VMD_PCIE_LINK_ACTIVE) != 0) {
+			up = 1;
+			break;
+		}
+
+		/* Gives up past the bound. */
+		if (sched_ticks() >= deadline)
+			break;
+
+		/* Lets the link train a while. */
+		kern_usleep_range(VMD_LINK_POLL_US, VMD_LINK_POLL_US);
+	}
+
+	/* Reports a link that did not come up. */
+	if (!up)
+		return ETIMEDOUT;
+
+	/* Gives the function behind the link its time before a configuration request. */
+	sched_sleep(sched_ticks() + kern_ms_to_ticks(VMD_LINK_SETTLE_MS));
+
+	/* Succeeded: the function behind the port may be touched. */
+	return 0;
+}
