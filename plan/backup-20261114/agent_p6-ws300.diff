diff --git a/include/drivers/pci/pci-link-plan.h b/include/drivers/pci/pci-link-plan.h
new file mode 100644
index 0000000000..f7c5d14608
--- /dev/null
+++ b/include/drivers/pci/pci-link-plan.h
@@ -0,0 +1,178 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The hardware-free half of a PCI Express link's power management.
+ *
+ * From what the two ends of one link report -- the port above it and the
+ * function below it -- this decides whether the link may use ASPM L1, the
+ * L1 PM Substates and Latency Tolerance Reporting, and computes the values
+ * the substates need: the common-mode restore time, the power-on time and
+ * the LTR threshold that L1.2 is entered above.  It touches no hardware, so
+ * a host test compiles it as it is; the driver that owns the link reads the
+ * registers, asks for a plan and writes it in the order the link needs.
+ */
+
+#ifndef DRIVERS_PCI_PCI_LINK_PLAN_H
+#define DRIVERS_PCI_PCI_LINK_PLAN_H
+
+#include <stdint.h>
+
+/*
+ * The PCI Express capability's registers the plan reads and writes, as
+ * offsets from the capability, and the fields of each.
+ *
+ * Values referenced: PCI Express Base Specification Revision 4.0, sections
+ * 7.5.3.3 (Device Capabilities: Endpoint L1 Acceptable Latency), 7.5.3.6
+ * and 7.5.3.7 (Link Capabilities: ASPM Support, L1 Exit Latency, Data Link
+ * Layer Link Active Reporting Capable; Link Control: ASPM Control, Common
+ * Clock Configuration), 7.5.3.8 (Link Status: Data Link Layer Link Active),
+ * 7.5.3.15 and 7.5.3.16 (Device Capabilities 2 and Device Control 2: LTR
+ * Mechanism Supported and Enable); FreeBSD 15.0 sys/dev/pci/pcireg.h
+ * (PCIER_DEVICE_CAP, PCIER_LINK_CAP, PCIER_LINK_CTL, PCIEM_CTL2_LTR_ENABLE).
+ */
+#define DRV_PCI_LINK_DEVICE_CAPABILITIES	0x04U
+#define DRV_PCI_LINK_LINK_CAPABILITIES		0x0cU
+#define DRV_PCI_LINK_LINK_CONTROL		0x10U
+#define DRV_PCI_LINK_LINK_STATUS		0x12U
+#define DRV_PCI_LINK_DEVICE_CAPABILITIES2	0x24U
+#define DRV_PCI_LINK_DEVICE_CONTROL2		0x28U
+
+#define DRV_PCI_LINK_DEVCAP_L1_ACCEPTABLE_SHIFT	9U
+#define DRV_PCI_LINK_DEVCAP_L1_ACCEPTABLE_MASK	0x7U
+#define DRV_PCI_LINK_LNKCAP_ASPM_L1		0x00000800U
+#define DRV_PCI_LINK_LNKCAP_L1_EXIT_SHIFT	15U
+#define DRV_PCI_LINK_LNKCAP_L1_EXIT_MASK	0x7U
+#define DRV_PCI_LINK_LNKCAP_LINK_ACTIVE_REPORTING	0x00100000U
+#define DRV_PCI_LINK_LNKCTL_ASPM_MASK		0x0003U
+#define DRV_PCI_LINK_LNKCTL_ASPM_L1		0x0002U
+#define DRV_PCI_LINK_LNKCTL_COMMON_CLOCK	0x0040U
+#define DRV_PCI_LINK_LNKSTA_LINK_ACTIVE		0x2000U
+#define DRV_PCI_LINK_DEVCAP2_LTR		0x00000800U
+#define DRV_PCI_LINK_DEVCTL2_LTR		0x0400U
+
+/*
+ * The L1 PM Substates extended capability: its identifier, its three
+ * registers as offsets from the capability, and their fields.
+ *
+ * Values referenced: PCI Express Base Specification Revision 4.0, section
+ * 7.8.3 (L1 PM Substates Extended Capability: the capabilities register's
+ * supported bits, Port Common_Mode_Restore_Time, Port T_POWER_ON Scale and
+ * Value; Control 1's enables, Common_Mode_Restore_Time,
+ * LTR_L1.2_THRESHOLD_Value and Scale; Control 2's T_POWER_ON Scale and
+ * Value); FreeBSD 15.0 sys/dev/pci/pcireg.h (PCIZ_L1PM, PCIR_L1PM_CAP,
+ * PCIR_L1PM_CTRL1, PCIR_L1PM_CTRL2 and the supported and enable bits).
+ */
+#define DRV_PCI_LINK_EXTENDED_L1SS		0x001eU
+#define DRV_PCI_LINK_L1SS_CAPABILITIES		0x04U
+#define DRV_PCI_LINK_L1SS_CONTROL1		0x08U
+#define DRV_PCI_LINK_L1SS_CONTROL2		0x0cU
+
+#define DRV_PCI_LINK_L1SS_PCIPM_L12		0x00000001U
+#define DRV_PCI_LINK_L1SS_PCIPM_L11		0x00000002U
+#define DRV_PCI_LINK_L1SS_ASPM_L12		0x00000004U
+#define DRV_PCI_LINK_L1SS_ASPM_L11		0x00000008U
+#define DRV_PCI_LINK_L1SS_ENABLE_MASK		0x0000000fU
+#define DRV_PCI_LINK_L1SS_SUPPORTED		0x00000010U
+#define DRV_PCI_LINK_L1SS_CMRT_SHIFT		8U
+#define DRV_PCI_LINK_L1SS_CMRT_MASK		0x000000ffU
+#define DRV_PCI_LINK_L1SS_POWER_ON_SCALE_SHIFT	16U
+#define DRV_PCI_LINK_L1SS_POWER_ON_VALUE_SHIFT	19U
+#define DRV_PCI_LINK_L1SS_THRESHOLD_VALUE_SHIFT	16U
+#define DRV_PCI_LINK_L1SS_THRESHOLD_VALUE_MASK	0x000003ffU
+#define DRV_PCI_LINK_L1SS_THRESHOLD_SCALE_SHIFT	29U
+#define DRV_PCI_LINK_L1SS_THRESHOLD_SCALE_MASK	0x00000007U
+#define DRV_PCI_LINK_L1SS_CONTROL2_SCALE_MASK	0x00000003U
+#define DRV_PCI_LINK_L1SS_CONTROL2_VALUE_SHIFT	3U
+#define DRV_PCI_LINK_L1SS_POWER_ON_SCALE_MASK	0x00000003U
+#define DRV_PCI_LINK_L1SS_POWER_ON_VALUE_MASK	0x0000001fU
+
+/*
+ * The Latency Tolerance Reporting extended capability: its identifier, the
+ * offsets of the maximum snoop and no-snoop latencies, and the latency a
+ * function that left both at zero is given: 3 in the scale of 1048576 ns,
+ * 3145728 ns.
+ *
+ * Values referenced: PCI Express Base Specification Revision 4.0, section
+ * 7.8.2 (LTR Extended Capability); Linux 6.12 drivers/pci/controller/vmd.c
+ * (the latency the VMD's quirk writes when a function reports none, 0x1003).
+ */
+#define DRV_PCI_LINK_EXTENDED_LTR		0x0018U
+#define DRV_PCI_LINK_LTR_MAX_SNOOP		0x04U
+#define DRV_PCI_LINK_LTR_MAX_NO_SNOOP		0x06U
+#define DRV_PCI_LINK_LTR_DEFAULT_LATENCY	0x1003U
+
+/*
+ * Why a plan leaves ASPM L1 off, as bits: the ends cannot or do not
+ * share a common clock, an end lacks L1, or the link wakes from L1
+ * slower than the function accepts.
+ */
+#define DRV_PCI_LINK_NO_COMMON_CLOCK		0x01U
+#define DRV_PCI_LINK_NO_L1			0x02U
+#define DRV_PCI_LINK_L1_TOO_SLOW		0x04U
+
+/*
+ * What one end of a link reports: the registers of its PCI Express
+ * capability the plan needs, and its L1 PM Substates and LTR capabilities
+ * when it has them.  The driver fills one for the port above the link and
+ * one for the function below it.
+ */
+struct drv_pci_link_end {
+	uint32_t device_capabilities;
+	uint32_t link_capabilities;
+	uint16_t link_control;
+	uint32_t device_capabilities2;
+	uint8_t has_l1ss;
+	uint32_t l1ss_capabilities;
+	uint8_t has_ltr;
+	uint16_t ltr_max_snoop;
+	uint16_t ltr_max_no_snoop;
+};
+
+/*
+ * What a link is to be given.
+ *
+ * aspm_l1 enables ASPM L1 at both ends.  ltr enables LTR at both ends;
+ * ltr_latency_write gives the function below the link the LTR latency
+ * ltr_latency for both snoop and no-snoop.  l1ss_enable holds the L1 PM
+ * Substates enable bits for both ends; when it is not zero, port_control1
+ * and function_control1 are the fields of Control 1 to write beside them
+ * (the common-mode restore time only at the port), control2 is Control 2
+ * for both ends, and threshold_ns is the LTR threshold the encoding
+ * stands for.  aspm_reasons says why aspm_l1 is off.
+ */
+struct drv_pci_link_plan {
+	uint8_t aspm_l1;
+	uint8_t ltr;
+	uint8_t ltr_latency_write;
+	uint16_t ltr_latency;
+	uint32_t l1ss_enable;
+	uint32_t port_control1;
+	uint32_t function_control1;
+	uint32_t control2;
+	uint32_t threshold_ns;
+	unsigned aspm_reasons;
+};
+
+int
+drv_pci_link_plan_make(
+	const struct drv_pci_link_end *port,
+	const struct drv_pci_link_end *function,
+	struct drv_pci_link_plan *plan);
+
+int
+drv_pci_link_threshold_encode(
+	uint32_t nanoseconds,
+	uint32_t *field,
+	uint32_t *encoded_nanoseconds);
+
+uint32_t
+drv_pci_link_power_on_us(
+	uint32_t scale,
+	uint32_t value);
+
+#endif
diff --git a/include/drivers/pci/pci-nvme-power.h b/include/drivers/pci/pci-nvme-power.h
new file mode 100644
index 0000000000..a8ad253c7f
--- /dev/null
+++ b/include/drivers/pci/pci-nvme-power.h
@@ -0,0 +1,107 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The hardware-free half of an NVMe controller's power states.
+ *
+ * It reads the power state descriptors of Identify Controller, builds the
+ * table of Autonomous Power State Transition that sends an idle controller
+ * to its non-operational states, and the Set Features command that gives
+ * the controller the table.  It touches no hardware, so a host test
+ * compiles it as it is.
+ */
+
+#ifndef DRIVERS_PCI_PCI_NVME_POWER_H
+#define DRIVERS_PCI_PCI_NVME_POWER_H
+
+#include <drivers/pci/pci-nvme-protocol.h>
+
+#include <stddef.h>
+#include <stdint.h>
+
+/*
+ * The most power states a controller describes, the size of the table of
+ * Autonomous Power State Transition and of one of its entries, and the
+ * feature that carries the table.
+ *
+ * Values referenced: NVM Express Base Specification 2.0e, Figure 280
+ * (Identify Controller: NPSS, at most 32 states) and section 5.27.1.9
+ * (Feature Identifier 0Ch, Autonomous Power State Transition: the 256-byte
+ * table of 32 eight-byte entries, CDW11 bit 0 APSTE).
+ */
+#define DRV_NVME_POWER_STATES_MAX		32U
+#define DRV_NVME_APST_TABLE_BYTES		256U
+#define DRV_NVME_APST_ENTRY_BYTES		8U
+#define DRV_NVME_FEATURE_APST			0x0cU
+#define DRV_NVME_APST_ENABLE			0x00000001U
+
+/*
+ * The default most a transition into and out of a state may take for the
+ * state to be used, in microseconds.
+ *
+ * Value referenced: Linux 6.19 drivers/nvme/host/core.c (the default of
+ * the parameter default_ps_max_latency_us, 100000), as the 5330's Debian
+ * reports it.
+ */
+#define DRV_NVME_APST_LATENCY_LIMIT_US		100000U
+
+/*
+ * One power state as its descriptor gives it: the most power it draws in
+ * units of 0.0001 W, whether it is non-operational (processes no I/O), and
+ * the time to enter and to leave it in microseconds (zero when the
+ * controller does not report it).
+ */
+struct drv_nvme_power_state {
+	uint32_t max_power_tenth_mw;
+	uint8_t non_operational;
+	uint32_t entry_latency_us;
+	uint32_t exit_latency_us;
+};
+
+/*
+ * What a controller says about its power: how many states it has, whether
+ * it supports Autonomous Power State Transition, and each state.
+ */
+struct drv_nvme_power_profile {
+	unsigned count;
+	uint8_t apst_supported;
+	struct drv_nvme_power_state states[DRV_NVME_POWER_STATES_MAX];
+};
+
+/*
+ * The transitions a table holds, for the log: for each state, the state
+ * an idle controller moves to (or itself, for none) and after how many
+ * milliseconds.
+ */
+struct drv_nvme_apst_summary {
+	unsigned transitions;
+	uint8_t target[DRV_NVME_POWER_STATES_MAX];
+	uint32_t idle_ms[DRV_NVME_POWER_STATES_MAX];
+};
+
+int
+drv_nvme_power_parse(
+	const uint8_t *identify,
+	size_t size,
+	struct drv_nvme_power_profile *profile);
+
+int
+drv_nvme_apst_build(
+	const struct drv_nvme_power_profile *profile,
+	uint32_t latency_limit_us,
+	uint8_t *table,
+	size_t size,
+	struct drv_nvme_apst_summary *summary);
+
+int
+drv_nvme_apst_command(
+	struct drv_nvme_command *command,
+	uint16_t command_id,
+	int enable,
+	uint64_t table);
+
+#endif
