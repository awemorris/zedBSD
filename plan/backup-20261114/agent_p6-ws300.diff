+/*
+ * Collects one root port behind the VMD that no driver binds to, with the
+ * parts of its PCI Express and power management capabilities its suspend
+ * needs, and says how it will sleep.
+ */
+static int
+vmd_collect_port(
+	struct drv_pci_device *device,
+	void *argument)
+{
+	struct drv_pci_address address;
+	struct vmd_port_power *port;
+	struct drv_pci_driver *driver;
+	struct drv_pci_bus *below;
+	struct vmd_host *host;
+	unsigned capability;
+	unsigned functions;
+	uint16_t capabilities;
+	uint32_t link;
+	bool bridge;
+	int keeps;
+	int error;
+
+	/* Passes over an endpoint, and a bridge a driver suspends itself. */
+	host = argument;
+	bridge = drv_pci_device_is_bridge(device);
+	if (!bridge)
+		return 0;
+	driver = drv_pci_device_driver(device);
+	if (driver != NULL)
+		return 0;
+
+	/* Passes over a port beyond the table, and says so. */
+	if (host->port_count == DRV_PCI_VMD_PORTS_MAX) {
+		kern_logf("vmd: %04x: more than %u root ports; the rest is not suspended\n", host->segment, DRV_PCI_VMD_PORTS_MAX);
+		return 0;
+	}
+
+	/* Starts the port's entry with nothing saved. */
+	port = &host->ports[host->port_count];
+	kern_memset(port, 0, sizeof(*port));
+	port->device = device;
+
+	/* Reads the PCI Express capability: whether a slot hangs below, whether it is a root port, whether it reports its link. */
+	error = drv_pci_device_find_capability(device, VMD_CAP_PCIE, &capability);
+	if (error == 0) {
+		port->pcie_offset = capability;
+		capabilities = 0;
+		(void)drv_pci_device_config_read16(device, capability + VMD_PCIE_CAPABILITIES, &capabilities);
+		if ((capabilities & VMD_PCIE_SLOT_IMPLEMENTED) != 0)
+			port->has_slot = 1;
+		if (((capabilities >> VMD_PCIE_TYPE_SHIFT) & VMD_PCIE_TYPE_MASK) == VMD_PCIE_TYPE_ROOT_PORT)
+			port->is_root_port = 1;
+		link = 0;
+		(void)drv_pci_device_config_read32(device, capability + VMD_PCIE_LINK_CAPABILITIES, &link);
+		if ((link & VMD_PCIE_LINK_ACTIVE_REPORTING) != 0)
+			port->reports_link = 1;
+	}
+
+	/* Reads whether the port keeps its configuration in D3hot, which decides whether it may sleep there. */
+	keeps = vmd_keeps_configuration(device);
+	if (keeps)
+		port->no_soft_reset = 1;
+
+	/* Counts the functions the scan found behind the port. */
+	functions = 0;
+	below = drv_pci_device_subordinate_bus(device);
+	if (below != NULL)
+		(void)drv_pci_bus_foreach_device(below, vmd_count_function, &functions);
+	if (functions != 0)
+		port->has_function = 1;
+
+	/* Says how the port will sleep; a port that would lose its configuration in D3hot stays in D0. */
+	drv_pci_device_address(device, &address);
+	kern_logf("vmd: root port %04x:%02x:%02x.%u sleeps in %s (no soft reset %u, %u functions behind it)\n",
+		  host->segment,
+		  address.bus,
+		  address.device,
+		  address.function,
+		  (port->no_soft_reset || host->d3_forced) ? "D3hot" : "D0",
+		  (unsigned)port->no_soft_reset,
+		  functions);
+
+	/* port_count moving makes the suspend take the port. */
+	host->port_count++;
+
+	/* Goes on with the next function. */
+	return 0;
+}
+
+/* Counts one function behind a root port. */
+static int
+vmd_count_function(
+	struct drv_pci_device *device,
+	void *argument)
+{
+	unsigned *count;
+
+	UNUSED_PARAMETER(device);
+
+	/* Counts it. */
+	count = argument;
+	(*count)++;
+
+	/* Goes on with the next function. */
+	return 0;
+}
+
+/* Counts one function behind a root port that is not in D3hot. */
+static int
+vmd_count_awake(
+	struct drv_pci_device *device,
+	void *argument)
+{
+	unsigned *count;
+	unsigned capability;
+	uint16_t control;
+	int error;
+
+	/* A function without power management cannot sleep, so it counts as awake. */
+	count = argument;
+	error = drv_pci_device_find_capability(device, VMD_CAP_PM, &capability);
+	if (error != 0) {
+		(*count)++;
+		return 0;
+	}
+
+	/* A function whose power state is not D3hot is awake. */
+	control = 0;
+	error = drv_pci_device_config_read16(device, capability + VMD_PM_CONTROL, &control);
+	if (error != 0 || (control & VMD_PM_STATE_MASK) != DRV_PCI_D3_HOT)
+		(*count)++;
+
+	/* Goes on with the next function. */
+	return 0;
+}
+
+/* Finds the first function behind a root port. */
+static int
+vmd_first_function(
+	struct drv_pci_device *device,
+	void *argument)
+{
+	struct drv_pci_device **found;
+
+	/* Takes it, and stops. */
+	found = argument;
+	*found = device;
+	return 1;
+}
