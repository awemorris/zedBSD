+/*
+ * Suspends one root port: saves its configuration and the controls the
+ * core's save leaves out, and puts it in D3hot when it keeps its
+ * configuration there (or the boot line forces D3hot) and every function
+ * behind it sleeps in D3hot.  A port that cannot be saved, or that should
+ * not go to D3hot, sleeps in D0.
+ */
+static int
+vmd_port_suspend(
+	struct vmd_host *host,
+	struct vmd_port_power *port)
+{
+	struct drv_pci_address address;
+	struct drv_pci_driver *driver;
+	struct drv_pci_bus *below;
+	unsigned awake;
+	int error;
+
+	/* Starts with nothing saved and the port in D0. */
+	port->in_d3 = 0;
+	port->saved.saved = 0;
+
+	/* Leaves a port a driver has bound to since the scan to the core, which suspends it. */
+	driver = drv_pci_device_driver(port->device);
+	if (driver != NULL)
+		return 0;
+
+	/* Saves the header (bus numbers, windows, bridge control) and the PCI Express controls; a port that cannot be saved stays in D0. */
+	drv_pci_device_address(port->device, &address);
+	error = drv_pci_device_save_state(port->device, &port->saved);
+	if (error != 0) {
+		kern_logf("vmd: root port %04x:%02x:%02x.%u cannot be saved (%d); it sleeps in D0\n", host->segment, address.bus, address.device, address.function, error);
+		port->saved.saved = 0;
+		return 0;
+	}
+
+	/* Saves the slot control and the root control, which the header save leaves out. */
+	port->slot_control = 0;
+	port->root_control = 0;
+	if (port->pcie_offset != 0 && port->has_slot)
+		(void)drv_pci_device_config_read16(port->device, port->pcie_offset + VMD_PCIE_SLOT_CONTROL, &port->slot_control);
+	if (port->pcie_offset != 0 && port->is_root_port)
+		(void)drv_pci_device_config_read16(port->device, port->pcie_offset + VMD_PCIE_ROOT_CONTROL, &port->root_control);
+
+	/* A port that would lose its configuration in D3hot sleeps in D0, unless the boot line forces D3hot. */
+	if (!port->no_soft_reset && !host->d3_forced)
+		return 0;
+
+	/* A port with a function behind it still awake sleeps in D0, and says so. */
+	awake = 0;
+	below = drv_pci_device_subordinate_bus(port->device);
+	if (below != NULL)
+		(void)drv_pci_bus_foreach_device(below, vmd_count_awake, &awake);
+	if (awake != 0) {
+		kern_logf("vmd: root port %04x:%02x:%02x.%u has %u functions awake behind it; it sleeps in D0\n", host->segment, address.bus, address.device, address.function, awake);
+		return 0;
+	}
+
+	/* Puts the port in D3hot; one without power management stays in D0. */
+	error = drv_pci_device_set_power_state(port->device, DRV_PCI_D3_HOT);
+	if (error == ENOENT)
+		return 0;
+	if (error != 0) {
+		drv_pci_device_discard_state(&port->saved);
+		return error;
+	}
+
+	/* in_d3 makes the resume bring it back to D0. */
+	port->in_d3 = 1;
+
+	/* Succeeded: the port sleeps. */
+	return 0;
+}
+
+/*
+ * Resumes one root port: D0, then its configuration and controls written
+ * back, then, for a port with a function behind it, a wait for its link
+ * and for that function when the port was reset or its link is down.
+ * Every step is tried; the first failure is reported.
+ */
+static int
+vmd_port_resume(
+	struct vmd_host *host,
+	struct vmd_port_power *port)
+{
+	struct drv_pci_address address;
+	uint16_t vendor;
+	uint16_t slot;
+	uint8_t secondary;
+	uint8_t saved_secondary;
+	int first_error;
+	int reset;
+	int error;
+
+	/* Brings the port back to D0. */
+	first_error = 0;
+	if (port->in_d3) {
+		error = drv_pci_device_set_power_state(port->device, DRV_PCI_D0);
+		if (error != 0)
+			first_error = error;
+
+		/* The port is in D0. */
+		port->in_d3 = 0;
+	}
+
+	/* Refuses a port that no longer answers: the VMD lost its hold on it, and no wait brings it back. */
+	drv_pci_device_address(port->device, &address);
+	vendor = 0xffffU;
+	(void)drv_pci_device_config_read16(port->device, 0x00U, &vendor);
+	if (vendor == 0xffffU) {
+		kern_logf("vmd: root port %04x:%02x:%02x.%u does not answer after the sleep\n", host->segment, address.bus, address.device, address.function);
+		return EIO;
+	}
+
+	/* A port that was not saved was left alone, in D0. */
+	if (!port->saved.saved)
+		return first_error;
+
+	/*
+	 * A port whose secondary bus reads zero, though it had one before the
+	 * sleep, lost its configuration in a reset.  The saved header's sixth
+	 * dword holds the bus numbers, the secondary in its second byte.
+	 */
+	reset = 0;
+	secondary = 0;
+	saved_secondary = (uint8_t)(port->saved.header[6] >> 8);
+	error = drv_pci_device_config_read8(port->device, VMD_BRIDGE_SECONDARY_BUS, &secondary);
+	if (error == 0 && secondary == 0 && saved_secondary != 0)
+		reset = 1;
+
+	/* Writes the configuration back. */
+	error = drv_pci_device_restore_state(port->device, &port->saved);
+	if (error != 0 && first_error == 0)
+		first_error = error;
+
+	/*
+	 * Writes the slot control back only when the sleep changed it, since a
+	 * write is a command to the slot, and never changes the slot's power.
+	 */
+	if (port->pcie_offset != 0 && port->has_slot) {
+		slot = 0;
+		(void)drv_pci_device_config_read16(port->device, port->pcie_offset + VMD_PCIE_SLOT_CONTROL, &slot);
