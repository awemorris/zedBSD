+/* Finds the single-function endpoint at slot 0, function 0 behind a port. */
+static int
+vmd_find_function(
+	struct drv_pci_device *device,
+	void *argument)
+{
+	struct drv_pci_address address;
+	struct drv_pci_device **found;
+	bool bridge;
+	bool multifunction;
+
+	/* Passes over every function but the first of slot 0. */
+	found = argument;
+	drv_pci_device_address(device, &address);
+	if (address.device != 0 || address.function != 0)
+		return 0;
+
+	/*
+	 * Leaves out a switch, whose links this driver does not manage, and a
+	 * device of several functions, whose functions would all need the same
+	 * link settings.
+	 */
+	bridge = drv_pci_device_is_bridge(device);
+	multifunction = drv_pci_device_is_multifunction(device);
+	if (bridge || multifunction)
+		return 0;
+
+	/* Takes it. */
+	*found = device;
+
+	/* Stops at the function found. */
+	return 1;
+}
