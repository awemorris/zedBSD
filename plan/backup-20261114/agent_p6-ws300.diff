+/*
+ * Reports whether a function keeps its configuration across D3hot: its
+ * power management control has No_Soft_Reset set.  A function without the
+ * capability, or whose register cannot be read, reports 0.
+ */
+static int
+vmd_keeps_configuration(
+	struct drv_pci_device *device)
+{
+	unsigned capability;
+	uint16_t control;
+	int error;
+
+	/* Finds the power management capability. */
+	error = drv_pci_device_find_capability(device, VMD_CAP_PM, &capability);
+	if (error != 0)
+		return 0;
+
+	/* Reads the control register. */
+	control = 0;
+	error = drv_pci_device_config_read16(device, capability + VMD_PM_CONTROL, &control);
+	if (error != 0 || control == 0xffffU)
+		return 0;
+
+	/* No_Soft_Reset says the configuration survives. */
+	if ((control & VMD_PM_NO_SOFT_RESET) != 0)
+		return 1;
+
+	/* Reports a function that is reset on its way out of D3hot. */
+	return 0;
+}
