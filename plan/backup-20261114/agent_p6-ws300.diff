diff --git a/plan/ws300/tests/host/link-plan-test.c b/plan/ws300/tests/host/link-plan-test.c
new file mode 100644
index 0000000000..907f614bf0
--- /dev/null
+++ b/plan/ws300/tests/host/link-plan-test.c
@@ -0,0 +1,191 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * Host test of src/drivers/pci/pci-link-plan.c: the 5330's link behind its
+ * VMD (the root port and the KIOXIA BG5, as Debian read them), the LTR
+ * threshold's encoding at its edges, the L1 latency check, and ends that
+ * lack the substates, LTR or a common clock.
+ *
+ *   cc -std=c99 -Wall -Wextra -Werror -I include -o build/tmp/link-plan-test \
+ *       plan/ws300/tests/host/link-plan-test.c src/drivers/pci/pci-link-plan.c
+ */
+
+#include <drivers/pci/pci-link-plan.h>
+#include <uapi/errno.h>
+
+#include <stdio.h>
+#include <string.h>
+
+/* How many checks failed; the test passes only when it stays zero. */
+static unsigned failures;
+
+static void
+check(int condition, const char *what)
+{
+	if (!condition) {
+		printf("FAIL: %s\n", what);
+		failures++;
+	}
+}
+
+/* An L1 PM Substates capabilities register from its parts. */
+static uint32_t
+l1ss_cap(uint32_t supported, uint32_t restore_us, uint32_t scale, uint32_t value)
+{
+	return supported | (restore_us << 8) | (scale << 16) | (value << 19);
+}
+
+/* The 5330's root port 10000:e0:06.0: L1 exit < 16 us, LTR, common clock, all substates, CMRT 110 us, T_POWER_ON 500 us. */
+static void
+port_5330(struct drv_pci_link_end *end)
+{
+	memset(end, 0, sizeof(*end));
+	end->link_capabilities = DRV_PCI_LINK_LNKCAP_ASPM_L1 | (4U << 15) | DRV_PCI_LINK_LNKCAP_LINK_ACTIVE_REPORTING;
+	end->link_control = DRV_PCI_LINK_LNKCTL_COMMON_CLOCK;
+	end->device_capabilities2 = DRV_PCI_LINK_DEVCAP2_LTR;
+	end->has_l1ss = 1;
+	end->l1ss_capabilities = l1ss_cap(0x1fU, 110U, 2U, 5U);
+}
+
+/* The 5330's BG5: L1 exit < 32 us, no limit on its L1 latency, LTR with no maximum set, no ASPM L1.1, CMRT 60 us, T_POWER_ON 150 us. */
+static void
+nvme_5330(struct drv_pci_link_end *end)
+{
+	memset(end, 0, sizeof(*end));
+	end->device_capabilities = 7U << 9;
+	end->link_capabilities = DRV_PCI_LINK_LNKCAP_ASPM_L1 | (5U << 15);
+	end->link_control = DRV_PCI_LINK_LNKCTL_COMMON_CLOCK;
+	end->device_capabilities2 = DRV_PCI_LINK_DEVCAP2_LTR;
+	end->has_l1ss = 1;
+	end->l1ss_capabilities = l1ss_cap(0x17U, 60U, 1U, 15U);
+	end->has_ltr = 1;
+}
+
+int
+main(void)
+{
+	struct drv_pci_link_end port;
+	struct drv_pci_link_end nvme;
+	struct drv_pci_link_plan plan;
+	uint32_t field;
+	uint32_t encoded;
+	int error;
+
+	/* The 5330 link: ASPM L1, PCI-PM L1.2 and L1.1, ASPM L1.2, LTR, threshold 616448 ns. */
+	port_5330(&port);
+	nvme_5330(&nvme);
+	error = drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(error == 0, "5330: plan made");
+	check(plan.aspm_l1 == 1, "5330: ASPM L1");
+	check(plan.aspm_reasons == 0, "5330: no reason against L1");
+	check(plan.ltr == 1, "5330: LTR");
+	check(plan.ltr_latency_write == 1 && plan.ltr_latency == 0x1003U, "5330: LTR latency 0x1003 given");
+	check(plan.l1ss_enable == 0x7U, "5330: enables PCI-PM L1.2, PCI-PM L1.1, ASPM L1.2");
+	check(plan.threshold_ns == 616448U, "5330: threshold 616448 ns");
+	check(plan.control2 == (2U | (5U << 3)), "5330: T_POWER_ON 500 us in the port's scale");
+	check(plan.port_control1 == ((602U << 16) | (2U << 29) | (110U << 8)), "5330: port control 1");
+	check(plan.function_control1 == ((602U << 16) | (2U << 29)), "5330: function control 1 without CMRT");
+
+	/* A function that already reports a maximum latency keeps it. */
+	nvme.ltr_max_snoop = 0x1003U;
+	nvme.ltr_max_no_snoop = 0x1003U;
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.ltr_latency_write == 0, "set latency kept");
+
+	/* The function accepting < 32 us takes the 32 us link; < 16 us refuses it, and the ASPM substates go with it. */
+	nvme_5330(&nvme);
+	nvme.device_capabilities = 5U << 9;
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.aspm_l1 == 1, "accepts < 32 us");
+	nvme.device_capabilities = 4U << 9;
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.aspm_l1 == 0 && (plan.aspm_reasons & DRV_PCI_LINK_L1_TOO_SLOW) != 0, "refuses < 16 us");
+	check(plan.l1ss_enable == 0x3U, "without ASPM L1 only the PCI-PM substates");
+
+	/* An exit of more than 64 us is accepted only without a limit. */
+	nvme_5330(&nvme);
+	nvme.link_capabilities = DRV_PCI_LINK_LNKCAP_ASPM_L1 | (7U << 15);
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.aspm_l1 == 1, "> 64 us with no limit");
+	nvme.device_capabilities = 6U << 9;
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.aspm_l1 == 0, "> 64 us with < 64 us");
+
+	/* No common clock: neither ASPM nor the ASPM substates. */
+	nvme_5330(&nvme);
+	nvme.link_control = 0;
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.aspm_l1 == 0 && (plan.aspm_reasons & DRV_PCI_LINK_NO_COMMON_CLOCK) != 0, "no common clock");
+
+	/* An end without L1 support. */
+	nvme_5330(&nvme);
+	port.link_capabilities &= ~DRV_PCI_LINK_LNKCAP_ASPM_L1;
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.aspm_l1 == 0 && (plan.aspm_reasons & DRV_PCI_LINK_NO_L1) != 0, "no L1 at the port");
+
+	/* Without LTR at one end: no LTR, no ASPM L1.2, the rest stays. */
+	port_5330(&port);
+	port.device_capabilities2 = 0;
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.ltr == 0 && plan.ltr_latency_write == 0, "no LTR at the port");
+	check(plan.l1ss_enable == 0x3U, "no ASPM L1.2 without LTR");
+
+	/* Without the substates at one end. */
+	port_5330(&port);
+	nvme.has_l1ss = 0;
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.l1ss_enable == 0 && plan.control2 == 0 && plan.port_control1 == 0, "no substates without the capability");
+	check(plan.aspm_l1 == 1, "ASPM L1 without the substates");
+
+	/* The capability present but its supported bit clear. */
+	nvme_5330(&nvme);
+	nvme.l1ss_capabilities &= ~DRV_PCI_LINK_L1SS_SUPPORTED;
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.l1ss_enable == 0, "no substates without the supported bit");
+
+	/* The function's power-on time longer: its scale and value are used. */
+	nvme_5330(&nvme);
+	nvme.l1ss_capabilities = l1ss_cap(0x17U, 60U, 2U, 7U);
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.control2 == (2U | (7U << 3)), "the longer power-on time is the function's");
+	check(plan.threshold_ns == 816128U, "threshold for 110 + 700 + 6 us rounds up to 797 x 1024 ns");
+
+	/* A reserved power-on scale at one end (as all ones read back): no substates, ASPM L1 stays. */
+	nvme_5330(&nvme);
+	nvme.l1ss_capabilities = l1ss_cap(0x17U, 60U, 3U, 31U);
+	(void)drv_pci_link_plan_make(&port, &nvme, &plan);
+	check(plan.l1ss_enable == 0 && plan.control2 == 0, "reserved power-on scale: no substates");
+	check(plan.aspm_l1 == 1, "reserved power-on scale: ASPM L1 stays");
+
+	/* The encoding: 1023 ns fits the finest scale, 1024 does not; the largest; beyond. */
+	error = drv_pci_link_threshold_encode(1023U, &field, &encoded);
+	check(error == 0 && field == (1023U << 16) && encoded == 1023U, "1023 ns in scale 0");
+	error = drv_pci_link_threshold_encode(1024U, &field, &encoded);
+	check(error == 0 && field == ((32U << 16) | (1U << 29)) && encoded == 1024U, "1024 ns in scale 1");
+	error = drv_pci_link_threshold_encode(1025U, &field, &encoded);
+	check(error == 0 && encoded == 1056U, "1025 ns rounds up to 33 x 32 ns");
+	error = drv_pci_link_threshold_encode(0U, &field, &encoded);
+	check(error == 0 && field == 0 && encoded == 0, "0 ns");
+	error = drv_pci_link_threshold_encode(0xffffffffU, &field, &encoded);
+	check(error == ERANGE, "beyond what 32 bits report");
+	error = drv_pci_link_threshold_encode(1023U * 1048576U, &field, &encoded);
+	check(error == 0 && field == ((1023U << 16) | (4U << 29)), "1023 x 1048576 ns in scale 4");
+
+	/* The power-on scales, and the reserved one. */
+	check(drv_pci_link_power_on_us(0U, 31U) == 62U, "scale 2 us");
+	check(drv_pci_link_power_on_us(1U, 15U) == 150U, "scale 10 us");
+	check(drv_pci_link_power_on_us(2U, 5U) == 500U, "scale 100 us");
+	check(drv_pci_link_power_on_us(3U, 5U) == 0U, "reserved scale");
+
+	/* Missing arguments. */
+	check(drv_pci_link_plan_make(NULL, &nvme, &plan) == EINVAL, "no port");
+	check(drv_pci_link_threshold_encode(1U, NULL, &encoded) == EINVAL, "no field");
+
+	printf("link-plan-test: %s\n", failures == 0 ? "PASS" : "FAIL");
+	return failures == 0 ? 0 : 1;
+}
diff --git a/plan/ws300/tests/host/nvme-apst-test.c b/plan/ws300/tests/host/nvme-apst-test.c
new file mode 100644
index 0000000000..e051ef4e04
--- /dev/null
+++ b/plan/ws300/tests/host/nvme-apst-test.c
@@ -0,0 +1,187 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * Host test of src/drivers/pci/pci-nvme-power.c: the power state
+ * descriptors of the 5330's KIOXIA BG5 (as Debian read them), its table of
+ * Autonomous Power State Transition, states beyond the latency limit or
+ * without reported latencies, a controller without the feature, and the
+ * Set Features command.
+ *
+ *   cc -std=c99 -Wall -Wextra -Werror -I include -o build/tmp/nvme-apst-test \
+ *       plan/ws300/tests/host/nvme-apst-test.c src/drivers/pci/pci-nvme-power.c
+ */
+
+#include <drivers/pci/pci-nvme-power.h>
+#include <uapi/errno.h>
+
+#include <stdio.h>
+#include <string.h>
+
+/* How many checks failed; the test passes only when it stays zero. */
+static unsigned failures;
+
+static void
+check(int condition, const char *what)
+{
+	if (!condition) {
+		printf("FAIL: %s\n", what);
+		failures++;
+	}
+}
+
+static void
+put16(uint8_t *bytes, uint16_t value)
+{
+	bytes[0] = (uint8_t)value;
+	bytes[1] = (uint8_t)(value >> 8);
+}
+
+static void
+put32(uint8_t *bytes, uint32_t value)
+{
+	put16(bytes, (uint16_t)value);
+	put16(bytes + 2, (uint16_t)(value >> 16));
+}
+
+static uint64_t
+get64(const uint8_t *bytes)
+{
+	uint64_t value;
+	unsigned index;
+
+	value = 0;
+	for (index = 0; index < 8U; index++)
+		value |= (uint64_t)bytes[index] << (index * 8U);
+	return value;
+}
+
+/* Writes one power state descriptor. */
+static void
+psd(uint8_t *identify, unsigned state, uint16_t power, int fine_scale, int non_operational, uint32_t entry, uint32_t exit)
+{
+	uint8_t *descriptor;
+
+	descriptor = identify + 2048U + state * 32U;
+	put16(descriptor, power);
+	descriptor[3] = (uint8_t)((fine_scale ? 1U : 0U) | (non_operational ? 2U : 0U));
+	put32(descriptor + 4, entry);
+	put32(descriptor + 8, exit);
+}
+
+/* The BG5: PS0-PS2 operational 4.0, 2.5, 1.3 W; PS3 0.05 W 800+1000 us; PS4 0.003 W (0.0030 in the fine scale) 3000+44900 us; APSTA 1. */
+static void
+bg5(uint8_t *identify)
+{
+	memset(identify, 0, 4096);
+	identify[263] = 4;
+	identify[265] = 1;
+	psd(identify, 0, 400, 0, 0, 1, 1);
+	psd(identify, 1, 250, 0, 0, 1, 1);
+	psd(identify, 2, 130, 0, 0, 1, 1);
+	psd(identify, 3, 5, 0, 1, 800, 1000);
+	psd(identify, 4, 30, 1, 1, 3000, 44900);
+}
+
+int
+main(void)
+{
+	static uint8_t identify[4096];
+	static uint8_t table[256];
+	struct drv_nvme_power_profile profile;
+	struct drv_nvme_apst_summary summary;
+	struct drv_nvme_command command;
+	unsigned index;
+	int error;
+
+	/* The BG5's descriptors. */
+	bg5(identify);
+	error = drv_nvme_power_parse(identify, sizeof(identify), &profile);
+	check(error == 0, "bg5: parsed");
+	check(profile.count == 5 && profile.apst_supported == 1, "bg5: 5 states, APST");
+	check(profile.states[0].max_power_tenth_mw == 40000U && !profile.states[0].non_operational, "bg5: PS0 4 W operational");
+	check(profile.states[3].max_power_tenth_mw == 500U && profile.states[3].non_operational, "bg5: PS3 0.05 W non-operational");
+	check(profile.states[3].entry_latency_us == 800U && profile.states[3].exit_latency_us == 1000U, "bg5: PS3 latencies");
+	check(profile.states[4].max_power_tenth_mw == 30U, "bg5: PS4 0.003 W in the fine scale");
+	check(profile.states[4].exit_latency_us == 44900U, "bg5: PS4 exit");
+	check(profile.states[5].max_power_tenth_mw == 0 && profile.states[5].entry_latency_us == 0, "bg5: no state 5");
+
+	/* Its table: PS0-PS2 to PS3 after 100 ms, PS3 to PS4 after 2000 ms, PS4 stays. */
+	memset(table, 0xa5, sizeof(table));
+	error = drv_nvme_apst_build(&profile, DRV_NVME_APST_LATENCY_LIMIT_US, table, sizeof(table), &summary);
+	check(error == 0, "bg5: table built");
+	check(summary.transitions == 4, "bg5: four moves");
+	for (index = 0; index < 3; index++)
+		check(get64(table + index * 8U) == ((3ULL << 3) | (100ULL << 8)), "bg5: operational to PS3 after 100 ms");
+	check(get64(table + 3U * 8U) == ((4ULL << 3) | (2000ULL << 8)), "bg5: PS3 to PS4 after 2000 ms");
+	check(get64(table + 4U * 8U) == 0, "bg5: PS4 stays");
+	check(get64(table + 31U * 8U) == 0, "bg5: the table is cleared past the states");
+	check(summary.target[2] == 3 && summary.idle_ms[3] == 2000U && summary.target[4] == 4, "bg5: summary");
+
+	/* A limit below PS4's 47.9 ms: only PS3 is used. */
+	error = drv_nvme_apst_build(&profile, 10000U, table, sizeof(table), &summary);
+	check(error == 0 && summary.transitions == 3, "limit 10 ms: three moves");
+	check(get64(table + 3U * 8U) == 0, "limit 10 ms: PS3 stays");
+
+	/* A limit below PS3's 1.8 ms: nothing. */
+	error = drv_nvme_apst_build(&profile, 1000U, table, sizeof(table), &summary);
+	check(error == 0 && summary.transitions == 0, "limit 1 ms: no move");
+
+	/* PS3 without reported latencies: the operational states go straight to PS4. */
+	psd(identify, 3, 5, 0, 1, 0, 1000);
+	(void)drv_nvme_power_parse(identify, sizeof(identify), &profile);
+	(void)drv_nvme_apst_build(&profile, DRV_NVME_APST_LATENCY_LIMIT_US, table, sizeof(table), &summary);
+	check(get64(table) == ((4ULL << 3) | (2000ULL << 8)), "unreported PS3: PS0 to PS4");
+	check(summary.target[3] == 4, "unreported PS3: PS3 may still move on");
+
+	/* A deeper state drawing more is no target. */
+	bg5(identify);
+	psd(identify, 4, 6, 0, 1, 3000, 44900);
+	(void)drv_nvme_power_parse(identify, sizeof(identify), &profile);
+	(void)drv_nvme_apst_build(&profile, DRV_NVME_APST_LATENCY_LIMIT_US, table, sizeof(table), &summary);
+	check(get64(table + 3U * 8U) == 0, "PS4 at more power than PS3: PS3 stays");
+
+	/* The step between the idle times: 15000 us is quick, 15001 us slow. */
+	bg5(identify);
+	psd(identify, 3, 5, 0, 1, 7000, 8000);
+	psd(identify, 4, 30, 1, 1, 7000, 8001);
+	(void)drv_nvme_power_parse(identify, sizeof(identify), &profile);
+	(void)drv_nvme_apst_build(&profile, DRV_NVME_APST_LATENCY_LIMIT_US, table, sizeof(table), &summary);
+	check(summary.idle_ms[0] == 100U && summary.idle_ms[3] == 2000U, "15000 us after 100 ms, 15001 us after 2000 ms");
+
+	/* Huge latencies within a huge limit do not overflow. */
+	bg5(identify);
+	psd(identify, 4, 30, 1, 1, 0xffffffffU, 0xffffffffU);
+	(void)drv_nvme_power_parse(identify, sizeof(identify), &profile);
+	(void)drv_nvme_apst_build(&profile, 0xffffffffU, table, sizeof(table), &summary);
+	check(summary.target[3] == 3, "a sum beyond 32 bits exceeds any limit");
+
+	/* A controller without APST. */
+	bg5(identify);
+	identify[265] = 0;
+	(void)drv_nvme_power_parse(identify, sizeof(identify), &profile);
+	error = drv_nvme_apst_build(&profile, DRV_NVME_APST_LATENCY_LIMIT_US, table, sizeof(table), &summary);
+	check(error == ENOTSUP && summary.transitions == 0 && get64(table) == 0, "no APST: refused, table empty");
+
+	/* NPSS of 31 (32 states) needs the whole page; a short page is refused. */
+	bg5(identify);
+	identify[263] = 31;
+	check(drv_nvme_power_parse(identify, 2048U + 32U * 32U, &profile) == 0 && profile.count == 32, "32 states");
+	check(drv_nvme_power_parse(identify, 2048U + 32U * 31U, &profile) == EINVAL, "short page");
+	check(drv_nvme_power_parse(NULL, 4096, &profile) == EINVAL, "no page");
+	check(drv_nvme_apst_build(&profile, 1U, table, 255U, &summary) == EINVAL, "short table");
+
+	/* The command. */
+	check(drv_nvme_apst_command(&command, 7, 1, 0x123000ULL) == 1, "command built");
+	check(command.cdw0 == (0x09U | (7U << 16)) && command.cdw10 == 0x0cU && command.cdw11 == 1U && command.prp1 == 0x123000ULL, "enable command");
+	(void)drv_nvme_apst_command(&command, 7, 0, 0x123000ULL);
+	check(command.cdw11 == 0 && command.prp1 == 0x123000ULL, "disable command still carries the table");
+	check(drv_nvme_apst_command(&command, 7, 1, 0) == 0, "no table refused");
+
+	printf("nvme-apst-test: %s\n", failures == 0 ? "PASS" : "FAIL");
+	return failures == 0 ? 0 : 1;
+}
