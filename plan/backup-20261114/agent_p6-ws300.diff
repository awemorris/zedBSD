+/* Reports whether the boot line holds a whole token. */
+static int
+vmd_boot_token(
+	const char *token)
+{
+	const char *line;
+	int present;
+
+	/* Reads the line the loader handed over; without one no token is present. */
+	line = kern_boot_handoff("boot.command-line");
+	if (line == NULL)
+		return 0;
+
+	/* Looks for the token. */
+	present = kern_boot_parameters_token_present(line, token);
+	if (present)
+		return 1;
+
+	/* Reports the token as absent. */
+	return 0;
