new file mode 100644
index 0000000000..6d655e8461
--- /dev/null
+++ b/plan/ws296/tests/check-mgmt.sh
@@ -0,0 +1,52 @@
+#!/bin/sh
+#
+# Lists the lines of src/drivers (gpu/ left out) that carry development
+# management information: WS, Phase, Queue and Bug numbers, test run
+# numbers, plan/ paths, dated records and the like.  Lines that only look
+# like it (hardware names, register fields, citations) are listed in
+# check-mgmt.exclude as FILE:TEXT, TEXT matched as a fixed string.
+#
+#   sh plan/ws296/tests/check-mgmt.sh [ROOT]
+#
+# Prints the remaining lines and their count; exits 1 when any remain.
+# It only reads the tree and writes nothing.
+
+root=${1:-.}
+here=$(dirname "$0")
+exclude="$here/check-mgmt.exclude"
+
+pattern='\b[Ww][Ss][0-9]{3}[a-z]?\b|\b[Ww][Ss][0-9]{3}-p[0-9]|\bp[0-9]{3}[a-z]?[0-9]*\b|\bBUG-?[0-9]+|\bq[0-9]{3,4}(-i[0-9]+)?\b|\bT[0-9]+-[0-9]+\b|\bT[0-9]\b|plan/|\b20[0-9]{2}-[01][0-9]-[0-3][0-9]\b|\bAAT\b|user.s approval|the user.s [A-Z][0-9]|\bround [0-9]+|design [A-Z][0-9]|phase[0-9]{3}|HW-T[0-9]'
+
+hits=$(grep -rnE "$pattern" "$root/src/drivers" \
+	--include='*.c' --include='*.h' --include='*.inc' \
+	| sed "s|^$root/||" \
+	| grep -v '^src/drivers/gpu/' \
+	| awk -v ex="$exclude" '
+		BEGIN {
+			n = 0;
+			while ((getline line < ex) > 0) {
+				if (line ~ /^#/ || line == "")
+					continue;
+				i = index(line, ":");
+				file[++n] = substr(line, 1, i - 1);
+				text[n] = substr(line, i + 1);
+			}
+		}
+		{
+			split($0, part, ":");
+			for (k = 1; k <= n; k++) {
+				if (part[1] == file[k] && index($0, text[k]) > 0)
+					next;
+			}
+			print;
+		}')
+
+if [ -n "$hits" ]; then
+	printf '%s\n' "$hits"
+	count=$(printf '%s\n' "$hits" | wc -l)
+else
+	count=0
+fi
+
+echo "check-mgmt: $count"
+[ "$count" -eq 0 ]
