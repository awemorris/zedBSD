+/* Reads the unsigned value one report descriptor item carries. */
+static uint32_t
+item_unsigned(
+	const uint8_t *data,
+	size_t size)
+{
+	uint32_t value = 0;
+	size_t index;
+
+	/* Assembles the item's data bytes, which are little endian. */
+	for (index = 0; index < size; index++)
+		value |= (uint32_t)data[index] << (index * 8U);
+
+	/* Reports the item's data as an unsigned number. */
+	return value;
+}
+
+/* Extends a value of the given width to a full signed one. */
+static int32_t
+sign_extend(
+	uint32_t value,
+	unsigned bits)
+{
+	int64_t extended = value;
+
+	/* A set top bit makes the value negative in its own width. */
+	if ((value & ((uint32_t)1U << (bits - 1U))) != 0)
+		extended -= (int64_t)((uint64_t)1U << bits);
+
+	/* Reports the value in the full signed width. */
+	return (int32_t)extended;
+}
+
+/* Reads the signed value one report descriptor item carries. */
+static int
+item_signed(
+	const uint8_t *data,
+	size_t size,
+	int32_t *result)
+{
+	uint32_t raw;
+
+	/* Refuses an item whose data is not one, two or four bytes long. */
+	if (size != 1U && size != 2U && size != 4U)
+		return EINVAL;
+
+	/* Reads the item's bytes and widens them by their own sign bit. */
+	raw = item_unsigned(data, size);
+	*result = sign_extend(raw, (unsigned)size * 8U);
+
+	/* Succeeded: the caller holds the item's signed value. */
+	return 0;
+}
