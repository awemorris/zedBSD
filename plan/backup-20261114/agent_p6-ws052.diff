+void
+mutex_lock(
+	struct mutex *lock)
+{
+	/* One thread: nobody else holds it. */
+	lock->locked = 1U;
+}
+
+/* Lets a mutex go. */
+void
+mutex_unlock(
+	struct mutex *lock)
+{
+	/* Released. */
+	lock->locked = 0U;
+}
