+	error = ioctl(fd, KERN_SYSTEM_SLEEP_INFO, &info);
+	if (error != 0) {
+		fprintf(stderr, "sleepctl: KERN_SYSTEM_SLEEP_INFO: %s\n", strerror(errno));
+		return 1;
+	}
+
+	/* Refuses a kernel whose record is not the one this program knows. */
+	if (info.version != KERN_SYSTEM_SLEEP_INFO_VERSION || info.struct_size != sizeof(info)) {
+		fprintf(stderr, "sleepctl: sleep info version %u size %u not known\n", (unsigned)info.version, (unsigned)info.struct_size);
+		return 1;
+	}
+
+	/* What the machine has. */
+	can_sleep = 0U;
+	if ((info.flags & KERN_SYSTEM_SLEEP_CAN_SLEEP) != 0U)
+		can_sleep = 1U;
+	timer = 0U;
+	if ((info.flags & KERN_SYSTEM_SLEEP_HAS_WAKE_TIMER) != 0U)
+		timer = 1U;
+	printf("info flags=0x%x can-sleep=%u wake-timer=%u attempts=%u entered=%u\n",
+	       (unsigned)info.flags,
+	       can_sleep,
+	       timer,
+	       (unsigned)info.attempts,
+	       (unsigned)info.entered);
+
+	/* The last sleep, once one was tried. */
+	if ((info.flags & KERN_SYSTEM_SLEEP_LAST_VALID) != 0U) {
+		info.last_device[sizeof(info.last_device) - 1U] = '\0';
+		device = info.last_device;
+		if (device[0] == '\0')
+			device = "-";
+		printf("last wake=%u result=%d resume=%d spurious=%u slept-us=%llu device=%s\n",
+		       (unsigned)info.last_wake,
+		       (int)info.last_result,
+		       (int)info.last_resume_result,
+		       (unsigned)info.last_spurious,
+		       (unsigned long long)info.last_duration_us,
+		       device);
+	}
+
+	/* Each low-power idle state the firmware lists. */
+	for (index = 0; index < info.state_count && index < KERN_SYSTEM_SLEEP_STATE_MAX; index++) {
+		state = &info.state[index];
+
+		/* Where its counter is. */
+		counter = "none";
+		if ((state->flags & KERN_SYSTEM_SLEEP_STATE_MEMORY) != 0U) {
+			counter = "memory";
+		} else if ((state->flags & KERN_SYSTEM_SLEEP_STATE_PROCESSOR) != 0U) {
+			counter = "processor";
+		}
+
+		/* The line, with "-" for what the kernel could not read or measure. */
+		printf("state id=%u counter=%s flags=0x%x", (unsigned)state->id, counter, (unsigned)state->flags);
+		if ((state->flags & KERN_SYSTEM_SLEEP_STATE_READABLE) != 0U) {
+			printf(" total-us=%llu", (unsigned long long)state->total_us);
+		} else {
+			printf(" total-us=-");
+		}
+		if ((state->flags & KERN_SYSTEM_SLEEP_STATE_MEASURED) != 0U) {
+			printf(" residency-us=%llu\n", (unsigned long long)state->last_residency_us);
+		} else {
+			printf(" residency-us=-\n");
+		}
+	}
+
+	/* Succeeded: the state is printed. */
+	return 0;
+}
+
+/* Reads a number of seconds for the wake timer: 1 to WAKE_SECONDS_MAX. */
+static int
+parse_seconds(
+	const char *text,
+	unsigned *seconds)
+{
+	unsigned long value;
+	char *end;
+
+	/* A decimal number and nothing after it. */
+	errno = 0;
+	value = strtoul(text, &end, 10);
+	if (errno != 0 || end == text || *end != '\0')
+		return -1;
+
+	/* Refuses zero, which disarms the timer, and a value the timer cannot take. */
+	if (value == 0UL || value > WAKE_SECONDS_MAX)
+		return -1;
+
+	/* Succeeded: the seconds. */
+	*seconds = (unsigned)value;
+	return 0;
+}
