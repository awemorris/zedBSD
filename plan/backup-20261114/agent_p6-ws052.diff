diff --git a/src/drivers/acpi/acpi-alarm.c b/src/drivers/acpi/acpi-alarm.c
new file mode 100644
index 0000000000..3b8e6bd30d
--- /dev/null
+++ b/src/drivers/acpi/acpi-alarm.c
@@ -0,0 +1,491 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The time and alarm device (ACPI000E) as the wake timer of S0 idle.
+ *
+ * The device has a timer for each power source, AC and DC, that counts
+ * down seconds and wakes the system when it expires; firmware signals the
+ * expiry through the GPE the device's _PRW names, and notifies the device
+ * (Device Wake).  Arming the wake timer sets every timer the device can
+ * wake the system with (_GCP) to the seconds asked (_STV), whichever
+ * power source the machine is on when they expire, and arms the device's
+ * wake (its GPE).  Disarming sets every timer to the value that disables
+ * it and disarms the wake.  The kernel disarms the timer when a sleep to
+ * idle ends.
+ */
+
+#include <kern/kcrt.h>
+#include <kern/klog.h>
+#include <kern/lock.h>
+#include <kern/sleep.h>
+#include <uapi/errno.h>
+
+#include <drivers/acpi/acpi.h>
+
+#include <stdbool.h>
+
+/*
+ * The device's identifier, its capabilities that say a timer can wake
+ * the system on AC and on DC power, the two timers' numbers, the timer
+ * value that disables a timer, and the Notify of a device's wake.
+ *
+ * Values referenced: ACPI Specification 6.5, section 9.17, Time and
+ * Alarm Device (_GCP's bits 0 and 1, the timer identifiers of _STV and
+ * _CWS, the disabled timer value 0xFFFFFFFF), and section 5.6.6, the
+ * Device Wake notification value 0x02.
+ */
+#define ALARM_HID		"ACPI000E"
+#define ALARM_CAN_WAKE_AC	0x1U
+#define ALARM_CAN_WAKE_DC	0x2U
+#define ALARM_TIMER_AC		0U
+#define ALARM_TIMER_DC		1U
+#define ALARM_TIMERS		2U
+#define ALARM_DISABLED		0xffffffffU
+#define NOTIFY_DEVICE_WAKE	0x02U
+
+/* _STA: the device is present. */
+#define STATUS_PRESENT		0x01U
+
+/* What the GPE of a device without one, or with one in a GPE block device, reads as. */
+#define ALARM_GPE_NONE		0xffffffffU
+
+/* The largest GPE number ACPI has (the blocks hold at most 256 events). */
+#define GPE_NUMBER_MAX		0xffU
+
+/*
+ * The note of what woke the system from S0 idle.  It is weak so that a
+ * build without the sleep's coordinator links; alarm_note_wake() tests
+ * it first.
+ */
+extern void kern_sleep_note_wake(unsigned reason) __attribute__((weak));
+
+/*
+ * The time and alarm device drv_acpi_alarm_attach() found (NULL when the
+ * platform has none that can wake it), its capabilities (_GCP) and the
+ * GPE its _PRW names.  They are set once at attachment, before any arming,
+ * and only read afterwards.
+ */
+static struct drv_acpi_node *alarm_node;
+static uint32_t alarm_capabilities;
+static unsigned alarm_gpe;
+
+/*
+ * Whether the timers are set and the device's wake armed; alarm_lock
+ * keeps one arming or disarming at a time, so that the wake is armed
+ * exactly once while the timers are set.
+ */
+static bool alarm_armed;
+static struct mutex alarm_lock;
+
+static int find_visitor(struct drv_acpi_node *node, unsigned depth, void *argument);
+static bool is_alarm(struct drv_acpi_node *node);
+static unsigned read_gpe(struct drv_acpi_node *node);
+static void notify_handler(struct drv_acpi_node *node, uint32_t value, void *argument);
+static bool timer_can_wake(unsigned timer);
+static int timer_call(const char *method, unsigned timer, uint32_t value, unsigned argument_count);
+static void timers_disable(void);
+
+/*
+ * Finds the time and alarm device and takes its wake notifications.
+ *
+ * Called once the namespace is ready.  It reports ENODEV when the
+ * platform has no present time and alarm device, or one whose timers
+ * cannot wake the system.
+ */
+int
+drv_acpi_alarm_attach(void)
+{
+	struct drv_acpi_node *found;
+	uint64_t capabilities;
+	int error;
+
+	/* The lock of the arming, before anyone may arm. */
+	error = mutex_init(&alarm_lock, LOCK_RANK_DEVICE, "acpi alarm");
+	if (error != 0)
+		return error;
+
+	/* The device. */
+	found = NULL;
+	(void)drv_acpi_walk(NULL, find_visitor, &found);
+	if (found == NULL)
+		return ENODEV;
+
+	/* Its capabilities, which must let a timer wake the system. */
+	error = drv_acpi_evaluate_integer(found, "_GCP", &capabilities);
+	if (error != 0) {
+		kern_logf("acpi: the time and alarm device has no _GCP (error %d)\n", error);
+		return ENODEV;
+	}
+
+	/* Refuses a device whose timers wake the system on neither power source. */
+	if ((capabilities & (ALARM_CAN_WAKE_AC | ALARM_CAN_WAKE_DC)) == 0U) {
+		kern_logf("acpi: the time and alarm device cannot wake the system (_GCP 0x%llx)\n", (unsigned long long)capabilities);
+		return ENODEV;
+	}
+
+	/* The GPE its expiry comes through, which tells a timer's wake apart. */
+	alarm_gpe = read_gpe(found);
+
+	/* Its wake notifications, which note the timer as what woke the system. */
+	error = drv_acpi_notify_install(found, notify_handler, NULL);
+	if (error != 0)
+		kern_logf("acpi: the time and alarm device's notify not taken (%d)\n", error);
+
+	/* Arming may start. */
+	alarm_capabilities = (uint32_t)capabilities;
+	alarm_node = found;
+
+	/* Succeeded: the log shows the device's capabilities and GPE. */
+	kern_logf("acpi: wake timer _GCP 0x%x GPE 0x%x\n", (unsigned)alarm_capabilities, alarm_gpe);
+	return 0;
+}
+
+/* Reports whether the platform has a wake timer: 1 or 0. */
+int
+drv_acpi_wake_timer_present(void)
+{
+	/* No time and alarm device that can wake the system. */
+	if (alarm_node == NULL)
+		return 0;
+
+	/* Succeeded: the timer can wake the system. */
+	return 1;
+}
+
+/*
+ * Arms the wake timer to wake the system seconds from now, or disarms it
+ * when seconds is zero.
+ *
+ * Arming again sets the timers anew.  It reports EOPNOTSUPP on a platform
+ * without a wake timer, EINVAL for seconds that is the disabled value, and
+ * EIO when the firmware refused; a failed arming leaves the timer
+ * disarmed.
+ */
+int
+drv_acpi_wake_timer_set(
+	uint32_t seconds)
+{
+	unsigned timer;
+	bool wakes;
+	int error;
+
+	/* Refuses a platform without the timer, and the value that disables it. */
+	if (alarm_node == NULL)
+		return EOPNOTSUPP;
+	if (seconds == ALARM_DISABLED)
+		return EINVAL;
+
+	/* One arming at a time. */
+	mutex_lock(&alarm_lock);
+
+	/* Disarming: the timers disabled and the wake let go. */
+	if (seconds == 0U) {
+		if (alarm_armed) {
+			timers_disable();
+			(void)drv_acpi_device_wake_disable(alarm_node);
+			alarm_armed = false;
+		}
+		mutex_unlock(&alarm_lock);
+		return 0;
+	}
+
+	/* Each timer that can wake the system: its old expiry cleared, then the seconds. */
+	for (timer = 0; timer < ALARM_TIMERS; timer++) {
+		/* A timer the device cannot wake the system with is left alone. */
+		wakes = timer_can_wake(timer);
+		if (!wakes)
+			continue;
+
+		/* Clears an expiry left from before, which would wake the system at once. */
+		(void)timer_call("_CWS", timer, 0U, 1U);
+
+		/* Sets the seconds. */
+		error = timer_call("_STV", timer, seconds, 2U);
+		if (error != 0) {
+			timers_disable();
+			if (alarm_armed)
+				(void)drv_acpi_device_wake_disable(alarm_node);
+			alarm_armed = false;
+			mutex_unlock(&alarm_lock);
+			kern_logf("acpi: wake timer %u not set (error %d)\n", timer, error);
+			return EIO;
+		}
+	}
+
+	/* The device's wake, armed once while the timers are set; the device stays in D0. */
+	if (!alarm_armed) {
+		error = drv_acpi_device_wake_enable(alarm_node, DRV_ACPI_D0);
+		if (error != 0) {
+			timers_disable();
+			mutex_unlock(&alarm_lock);
+			kern_logf("acpi: wake timer's wake not armed (error %d)\n", error);
+			return EIO;
+		}
+		alarm_armed = true;
+	}
+
+	mutex_unlock(&alarm_lock);
+
+	/* Succeeded: the timer wakes the system in seconds. */
+	kern_logf("acpi: wake timer armed for %u s\n", (unsigned)seconds);
+	return 0;
+}
+
+/*
+ * Reports the GPE the wake timer's expiry comes through.  It reports
+ * ENODEV without a wake timer, or when its GPE is not known.
+ */
+int
+drv_acpi_wake_timer_gpe(
+	unsigned *gpe)
+{
+	/* No timer, or one whose GPE is not a plain number. */
+	if (alarm_node == NULL || alarm_gpe == ALARM_GPE_NONE)
+		return ENODEV;
+
+	/* Succeeded: the timer's GPE. */
+	*gpe = alarm_gpe;
+	return 0;
+}
+
+/* Stops the walk at the first present time and alarm device and keeps it. */
+static int
+find_visitor(
+	struct drv_acpi_node *node,
+	unsigned depth,
+	void *argument)
+{
+	struct drv_acpi_node **found;
+	enum drv_acpi_type type;
+	uint64_t status;
+	bool alarm;
+	int error;
+
+	/* The depth does not matter; the argument is where the device goes. */
+	(void)depth;
+	found = argument;
+
+	/* Only a device. */
+	type = drv_acpi_node_type(node);
+	if (type != DRV_ACPI_TYPE_DEVICE)
+		return 0;
+
+	/* Only the time and alarm device. */
+	alarm = is_alarm(node);
+	if (!alarm)
+		return 0;
+
+	/* A device that is not present is passed over (no _STA is present). */
+	error = drv_acpi_evaluate_integer(node, "_STA", &status);
+	if (error == 0 && (status & STATUS_PRESENT) == 0U)
+		return 0;
+
+	/* Succeeded: the first present one ends the walk. */
+	*found = node;
+	return -1;
+}
+
+/* Tells whether a device's _HID names the time and alarm device. */
+static bool
+is_alarm(
+	struct drv_acpi_node *node)
+{
+	struct drv_acpi_object *hid;
+	enum drv_acpi_type type;
+	const char *text;
+	size_t length;
+	bool alarm;
+	int compared;
+	int error;
+
+	/* The hardware identifier, a string for an ACPI identifier. */
+	hid = NULL;
+	error = drv_acpi_evaluate(node, "_HID", NULL, 0U, &hid);
+	if (error != 0 || hid == NULL)
+		return false;
+
+	/* The string names the device. */
+	alarm = false;
+	type = drv_acpi_object_type(hid);
+	if (type == DRV_ACPI_TYPE_STRING) {
+		text = drv_acpi_object_string(hid, &length);
+		if (text != NULL) {
+			compared = kern_strcmp(text, ALARM_HID);
+			if (compared == 0)
+				alarm = true;
+		}
+	}
+
+	/* The identifier is no longer needed. */
+	drv_acpi_object_release(hid);
+
+	/* Reports whether it is the time and alarm device. */
+	return alarm;
+}
+
+/* Reads the GPE number the device's _PRW names, or ALARM_GPE_NONE. */
+static unsigned
+read_gpe(
+	struct drv_acpi_node *node)
+{
+	struct drv_acpi_object *wake;
+	struct drv_acpi_object *element;
+	enum drv_acpi_type type;
+	uint64_t gpe;
+	int error;
+
+	/* The device's wake: a package whose first element is the GPE. */
+	wake = NULL;
+	error = drv_acpi_evaluate(node, "_PRW", NULL, 0U, &wake);
+	if (error != 0 || wake == NULL)
+		return ALARM_GPE_NONE;
+
+	/* The first element, when it is a plain number (a GPE block device's is a package). */
+	gpe = ALARM_GPE_NONE;
+	type = drv_acpi_object_type(wake);
+	if (type == DRV_ACPI_TYPE_PACKAGE) {
+		element = drv_acpi_object_package_element(wake, 0U);
+		if (element != NULL) {
+			type = drv_acpi_object_type(element);
+			if (type == DRV_ACPI_TYPE_INTEGER)
+				gpe = drv_acpi_object_integer(element);
+		}
+	}
+
+	/* The package is no longer needed. */
+	drv_acpi_object_release(wake);
+
+	/* A number past the last GPE ACPI has is not one. */
+	if (gpe > GPE_NUMBER_MAX)
+		return ALARM_GPE_NONE;
+
+	/* Succeeded: the GPE. */
+	return (unsigned)gpe;
+}
+
+/*
+ * Takes a Notify on the device, inside the interpreter: a device wake is
+ * the timer's expiry, noted for a sleep under way.
+ */
+static void
+notify_handler(
+	struct drv_acpi_node *node,
+	uint32_t value,
+	void *argument)
+{
+	/* The device and the argument do not matter: there is one such device. */
+	(void)node;
+	(void)argument;
+
+	/* Only the device's wake tells of the timer. */
+	if (value != NOTIFY_DEVICE_WAKE)
+		return;
+
+	/* The log, and the note when the kernel has the sleep's coordinator. */
+	kern_logf("acpi: wake timer expired\n");
+	if (kern_sleep_note_wake != NULL)
+		kern_sleep_note_wake(KERN_SLEEP_WAKE_TIMER);
+}
+
+/* Tells whether the device can wake the system with a timer (AC or DC). */
+static bool
+timer_can_wake(
+	unsigned timer)
+{
+	/* The AC timer. */
+	if (timer == ALARM_TIMER_AC && (alarm_capabilities & ALARM_CAN_WAKE_AC) != 0U)
+		return true;
+
+	/* The DC timer. */
+	if (timer == ALARM_TIMER_DC && (alarm_capabilities & ALARM_CAN_WAKE_DC) != 0U)
+		return true;
+
+	/* A timer the device does not wake the system with. */
+	return false;
+}
+
+/*
+ * Calls one of the device's timer methods with the timer and, for two
+ * arguments, the value.  It reports EIO when the method answered that it
+ * failed (an integer other than zero), else the evaluation's error.
+ */
+static int
+timer_call(
+	const char *method,
+	unsigned timer,
+	uint32_t value,
+	unsigned argument_count)
+{
+	struct drv_acpi_object *arguments[2];
+	struct drv_acpi_object *answer;
+	enum drv_acpi_type type;
+	uint64_t status;
+	int error;
+
+	/* The timer's number. */
+	arguments[0] = drv_acpi_object_integer_new(timer);
+	if (arguments[0] == NULL)
+		return ENOMEM;
+
+	/* The value, for a method that takes one. */
+	arguments[1] = NULL;
+	if (argument_count > 1U) {
+		arguments[1] = drv_acpi_object_integer_new(value);
+		if (arguments[1] == NULL) {
+			drv_acpi_object_release(arguments[0]);
+			return ENOMEM;
+		}
+	}
+
+	/* Calls the method; the arguments are no longer needed after it. */
+	answer = NULL;
+	error = drv_acpi_evaluate(alarm_node, method, arguments, argument_count, &answer);
+	drv_acpi_object_release(arguments[0]);
+	if (arguments[1] != NULL)
+		drv_acpi_object_release(arguments[1]);
+	if (error != 0)
+		return error;
+
+	/* The method's answer: zero is success, anything else a failure. */
+	status = 0U;
+	if (answer != NULL) {
+		type = drv_acpi_object_type(answer);
+		if (type == DRV_ACPI_TYPE_INTEGER)
+			status = drv_acpi_object_integer(answer);
+		drv_acpi_object_release(answer);
+	}
+
+	/* Reports a method that answered with a failure. */
+	if (status != 0U)
+		return EIO;
+
+	/* Succeeded: the method did it. */
+	return 0;
+}
+
+/* Disables every timer the device can wake the system with; a failure is logged. */
+static void
+timers_disable(void)
+{
+	unsigned timer;
+	bool wakes;
+	int error;
+
+	/* Each timer, set to the value that disables it. */
+	for (timer = 0; timer < ALARM_TIMERS; timer++) {
+		/* A timer the device cannot wake the system with was never set. */
+		wakes = timer_can_wake(timer);
+		if (!wakes)
+			continue;
+
+		/* Disables it. */
+		error = timer_call("_STV", timer, ALARM_DISABLED, 2U);
+		if (error != 0)
+			kern_logf("acpi: wake timer %u not disabled (error %d)\n", timer, error);
+	}
+}
