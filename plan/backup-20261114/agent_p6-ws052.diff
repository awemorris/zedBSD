+#!/bin/sh
+# The base test of the sleep on the Latitude 5330, the part that runs on zedBSD as root (plan/ws052/tests/p014-5330.sh puts
+# it in /tmp and runs it through the EXTRA of 5330-run.sh).  It prints sections that p014-5330.sh reads:
+#   == info before         sleepctl info: what the machine has for S0 idle, the low-power idle states with their counters
+#   == devices N           sleepctl devices, ROUNDS times, while an app (mview) draws in the session
+#   == s0idle              sleepctl s0idle --wake-after WAKE: the sleep to idle, woken by the wake timer
+#   == info after          sleepctl info: the outcome of the sleep and the residency of each state
+#   == app                 the last lines of the app (it drew through every round trip)
+#   == dmesg               the lines of the kernel of the sleep, the devices and the firmware
+# ROUNDS (default 5), WAKE (default 30 seconds) and SESSION_USER (default user) may be set on the command line as
+# NAME=VALUE words.  Nothing is removed but the app, which is stopped at the end.
+# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
+ROUNDS=5
+WAKE=30
+SESSION_USER=user
+for word in "$@"; do
+	case "$word" in
+	ROUNDS=*) ROUNDS=${word#ROUNDS=} ;;
+	WAKE=*) WAKE=${word#WAKE=} ;;
+	SESSION_USER=*) SESSION_USER=${word#SESSION_USER=} ;;
+	esac
+done
+
+echo "== info before"
+/bin/sleepctl info
+
+# An app that keeps drawing in the session through the round trips.
+su "$SESSION_USER" -c "env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 /bin/mview --token=p014 --frames=100000" > /tmp/p014-app.log 2>&1 < /dev/null &
+app=$!
+sleep 5
+
+round=1
+while [ "$round" -le "$ROUNDS" ]; do
+	echo "== devices $round"
+	/bin/sleepctl devices
+	sleep 5
+	round=$((round + 1))
+done
+
+echo "== s0idle"
+/bin/sleepctl s0idle --wake-after "$WAKE"
+sleep 10
+
+echo "== info after"
+/bin/sleepctl info
+
+echo "== app"
+kill "$app" 2> /dev/null
+tail -5 /tmp/p014-app.log
+
+echo "== dmesg"
+dmesg | grep -E "sleep:|system: sleep|acpi: (LPIT|wake timer)|ACPI: sleeping|nvme:|vmd|pci: (suspend|resume)|i915: (park|DC9|suspend|resume|unpark|dmc|resident display)" | tail -200
