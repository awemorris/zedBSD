diff --git a/plan/ws052/tests/alarm.asl b/plan/ws052/tests/alarm.asl
new file mode 100644
index 0000000000..7cf8fba08c
--- /dev/null
+++ b/plan/ws052/tests/alarm.asl
@@ -0,0 +1,69 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The table of the wake timer's host test (run-host-sleep.sh): a time and
+ * alarm device (ACPI000E) shaped as the Latitude 5330's AWAC, with AC and
+ * DC wake (_GCP 0x1e3), its expiry on GPE 0x15 (inside the harness's
+ * simulated GPE block), and _STV and _CWS that keep what they were told in
+ * names the test reads back (ACWA, DCWA, CWSN).  The GPE's method notifies
+ * the device's wake, as the 5330's _L72 does.
+ */
+DefinitionBlock ("", "DSDT", 2, "ZEDBSD", "WS052ALM", 1)
+{
+	Name (ACWA, Zero)
+	Name (DCWA, Zero)
+	Name (CWSN, Zero)
+
+	Scope (\_SB)
+	{
+		Device (AWAC)
+		{
+			Name (_HID, "ACPI000E")
+			Name (_PRW, Package (0x02) { 0x15, 0x04 })
+			Method (_STA, 0, NotSerialized)
+			{
+				Return (0x0F)
+			}
+
+			Method (_GCP, 0, NotSerialized)
+			{
+				Return (0x01E3)
+			}
+
+			Method (_STV, 2, Serialized)
+			{
+				If ((Arg0 == Zero))
+				{
+					ACWA = Arg1
+				}
+				Else
+				{
+					DCWA = Arg1
+				}
+
+				Return (Zero)
+			}
+
+			/* Counts the clears, one for each timer. */
+			Method (_CWS, 1, Serialized)
+			{
+				CWSN++
+				Return (Zero)
+			}
+		}
+	}
+
+	Scope (\_GPE)
+	{
+		/* The timer's expiry. */
+		Method (_L15, 0, NotSerialized)
+		{
+			Notify (\_SB.AWAC, 0x02)
+		}
+	}
+}
