 static int system_file_matches(struct file *candidate, const struct path *target, unsigned query_flags, unsigned *socket_match);
 static int system_path_matches(const struct path *candidate, const struct path *target, unsigned query_flags);
@@ -119,6 +121,13 @@ extern int drv_pci_suspend_all(struct drv_pci_device **failed) __attribute__((we
 extern int drv_pci_resume_all(void) __attribute__((weak));
 extern void drv_pci_device_name(struct drv_pci_device *device, char *text, size_t size) __attribute__((weak));
 
+/*
+ * The wake timer of S0 idle (the ACPI time and alarm device).  It is weak
+ * because only the platforms with ACPI build it; a null test makes
+ * KERN_SYSTEM_SET_WAKE_TIMER answer EOPNOTSUPP on the others.
+ */
+extern int drv_acpi_wake_timer_set(uint32_t seconds) __attribute__((weak));
+
 /*
  * Whether a sleep is under way: set by the KERN_SYSTEM_SLEEP that runs and
  * cleared when it returns, so that a second one is refused with EBUSY.
@@ -410,6 +419,103 @@ sleep_request_empty(
 	return 1;
 }
 
+/*
+ * Arms the wake timer of the next sleep to idle, or disarms it
+ * (KERN_SYSTEM_SET_WAKE_TIMER).  Only root may.
+ */
+static int
+system_set_wake_timer(
+	uintptr_t argument)
+{
+	struct system_wake_timer timer;
+	struct ucred *credential;
+	int superuser;
+	int error;
+
+	/* Refuses a caller that is not root. */
+	credential = cred_current_ref();
+	superuser = cred_is_superuser(credential);
+	cred_release(credential);
+	if (!superuser)
+		return EPERM;
+
+	/* Reads the request. */
+	error = copyin(argument, &timer, sizeof(timer));
+	if (error != 0)
+		return error;
+
+	/* Refuses a reserved field that is not zero. */
+	if (timer.reserved != 0U)
+		return EINVAL;
+
+	/* Refuses a platform without the timer. */
+	if (drv_acpi_wake_timer_set == NULL)
+		return EOPNOTSUPP;
+
+	/* Arms or disarms it. */
+	error = drv_acpi_wake_timer_set(timer.seconds);
+	if (error != 0)
+		return error;
+
+	/* Succeeded: the timer is armed for the seconds, or disarmed. */
+	return 0;
+}
+
+/*
+ * Copies out the state of S0 idle (KERN_SYSTEM_SLEEP_INFO): what the
+ * machine has, the sleeps since boot, the last one's outcome and the
+ * residency of the low-power idle states.  Anyone may read it.
+ */
+static int
+system_sleep_info(
+	uintptr_t argument)
+{
+	struct system_sleep_info info;
+	struct kern_sleep_info state;
+	const struct kern_sleep_residency *reading;
+	struct system_sleep_state_info *entry;
+	unsigned index;
+	int error;
+
+	/* The kernel's state of S0 idle. */
+	kern_sleep_info(&state);
+
+	/* The machine, the counts and the last sleep (the flags and reasons have the UAPI's numbers). */
+	kern_memset(&info, 0, sizeof(info));
+	info.version = KERN_SYSTEM_SLEEP_INFO_VERSION;
+	info.struct_size = sizeof(info);
+	info.flags = state.flags;
+	info.attempts = state.attempts;
+	info.entered = state.entered;
+	info.last_wake = state.last_wake;
+	info.last_result = state.last_result;
+	info.last_resume_result = state.last_resume_result;
+	info.last_spurious = state.last_spurious;
+	info.last_duration_us = state.last_duration_us;
+	kern_memcpy(info.last_device, state.last_device, sizeof(info.last_device));
+
+	/* Each low-power idle state: its counter now, and its residency in the last sleep when it was measured. */
+	info.state_count = state.state_count;
+	for (index = 0; index < state.state_count && index < KERN_SYSTEM_SLEEP_STATE_MAX; index++) {
+		reading = &state.states[index];
+		entry = &info.state[index];
+		entry->id = reading->id;
+		entry->flags = reading->flags;
+		entry->frequency = reading->frequency;
+		if ((reading->flags & KERN_SLEEP_STATE_READABLE) != 0U)
+			entry->total_us = kern_sleep_residency_us(NULL, reading);
+		entry->last_residency_us = state.last_residency_us[index];
+	}
+
+	/* Copies it out. */
+	error = copyout(&info, argument, sizeof(info));
+	if (error != 0)
+		return error;
+
+	/* Succeeded: the caller has the state. */
+	return 0;
+}
+
 /*
  * Suspends every device and resumes it again at once
  * (KERN_SYSTEM_SLEEP_DEVICES), the test of the devices' suspend and
@@ -495,6 +601,12 @@ system_ioctl(
