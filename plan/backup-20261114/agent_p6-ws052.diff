+/*
+ * Gives the controller its table of autonomous power state transitions,
+ * after a probe, a recovery or a resume reset it.
+ *
+ * It runs only when the boot line asks for it (NVME_TOKEN_APST_ON).  The
+ * table sends an idle controller into its non-operational states
+ * (drv_nvme_apst_build()); a controller with nowhere to go is told to
+ * make none.  A failure is logged and the controller runs on without: the
+ * transitions save power and do not change what a request does.  report
+ * logs the power states and the table once, at the probe.
+ */
+static void
+nvme_apst_apply(
+	struct nvme_controller *controller,
+	int recovery_command,
+	int report)
+{
+	struct drv_nvme_apst_summary summary;
+	struct drv_nvme_command command;
+	const char *line;
+	int enable;
+	int built;
+	int wanted;
