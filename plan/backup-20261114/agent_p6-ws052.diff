+	/* Says that a port was reset; nothing else tells whether D3hot loses a port's configuration. */
+	if (reset)
+		kern_logf("vmd: root port %04x:%02x:%02x.%u was reset in the sleep\n", host->segment, address.bus, address.device, address.function);
+
+	/* Waits for the link and the function behind a port that has one, which the core touches next. */
+	if (port->has_function) {
+		error = vmd_port_wait_ready(port, reset);
+		if (error != 0 && first_error == 0)
+			first_error = error;
+	}
+
+	/* Reports the first step that failed. */
+	if (first_error != 0)
+		return first_error;
+
+	/* Succeeded: the port runs again. */
+	return 0;
+}
+
+/*
+ * Waits, when the port was reset or its link is down, for the link to
+ * come up and then for the first function behind it to answer its
+ * configuration space (neither all ones nor the vendor 0001h of a
+ * function still starting).
+ *
+ * It reports ETIMEDOUT for a link or a function that did not come within
+ * the bound; a port that cannot report its link waits the link's whole
+ * bound.
+ */
+static int
+vmd_port_wait_ready(
+	struct vmd_port_power *port,
+	int reset)
+{
+	struct drv_pci_device *function;
+	struct drv_pci_bus *below;
+	uint64_t deadline;
+	uint16_t status;
+	uint16_t vendor;
+	int ready;
+	int wait;
+	int error;
+
+	/* A link the port reports down needs the wait as a reset does. */
+	wait = reset;
+	if (port->reports_link && port->pcie_offset != 0) {
+		status = 0;
+		(void)drv_pci_device_config_read16(port->device, port->pcie_offset + VMD_PCIE_LINK_STATUS, &status);
+		if ((status & VMD_PCIE_LINK_ACTIVE) == 0)
+			wait = 1;
+	}
+
+	/* A port whose link stayed up has nothing to wait for. */
+	if (!wait)
+		return 0;
+
+	/* Waits for the link. */
+	error = vmd_port_wait_link(port);
+	if (error != 0)
+		return error;
+
+	/* Finds the first function behind the port; without one there is nothing more to wait for. */
+	function = NULL;
+	below = drv_pci_device_subordinate_bus(port->device);
+	if (below != NULL)
+		(void)drv_pci_bus_foreach_device(below, vmd_first_function, &function);
+	if (function == NULL)
+		return 0;
+
+	/* Polls its vendor until it answers, or the bound passes. */
+	deadline = sched_ticks() + kern_ms_to_ticks(VMD_FUNCTION_READY_MS);
+	ready = 0;
+	while (!ready) {
+		/* Reads the vendor; a real one ends the wait. */
+		vendor = 0xffffU;
+		(void)drv_pci_device_config_read16(function, 0x00U, &vendor);
+		if (vendor != 0xffffU && vendor != VMD_VENDOR_STARTING) {
+			ready = 1;
+			break;
+		}
+
+		/* Gives up past the bound. */
+		if (sched_ticks() >= deadline)
+			break;
+
+		/* Lets the function start a while. */
+		kern_usleep_range(VMD_LINK_POLL_US, VMD_LINK_POLL_US);
+	}
+
+	/* Reports a function that did not answer. */
+	if (!ready)
+		return ETIMEDOUT;
+
+	/* Succeeded: the function behind the port answers. */
+	return 0;
+}
+
+/*
+ * Waits for a port's link to come up, then for the function behind it.
+ *
+ * It reports ETIMEDOUT for a link that did not come up within the bound;
+ * a port that cannot report its link waits the whole bound.
+ */
+static int
+vmd_port_wait_link(
+	struct vmd_port_power *port)
+{
+	uint64_t deadline;
+	uint16_t status;
+	int up;
+	int error;
+
+	/* A port that cannot report its link is given the whole bound. */
+	if (!port->reports_link || port->pcie_offset == 0) {
+		sched_sleep(sched_ticks() + kern_ms_to_ticks(VMD_LINK_UP_MS));
+		return 0;
+	}
+
+	/* Polls the link status until the data link layer is up, or the bound passes. */
+	deadline = sched_ticks() + kern_ms_to_ticks(VMD_LINK_UP_MS);
+	up = 0;
+	while (!up) {
+		/* Reads the status; a link that answers active ends the wait. */
+		status = 0;
+		error = drv_pci_device_config_read16(port->device, port->pcie_offset + VMD_PCIE_LINK_STATUS, &status);
+		if (error == 0 && (status & VMD_PCIE_LINK_ACTIVE) != 0) {
+			up = 1;
+			break;
+		}
+
+		/* Gives up past the bound. */
+		if (sched_ticks() >= deadline)
+			break;
+
+		/* Lets the link train a while. */
+		kern_usleep_range(VMD_LINK_POLL_US, VMD_LINK_POLL_US);
+	}
+
+	/* Reports a link that did not come up. */
+	if (!up)
+		return ETIMEDOUT;
+
+	/* Gives the function behind the link its time before a configuration request. */
+	sched_sleep(sched_ticks() + kern_ms_to_ticks(VMD_LINK_SETTLE_MS));
+
+	/* Succeeded: the function behind the port may be touched. */
+	return 0;
+}
+
+/* Finds the single-function endpoint at slot 0, function 0 behind a port. */
+static int
+vmd_find_function(
+	struct drv_pci_device *device,
+	void *argument)
+{
+	struct drv_pci_address address;
+	struct drv_pci_device **found;
+	bool bridge;
+	bool multifunction;
+
+	/* Passes over every function but the first of slot 0. */
+	found = argument;
+	drv_pci_device_address(device, &address);
+	if (address.device != 0 || address.function != 0)
+		return 0;
+
+	/*
+	 * Leaves out a switch, whose links this driver does not manage, and a
+	 * device of several functions, whose functions would all need the same
+	 * link settings.
+	 */
+	bridge = drv_pci_device_is_bridge(device);
+	multifunction = drv_pci_device_is_multifunction(device);
+	if (bridge || multifunction)
+		return 0;
+
+	/* Takes it. */
+	*found = device;
+
+	/* Stops at the function found. */
+	return 1;
+}
+
+/*
+ * Gives the link below one root port the power management both ends
+ * allow: ASPM L1, the L1 PM Substates and LTR.
+ *
+ * ASPM is turned off at both ends first, the substates are configured
+ * with their enables clear and then enabled at the port before the
+ * function, and ASPM L1 is enabled at the port before the function.  A
+ * link whose registers cannot be read is left as it was; one that fails
+ * on the way is left with ASPM off.
+ *
+ * Procedure referenced: PCI Express Base Specification Revision 4.0,
+ * section 5.5.4 (the L1 PM Substates are configured with ASPM L1 disabled,
+ * the power-on time and the threshold before the enables, the enables set
+ * in the upstream component first, and LTR enabled before ASPM L1.2);
+ * Linux 6.12 drivers/pci/pcie/aspm.c (the order: L1 enabled at the
+ * upstream component first and disabled at the downstream one first).
+ */
+static void
+vmd_link_power(
+	struct vmd_host *host,
+	struct vmd_port_power *port)
+{
+	struct drv_pci_link_plan plan;
+	struct drv_pci_link_end upper;
+	struct drv_pci_link_end lower;
+	struct drv_pci_address address;
+	struct drv_pci_device *function;
+	struct drv_pci_bus *below;
+	unsigned function_pcie;
+	unsigned port_l1ss;
+	unsigned function_l1ss;
+	unsigned function_ltr;
+	unsigned unused_ltr;
+	uint32_t control2_clear;
+	uint32_t function_clear;
+	uint32_t port_clear;
+	int error;
+
+	/* Finds the function below the port; a port without one has no link to configure. */
+	function = NULL;
+	below = drv_pci_device_subordinate_bus(port->device);
+	if (port->pcie_offset == 0 || below == NULL)
+		return;
+	(void)drv_pci_bus_foreach_device(below, vmd_find_function, &function);
+	if (function == NULL)
+		return;
+
+	/* Reads what the port reports. */
+	error = vmd_link_read_end(port->device, port->pcie_offset, &upper, &port_l1ss, &unused_ltr);
+	if (error != 0)
+		return;
+
+	/* Finds the function's PCI Express capability and reads what it reports. */
+	error = drv_pci_device_find_capability(function, VMD_CAP_PCIE, &function_pcie);
+	if (error != 0)
+		return;
+	error = vmd_link_read_end(function, function_pcie, &lower, &function_l1ss, &function_ltr);
+	if (error != 0)
+		return;
+
+	/*
+	 * Leaves alone a link whose registers read as all ones: an end that
+	 * does not answer would look as though it supported everything.
+	 */
+	drv_pci_device_address(port->device, &address);
+	if (upper.link_capabilities == 0xffffffffU ||
+	    lower.link_capabilities == 0xffffffffU ||
+	    lower.device_capabilities == 0xffffffffU ||
+	    upper.l1ss_capabilities == 0xffffffffU ||
+	    lower.l1ss_capabilities == 0xffffffffU) {
+		kern_logf("vmd: link %04x:%02x:%02x.%u: an end does not answer; left alone\n", host->segment, address.bus, address.device, address.function);
+		return;
+	}
+
+	/* Decides what the link may use. */
+	error = drv_pci_link_plan_make(&upper, &lower, &plan);
+	if (error != 0) {
+		kern_logf("vmd: link %04x:%02x:%02x.%u: no plan (%d)\n", host->segment, address.bus, address.device, address.function, error);
+		return;
+	}
+
+	/* Turns ASPM off at both ends, the function first. */
+	vmd_link_aspm_off(port->device, port->pcie_offset, function, function_pcie);
+
+	/* Gives the function a latency when it has none, before it may report. */
+	if (plan.ltr_latency_write && function_ltr != 0) {
+		(void)drv_pci_device_config_write16(function, function_ltr + DRV_PCI_LINK_LTR_MAX_SNOOP, plan.ltr_latency);
+		(void)drv_pci_device_config_write16(function, function_ltr + DRV_PCI_LINK_LTR_MAX_NO_SNOOP, plan.ltr_latency);
+	}
+
+	/* Enables LTR at the port, then at the function. */
+	if (plan.ltr) {
+		vmd_update16(port->device, port->pcie_offset + DRV_PCI_LINK_DEVICE_CONTROL2, 0, DRV_PCI_LINK_DEVCTL2_LTR);
+		vmd_update16(function, function_pcie + DRV_PCI_LINK_DEVICE_CONTROL2, 0, DRV_PCI_LINK_DEVCTL2_LTR);
+	}
+
+	/* Clears the substates' enables at the function, then at the port, before their values change. */
+	if (port_l1ss != 0 && function_l1ss != 0) {
+		vmd_update32(function, function_l1ss + DRV_PCI_LINK_L1SS_CONTROL1, DRV_PCI_LINK_L1SS_ENABLE_MASK, 0);
+		vmd_update32(port->device, port_l1ss + DRV_PCI_LINK_L1SS_CONTROL1, DRV_PCI_LINK_L1SS_ENABLE_MASK, 0);
+	}
+
+	/* Writes the substates' values at both ends, then their enables at the port before the function. */
+	if (plan.l1ss_enable != 0) {
+		/* The power-on time, leaving the reserved bits of Control 2. */
+		control2_clear = DRV_PCI_LINK_L1SS_CONTROL2_SCALE_MASK |
+		    (DRV_PCI_LINK_L1SS_POWER_ON_VALUE_MASK << DRV_PCI_LINK_L1SS_CONTROL2_VALUE_SHIFT);
+		vmd_update32(port->device, port_l1ss + DRV_PCI_LINK_L1SS_CONTROL2, control2_clear, plan.control2);
+		vmd_update32(function, function_l1ss + DRV_PCI_LINK_L1SS_CONTROL2, control2_clear, plan.control2);
+
+		/* The threshold at both ends, and the common-mode restore time at the port. */
+		function_clear = (DRV_PCI_LINK_L1SS_THRESHOLD_VALUE_MASK << DRV_PCI_LINK_L1SS_THRESHOLD_VALUE_SHIFT) |
+		    (DRV_PCI_LINK_L1SS_THRESHOLD_SCALE_MASK << DRV_PCI_LINK_L1SS_THRESHOLD_SCALE_SHIFT);
+		port_clear = function_clear | (DRV_PCI_LINK_L1SS_CMRT_MASK << DRV_PCI_LINK_L1SS_CMRT_SHIFT);
+		vmd_update32(port->device, port_l1ss + DRV_PCI_LINK_L1SS_CONTROL1, port_clear, plan.port_control1);
+		vmd_update32(function, function_l1ss + DRV_PCI_LINK_L1SS_CONTROL1, function_clear, plan.function_control1);
+
+		/* The enables, the port first. */
+		vmd_update32(port->device, port_l1ss + DRV_PCI_LINK_L1SS_CONTROL1, 0, plan.l1ss_enable);
+		vmd_update32(function, function_l1ss + DRV_PCI_LINK_L1SS_CONTROL1, 0, plan.l1ss_enable);
+	}
+
+	/* Enables ASPM L1 at the port, then at the function. */
+	if (plan.aspm_l1) {
+		vmd_update16(port->device, port->pcie_offset + DRV_PCI_LINK_LINK_CONTROL, 0, DRV_PCI_LINK_LNKCTL_ASPM_L1);
+		vmd_update16(function, function_pcie + DRV_PCI_LINK_LINK_CONTROL, 0, DRV_PCI_LINK_LNKCTL_ASPM_L1);
+	}
+
+	/* Reports what the link uses. */
+	kern_logf("vmd: link %04x:%02x:%02x.%u aspm%s%s substates%s%s%s%s%s ltr%s threshold %u ns\n",
+		  host->segment,
+		  address.bus,
+		  address.device,
+		  address.function,
+		  plan.aspm_l1 ? " l1" : " off",
+		  plan.aspm_reasons != 0 ? " (refused)" : "",
+		  (plan.l1ss_enable & DRV_PCI_LINK_L1SS_PCIPM_L12) != 0 ? " pcipm-l1.2" : "",
+		  (plan.l1ss_enable & DRV_PCI_LINK_L1SS_PCIPM_L11) != 0 ? " pcipm-l1.1" : "",
+		  (plan.l1ss_enable & DRV_PCI_LINK_L1SS_ASPM_L12) != 0 ? " aspm-l1.2" : "",
+		  (plan.l1ss_enable & DRV_PCI_LINK_L1SS_ASPM_L11) != 0 ? " aspm-l1.1" : "",
+		  plan.l1ss_enable == 0 ? " none" : "",
+		  plan.ltr ? " on" : " off",
+		  (unsigned)plan.threshold_ns);
+}
+
+/*
+ * Reads what one end of a link reports: its PCI Express registers, and its
+ * L1 PM Substates and LTR capabilities, whose offsets l1ss and ltr receive
+ * (zero for none).  It reports EIO when a register cannot be read.
+ */
+static int
+vmd_link_read_end(
+	struct drv_pci_device *device,
+	unsigned pcie,
+	struct drv_pci_link_end *end,
+	unsigned *l1ss,
+	unsigned *ltr)
+{
+	int error;
+
+	/* Starts with nothing reported. */
+	kern_memset(end, 0, sizeof(*end));
+	*l1ss = 0;
+	*ltr = 0;
+
+	/* Reads the device, link and device 2 capabilities and the link control. */
+	error = drv_pci_device_config_read32(device, pcie + DRV_PCI_LINK_DEVICE_CAPABILITIES, &end->device_capabilities);
+	if (error != 0)
+		return EIO;
+	error = drv_pci_device_config_read32(device, pcie + DRV_PCI_LINK_LINK_CAPABILITIES, &end->link_capabilities);
+	if (error != 0)
+		return EIO;
+	error = drv_pci_device_config_read16(device, pcie + DRV_PCI_LINK_LINK_CONTROL, &end->link_control);
+	if (error != 0)
+		return EIO;
+	error = drv_pci_device_config_read32(device, pcie + DRV_PCI_LINK_DEVICE_CAPABILITIES2, &end->device_capabilities2);
+	if (error != 0)
+		return EIO;
+
+	/* Reads the L1 PM Substates capabilities, when the end has them. */
+	error = drv_pci_device_find_extended_capability(device, DRV_PCI_LINK_EXTENDED_L1SS, 0, l1ss);
+	if (error == 0) {
+		error = drv_pci_device_config_read32(device, *l1ss + DRV_PCI_LINK_L1SS_CAPABILITIES, &end->l1ss_capabilities);
+		if (error != 0)
+			return EIO;
+		end->has_l1ss = 1;
+	} else {
+		*l1ss = 0;
+	}
+
+	/* Reads the LTR latencies, when the end has the capability. */
+	error = drv_pci_device_find_extended_capability(device, DRV_PCI_LINK_EXTENDED_LTR, 0, ltr);
+	if (error == 0) {
+		error = drv_pci_device_config_read16(device, *ltr + DRV_PCI_LINK_LTR_MAX_SNOOP, &end->ltr_max_snoop);
+		if (error != 0)
+			return EIO;
+		error = drv_pci_device_config_read16(device, *ltr + DRV_PCI_LINK_LTR_MAX_NO_SNOOP, &end->ltr_max_no_snoop);
+		if (error != 0)
+			return EIO;
+		end->has_ltr = 1;
+	} else {
+		*ltr = 0;
+	}
+
+	/* Succeeded: the end is described. */
+	return 0;
+}
+
+/* Turns ASPM off at both ends of a link, the function below it first. */
+static void
+vmd_link_aspm_off(
+	struct drv_pci_device *port,
+	unsigned port_pcie,
+	struct drv_pci_device *function,
+	unsigned function_pcie)
+{
+	/* Clears the ASPM control of the function, then of the port, by 16 bits, which leaves the link status alone. */
+	vmd_update16(function, function_pcie + DRV_PCI_LINK_LINK_CONTROL, DRV_PCI_LINK_LNKCTL_ASPM_MASK, 0);
+	vmd_update16(port, port_pcie + DRV_PCI_LINK_LINK_CONTROL, DRV_PCI_LINK_LNKCTL_ASPM_MASK, 0);
+}
+
+/*
+ * Clears and sets bits of a 16-bit control register, leaving the others.
+ *
+ * The access is 16 bits wide, so that the status register beside a
+ * control register, whose bits clear when written as one, is not written.
+ */
+static void
+vmd_update16(
+	struct drv_pci_device *device,
+	unsigned offset,
+	uint16_t clear,
+	uint16_t set)
+{
+	uint16_t value;
+	int error;
+
+	/* Reads the register; one that cannot be read is left alone. */
+	error = drv_pci_device_config_read16(device, offset, &value);
+	if (error != 0)
+		return;
+
+	/* Writes it back changed. */
+	(void)drv_pci_device_config_write16(device, offset, (uint16_t)((value & ~clear) | set));
+}
+
+/* Clears and sets bits of a 32-bit register, leaving the others. */
+static void
+vmd_update32(
+	struct drv_pci_device *device,
+	unsigned offset,
+	uint32_t clear,
+	uint32_t set)
+{
+	uint32_t value;
+	int error;
+
+	/* Reads the register; one that cannot be read is left alone. */
+	error = drv_pci_device_config_read32(device, offset, &value);
+	if (error != 0)
+		return;
+
+	/* Writes it back changed. */
+	(void)drv_pci_device_config_write32(device, offset, (value & ~clear) | set);
+}
+
+/*
+ * Reports whether the firmware forbids the operating system to enable
+ * ASPM: the FADT's boot architecture flag "PCIe ASPM Controls".  Without
+ * ACPI nothing forbids it.
+ */
+static int
+vmd_firmware_forbids_aspm(
+	void)
+{
+	int forbidden;
+
+	/* Asks the ACPI driver, which holds the FADT. */
+	forbidden = 0;
+#if CONFIG_DRIVER_ACPI
+	forbidden = drv_acpi_pcie_aspm_forbidden();
+#endif
+
+	/* Reports what the firmware says. */
+	if (forbidden)
+		return 1;
+
+	/* Nothing forbids ASPM. */
+	return 0;
+}
