+		/* A state not read before, or read only once, has no residency to tell. */
+		if (index >= before_count ||
+		    before[index].id != after->id ||
+		    (before[index].flags & KERN_SLEEP_STATE_READABLE) == 0U ||
+		    (after->flags & KERN_SLEEP_STATE_READABLE) == 0U) {
+			kern_logf("sleep: low-power idle state %u not measured\n", (unsigned)after->id);
+			continue;
+		}
+
+		/* The residency, and the log that shows it. */
+		elapsed = kern_sleep_residency_us(&before[index], after);
+		record->last_residency_us[index] = elapsed;
+		after->flags |= KERN_SLEEP_STATE_MEASURED;
