+/*
+ * Converts counts at a frequency in hertz to microseconds, whole seconds
+ * first so that a large count does not overflow; zero for a frequency
+ * that is not known.
+ */
+static uint64_t
+sleep_counter_us(
+	uint64_t count,
+	uint64_t frequency)
+{
+	uint64_t seconds;
+	uint64_t rest;
+	uint64_t elapsed;
+
+	/* A counter whose frequency is not known counted nothing that can be told. */
+	if (frequency == 0U)
+		return 0U;
+
+	/* The whole seconds, and the microseconds of what remains. */
+	seconds = count / frequency;
+	rest = count % frequency;
+	elapsed = seconds * SLEEP_US_PER_SECOND;
+	elapsed += (rest * SLEEP_US_PER_SECOND) / frequency;
+
+	/* Reports the microseconds. */
+	return elapsed;
