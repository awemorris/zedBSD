diff --git a/include/kern/sleep.h b/include/kern/sleep.h
index f54893993f..75b14adb76 100644
--- a/include/kern/sleep.h
+++ b/include/kern/sleep.h
@@ -6,9 +6,9 @@
  */
 
 /*
- * The system sleep to idle, S0ix (ws052-p006, README-v2 §7): the
- * coordinator the sleep request runs, the idle loop's hook, and the notes
- * the drivers leave of what woke the system.
+ * The system sleep to idle, S0ix: the coordinator the sleep request runs,
+ * the idle loop's hook, the notes the drivers leave of what woke the
+ * system, and the residency of the low-power idle states.
  */
 
 #ifndef KERN_KERN_SLEEP_H
@@ -51,9 +51,78 @@ struct kern_sleep_outcome {
 	char device[KERN_SLEEP_DEVICE_MAX];
 };
 
+/* The most low-power idle states whose residency a sleep reports. */
+#define KERN_SLEEP_STATE_MAX		4U
+
+/*
+ * What is known of a low-power idle state's residency counter (the same
+ * numbers as the UAPI's KERN_SYSTEM_SLEEP_STATE_*): the firmware lists
+ * the state as disabled or without a counter, the kernel reads the
+ * counter, the counter is in memory (the platform's own) or a processor
+ * register, and the residency of the last sleep was measured.
+ */
+#define KERN_SLEEP_STATE_DISABLED	0x01U
+#define KERN_SLEEP_STATE_NO_COUNTER	0x02U
+#define KERN_SLEEP_STATE_READABLE	0x04U
+#define KERN_SLEEP_STATE_MEMORY		0x08U
+#define KERN_SLEEP_STATE_PROCESSOR	0x10U
+#define KERN_SLEEP_STATE_MEASURED	0x20U
+
+/*
+ * One reading of a low-power idle state's residency counter, as the
+ * firmware's table describes the state: its identifier, what is known of
+ * it (KERN_SLEEP_STATE_*), the counter's frequency (0 when the firmware
+ * gives the processor's time-stamp frequency), the largest value before
+ * the counter wraps to zero, and the counter's value when READABLE.
+ */
+struct kern_sleep_residency {
+	uint32_t id;
+	uint32_t flags;
+	uint64_t frequency;
+	uint64_t mask;
+	uint64_t value;
+};
+
+/*
+ * What the machine has for S0 idle (the same numbers as the UAPI's
+ * KERN_SYSTEM_SLEEP_HAS_* and KERN_SYSTEM_SLEEP_CAN_SLEEP), and whether a
+ * sleep to idle has been tried since boot.
+ */
+#define KERN_SLEEP_HAS_IDLE_STATE	0x001U
+#define KERN_SLEEP_HAS_S0_IDLE		0x002U
+#define KERN_SLEEP_HAS_LPS0		0x004U
+#define KERN_SLEEP_HAS_WAKE_TIMER	0x008U
+#define KERN_SLEEP_CAN_SLEEP		0x010U
+#define KERN_SLEEP_LAST_VALID		0x100U
+
+/*
+ * The state of S0 idle for KERN_SYSTEM_SLEEP_INFO: what the machine has,
+ * how many sleeps to idle were tried and how many entered, the last one's
+ * outcome (its wake, result, resume result, spurious wakes, the time it
+ * slept by the HAL's counter and the device that refused), and each
+ * low-power idle state's counter now with its residency during the last
+ * sleep.
+ */
+struct kern_sleep_info {
+	uint32_t flags;
+	uint32_t attempts;
+	uint32_t entered;
+	uint32_t last_wake;
+	int32_t last_result;
+	int32_t last_resume_result;
+	uint32_t last_spurious;
+	uint64_t last_duration_us;
+	unsigned state_count;
+	struct kern_sleep_residency states[KERN_SLEEP_STATE_MAX];
+	uint64_t last_residency_us[KERN_SLEEP_STATE_MAX];
+	char last_device[KERN_SLEEP_DEVICE_MAX];
+};
+
 int kern_sleep_supported(void);
 void kern_sleep_s0idle(struct kern_sleep_outcome *outcome);
 void kern_sleep_idle(hal_cpu_id_t cpu);
 void kern_sleep_note_wake(unsigned reason);
+void kern_sleep_info(struct kern_sleep_info *info);
+uint64_t kern_sleep_residency_us(const struct kern_sleep_residency *before, const struct kern_sleep_residency *after);
 
 #endif
diff --git a/include/uapi/system.h b/include/uapi/system.h
index 2b73d52c65..de8d6642d0 100644
--- a/include/uapi/system.h
+++ b/include/uapi/system.h
@@ -453,6 +453,101 @@ _Static_assert(offsetof(struct system_sleep_request, device) == 16U,
 #define KERN_SYSTEM_SLEEP                                                   \
 	_IOWR(KERN_SYSTEM_IOC_GROUP, 19, struct system_sleep_request)
 
+/*
+ * The wake timer of S0 idle: KERN_SYSTEM_SET_WAKE_TIMER arms the
+ * firmware's time and alarm device (ACPI000E) to wake the machine seconds
+ * from now, out of the next KERN_SYSTEM_SLEEP_S0IDLE (the wake reason is
+ * then KERN_SYSTEM_WAKE_TIMER).  The time counts from the ioctl, not from
+ * the sleep.  The kernel disarms the timer when that sleep ends, whether
+ * the timer woke the machine or not, and seconds zero disarms it at once.
+ * reserved is zero.  Only root may arm it (EPERM); EINVAL for a reserved
+ * field that is not zero or seconds of 0xffffffff, EOPNOTSUPP on a
+ * machine without a time and alarm device that can wake it, EIO when the
+ * firmware refused.
+ */
+struct system_wake_timer {
+	uint32_t seconds;
+	uint32_t reserved;
+};
+
+_Static_assert(sizeof(struct system_wake_timer) == 8U,
+    "wake timer ABI must be identical on ILP32 and LP64");
+
+#define KERN_SYSTEM_SET_WAKE_TIMER                                          \
+	_IOW(KERN_SYSTEM_IOC_GROUP, 22, struct system_wake_timer)
+
+/*
+ * The state of S0 idle (KERN_SYSTEM_SLEEP_INFO, anyone may read it): what
+ * the machine has (flags, KERN_SYSTEM_SLEEP_HAS_*), how many
+ * KERN_SYSTEM_SLEEP_S0IDLE requests ran (attempts) and how many of them
+ * entered the sleep (entered), and the outcome of the last one (valid with
+ * KERN_SYSTEM_SLEEP_LAST_VALID): its wake reason, result, resume result,
+ * the spurious wakes it slept through, the time it slept in microseconds
+ * by the kernel's counter, and the device that refused.
+ *
+ * state lists the low-power idle states the firmware's LPIT describes
+ * (state_count of them, at most KERN_SYSTEM_SLEEP_STATE_MAX).  Each has
+ * its identifier, what is known of it (KERN_SYSTEM_SLEEP_STATE_*), its
+ * counter's frequency (0: the processor's time-stamp frequency), the
+ * counter's value now in microseconds (total_us, which wraps with the
+ * counter; valid with READABLE) and the residency during the last sleep
+ * (last_residency_us, valid with MEASURED).  On Intel platforms the state
+ * whose counter is in memory (MEMORY) counts the platform's SLP_S0, and a
+ * processor register's (PROCESSOR) the package's deepest C-state.
+ */
+#define KERN_SYSTEM_SLEEP_INFO_VERSION	1U
+#define KERN_SYSTEM_SLEEP_STATE_MAX	4U
+
+#define KERN_SYSTEM_SLEEP_HAS_IDLE_STATE	0x001U	/* the processors have a suspend-safe idle state */
+#define KERN_SYSTEM_SLEEP_HAS_S0_IDLE		0x002U	/* the firmware declares low-power S0 idle (FADT) */
+#define KERN_SYSTEM_SLEEP_HAS_LPS0		0x004U	/* the LPS0 device attached */
+#define KERN_SYSTEM_SLEEP_HAS_WAKE_TIMER	0x008U	/* KERN_SYSTEM_SET_WAKE_TIMER can wake the machine */
+#define KERN_SYSTEM_SLEEP_CAN_SLEEP		0x010U	/* KERN_SYSTEM_SLEEP_S0IDLE would not be refused */
+#define KERN_SYSTEM_SLEEP_LAST_VALID		0x100U	/* the last_* fields tell of a request since boot */
+
+#define KERN_SYSTEM_SLEEP_STATE_DISABLED	0x01U	/* the firmware lists the state as disabled */
+#define KERN_SYSTEM_SLEEP_STATE_NO_COUNTER	0x02U	/* the firmware gives the state no counter */
+#define KERN_SYSTEM_SLEEP_STATE_READABLE	0x04U	/* the kernel reads the counter (total_us) */
+#define KERN_SYSTEM_SLEEP_STATE_MEMORY		0x08U	/* the counter is in memory, the platform's own */
+#define KERN_SYSTEM_SLEEP_STATE_PROCESSOR	0x10U	/* the counter is a processor register */
+#define KERN_SYSTEM_SLEEP_STATE_MEASURED	0x20U	/* last_residency_us was measured across the last sleep */
+
+struct system_sleep_state_info {
+	uint32_t id;
+	uint32_t flags;
+	uint64_t frequency;
+	uint64_t total_us;
+	uint64_t last_residency_us;
+};
+
+struct system_sleep_info {
+	uint32_t version;
+	uint32_t struct_size;
+	uint32_t flags;
+	uint32_t state_count;
+	uint32_t attempts;
+	uint32_t entered;
+	uint32_t last_wake;
+	int32_t last_result;
+	int32_t last_resume_result;
+	uint32_t last_spurious;
+	uint64_t last_duration_us;
+	struct system_sleep_state_info state[KERN_SYSTEM_SLEEP_STATE_MAX];
+	char last_device[KERN_SYSTEM_SLEEP_DEVICE_MAX];
+};
+
+_Static_assert(sizeof(struct system_sleep_state_info) == 32U,
+    "sleep state ABI must be identical on ILP32 and LP64");
+_Static_assert(sizeof(struct system_sleep_info) == 224U,
+    "sleep info ABI must be identical on ILP32 and LP64");
+_Static_assert(offsetof(struct system_sleep_info, state) == 48U,
+    "sleep info state offset is an ABI contract");
+_Static_assert(offsetof(struct system_sleep_info, last_device) == 176U,
+    "sleep info device offset is an ABI contract");
+
+#define KERN_SYSTEM_SLEEP_INFO                                              \
+	_IOR(KERN_SYSTEM_IOC_GROUP, 23, struct system_sleep_info)
+
