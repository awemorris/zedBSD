 read_physical(
diff --git a/src/drivers/acpi/acpi-lpit.c b/src/drivers/acpi/acpi-lpit.c
new file mode 100644
index 0000000000..846f4465e0
--- /dev/null
+++ b/src/drivers/acpi/acpi-lpit.c
@@ -0,0 +1,443 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The residency counters of the low-power idle states.
+ *
+ * The firmware's Low Power Idle Table lists the platform's low-power idle
+ * states, each with the generic address of a counter that counts the time
+ * spent in it.  The table is read once at attachment; a counter in memory
+ * is mapped then and read whenever asked, so that the sleep to idle can
+ * tell how long the platform stayed in each state.  A counter that is a
+ * processor register (functional fixed hardware) is listed but not read:
+ * reading it is the HAL's, and the HAL has no call for it.
+ */
+
+#include <kern/kcrt.h>
+#include <kern/klog.h>
+#include <kern/pmem.h>
+#include <kern/device-io.h>
+#include <kern/sleep.h>
+#include <uapi/errno.h>
+
+#include <drivers/acpi/acpi.h>
+
+#include "acpi-lpit.h"
+
+#include <stdbool.h>
+
+/*
+ * The layout of the table and of one native C-state descriptor: the
+ * header every system description table starts with, then descriptors
+ * that each start with their type and length.  A native C-state
+ * descriptor has its identifier, its flags, its entry trigger, its least
+ * residency and its latency, the generic address of its residency counter
+ * and the counter's frequency.
+ *
+ * Values referenced: Intel, ACPI Low Power Idle Table (LPIT), revision
+ * 001 (2015), the table header and the native C-state idle structure
+ * (type 0) with its fields and their offsets.
+ */
+#define LPIT_HEADER_SIZE	36U
+#define LPIT_ENTRY_TYPE		0U
+#define LPIT_ENTRY_LENGTH	4U
+#define LPIT_ENTRY_ID		8U
+#define LPIT_ENTRY_FLAGS	12U
+#define LPIT_ENTRY_COUNTER	36U
+#define LPIT_ENTRY_FREQUENCY	48U
+#define LPIT_NATIVE_SIZE	56U
+#define LPIT_TYPE_NATIVE	0U
+
+/* The least length of a descriptor: its type and its length. */
+#define LPIT_ENTRY_MINIMUM	8U
+
+/*
+ * The fields of a generic address structure, from its start: the address
+ * space, the register's width and offset in bits, the access size, and
+ * the address.  The access sizes 1 to 4 are a byte, a word, a double word
+ * and a quad word; 0 leaves the size to the width.
+ *
+ * Values referenced: ACPI Specification 6.5, section 5.2.3.2, Generic
+ * Address Structure (table 5.1).
+ */
+#define GAS_SPACE		0U
+#define GAS_WIDTH		1U
+#define GAS_OFFSET		2U
+#define GAS_ACCESS		3U
+#define GAS_ADDRESS		4U
+#define GAS_ACCESS_BYTE		1U
+#define GAS_ACCESS_QWORD	4U
+
+/*
+ * The states the table described, and the mapping of each counter in
+ * memory (NULL for a counter that is not mapped).  They are filled once by
+ * drv_acpi_lpit_attach() before lpit_ready is set, and only read after it,
+ * so the readings need no lock.
+ */
+static struct drv_acpi_lpit_state lpit_states[DRV_ACPI_LPIT_STATES_MAX];
+static volatile void *lpit_counters[DRV_ACPI_LPIT_STATES_MAX];
+static unsigned lpit_count;
+
+/* Set once the states and their mappings are in place; zero means no table was read. */
+static unsigned lpit_ready;
+
+static int map_counter(const struct drv_acpi_lpit_state *state, volatile void **mapped);
+static unsigned counter_bytes(const struct drv_acpi_lpit_state *state);
+static uint64_t counter_mask(const struct drv_acpi_lpit_state *state);
+static uint64_t read_counter(const struct drv_acpi_lpit_state *state, volatile void *mapped);
+static uint32_t load_u32(const uint8_t *bytes);
+static uint64_t load_u64(const uint8_t *bytes);
+
+/*
+ * Reads the native C-states of a Low Power Idle Table.
+ *
+ * Up to max states are kept in states, in the table's order, and count
+ * receives how many.  A descriptor of another type is passed over.  It
+ * reports EINVAL for a table too short for its header or whose length is
+ * past the bytes given, and stops at a descriptor whose length is too
+ * short or runs past the table, keeping the states before it.
+ */
+int
+drv_acpi_lpit_parse(
+	const uint8_t *table,
+	size_t length,
+	struct drv_acpi_lpit_state *states,
+	unsigned max,
+	unsigned *count)
+{
+	struct drv_acpi_lpit_state *state;
+	const uint8_t *entry;
+	uint32_t table_length;
+	uint32_t entry_length;
+	uint32_t type;
+	size_t remaining;
+
+	/* Nothing kept yet. */
+	*count = 0U;
+
+	/* Refuses a table without a whole header or longer than its bytes. */
+	if (table == NULL || length < LPIT_HEADER_SIZE)
+		return EINVAL;
+	table_length = load_u32(table + 4U);
+	if (table_length < LPIT_HEADER_SIZE || table_length > length)
+		return EINVAL;
+
+	/* Each descriptor, as long as a whole one remains and there is room. */
+	entry = table + LPIT_HEADER_SIZE;
+	remaining = table_length - LPIT_HEADER_SIZE;
+	while (remaining >= LPIT_ENTRY_MINIMUM && *count < max) {
+		/* Its length, which must hold its type and length and stay inside the table. */
+		entry_length = load_u32(entry + LPIT_ENTRY_LENGTH);
+		if (entry_length < LPIT_ENTRY_MINIMUM || entry_length > remaining)
+			break;
+
+		/* A whole native C-state descriptor is kept. */
+		type = load_u32(entry + LPIT_ENTRY_TYPE);
+		if (type == LPIT_TYPE_NATIVE && entry_length >= LPIT_NATIVE_SIZE) {
+			state = &states[*count];
+			kern_memset(state, 0, sizeof(*state));
+			state->id = (uint32_t)entry[LPIT_ENTRY_ID] | ((uint32_t)entry[LPIT_ENTRY_ID + 1U] << 8);
+			state->flags = load_u32(entry + LPIT_ENTRY_FLAGS);
+			state->counter_space = entry[LPIT_ENTRY_COUNTER + GAS_SPACE];
+			state->counter_width = entry[LPIT_ENTRY_COUNTER + GAS_WIDTH];
+			state->counter_offset = entry[LPIT_ENTRY_COUNTER + GAS_OFFSET];
+			state->counter_access = entry[LPIT_ENTRY_COUNTER + GAS_ACCESS];
+			state->counter_address = load_u64(entry + LPIT_ENTRY_COUNTER + GAS_ADDRESS);
+			state->frequency = load_u64(entry + LPIT_ENTRY_FREQUENCY);
+			(*count)++;
+		}
+
+		/* The next descriptor. */
+		entry += entry_length;
+		remaining -= entry_length;
+	}
+
+	/* Succeeded: the states the table describes, up to max. */
+	return 0;
+}
+
+/*
+ * Reads the firmware's Low Power Idle Table and maps the residency
+ * counters that are in memory.
+ *
+ * Called once the tables are found.  It reports ENODEV when the platform
+ * has no such table; a counter that cannot be mapped is logged and left
+ * unread.
+ */
+int
+drv_acpi_lpit_attach(void)
+{
+	const struct drv_acpi_lpit_state *state;
+	const uint8_t *table;
+	size_t length;
+	unsigned index;
+	unsigned count;
+	int error;
+
+	/* The table, which a platform without low-power idle states does not have. */
+	error = drv_acpi_table_lookup("LPIT", &table, &length);
+	if (error != 0)
+		return ENODEV;
+
+	/* Its native C-states. */
+	error = drv_acpi_lpit_parse(table, length, lpit_states, DRV_ACPI_LPIT_STATES_MAX, &count);
+	if (error != 0) {
+		kern_logf("acpi: the LPIT is malformed (error %d)\n", error);
+		return error;
+	}
+
+	/* Maps each enabled state's counter that is in memory, and logs every state. */
+	for (index = 0; index < count; index++) {
+		state = &lpit_states[index];
+		lpit_counters[index] = NULL;
+
+		/* A counter in memory of an enabled state that has one is mapped. */
+		if ((state->flags & (DRV_ACPI_LPIT_DISABLED | DRV_ACPI_LPIT_NO_COUNTER)) == 0U &&
+		    state->counter_space == DRV_ACPI_LPIT_SPACE_MEMORY) {
+			error = map_counter(state, &lpit_counters[index]);
+			if (error != 0)
+				kern_logf("acpi: LPIT state %u counter not mapped (error %d)\n", (unsigned)state->id, error);
+		}
+
+		/* The log names each state and where its counter is. */
+		kern_logf("acpi: LPIT state %u flags 0x%x counter space 0x%x address 0x%llx %u bits %llu Hz\n",
+			  (unsigned)state->id,
+			  (unsigned)state->flags,
+			  (unsigned)state->counter_space,
+			  (unsigned long long)state->counter_address,
+			  (unsigned)state->counter_width,
+			  (unsigned long long)state->frequency);
+	}
+
+	/* The readings may start; the stores above come first. */
+	lpit_count = count;
+	__atomic_store_n(&lpit_ready, 1U, __ATOMIC_RELEASE);
+
+	/* Succeeded: the states are known and their memory counters mapped. */
+	return 0;
+}
+
+/*
+ * Reads the residency counter of each low-power idle state.
+ *
+ * Up to max states go into states, in the table's order, and count
+ * receives how many; a state whose counter is read has
+ * KERN_SLEEP_STATE_READABLE and its value.  It reports ENODEV when no
+ * table was read.  It may be called from any thread at any time: it only
+ * reads the mapped counters.
+ */
+int
+drv_acpi_lpi_residency_read(
+	struct kern_sleep_residency *states,
+	unsigned max,
+	unsigned *count)
+{
+	const struct drv_acpi_lpit_state *state;
+	struct kern_sleep_residency *reading;
+	volatile void *mapped;
+	unsigned ready;
+	unsigned index;
+
+	/* Nothing read yet. */
+	*count = 0U;
+
+	/* Refuses before the table was read, or on a platform without it. */
+	ready = __atomic_load_n(&lpit_ready, __ATOMIC_ACQUIRE);
+	if (!ready)
+		return ENODEV;
+
+	/* Each state, as the table describes it, with its counter when it is mapped. */
+	for (index = 0; index < lpit_count && index < max; index++) {
+		state = &lpit_states[index];
+		reading = &states[index];
+		kern_memset(reading, 0, sizeof(*reading));
+		reading->id = state->id;
+		reading->frequency = state->frequency;
+		reading->mask = counter_mask(state);
+
+		/* What the table says of the state and where its counter is. */
+		if ((state->flags & DRV_ACPI_LPIT_DISABLED) != 0U)
+			reading->flags |= KERN_SLEEP_STATE_DISABLED;
+		if ((state->flags & DRV_ACPI_LPIT_NO_COUNTER) != 0U)
+			reading->flags |= KERN_SLEEP_STATE_NO_COUNTER;
+		if (state->counter_space == DRV_ACPI_LPIT_SPACE_MEMORY) {
+			reading->flags |= KERN_SLEEP_STATE_MEMORY;
+		} else if (state->counter_space == DRV_ACPI_LPIT_SPACE_FFH) {
+			reading->flags |= KERN_SLEEP_STATE_PROCESSOR;
+		}
+
+		/* The counter's value, when it is mapped. */
+		mapped = lpit_counters[index];
+		if (mapped != NULL) {
+			reading->value = read_counter(state, mapped);
+			reading->flags |= KERN_SLEEP_STATE_READABLE;
+		}
+	}
+
+	/* How many states were read. */
+	*count = index;
+
+	/* Succeeded: every state up to max is read. */
+	return 0;
+}
+
+/*
+ * Maps the page a memory counter lies in.  It reports EINVAL for a counter
+ * whose width or access is not one the reading makes, or which crosses
+ * the end of its page.
+ */
+static int
+map_counter(
+	const struct drv_acpi_lpit_state *state,
+	volatile void **mapped)
+{
+	uint64_t page;
+	uint64_t within;
+	size_t page_size;
+	unsigned bytes;
+	void *window;
+	int error;
+
+	/* Refuses a counter that is no whole register the reading can make. */
+	bytes = counter_bytes(state);
+	if (bytes == 0U)
+		return EINVAL;
+
+	/* Refuses a counter that crosses the end of its page. */
+	page_size = kern_page_size(1);
+	page = state->counter_address & ~(uint64_t)(page_size - 1U);
+	within = state->counter_address - page;
+	if (within + bytes > page_size)
+		return EINVAL;
+
+	/* Maps the page, uncached: the counter changes behind the processor. */
+	error = kern_device_map(page, page_size, KERN_DEVICE_UNCACHED, &window);
+	if (error != 0)
+		return error;
+
+	/* Succeeded: the counter's address in the mapping. */
+	*mapped = (volatile uint8_t *)window + within;
+	return 0;
+}
+
+/*
+ * Reports the bytes one read of a counter takes: the access size the
+ * address names, else the least that holds the counter's bits; 0 for a
+ * counter without bits or wider than a quad word.
+ */
+static unsigned
+counter_bytes(
+	const struct drv_acpi_lpit_state *state)
+{
+	unsigned bits;
+
+	/* Refuses a counter without bits, or one whose bits run past a quad word. */
+	bits = (unsigned)state->counter_width + (unsigned)state->counter_offset;
+	if (state->counter_width == 0U || bits > 64U)
+		return 0U;
+
+	/* The access size the address names: a byte, a word, a double word or a quad word. */
+	if (state->counter_access >= GAS_ACCESS_BYTE && state->counter_access <= GAS_ACCESS_QWORD) {
+		if (bits > (8U << (state->counter_access - 1U)))
+			return 0U;
+
+		/* Reports the size the address names. */
+		return 1U << (state->counter_access - 1U);
+	}
+
+	/* Without an access size, the least register that holds the bits. */
+	if (bits <= 8U)
+		return 1U;
+	if (bits <= 16U)
+		return 2U;
+	if (bits <= 32U)
+		return 4U;
+
+	/* A counter of more than 32 bits is read as a quad word. */
+	return 8U;
+}
+
+/* Reports the largest value of a counter of the state's width, after which it wraps to zero. */
+static uint64_t
+counter_mask(
+	const struct drv_acpi_lpit_state *state)
+{
+	/* A counter of 64 bits, or one whose width is unknown, wraps at 2^64. */
+	if (state->counter_width == 0U || state->counter_width >= 64U)
+		return ~(uint64_t)0;
+
+	/* Reports the mask of the counter's bits. */
+	return ((uint64_t)1 << state->counter_width) - 1U;
+}
+
+/* Reads a memory counter at its access size and takes its bits. */
+static uint64_t
+read_counter(
+	const struct drv_acpi_lpit_state *state,
+	volatile void *mapped)
+{
+	uint64_t raw;
+	uint64_t mask;
+	unsigned bytes;
+
+	/* Reads the register at the size it was mapped for. */
+	bytes = counter_bytes(state);
+	switch (bytes) {
+	case 1U:
+		raw = kern_mmio_read8(mapped);
+		break;
+	case 2U:
+		raw = kern_mmio_read16(mapped);
+		break;
+	case 4U:
+		raw = kern_mmio_read32(mapped);
+		break;
+	default:
+		raw = kern_mmio_read64(mapped);
+		break;
+	}
+
+	/* Takes the counter's bits out of the register. */
+	mask = counter_mask(state);
+	raw = (raw >> state->counter_offset) & mask;
+
+	/* Reports the counter's value. */
+	return raw;
+}
+
+/* Reads a little-endian 32-bit value. */
+static uint32_t
+load_u32(
+	const uint8_t *bytes)
+{
+	uint32_t value;
+
+	/* Assembles the value from its least significant byte up. */
+	value = (uint32_t)bytes[0];
+	value |= (uint32_t)bytes[1] << 8;
+	value |= (uint32_t)bytes[2] << 16;
+	value |= (uint32_t)bytes[3] << 24;
+
+	/* Reports the value. */
+	return value;
+}
+
+/* Reads a little-endian 64-bit value. */
+static uint64_t
+load_u64(
+	const uint8_t *bytes)
+{
+	uint64_t low;
+	uint64_t high;
+
+	/* Assembles the value from its two halves. */
+	low = load_u32(bytes);
+	high = load_u32(bytes + 4U);
+
+	/* Reports the value. */
+	return low | (high << 32);
+}
diff --git a/src/drivers/acpi/acpi-lpit.h b/src/drivers/acpi/acpi-lpit.h
new file mode 100644
index 0000000000..f499176ae7
--- /dev/null
+++ b/src/drivers/acpi/acpi-lpit.h
@@ -0,0 +1,55 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The firmware's Low Power Idle Table: the low-power idle states and the
+ * counters of their residency, as the table describes them.
+ */
+
+#ifndef KERN_DRIVERS_ACPI_ACPI_LPIT_H
+#define KERN_DRIVERS_ACPI_ACPI_LPIT_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* The most states the table's reading keeps. */
+#define DRV_ACPI_LPIT_STATES_MAX	4U
+
+/* A state's flags in the table: disabled, and without a residency counter. */
+#define DRV_ACPI_LPIT_DISABLED		0x1U
+#define DRV_ACPI_LPIT_NO_COUNTER	0x2U
+
+/* The address spaces a residency counter is found in: memory, and a processor's functional fixed hardware (a register). */
+#define DRV_ACPI_LPIT_SPACE_MEMORY	0x00U
+#define DRV_ACPI_LPIT_SPACE_FFH		0x7fU
+
+/*
+ * One native C-state the table describes: its identifier, its flags, the
+ * generic address of its residency counter (space, width and offset in
+ * bits, access size, address) and the counter's frequency in hertz (0:
+ * the processor's time-stamp frequency).
+ */
+struct drv_acpi_lpit_state {
+	uint32_t id;
+	uint32_t flags;
+	uint8_t counter_space;
+	uint8_t counter_width;
+	uint8_t counter_offset;
+	uint8_t counter_access;
+	uint64_t counter_address;
+	uint64_t frequency;
+};
+
+int
+drv_acpi_lpit_parse(
+	const uint8_t *table,
+	size_t length,
+	struct drv_acpi_lpit_state *states,
+	unsigned max,
+	unsigned *count);
+
+#endif
