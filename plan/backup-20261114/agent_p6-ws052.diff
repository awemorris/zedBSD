+static void
+sleep_residency_measure(
+	struct kern_sleep_info *record,
+	const struct kern_sleep_residency *before,
+	unsigned before_count)
+{
+	struct kern_sleep_residency *after;
+	unsigned count;
+	unsigned index;
+	uint64_t elapsed;
+
+	/* The counters now. */
+	sleep_residency_read(record->states, &count);
+	record->state_count = count;
+
+	/* Each state read before and after: the time it counted across the sleep. */
+	for (index = 0; index < count; index++) {
+		after = &record->states[index];
