diff --git a/plan/ws052/tests/host-lpit.c b/plan/ws052/tests/host-lpit.c
new file mode 100644
index 0000000000..9855091757
--- /dev/null
+++ b/plan/ws052/tests/host-lpit.c
@@ -0,0 +1,366 @@
+/*
+ * zedBSD
+ * Copyright (C) 2026 Awe Morris
+ *
+ * SPDX-License-Identifier: Zlib
+ */
+
+/*
+ * The host test of the residency counters of the low-power idle states
+ * (acpi-lpit.c).
+ *
+ * acpi-lpit.c is compiled against a simulated kernel: the firmware's table
+ * is the Latitude 5330's LPIT (plan/ws049/tests/latitude5330/lpit.dat, the
+ * path is the first argument), the device mapping gives a page of host
+ * memory, and the MMIO reads read it.  The checks: the three states and
+ * their counters as the table gives them, the memory counter of the
+ * enabled state mapped and read (its value and its 32-bit mask), the
+ * processor's counter and the disabled state listed but not read, and the
+ * refusals of a damaged table.
+ *
+ *   make -C plan/ws052/tests lpit && build/ws052/host/lpit plan/ws049/tests/latitude5330/lpit.dat
+ */
+
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <drivers/acpi/acpi.h>
+#include <kern/device-io.h>
+#include <kern/pmem.h>
+#include <kern/sleep.h>
+#include <uapi/errno.h>
+
+#include "kern/klog.h"
+#include "drivers/acpi/acpi-lpit.h"
+
+/* The simulated page size, and the largest table the test reads. */
+#define PAGE_BYTES		4096U
+#define TABLE_MAX		4096U
+
+/* The 5330's SLP_S0 counter: its page and its offset in the page. */
+#define SLP_S0_PAGE		0xfe001000ULL
+#define SLP_S0_OFFSET		0x93cU
+
+/*
+ * The table the simulated firmware lends, and the page the simulated
+ * device mapping gives, with the address it was mapped for and the number
+ * of mappings made.
+ */
+static uint8_t table_bytes[TABLE_MAX];
+static size_t table_length;
+static uint8_t device_page[PAGE_BYTES] __attribute__((aligned(8)));
+static uint64_t mapped_address;
+static unsigned map_count;
+
+/* The checks that failed. */
+static unsigned failures;
+
+static void check(bool condition, const char *what);
+static int read_table(const char *path);
+static void check_parse(void);
+static void check_attach_and_read(void);
+static void check_damaged(void);
+
+/*
+ * Runs the checks against the table the path names.
+ */
+int
+main(
+	int argc,
+	char **argv)
+{
+	int error;
+
+	/* The table. */
+	if (argc != 2) {
+		fprintf(stderr, "usage: lpit LPIT.dat\n");
+		return 2;
+	}
+	error = read_table(argv[1]);
+	if (error != 0)
+		return 2;
+
+	/* The checks, in order: the reading of the table, then the attachment that uses it. */
+	check_parse();
+	check_attach_and_read();
+	check_damaged();
+
+	/* The verdict. */
+	if (failures != 0U) {
+		printf("lpit: FAIL (%u)\n", failures);
+		return 1;
+	}
+
+	/* Succeeded: every check held. */
+	printf("lpit: PASS\n");
+	return 0;
+}
+
+/* Lends the simulated firmware's table by its signature. */
+int
+drv_acpi_table_lookup(
+	const char *signature,
+	const uint8_t **data,
+	size_t *length)
+{
+	/* Only the LPIT. */
+	if (strcmp(signature, "LPIT") != 0)
+		return ENOENT;
+
+	/* Succeeded: the table's bytes. */
+	*data = table_bytes;
+	*length = table_length;
+	return 0;
+}
+
+/* Maps the simulated device page for any address. */
+int
+kern_device_map(
+	uint64_t address,
+	size_t size,
+	unsigned attributes,
+	void **mapped)
+{
+	(void)attributes;
+
+	/* Only a page. */
+	if (size != PAGE_BYTES)
+		return EINVAL;
+
+	/* Succeeded: the host page stands for the device's. */
+	mapped_address = address;
+	map_count++;
+	*mapped = device_page;
+	return 0;
+}
+
+/* The simulated smallest page. */
+size_t
+kern_page_size(
+	int level)
+{
+	(void)level;
+
+	/* Reports the size. */
+	return PAGE_BYTES;
+}
+
+/* Reads a byte of the simulated page. */
+uint8_t
+kern_mmio_read8(
+	const volatile void *address)
+{
+	/* Reports it. */
+	return *(const volatile uint8_t *)address;
+}
+
+/* Reads a word of the simulated page. */
+uint16_t
+kern_mmio_read16(
+	const volatile void *address)
+{
+	uint16_t value;
+
+	/* Copies it, as the page may be unaligned for the type. */
+	memcpy(&value, (const void *)address, sizeof(value));
+	return value;
+}
+
+/* Reads a double word of the simulated page. */
+uint32_t
+kern_mmio_read32(
+	const volatile void *address)
+{
+	uint32_t value;
+
+	/* Copies it. */
+	memcpy(&value, (const void *)address, sizeof(value));
+	return value;
+}
+
+/* Reads a quad word of the simulated page. */
+uint64_t
+kern_mmio_read64(
+	const volatile void *address)
+{
+	uint64_t value;
+
+	/* Copies it. */
+	memcpy(&value, (const void *)address, sizeof(value));
+	return value;
+}
+
+/* Drops the kernel's log lines. */
+void
+kern_logf(
+	const char *format,
+	...)
+{
+	(void)format;
+}
+
+/* Counts a failed check and names it. */
+static void
+check(
+	bool condition,
+	const char *what)
+{
+	/* A check that held. */
+	if (condition)
+		return;
+
+	/* The failure. */
+	printf("lpit: FAIL %s\n", what);
+	failures++;
+}
+
+/* Reads the table's file. */
+static int
+read_table(
+	const char *path)
+{
+	FILE *file;
+
+	/* Opens it. */
+	file = fopen(path, "rb");
+	if (file == NULL) {
+		perror(path);
+		return -1;
+	}
+
+	/* Reads it whole. */
+	table_length = fread(table_bytes, 1U, sizeof(table_bytes), file);
+	fclose(file);
+	if (table_length == 0U) {
+		fprintf(stderr, "lpit: %s is empty\n", path);
+		return -1;
+	}
+
+	/* Succeeded: the table is in memory. */
+	return 0;
+}
+
+/* Checks the three states of the 5330's table. */
+static void
+check_parse(void)
+{
+	struct drv_acpi_lpit_state states[DRV_ACPI_LPIT_STATES_MAX];
+	unsigned count;
+	int error;
+
+	/* Reads the table. */
+	error = drv_acpi_lpit_parse(table_bytes, table_length, states, DRV_ACPI_LPIT_STATES_MAX, &count);
+	check(error == 0, "parse error");
+	check(count == 3U, "parse count");
+	if (count != 3U)
+		return;
+
+	/* State 0: the package C10 counter, MSR 0x632, 64 bits, at the time-stamp frequency. */
+	check(states[0].id == 0U, "state 0 id");
+	check(states[0].flags == 0U, "state 0 flags");
+	check(states[0].counter_space == DRV_ACPI_LPIT_SPACE_FFH, "state 0 space");
+	check(states[0].counter_address == 0x632U, "state 0 address");
+	check(states[0].counter_width == 64U, "state 0 width");
+	check(states[0].frequency == 0U, "state 0 frequency");
+
+	/* State 1: the SLP_S0 counter, memory 0xFE00193C, 32 bits, double word, 8197 Hz. */
+	check(states[1].id == 1U, "state 1 id");
+	check(states[1].flags == 0U, "state 1 flags");
+	check(states[1].counter_space == DRV_ACPI_LPIT_SPACE_MEMORY, "state 1 space");
+	check(states[1].counter_address == 0xfe00193cULL, "state 1 address");
+	check(states[1].counter_width == 32U, "state 1 width");
+	check(states[1].counter_access == 3U, "state 1 access");
+	check(states[1].frequency == 0x2005U, "state 1 frequency");
+
+	/* State 2: disabled. */
+	check(states[2].id == 2U, "state 2 id");
+	check(states[2].flags == DRV_ACPI_LPIT_DISABLED, "state 2 flags");
+
+	/* A room of one keeps the first state only. */
+	error = drv_acpi_lpit_parse(table_bytes, table_length, states, 1U, &count);
+	check(error == 0 && count == 1U && states[0].id == 0U, "parse with a room of one");
+}
+
+/* Checks the attachment's mapping and the readings of the counters. */
+static void
+check_attach_and_read(void)
+{
+	struct kern_sleep_residency readings[KERN_SLEEP_STATE_MAX];
+	unsigned count;
+	uint32_t value;
+	int error;
+
+	/* Nothing to read before the attachment. */
+	error = drv_acpi_lpi_residency_read(readings, KERN_SLEEP_STATE_MAX, &count);
+	check(error == ENODEV && count == 0U, "read before attach");
+
+	/* The SLP_S0 counter's value in the simulated page. */
+	value = 0x12345678U;
+	memcpy(&device_page[SLP_S0_OFFSET], &value, sizeof(value));
+
+	/* Attaches: only the enabled memory counter is mapped, at its page. */
+	error = drv_acpi_lpit_attach();
+	check(error == 0, "attach");
+	check(map_count == 1U, "one mapping");
+	check(mapped_address == SLP_S0_PAGE, "mapped page");
+
+	/* Reads every state. */
+	error = drv_acpi_lpi_residency_read(readings, KERN_SLEEP_STATE_MAX, &count);
+	check(error == 0 && count == 3U, "read count");
+	if (count != 3U)
+		return;
+
+	/* The processor's counter: listed, not read. */
+	check(readings[0].flags == KERN_SLEEP_STATE_PROCESSOR, "state 0 reading flags");
+	check(readings[0].mask == ~(uint64_t)0, "state 0 mask");
+
+	/* The SLP_S0 counter: read, its 32-bit mask and frequency. */
+	check(readings[1].flags == (KERN_SLEEP_STATE_MEMORY | KERN_SLEEP_STATE_READABLE), "state 1 reading flags");
+	check(readings[1].value == 0x12345678U, "state 1 value");
+	check(readings[1].mask == 0xffffffffU, "state 1 mask");
+	check(readings[1].frequency == 0x2005U, "state 1 reading frequency");
+
+	/* The disabled state: listed, not read. */
+	check(readings[2].flags == (KERN_SLEEP_STATE_DISABLED | KERN_SLEEP_STATE_MEMORY), "state 2 reading flags");
+
+	/* The counter moves, and a second reading sees it. */
+	value = 0x12345678U + 8197U;
+	memcpy(&device_page[SLP_S0_OFFSET], &value, sizeof(value));
+	error = drv_acpi_lpi_residency_read(readings, 2U, &count);
+	check(error == 0 && count == 2U, "read with a room of two");
+	check(readings[1].value == 0x12345678U + 8197U, "state 1 value moved");
+}
+
+/* Checks the refusals of a damaged table. */
+static void
+check_damaged(void)
+{
+	struct drv_acpi_lpit_state states[DRV_ACPI_LPIT_STATES_MAX];
+	uint8_t copy[TABLE_MAX];
+	unsigned count;
+	int error;
+
+	/* A table shorter than its header. */
+	error = drv_acpi_lpit_parse(table_bytes, 20U, states, DRV_ACPI_LPIT_STATES_MAX, &count);
+	check(error == EINVAL && count == 0U, "short header");
+
+	/* A table whose length runs past the bytes given. */
+	error = drv_acpi_lpit_parse(table_bytes, table_length - 1U, states, DRV_ACPI_LPIT_STATES_MAX, &count);
+	check(error == EINVAL, "length past the bytes");
+
+	/* A second descriptor of length zero ends the reading after the first. */
+	memcpy(copy, table_bytes, table_length);
+	memset(&copy[36U + 56U + 4U], 0, 4U);
+	error = drv_acpi_lpit_parse(copy, table_length, states, DRV_ACPI_LPIT_STATES_MAX, &count);
+	check(error == 0 && count == 1U, "descriptor of length zero");
+
+	/* A second descriptor that runs past the table ends the reading after the first. */
+	memcpy(copy, table_bytes, table_length);
+	copy[36U + 56U + 4U] = 0xffU;
+	error = drv_acpi_lpit_parse(copy, table_length, states, DRV_ACPI_LPIT_STATES_MAX, &count);
+	check(error == 0 && count == 1U, "descriptor past the table");
+}
