@@ -0,0 +1,66 @@
+#!/bin/sh
+# The sleep's base test on the bare Latitude 5330 started from its NVMe, end to end, printing only a short summary.
+# It runs plan/tools/hw5330/5330-run.sh (write the image or the kernel, start zedBSD once, survey, back to Linux) and
+# runs, while zedBSD is up, plan/tools/hw5330/../../ws052/tests/p014-guest.sh as root: the devices' round trip ROUNDS
+# times with an app drawing, then one sleep to idle woken by the wake timer after WAKE seconds, with the residency of
+# the low-power idle states before and after.
+#   sh plan/ws052/tests/p014-5330.sh --nvme-image IMG | --nvme-kernel VMUNIX | --nvme-none  NAME
+# The image: make ZEDBSD_CONFIG=plan/ws052/tests/config-5330-sleep.mk BUILD=<dir> disk-image (a kernel alone needs an
+# image of that configuration on the NVMe already, for sleepctl).  ROUNDS (default 5) and WAKE (default 30) are taken
+# from the environment.  The 5330 has no remote power: when the timer does not wake it, 5330-run.sh reports that
+# zedBSD and then Linux did not answer, and the power button is needed (Q1 asks the user).
+# Output: what 5330-run.sh writes (LOGS, default build/hw5330/logs: NAME-extra.txt is the guest's output), and the
+# summary lines "p014: ..." with the last "p014: PASS|FAIL".
+# Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib
+set -u
+MODE=${1:?usage: p014-5330.sh --nvme-image IMG | --nvme-kernel VMUNIX | --nvme-none NAME}
+case "$MODE" in
+--nvme-none) FILE= ; shift ;;
+--nvme-image | --nvme-kernel) FILE=${2:?the file}; shift 2 ;;
+*) echo "p014: the 5330 starts from its NVMe here (--nvme-image, --nvme-kernel or --nvme-none)"; exit 2 ;;
+esac
+NAME=${1:?NAME}
+cd "$(dirname "$0")/../../.."
+LOGS=${LOGS:-build/hw5330/logs}
+ROUNDS=${ROUNDS:-5}
+WAKE=${WAKE:-30}
+mkdir -p "$LOGS"
+
+# The guest's part goes in as one printf of the script (it has no single quote), then runs as root.
+guest=plan/ws052/tests/p014-guest.sh
+if grep -q "'" "$guest"; then
+	echo "p014: FAIL: $guest has a single quote"
+	exit 2
+fi
+body=$(cat "$guest")
+EXTRA="printf '%s\n' '$body' > /tmp/p014-guest.sh && echo user | sudo -S sh /tmp/p014-guest.sh ROUNDS=$ROUNDS WAKE=$WAKE"
+export EXTRA
+
+# One start of zedBSD; the guest's part needs the long timeout (the round trips and the sleep).
+if [ -n "$FILE" ]; then
+	T=900 sh plan/tools/hw5330/5330-run.sh "$MODE" "$FILE" "$NAME" > "$LOGS/$NAME-run.txt" 2>&1
+else
+	T=900 sh plan/tools/hw5330/5330-run.sh "$MODE" "$NAME" > "$LOGS/$NAME-run.txt" 2>&1
+fi
+tail -1 "$LOGS/$NAME-run.txt" | sed 's/^/p014: /'
+
+# The summary of the guest's output.
+out=$LOGS/$NAME-extra.txt
+if [ ! -s "$out" ]; then
+	echo "p014: FAIL: no output from zedBSD ($LOGS/$NAME-run.txt)"
+	exit 1
+fi
+devices_ok=$(grep -c '^sleep result=0 resume=0 device=-$' "$out")
+echo "p014: devices round trips ok $devices_ok of $ROUNDS"
+grep -E '^sleep (result|refused)|^wake timer refused' "$out" | tail -1 | sed 's/^/p014: s0idle /'
+sed -n '/^== info after/,/^== app/p' "$out" | grep -E '^(info|last|state) ' | sed 's/^/p014: /'
+memory=$(sed -n '/^== info after/,/^== app/p' "$out" | grep -E '^state .*counter=memory' | grep -v 'residency-us=-' | sed -n 's/.*residency-us=\([0-9]*\).*/\1/p' | head -1)
+woke=$(sed -n '/^== info after/,/^== app/p' "$out" | sed -n 's/^last wake=\([0-9]*\) result=0 resume=0 .*/\1/p' | head -1)
+echo "p014: SLP_S0 residency us ${memory:-none}, wake ${woke:-none}"
+
+# PASS: every round trip, a sleep that woke by the timer (6), and the platform's residency grew.
+if [ "$devices_ok" -eq "$ROUNDS" ] && [ "${woke:-}" = 6 ] && [ -n "${memory:-}" ] && [ "$memory" -gt 0 ]; then
+	echo "p014: PASS"
+else
+	echo "p014: FAIL"
+fi
