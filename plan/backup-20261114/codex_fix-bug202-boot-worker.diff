+	/* A run or woken queue, by its priority. */
+	for (priority = 0; cpu != NULL && priority < SCHED_PRIOR_LEVELS; priority++) {
+		if (queue == &cpu->run[priority]) {
+			kind = "run";
+			level = priority;
+		} else if (queue == &cpu->woken[priority]) {
+			kind = "woken";
+			level = priority;
+		}
+	}
