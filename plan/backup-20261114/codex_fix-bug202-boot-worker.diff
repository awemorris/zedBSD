+	level = -1;
+	cpu = NULL;
+	if (thread->sched.cpu < scheduler_cpu_count)
+		cpu = &scheduler_cpus[thread->sched.cpu];
+	if (cpu != NULL && queue == &cpu->sleep)
+		kind = "sleep";
