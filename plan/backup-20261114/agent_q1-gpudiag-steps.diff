-	/* The physical runtime prints pass only after all GPU output pixels were inspected. */
-	bcm2711_stage_mark(BCM2711_FAMILY_V3D, "V8 RGBA8 64x64 all 4096 pixels %08x", DIAGNOSTIC_COLOR);
