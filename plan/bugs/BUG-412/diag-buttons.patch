Temporary diagnostics for BUG-412 (not for main): every button reaching the seat, and every input report with
keys, with the evdev time and the compositor's clock.  Applied on the board's source (8f91a0d) with the KWL PRESS
log of 8e9c773ad5, built for config-rpi5.mk and put as /bin/wayland on the Pi 5 for the physical click session.
--- a/userland/desktop/wayland/input.c
+++ b/userland/desktop/wayland/input.c
@@ -1551,6 +1551,8 @@

 	/* A changed position is reported as motion before any button of the same report. */
 	pointer_activity = 0;
+	if (frame->key_count != 0U)
+		printf("KWL FRAME dev=%s keys=%u code0=%u value0=%d placed=%u write_us=%llu time=%u at_ms=%llu\n", device->path, frame->key_count, frame->keys[0].code, frame->keys[0].value, frame->placed, (unsigned long long)frame->motion.write_us, event->time, (unsigned long long)kwl_milliseconds());
 	moved = apply_motion(server, &frame->motion, frame->absolute, event->time);
 	if (moved)
 		pointer_activity = 1;
--- a/userland/desktop/wayland/seat.c
+++ b/userland/desktop/wayland/seat.c
@@ -650,6 +650,7 @@
 {
 	int taken;

+	printf("KWL BTN button=%u state=%u time=%u x=%d y=%d at_ms=%llu\n", button, state, time, server->pointer_x, server->pointer_y, (unsigned long long)kwl_milliseconds());
 	/* A button while the Windows key is down: no tap of its own (ws142-p002). */
 	if (state != 0U)
 		kwl_super_tap_cancel(&server->super_tap);
