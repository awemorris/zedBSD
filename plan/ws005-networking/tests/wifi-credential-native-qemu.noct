require zedbuild;

// WS005 p005 actual /sbin/net credential persistence acceptance.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib

var qmpTranscript = "";
var cellFailure = "";

func capture(command, what) {
    var child = Process.spawn(["/bin/sh", "-c", command + " 2>&1"]);
    if (child < 0) { zbFail("cannot start " + what); }
    var output = "";
    while (Process.isAlive(child) == 1) {
        output = output + Process.read(child, 100);
    }
    output = output + Process.read(child, 0);
    var status = Process.wait(child);
    Process.close(child);
    while (String.charCount(output) > 0 &&
           (String.charCodeAt(output, String.charCount(output) - 1) == 10 ||
            String.charCodeAt(output, String.charCount(output) - 1) == 13)) {
        output = String.substring(output, 0, String.charCount(output) - 1);
    }
    if (status != 0) {
        zbFail(what + " failed (status=" + status + "): " + output);
    }
    return output;
}

func run(command, what) {
    var status = System.shell(command);
    if (status != 0) { zbFail(what + " failed (status=" + status + ")"); }
}

func runLogged(command, log, what) {
    var status = System.shell(command + " >" + zbShellQuote(log) + " 2>&1");
    if (status != 0) {
        zbFail(what + " failed (status=" + status + "; log=" + log + ")");
    }
}

func appendText(path, value) {
    var current = "";
    if (FileUtil.checkFileExists(path) == 1) {
        current = FileUtil.readText(path);
    }
    FileUtil.writeText(path, current + value);
}

func requirePattern(path, pattern, what) {
    if (System.shell("rg -a -q -- " + zbShellQuote(pattern) + " " +
                     zbShellQuote(path)) != 0) {
        zbFail(what + " is missing (log=" + path + ")");
    }
}

func rejectPattern(path, pattern, what) {
    var status = System.shell("rg -a -q -- " + zbShellQuote(pattern) + " " +
                              zbShellQuote(path));
    if (status == 0) { zbFail(what + " was observed (log=" + path + ")"); }
    if (status != 1 && status != 256) { zbFail("cannot inspect " + path); }
}

func resolveCommand(expression, what) {
    var value = capture("command -v \"" + expression + "\"", what);
    if (value == "") { zbFail(what + " resolved to an empty path"); }
    return value;
}

func resolveFile(expression, what) {
    var value = capture("realpath \"" + expression + "\"", what);
    if (FileUtil.checkFileExists(value) != 1) {
        zbFail(what + " not found: " + value);
    }
    return value;
}

func commandText(command) {
    var result = "";
    for (i in 0..Array.size(command)) {
        if (i != 0) { result = result + " "; }
        result = result + zbShellQuote(command[i]);
    }
    return result + "\n";
}

func stopQemu(child) {
    if (Process.isAlive(child) == 1) {
        Process.write(child, "{\"execute\":\"quit\"}\n");
    }
    var output = "";
    var ticks = 0;
    var forced = 0;
    while (Process.isAlive(child) == 1 && ticks < 50) {
        output = output + Process.read(child, 100);
        ticks = ticks + 1;
    }
    if (Process.isAlive(child) == 1) {
        forced = 15;
        Process.kill(child, 15);
        ticks = 0;
        while (Process.isAlive(child) == 1 && ticks < 20) {
            output = output + Process.read(child, 100);
            ticks = ticks + 1;
        }
    }
    if (Process.isAlive(child) == 1) {
        forced = 9;
        Process.kill(child, 9);
        ticks = 0;
        while (Process.isAlive(child) == 1 && ticks < 20) {
            output = output + Process.read(child, 100);
            ticks = ticks + 1;
        }
    }
    output = output + Process.read(child, 0);
    if (Process.isAlive(child) == 1) {
        Process.close(child);
        return [-2, output, forced];
    }
    var status = Process.wait(child);
    Process.close(child);
    return [status, output, forced];
}

func guestHas(path, marker) {
    if (FileUtil.checkFileExists(path) != 1) { return false; }
    return String.indexOf(FileUtil.readText(path), marker) >= 0;
}

func guestFatal(path) {
    if (FileUtil.checkFileExists(path) != 1) { return false; }
    var output = FileUtil.readText(path);
    return String.indexOf(output, "WS005-P005 FAIL") >= 0 ||
        String.indexOf(output, "kernel panic") >= 0 ||
        String.indexOf(output, "panic:") >= 0 ||
        String.indexOf(output, "amd64 fault v=") >= 0 ||
        String.indexOf(output, "VFS initialization failed") >= 0;
}

func waitGuest(child, guestLog, marker) {
    var ticks = 0;
    while (ticks < 2400 && Process.isAlive(child) == 1) {
        qmpTranscript = qmpTranscript + Process.read(child, 100);
        if (guestFatal(guestLog)) {
            cellFailure = "fatal guest output while waiting for " + marker;
            return false;
        }
        if (String.indexOf(qmpTranscript, "\"error\"") >= 0) {
            cellFailure = "QMP error while waiting for " + marker;
            return false;
        }
        if (guestHas(guestLog, marker)) { return true; }
        ticks = ticks + 1;
    }
    if (Process.isAlive(child) != 1) {
        cellFailure = "QEMU exited while waiting for " + marker;
    } else {
        cellFailure = "timeout waiting for " + marker;
    }
    return false;
}

func qemuCommand(qemu, ovmfCode, ovmfVars, image, guestLog, serialLog) {
    return [qemu, "-machine", "q35,usb=off", "-accel",
        "tcg,thread=single", "-m", "512", "-smp", "4", "-drive",
        "if=pflash,format=raw,unit=0,readonly=on,file=" + ovmfCode,
        "-drive", "if=pflash,format=raw,unit=1,file=" + ovmfVars,
        "-device", "qemu-xhci,id=xhci", "-drive",
        "if=none,id=boot,file=" + image + ",format=raw", "-device",
        "usb-storage,bus=xhci.0,port=1,drive=boot,id=bootstick," +
        "bootindex=1", "-boot", "order=c,strict=on", "-display", "none",
        "-serial", "file:" + serialLog, "-debugcon", "file:" + guestLog,
        "-qmp", "stdio", "-no-reboot", "-no-shutdown"];
}

func runCell(qemu, ovmfCode, ovmfVars, evidence, name, image, marker,
             results) {
    var cell = evidence + "/cells/" + name;
    run("mkdir -p " + zbShellQuote(cell), "create " + name + " cell");
    var guestLog = cell + "/debugcon.log";
    var serialLog = cell + "/serial.log";
    var qmpLog = cell + "/qmp.log";
    var varsCopy = cell + "/OVMF_VARS.fd";
    run("cp " + zbShellQuote(ovmfVars) + " " + zbShellQuote(varsCopy),
        "prepare " + name + " OVMF vars");
    FileUtil.writeText(guestLog, "");
    FileUtil.writeText(serialLog, "");
    qmpTranscript = "";
    cellFailure = "";
    var command = qemuCommand(qemu, ovmfCode, varsCopy, image, guestLog,
                              serialLog);
    FileUtil.writeText(cell + "/qemu-command.txt", commandText(command));
    var child = Process.spawn(command);
    if (child < 0) { zbFail("cannot start QEMU cell " + name); }
    Process.write(child, "{\"execute\":\"qmp_capabilities\"}\n");
    var okay = waitGuest(child, guestLog, marker);
    // This quit is deliberately immediate: no guest unmount or shutdown may
    // make an unsynchronized namespace update look durable.
    var stopped = stopQemu(child);
    qmpTranscript = qmpTranscript + stopped[1];
    FileUtil.writeText(qmpLog, qmpTranscript);
    if (!okay) {
        zbFail(name + " failed: " + cellFailure + " (logs=" + cell + ")");
    }
    if (stopped[0] != 0 || stopped[2] != 0) {
        zbFail(name + " QEMU did not stop cleanly");
    }
    rejectPattern(qmpLog, "\\\"error\\\"[[:space:]]*:",
                  name + " QMP error");
    rejectPattern(guestLog,
        "WS005-P005 FAIL|kernel panic|panic:|amd64 fault v=|" +
        "VFS initialization failed|usb-storage: .*error=[1-9]|" +
        "loop[0-9]+: .*error=[1-9]|[sh]d[a-z]+ .*error=[1-9]",
        name + " fatal guest failure");
    requirePattern(guestLog, marker, name + " terminal marker");
    // Every synthetic passphrase starts with this prefix.  The probe captures
    // child output internally, and the controller independently rejects it
    // from every retained text stream.
    rejectPattern(guestLog, "Q051-DUMMY-", name + " debugcon secret");
    rejectPattern(serialLog, "Q051-DUMMY-", name + " serial secret");
    rejectPattern(qmpLog, "Q051-DUMMY-", name + " QMP secret");
    rejectPattern(cell + "/qemu-command.txt", "Q051-DUMMY-",
                  name + " command secret");
    FileUtil.writeText(cell + "/result.txt", name + "\tPASS\n");
    appendText(results, name + "\tPASS\t" + name + "/result.txt\n");
}

func main(args) {
    if (Array.size(args) != 2) {
        zbFail("usage: wifi-credential-native-qemu.noct REPOSITORY EVIDENCE");
    }
    var repo = capture("realpath " + zbShellQuote(args[0]),
                       "resolve repository");
    var evidence = capture("realpath -m " + zbShellQuote(args[1]),
                           "resolve evidence");
    if (FileUtil.checkFileExists(evidence) == 1) {
        zbFail("evidence path already exists: " + evidence);
    }
    run("mkdir -p " + zbShellQuote(evidence + "/cells") + " " +
        zbShellQuote(evidence + "/build") + " " +
        zbShellQuote(evidence + "/tmp") + " " +
        zbShellQuote(evidence + "/private") + " && chmod 700 " +
        zbShellQuote(evidence + "/private"), "create evidence tree");
    var results = evidence + "/results.tsv";
    FileUtil.writeText(results, "cell\tresult\tevidence\n");
    var qemu = resolveCommand("${QEMU_SYSTEM_X86_64:-qemu-system-x86_64}",
                              "qemu-system-x86_64");
    var ovmfCode = resolveFile("${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}",
                               "OVMF code");
    var ovmfVars = resolveFile("${OVMF_VARS:-/usr/share/OVMF/OVMF_VARS_4M.fd}",
                               "OVMF vars");
    var fixture = repo + "/plan/ws005-networking/tests";
    var config = fixture + "/wifi-credential-native-qemu-config.mk";
    var makefile = fixture + "/wifi-credential-native-qemu.mk";
    var guest = fixture + "/wifi-credential-native.c";
    runLogged("cc -std=c11 -Wall -Wextra -Werror " +
        "-DZEDBSD_USER_ABI_LP64 -I" +
        zbShellQuote(repo + "/libc/include") + " -I" +
        zbShellQuote(repo + "/include/uapi") + " -I" +
        zbShellQuote(repo) + " -fsyntax-only " + zbShellQuote(guest),
        evidence + "/guest-syntax.log", "guest probe host syntax gate");
    appendText(results, "guest-syntax\tPASS\tguest-syntax.log\n");
    runLogged("make -C " + zbShellQuote(repo) + " -j16 toolchain",
              evidence + "/toolchain.log", "Noct toolchain");
    var build = evidence + "/build/amd64";
    var arch = evidence + "/build/arch-images";
    var data = evidence + "/build/data.img";
    var swap = evidence + "/build/swapfile";
    var buildCommand = "TMPDIR=" + zbShellQuote(evidence + "/tmp") +
        " make -C " + zbShellQuote(repo) + " -j16 -f Makefile -f " +
        zbShellQuote(makefile) + " ZEDBSD_CONFIG=" + zbShellQuote(config) +
        " BUILD=" + zbShellQuote(build) + " ARCH_IMAGE_DIR=" +
        zbShellQuote(arch) + " DATA_IMAGE=" + zbShellQuote(data) +
        " SWAP_IMAGE=" + zbShellQuote(swap) +
        " ws005-p005-native-qemu-image";
    runLogged(buildCommand, evidence + "/build.log",
              "private WS005 p005 image");
    var source = build + "/tests/ws005-p005-overlay.img";
    run("sha256sum " + zbShellQuote(source) + " >" +
        zbShellQuote(evidence + "/source-before.sha256"),
        "freeze source hash");
    var writable = evidence + "/private/writable.img";
    run("cp --reflink=auto --sparse=always " + zbShellQuote(source) + " " +
        zbShellQuote(writable) + " && chmod 600 " + zbShellQuote(writable),
        "prepare protected writable medium");
    runCell(qemu, ovmfCode, ovmfVars, evidence, "stage1", writable,
            "WS005-P005 STAGE1 PASS", results);
    runCell(qemu, ovmfCode, ovmfVars, evidence, "stage2", writable,
            "WS005-P005 PASS", results);
    run("sha256sum -c " + zbShellQuote(evidence + "/source-before.sha256") +
        " >" + zbShellQuote(evidence + "/source-after.log"),
        "verify source image immutability");
    run("sha256sum " + zbShellQuote(guest) + " " + zbShellQuote(config) +
        " " + zbShellQuote(makefile) + " " +
        zbShellQuote(fixture + "/wifi-credential-native.cfg") + " " +
        zbShellQuote(fixture + "/wifi-credential-native-passwd") + " " +
        zbShellQuote(fixture + "/wifi-credential-native-group") + " >" +
        zbShellQuote(evidence + "/inputs.sha256"), "hash fixture inputs");
    rejectPattern(evidence + "/build.log", "Q051-DUMMY-",
                  "build-log secret");
    rejectPattern(evidence + "/guest-syntax.log", "Q051-DUMMY-",
                  "syntax-log secret");
    run("rm -f " + zbShellQuote(writable) + " && rmdir " +
        zbShellQuote(evidence + "/private"),
        "remove protected credential medium");
    FileUtil.writeText(evidence + "/metadata.txt",
        "test=WS005 p005 native credential store\nlaunches=2\n" +
        "topology=q35 OVMF; xHCI USB overlay-root writable media\n" +
        "shutdown_boundary=QMP quit immediately after stage1 PASS\n" +
        "credential_media_retained=no\nsource_image_immutable=yes\n" +
        "secret_output=independently rejected from all retained streams\n" +
        "qemu=" + capture(zbShellQuote(qemu) +
        " --version | sed -n '1p'", "capture QEMU version") + "\n");
    appendText(results, "source-integrity\tPASS\tsource-after.log\n");
    print("WS005 p005 native credential acceptance: PASS: " + evidence);
}
