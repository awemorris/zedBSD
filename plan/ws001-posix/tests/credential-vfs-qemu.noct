require zedbuild;

// WS001 p022/p023 bounded, disposable QEMU/remount acceptance.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib

var qmpTranscript = "";
var cellFailure = "";

func capture(command, what) {
    var child = Process.spawn(["/bin/sh", "-c", command + " 2>&1"]);
    if (child < 0) { zbFail("cannot start " + what); }
    var output = "";
    while (Process.isAlive(child) == 1) {
        output = output + Process.read(child, 100);
    }
    output = output + Process.read(child, 0);
    var status = Process.wait(child);
    Process.close(child);
    while (String.charCount(output) > 0 &&
           (String.charCodeAt(output, String.charCount(output) - 1) == 10 ||
            String.charCodeAt(output, String.charCount(output) - 1) == 13)) {
        output = String.substring(output, 0, String.charCount(output) - 1);
    }
    if (status != 0) {
        zbFail(what + " failed (status=" + status + "): " + output);
    }
    return output;
}

func run(command, what) {
    var status = System.shell(command);
    if (status != 0) { zbFail(what + " failed (status=" + status + ")"); }
}

func runLogged(command, log, what) {
    var status = System.shell(command + " >" + zbShellQuote(log) + " 2>&1");
    if (status != 0) {
        zbFail(what + " failed (status=" + status + "; log=" + log + ")");
    }
}

func appendText(path, value) {
    var current = "";
    if (FileUtil.checkFileExists(path) == 1) {
        current = FileUtil.readText(path);
    }
    FileUtil.writeText(path, current + value);
}

func requirePattern(path, pattern, what) {
    if (System.shell("rg -a -q -- " + zbShellQuote(pattern) + " " +
                     zbShellQuote(path)) != 0) {
        zbFail(what + " is missing (log=" + path + ")");
    }
}

func rejectPattern(path, pattern, what) {
    var status = System.shell("rg -a -q -- " + zbShellQuote(pattern) + " " +
                              zbShellQuote(path));
    if (status == 0) { zbFail(what + " was observed (log=" + path + ")"); }
    if (status != 1 && status != 256) { zbFail("cannot inspect " + path); }
}

func resolveCommand(expression, what) {
    var value = capture("command -v \"" + expression + "\"", what);
    if (value == "") { zbFail(what + " resolved to an empty path"); }
    return value;
}

func resolveFile(expression, what) {
    var value = capture("realpath \"" + expression + "\"", what);
    if (FileUtil.checkFileExists(value) != 1) {
        zbFail(what + " not found: " + value);
    }
    return value;
}

func commandText(command) {
    var result = "";
    for (i in 0..Array.size(command)) {
        if (i != 0) { result = result + " "; }
        result = result + zbShellQuote(command[i]);
    }
    return result + "\n";
}

func stopQemu(child) {
    if (Process.isAlive(child) == 1) {
        Process.write(child, "{\"execute\":\"quit\"}\n");
    }
    var output = "";
    var ticks = 0;
    var forced = 0;
    while (Process.isAlive(child) == 1 && ticks < 50) {
        output = output + Process.read(child, 100);
        ticks = ticks + 1;
    }
    if (Process.isAlive(child) == 1) {
        forced = 15;
        Process.kill(child, 15);
        ticks = 0;
        while (Process.isAlive(child) == 1 && ticks < 20) {
            output = output + Process.read(child, 100);
            ticks = ticks + 1;
        }
    }
    if (Process.isAlive(child) == 1) {
        forced = 9;
        Process.kill(child, 9);
        ticks = 0;
        while (Process.isAlive(child) == 1 && ticks < 20) {
            output = output + Process.read(child, 100);
            ticks = ticks + 1;
        }
    }
    output = output + Process.read(child, 0);
    if (Process.isAlive(child) == 1) {
        Process.close(child);
        return [-2, output, forced];
    }
    var status = Process.wait(child);
    Process.close(child);
    return [status, output, forced];
}

func guestHas(path, marker) {
    if (FileUtil.checkFileExists(path) != 1) { return false; }
    return String.indexOf(FileUtil.readText(path), marker) >= 0;
}

func guestFatal(path) {
    if (FileUtil.checkFileExists(path) != 1) { return false; }
    var text = FileUtil.readText(path);
    return String.indexOf(text, "WS001-P015 FAIL") >= 0 ||
        String.indexOf(text, "WS001-P023 FAIL") >= 0 ||
        String.indexOf(text, "kernel panic") >= 0 ||
        String.indexOf(text, "panic:") >= 0 ||
        String.indexOf(text, "amd64 fault v=") >= 0 ||
        String.indexOf(text, "VFS initialization failed") >= 0;
}

func waitGuest(child, guestLog, marker) {
    var ticks = 0;
    while (ticks < 2400 && Process.isAlive(child) == 1) {
        qmpTranscript = qmpTranscript + Process.read(child, 100);
        if (guestFatal(guestLog)) {
            cellFailure = "fatal guest output while waiting for " + marker;
            return false;
        }
        if (String.indexOf(qmpTranscript, "\"error\"") >= 0) {
            cellFailure = "QMP error while waiting for " + marker;
            return false;
        }
        if (guestHas(guestLog, marker)) { return true; }
        ticks = ticks + 1;
    }
    if (Process.isAlive(child) != 1) {
        cellFailure = "QEMU exited while waiting for " + marker;
    } else {
        cellFailure = "timeout waiting for " + marker;
    }
    return false;
}

func makeQemuCommand(qemu, ovmfCode, ovmfVars, bootImage, auxiliary,
                     guestLog, serialLog) {
    var command = [qemu, "-machine", "q35,usb=off", "-accel",
        "tcg,thread=single", "-m", "512", "-smp", "4"];
    if (ovmfCode != "") {
        Array.push(command, "-drive");
        Array.push(command,
            "if=pflash,format=raw,unit=0,readonly=on,file=" + ovmfCode);
        Array.push(command, "-drive");
        Array.push(command,
            "if=pflash,format=raw,unit=1,file=" + ovmfVars);
    }
    Array.push(command, "-device");
    Array.push(command, "qemu-xhci,id=xhci");
    Array.push(command, "-drive");
    Array.push(command,
        "if=none,id=boot,file=" + bootImage + ",format=raw");
    Array.push(command, "-device");
    Array.push(command,
        "usb-storage,bus=xhci.0,port=1,drive=boot,id=bootstick," +
        "bootindex=1");
    if (auxiliary != "") {
        Array.push(command, "-drive");
        Array.push(command,
            "if=none,id=aux,file=" + auxiliary + ",format=raw");
        Array.push(command, "-device");
        Array.push(command, "piix3-ide,id=auxide");
        Array.push(command, "-device");
        Array.push(command,
            "ide-hd,bus=auxide.0,unit=0,drive=aux,id=auxdisk");
    }
    Array.push(command, "-boot");
    Array.push(command, "order=c,strict=on");
    Array.push(command, "-display");
    Array.push(command, "none");
    Array.push(command, "-serial");
    Array.push(command, "file:" + serialLog);
    Array.push(command, "-debugcon");
    Array.push(command, "file:" + guestLog);
    Array.push(command, "-qmp");
    Array.push(command, "stdio");
    Array.push(command, "-no-reboot");
    Array.push(command, "-no-shutdown");
    return command;
}

func runCell(qemu, ovmfCode, ovmfVars, evidence, name, bootImage,
             auxiliary, marker, results) {
    var cell = evidence + "/cells/" + name;
    run("mkdir -p " + zbShellQuote(cell), "create " + name + " cell");
    var guestLog = cell + "/debugcon.log";
    var serialLog = cell + "/serial.log";
    var qmpLog = cell + "/qmp.log";
    var varsCopy = "";
    if (ovmfVars != "") {
        varsCopy = cell + "/OVMF_VARS.fd";
        run("cp " + zbShellQuote(ovmfVars) + " " + zbShellQuote(varsCopy),
            "prepare " + name + " OVMF vars");
    }
    FileUtil.writeText(guestLog, "");
    FileUtil.writeText(serialLog, "");
    qmpTranscript = "";
    cellFailure = "";
    var command = makeQemuCommand(qemu, ovmfCode, varsCopy, bootImage,
                                  auxiliary, guestLog, serialLog);
    FileUtil.writeText(cell + "/qemu-command.txt", commandText(command));
    var child = Process.spawn(command);
    if (child < 0) { zbFail("cannot start QEMU cell " + name); }
    Process.write(child, "{\"execute\":\"qmp_capabilities\"}\n");
    var okay = waitGuest(child, guestLog, marker);
    // Intentionally do not ask the guest to unmount or shut down.  The QMP
    // quit immediately after PASS is the persistence/crash boundary.
    var stopped = stopQemu(child);
    qmpTranscript = qmpTranscript + stopped[1];
    FileUtil.writeText(qmpLog, qmpTranscript);
    if (!okay) {
        zbFail(name + " failed: " + cellFailure + " (logs=" + cell + ")");
    }
    if (stopped[0] != 0 || stopped[2] != 0) {
        zbFail(name + " QEMU did not stop cleanly");
    }
    rejectPattern(qmpLog, "\\\"error\\\"[[:space:]]*:",
                  name + " QMP error");
    rejectPattern(guestLog,
        "WS001-P015 FAIL|WS001-P023 FAIL|kernel panic|panic:|" +
        "amd64 fault v=|VFS initialization failed|" +
        "usb-storage: .*error=[1-9]|" +
        "loop[0-9]+: .*error=[1-9]|[sh]d[a-z]+ .*error=[1-9]",
        name + " fatal guest failure");
    requirePattern(guestLog, marker, name + " terminal marker");
    var media = zbShellQuote(bootImage);
    if (varsCopy != "") { media = media + " " + zbShellQuote(varsCopy); }
    if (auxiliary != "") { media = media + " " + zbShellQuote(auxiliary); }
    run("sha256sum " + media + " >" +
        zbShellQuote(cell + "/writable-media.sha256"),
        "hash " + name + " writable media");
    FileUtil.writeText(cell + "/result.txt", name + "\tPASS\n");
    appendText(results, name + "\tPASS\t" + name + "/result.txt\n");
}

func main(args) {
    if (Array.size(args) != 2) {
        zbFail("usage: credential-vfs-qemu.noct REPOSITORY EVIDENCE");
    }
    var repo = capture("realpath " + zbShellQuote(args[0]),
                       "resolve repository");
    var evidence = capture("realpath -m " + zbShellQuote(args[1]),
                           "resolve evidence");
    if (FileUtil.checkFileExists(evidence) == 1) {
        zbFail("evidence path already exists: " + evidence);
    }
    run("mkdir -p " + zbShellQuote(evidence + "/cells") + " " +
        zbShellQuote(evidence + "/build") + " " +
        zbShellQuote(evidence + "/tmp") + " " +
        zbShellQuote(evidence + "/run"), "create evidence tree");
    var results = evidence + "/results.tsv";
    FileUtil.writeText(results, "cell\tresult\tevidence\n");
    var qemu = resolveCommand("${QEMU_SYSTEM_X86_64:-qemu-system-x86_64}",
                              "qemu-system-x86_64");
    var ovmfCode = resolveFile("${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}",
                               "OVMF code");
    var ovmfVars = resolveFile("${OVMF_VARS:-/usr/share/OVMF/OVMF_VARS_4M.fd}",
                               "OVMF vars");
    var fixture = repo + "/plan/ws001-posix/tests";
    var config = fixture + "/credential-vfs-qemu-config.mk";
    var makefile = fixture + "/credential-vfs-qemu.mk";
    var guest = fixture + "/credential-vfs-native.c";
    runLogged("cc -std=c11 -Wall -Wextra -Werror " +
        "-DZEDBSD_USER_ABI_LP64 -I" +
        zbShellQuote(repo + "/libc/include") + " -I" +
        zbShellQuote(repo + "/include/uapi") + " -fsyntax-only " +
        zbShellQuote(guest), evidence + "/guest-syntax.log",
        "guest probe host syntax gate");
    appendText(results, "guest-syntax\tPASS\tguest-syntax.log\n");
    runLogged("make -C " + zbShellQuote(repo) + " -j16 toolchain",
              evidence + "/toolchain.log", "Noct toolchain");
    var build = evidence + "/build/amd64";
    var arch = evidence + "/build/arch-images";
    var data = evidence + "/build/data.img";
    var swap = evidence + "/build/swapfile";
    var buildCommand = "TMPDIR=" + zbShellQuote(evidence + "/tmp") +
        " make -C " + zbShellQuote(repo) + " -j16 -f Makefile -f " +
        zbShellQuote(makefile) + " ZEDBSD_CONFIG=" + zbShellQuote(config) +
        " BUILD=" + zbShellQuote(build) + " ARCH_IMAGE_DIR=" +
        zbShellQuote(arch) + " DATA_IMAGE=" + zbShellQuote(data) +
        " SWAP_IMAGE=" + zbShellQuote(swap) +
        " ws001-p022-p023-qemu-images";
    runLogged(buildCommand, evidence + "/build.log",
              "private WS001 p022/p023 images");
    var overlaySource = build + "/tests/ws001-p022-overlay.img";
    var nativeSource = build + "/tests/ws001-p022-native.img";
    var fatSource = build + "/tests/ws001-p022-fat.img";
    var ufs2Source = build + "/tests/ws001-p022-ufs2.img";
    var fatExternalSource = build + "/tests/ws001-p022-fat-external.img";
    run("test \"$(dd if=" + zbShellQuote(ufs2Source) +
        " bs=1 skip=16777216 count=4 2>/dev/null)\" = ZUJ1",
        "verify UFS2 journal locator");
    FileUtil.writeText(evidence + "/ufs2-journal.txt",
        "format=ufs2\njournal_locator=ZUJ1\njournal_mib=4\n" +
        "activation=stage2 writable remount after QMP quit\n");
    var sourceList = zbShellQuote(overlaySource) + " " +
        zbShellQuote(nativeSource) + " " + zbShellQuote(fatSource) + " " +
        zbShellQuote(ufs2Source) + " " + zbShellQuote(fatExternalSource);
    run("sha256sum " + sourceList + " >" +
        zbShellQuote(evidence + "/source-before.sha256"),
        "freeze source hashes");
    var overlay = evidence + "/run/overlay.img";
    var native = evidence + "/run/native.img";
    var fat = evidence + "/run/fat-root.img";
    var ufs2 = evidence + "/run/ufs2.img";
    var fatExternal = evidence + "/run/fat-external.img";
    run("cp --reflink=auto --sparse=always " + zbShellQuote(overlaySource) +
        " " + zbShellQuote(overlay) + " && cp --reflink=auto --sparse=always " +
        zbShellQuote(nativeSource) + " " + zbShellQuote(native) +
        " && cp --reflink=auto --sparse=always " + zbShellQuote(fatSource) +
        " " + zbShellQuote(fat) + " && cp --reflink=auto --sparse=always " +
        zbShellQuote(ufs2Source) + " " + zbShellQuote(ufs2) +
        " && cp --reflink=auto --sparse=always " +
        zbShellQuote(fatExternalSource) + " " + zbShellQuote(fatExternal),
        "prepare disposable writable media");
    runCell(qemu, ovmfCode, ovmfVars, evidence, "overlay-stage1",
        overlay, ufs2,
        "WS001-P023 STAGE1 PASS scenario=overlay backend=ufs2", results);
    runCell(qemu, ovmfCode, ovmfVars, evidence, "overlay-stage2",
        overlay, ufs2,
        "WS001-P023 PASS scenario=overlay backend=ufs2", results);
    runCell(qemu, "", "", evidence, "native-ufs1-stage1",
        native, "",
        "WS001-P023 STAGE1 PASS scenario=native backend=ufs1", results);
    runCell(qemu, "", "", evidence, "native-ufs1-stage2",
        native, "",
        "WS001-P023 PASS scenario=native-ufs1", results);
    runCell(qemu, ovmfCode, ovmfVars, evidence, "fat-remount",
        fat, fatExternal,
        "WS001-P023 PASS scenario=fat", results);
    run("sha256sum -c " + zbShellQuote(evidence + "/source-before.sha256") +
        " >" + zbShellQuote(evidence + "/source-after.log"),
        "verify source image immutability");
    run("sha256sum " + zbShellQuote(guest) + " " + zbShellQuote(config) +
        " " + zbShellQuote(makefile) + " " +
        zbShellQuote(fixture + "/credential-vfs-overlay.cfg") + " " +
        zbShellQuote(fixture + "/credential-vfs-native.cfg") + " " +
        zbShellQuote(fixture + "/credential-vfs-fat-unixmode.txt") + " >" +
        zbShellQuote(evidence + "/inputs.sha256"), "hash fixture inputs");
    FileUtil.writeText(evidence + "/metadata.txt",
        "test=WS001 p022/p023\nlaunches=5\n" +
        "shutdown_boundary=QMP quit immediately after PASS\n" +
        "topology=q35; OVMF hybrid images and SeaBIOS native UFS1; " +
        "USB xHCI boot/root; IDE auxiliary fixture\n" +
        "ufs2_journal=ZUJ1,4MiB; stage2 writable remount required\n" +
        "source_images_immutable=yes\nqemu=" +
        capture(zbShellQuote(qemu) + " --version | sed -n '1p'",
                "capture QEMU version") + "\n");
    appendText(results, "source-integrity\tPASS\tsource-after.log\n");
    print("WS001 p022/p023 QEMU acceptance: PASS: " + evidence);
}
