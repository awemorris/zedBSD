require zedbuild;

// MAC-T010/MAC-T011 production image-layout and atomic-publication fixture.
// Copyright (C) 2026 Awe Morris; SPDX-License-Identifier: Zlib

func run(repo, command, what) {
    var status = System.shell("cd " + zbShellQuote(repo) + " && " + command);
    if (status != 0) { zbFail(what + " failed (status=" + status + ")"); }
}

func runLogged(repo, log, command, what) {
    var status = System.shell("cd " + zbShellQuote(repo) + " && " + command +
                              " >" + zbShellQuote(log) + " 2>&1");
    if (status != 0) {
        zbFail(what + " failed (status=" + status + "; log=" + log + ")");
    }
}

func expectFailure(repo, log, command, what) {
    var status = System.shell("cd " + zbShellQuote(repo) + " && " + command +
                              " >" + zbShellQuote(log) + " 2>&1");
    if (status == 0) { zbFail(what + " unexpectedly passed"); }
}

func crc32Range(data, start, count) {
    var crc = 4294967295;
    for (i in 0..count) {
        crc = crc ^ data[start + i];
        for (j in 0..8) {
            if ((crc & 1) != 0) { crc = (crc >> 1) ^ 0xedb88320; }
            else { crc = crc >> 1; }
        }
    }
    return (crc ^ 4294967295) & 4294967295;
}

func updatePrimaryHeaderCrc(data) {
    zbPut32LE(data, 512 + 16, 0);
    zbPut32LE(data, 512 + 16, crc32Range(data, 512, 92));
}

func writeSemanticMutation(source, destination, kind) {
    var data = zbReadFile(source);
    if (kind == "alternate") {
        // Keep the primary header internally valid while moving its declared
        // alternate LBA away from the fixed logical last block.
        zbPut64LE(data, 512 + 32, 395295);
        updatePrimaryHeaderCrc(data);
    } else if (kind == "overlap") {
        // Move payload first-LBA into the ESP and update both CRCs so the
        // semantic extent check, rather than a checksum check, rejects it.
        zbPut64LE(data, 1152 + 32, 2048);
        zbPut32LE(data, 512 + 88, crc32Range(data, 1024, 16384));
        updatePrimaryHeaderCrc(data);
    } else if (kind == "outside") {
        // Extend payload one sector past compact EOF, again with valid CRCs.
        zbPut64LE(data, 1152 + 40, 395264);
        zbPut32LE(data, 512 + 88, crc32Range(data, 1024, 16384));
        updatePrimaryHeaderCrc(data);
    } else {
        zbFail("unknown semantic GPT mutation");
    }
    zbWriteFile(destination, data);
}

func writeFat32BackupMutation(source, destination, volumeOffset) {
    var data = zbReadFile(source);
    var reserved = zbU16LE(data, volumeOffset + 14);
    var backup = zbU16LE(data, volumeOffset + 50);
    if (backup == 0 || backup >= reserved) {
        zbFail("invalid FAT32 backup fixture geometry");
    }
    data[volumeOffset + backup * 512] =
        data[volumeOffset + backup * 512] ^ 1;
    zbWriteFile(destination, data);
}

func writeValidBackupGptMutation(source, destination) {
    var data = zbReadFile(source);
    var total = 395297;
    var tableAt = (total - 33) * 512;
    var headerAt = (total - 1) * 512;
    zbCopy(data, tableAt, data, 1024, 16384);
    zbCopy(data, headerAt, data, 512, 512);
    zbPut64LE(data, headerAt + 24, total - 1);
    zbPut64LE(data, headerAt + 32, 1);
    zbPut64LE(data, headerAt + 72, total - 33);
    zbPut32LE(data, headerAt + 16, 0);
    zbPut32LE(data, headerAt + 16, crc32Range(data, headerAt, 92));
    zbWriteFile(destination, data);
}

func makeVariables(config, build, evidence) {
    return " ZEDBSD_CONFIG=" + zbShellQuote(config) +
        " BUILD=" + zbShellQuote(build) +
        " ARCH_IMAGE_DIR=" + zbShellQuote(evidence + "/arch-images") +
        " DATA_IMAGE=" + zbShellQuote(evidence + "/data.img") +
        " SWAP_IMAGE=" + zbShellQuote(evidence + "/swapfile") +
        " ZEDBSD_IMAGE_HOST=" + zbShellQuote(evidence + "/zedimage-host");
}

func makeImage(repo, evidence, config, build, layout) {
    var name = layout;
    var command = "make --no-print-directory -j16 " +
        "ZEDBSD_PLATFORM=amd64 ZEDBSD_ARCHITECTURE=amd64 " +
        "ZEDBSD_BOARD=pcat ZEDBSD_VARIANT=" + layout +
        makeVariables(config, build, evidence) + " disk-image";
    runLogged(repo, evidence + "/build-" + name + ".log", command,
              name + " production image");
    var expected = "";
    if (layout == "hybrid") { expected = "253755392"; }
    else if (layout == "bios") { expected = "185597952"; }
    else { expected = "252723712"; }
    var image = build + "/hdd-image.img";
    run(repo, "test \"$(stat -c%s " + zbShellQuote(image) + ")\" = " + expected,
        name + " exact artifact extent");
    var checker = "build/NoctLang/build-static/noct --path=tools/build " +
        "platform/amd64/tools/check-amd64-gpt-image.noct ";
    runLogged(repo, evidence + "/check-" + name + ".log",
        checker + checkerArgs(build, evidence, layout, image),
        name + " independent production check");
}

func checkerArgsForMachineStage1(build, evidence, layout, image,
                                 machine, stage1) {
    return "--layout " + layout +
        " --machine " + machine + " --stage1 " + zbShellQuote(stage1) +
        " --stage2 " + zbShellQuote(build + "/bootloader/stage2-chain.bin") +
        " --partition-pbr " +
        zbShellQuote(build + "/bootloader/partition-pbr.bin") +
        " --bootzbsd " + zbShellQuote(build + "/bootloader/BOOTZBSD.EXE") +
        " --kernel " + zbShellQuote(build + "/vmunix") +
        " --bootx64 " + zbShellQuote(build + "/uefi/BOOTX64.EFI") +
        " --zedbsd-config platform/amd64/zedbsd.cfg" +
        " --arch-profile amd64 --arch-image " +
        zbShellQuote(evidence + "/arch-images/amd64.ufs") +
        " --arch-format ufs --data-image " +
        zbShellQuote(evidence + "/data.img") +
        " --swapfile " + zbShellQuote(evidence + "/swapfile") + " " +
        zbShellQuote(image);
}

func checkerArgsForStage1(build, evidence, layout, image, stage1) {
    return checkerArgsForMachineStage1(build, evidence, layout,
                                       image, "pcat", stage1);
}

func checkerArgs(build, evidence, layout, image) {
    var stage1 = build + "/bootloader/stage1.bin";
    if (layout == "bios") {
        stage1 = build + "/bootloader/stage1-native.bin";
    }
    return checkerArgsForStage1(build, evidence, layout, image,
                                stage1);
}

func backendArgsOmitting(build, evidence, layout, image, omitted) {
    var stage1 = build + "/bootloader/stage1.bin";
    if (layout == "bios") { stage1 = build + "/bootloader/stage1-native.bin"; }
    var result = "--layout " + layout +
        " --machine pcat --stage1 " + zbShellQuote(stage1) +
        " --stage2 " + zbShellQuote(build + "/bootloader/stage2-chain.bin") +
        " --partition-pbr " +
        zbShellQuote(build + "/bootloader/partition-pbr.bin") +
        " --bootzbsd " + zbShellQuote(build + "/bootloader/BOOTZBSD.EXE") +
        " --kernel " + zbShellQuote(build + "/vmunix") +
        " --zedbsd-config platform/amd64/zedbsd.cfg" +
        " --arch-image " + zbShellQuote(evidence + "/arch-images/amd64.ufs") +
        " --swapfile " + zbShellQuote(evidence + "/swapfile");
    if (omitted != "bootx64") {
        result = result + " --bootx64 " +
                 zbShellQuote(build + "/uefi/BOOTX64.EFI");
    }
    if (omitted != "data") {
        result = result + " --data-image " + zbShellQuote(evidence + "/data.img");
    }
    return result + " " + zbShellQuote(image);
}

func main(args) {
    if (Array.size(args) != 2) {
        zbFail("usage: image-layout-test.noct REPOSITORY EVIDENCE");
    }
    var repo = args[0];
    var evidence = args[1];
    run(repo, "mkdir -p " + zbShellQuote(evidence), "create evidence directory");
    var config = evidence + "/config.mk";
    var build = evidence + "/build-amd64";
    run(repo, "cp config.mk " + zbShellQuote(config),
        "snapshot fixture configuration");
    runLogged(repo, evidence + "/clean-private-build.log",
        "make --no-print-directory ZEDBSD_CONFIG=" + zbShellQuote(config) +
        " BUILD=" + zbShellQuote(build) + " clean",
        "clean fixture-private BUILD");

    // Hybrid remains the accepted self-contained GPT and BIOS remains the
    // legacy MBR artifact.  UEFI-only has one fixed primary-only GPT extent.
    makeImage(repo, evidence, config, build, "hybrid");
    var hybrid = evidence + "/hybrid.img";
    run(repo, "cp --reflink=auto --sparse=always " +
        zbShellQuote(build + "/hdd-image.img") + " " +
        zbShellQuote(hybrid), "save Hybrid fixture");

    // The explicit layout interface owns its fixed partition geometry.  Old
    // geometry and native/fragmentation switches remain available only to
    // legacy builder calls without --layout.
    expectFailure(repo, evidence + "/reject-layout-size-override.log",
        zbShellQuote(evidence + "/zedimage-host") + " disk " +
        checkerArgs(build, evidence, "hybrid",
                    evidence + "/override.img") + " --size-mib 130",
        "explicit layout size override");
    expectFailure(repo, evidence + "/reject-layout-native-override.log",
        zbShellQuote(evidence + "/zedimage-host") + " disk " +
        checkerArgs(build, evidence, "bios",
                    evidence + "/override.img") +
        " --ufs-root " + zbShellQuote(evidence + "/arch-images/amd64.ufs"),
        "explicit layout native-root override");
    expectFailure(repo, evidence + "/reject-hybrid-native-stage1-backend.log",
        zbShellQuote(evidence + "/zedimage-host") + " disk " +
        checkerArgsForStage1(build, evidence, "hybrid",
            evidence + "/override.img",
            build + "/bootloader/stage1-native.bin"),
        "Hybrid backend with native-LBA Stage 1");
    expectFailure(repo, evidence + "/reject-bios-gpt-stage1-backend.log",
        zbShellQuote(evidence + "/zedimage-host") + " disk " +
        checkerArgsForStage1(build, evidence, "bios",
            evidence + "/override.img", build + "/bootloader/stage1.bin"),
        "BIOS backend with GPT-LBA Stage 1");
    expectFailure(repo, evidence + "/reject-layout-machine.log",
        zbShellQuote(evidence + "/zedimage-host") + " disk " +
        checkerArgsForMachineStage1(build, evidence, "hybrid",
            evidence + "/override.img", "banana",
            build + "/bootloader/stage1.bin"),
        "explicit layout non-PCAT machine");
    var corruptStage1 = evidence + "/broken-stage1-metadata.bin";
    run(repo, "cp " + zbShellQuote(build + "/bootloader/stage1.bin") + " " +
        zbShellQuote(corruptStage1), "copy Stage 1 metadata fixture");
    run(repo, "printf X | dd of=" + zbShellQuote(corruptStage1) +
        " bs=1 seek=416 count=1 conv=notrunc status=none",
        "corrupt Stage 1 metadata magic");
    expectFailure(repo, evidence + "/reject-stage1-metadata-backend.log",
        zbShellQuote(evidence + "/zedimage-host") + " disk " +
        checkerArgsForStage1(build, evidence, "hybrid",
            evidence + "/override.img", corruptStage1),
        "backend corrupted Stage 1 metadata");
    expectFailure(repo, evidence + "/reject-bios-missing-data.log",
        zbShellQuote(evidence + "/zedimage-host") + " disk " +
        backendArgsOmitting(build, evidence, "bios",
                            evidence + "/override.img", "data"),
        "BIOS backend missing required data image");
    expectFailure(repo, evidence + "/reject-hybrid-missing-bootx64.log",
        zbShellQuote(evidence + "/zedimage-host") + " disk " +
        backendArgsOmitting(build, evidence, "hybrid",
                            evidence + "/override.img", "bootx64"),
        "Hybrid backend missing required BOOTX64.EFI");

    makeImage(repo, evidence, config, build, "bios");
    var bios = evidence + "/bios.img";
    run(repo, "cp --reflink=auto --sparse=always " +
        zbShellQuote(build + "/hdd-image.img") + " " +
        zbShellQuote(bios), "save BIOS fixture");

    makeImage(repo, evidence, config, build, "uefi");
    var valid = evidence + "/uefi.img";
    run(repo, "cp --reflink=auto --sparse=always " +
        zbShellQuote(build + "/hdd-image.img") + " " +
        zbShellQuote(valid), "save fixed UEFI fixture");

    var checker = "build/NoctLang/build-static/noct --path=tools/build " +
        "platform/amd64/tools/check-amd64-gpt-image.noct ";
    for (mutation in ["primary", "table"]) {
        var broken = evidence + "/broken-" + mutation + ".img";
        run(repo, "cp --reflink=auto --sparse=always " + zbShellQuote(valid) +
            " " + zbShellQuote(broken), "copy " + mutation + " mutation");
        var offset = "512";
        if (mutation == "table") { offset = "1024"; }
        run(repo, "printf X | dd of=" + zbShellQuote(broken) +
            " bs=1 seek=" + offset + " count=1 conv=notrunc status=none",
            "write " + mutation + " mutation");
        expectFailure(repo, evidence + "/reject-" + mutation + ".log",
            checker + checkerArgs(build, evidence, "uefi", broken),
            mutation + " corruption rejection");
    }
    for (mutation in ["alternate", "overlap", "outside"]) {
        var broken = evidence + "/broken-" + mutation + ".img";
        writeSemanticMutation(valid, broken, mutation);
        expectFailure(repo, evidence + "/reject-" + mutation + ".log",
            checker + checkerArgs(build, evidence, "uefi", broken),
            mutation + " semantic rejection");
    }

    // Loader presence is layout-specific.  A BIOS loader inserted into the
    // UEFI payload and either valid image checked as another layout must fail.
    var crossLoader = evidence + "/broken-cross-loader.img";
    run(repo, "cp --reflink=auto --sparse=always " + zbShellQuote(valid) +
        " " + zbShellQuote(crossLoader), "copy cross-loader mutation");
    run(repo, "mcopy -o -i " + zbShellQuote(crossLoader + "@@68157440") +
        " " + zbShellQuote(build + "/bootloader/BOOTZBSD.EXE") +
        " ::/BOOTZBSD.EXE",
        "insert forbidden BIOS loader into UEFI payload");
    expectFailure(repo, evidence + "/reject-cross-loader.log",
        checker + checkerArgs(build, evidence, "uefi", crossLoader),
        "cross-layout loader rejection");
    expectFailure(repo, evidence + "/reject-uefi-as-hybrid.log",
        checker + checkerArgs(build, evidence, "hybrid", valid),
        "UEFI artifact as Hybrid rejection");
    expectFailure(repo, evidence + "/reject-hybrid-as-uefi.log",
        checker + checkerArgs(build, evidence, "uefi", hybrid),
        "Hybrid artifact as UEFI rejection");
    expectFailure(repo, evidence + "/reject-bios-as-uefi.log",
        checker + checkerArgs(build, evidence, "uefi", bios),
        "BIOS artifact as UEFI rejection");

    // Byte comparison alone must not let a caller redefine a layout's Stage
    // 2 LBA.  Preserve the valid MBR-owned tail while substituting only the
    // executable prefix, then declare that wrong input to the checker.
    var wrongHybridStage1 = evidence + "/broken-hybrid-native-stage1.img";
    run(repo, "cp --reflink=auto --sparse=always " + zbShellQuote(hybrid) +
        " " + zbShellQuote(wrongHybridStage1),
        "copy Hybrid wrong-Stage-1 fixture");
    run(repo, "dd if=" +
        zbShellQuote(build + "/bootloader/stage1-native.bin") + " of=" +
        zbShellQuote(wrongHybridStage1) +
        " bs=1 count=440 conv=notrunc status=none",
        "substitute native Stage 1 into Hybrid");
    expectFailure(repo, evidence + "/reject-hybrid-native-stage1-check.log",
        checker + checkerArgsForStage1(build, evidence, "hybrid",
            wrongHybridStage1, build + "/bootloader/stage1-native.bin"),
        "Hybrid checker native-LBA Stage 1");
    var wrongBiosStage1 = evidence + "/broken-bios-gpt-stage1.img";
    run(repo, "cp --reflink=auto --sparse=always " + zbShellQuote(bios) +
        " " + zbShellQuote(wrongBiosStage1),
        "copy BIOS wrong-Stage-1 fixture");
    run(repo, "dd if=" +
        zbShellQuote(build + "/bootloader/stage1.bin") + " of=" +
        zbShellQuote(wrongBiosStage1) +
        " bs=1 count=440 conv=notrunc status=none",
        "substitute GPT Stage 1 into BIOS");
    expectFailure(repo, evidence + "/reject-bios-gpt-stage1-check.log",
        checker + checkerArgsForStage1(build, evidence, "bios",
            wrongBiosStage1, build + "/bootloader/stage1.bin"),
        "BIOS checker GPT-LBA Stage 1");
    var corruptStage1Image = evidence + "/broken-hybrid-stage1-metadata.img";
    run(repo, "cp --reflink=auto --sparse=always " + zbShellQuote(hybrid) +
        " " + zbShellQuote(corruptStage1Image),
        "copy Hybrid Stage 1 metadata fixture");
    run(repo, "dd if=" + zbShellQuote(corruptStage1) + " of=" +
        zbShellQuote(corruptStage1Image) +
        " bs=1 count=440 conv=notrunc status=none",
        "substitute corrupted Stage 1 metadata");
    expectFailure(repo, evidence + "/reject-stage1-metadata-check.log",
        checker + checkerArgsForStage1(build, evidence, "hybrid",
            corruptStage1Image, corruptStage1),
        "checker corrupted Stage 1 metadata");

    var hybridEspBackup = evidence + "/broken-hybrid-esp-backup.img";
    writeFat32BackupMutation(hybrid, hybridEspBackup, 1048576);
    expectFailure(repo, evidence + "/reject-hybrid-esp-backup.log",
        checker + checkerArgs(build, evidence, "hybrid",
                              hybridEspBackup),
        "Hybrid ESP backup-VBR corruption rejection");
    var hybridPayloadBackup = evidence + "/broken-hybrid-payload-backup.img";
    writeFat32BackupMutation(hybrid, hybridPayloadBackup, 68157440);
    expectFailure(repo, evidence + "/reject-hybrid-payload-backup.log",
        checker + checkerArgs(build, evidence, "hybrid",
                              hybridPayloadBackup),
        "Hybrid payload backup-VBR corruption rejection");
    var uefiEspBackup = evidence + "/broken-uefi-esp-backup.img";
    writeFat32BackupMutation(valid, uefiEspBackup, 1048576);
    expectFailure(repo, evidence + "/reject-uefi-esp-backup.log",
        checker + checkerArgs(build, evidence, "uefi", uefiEspBackup),
        "UEFI ESP backup-VBR corruption rejection");
    var uefiPayloadBackup = evidence + "/broken-uefi-payload-backup.img";
    writeFat32BackupMutation(valid, uefiPayloadBackup, 68157440);
    expectFailure(repo, evidence + "/reject-uefi-payload-backup.log",
        checker + checkerArgs(build, evidence, "uefi", uefiPayloadBackup),
        "UEFI payload backup-VBR corruption rejection");

    // The public UEFI artifact includes its zero final-33-sector reservation;
    // no target-capacity materialization step exists.
    var shortImage = evidence + "/broken-uefi-short.img";
    run(repo, "cp --reflink=auto --sparse=always " + zbShellQuote(valid) +
        " " + zbShellQuote(shortImage) + " && truncate -s 202391552 " +
        zbShellQuote(shortImage), "create short UEFI fixture");
    expectFailure(repo, evidence + "/reject-uefi-short.log",
        checker + checkerArgs(build, evidence, "uefi", shortImage),
        "short UEFI extent rejection");
    var longImage = evidence + "/broken-uefi-long.img";
    run(repo, "cp --reflink=auto --sparse=always " + zbShellQuote(valid) +
        " " + zbShellQuote(longImage) + " && truncate -s 202392576 " +
        zbShellQuote(longImage), "create long UEFI fixture");
    expectFailure(repo, evidence + "/reject-uefi-long.log",
        checker + checkerArgs(build, evidence, "uefi", longImage),
        "long UEFI extent rejection");
    var nonzeroTail = evidence + "/broken-uefi-tail.img";
    run(repo, "cp --reflink=auto --sparse=always " + zbShellQuote(valid) +
        " " + zbShellQuote(nonzeroTail) +
        " && printf X | dd of=" + zbShellQuote(nonzeroTail) +
        " bs=1 seek=202375168 count=1 conv=notrunc status=none",
        "create nonzero absent-backup reservation");
    expectFailure(repo, evidence + "/reject-uefi-tail.log",
        checker + checkerArgs(build, evidence, "uefi", nonzeroTail),
        "nonzero UEFI final reservation rejection");
    var completeGpt = evidence + "/broken-uefi-valid-backup.img";
    writeValidBackupGptMutation(valid, completeGpt);
    expectFailure(repo, evidence + "/reject-uefi-valid-backup.log",
        checker + checkerArgs(build, evidence, "uefi", completeGpt),
        "source UEFI valid backup GPT rejection");

    // Feed a corrupted compact image through the real atomic wrapper using a
    // temporary backend.  A checker failure must retain the old destination.
    var fake = evidence + "/copy-corrupt-backend";
    var script = "#!/bin/sh\nlast=\nfor arg do last=$arg; done\n" +
                 "cp " + zbShellQuote(evidence + "/broken-primary.img") +
                 " \"$last\"\n";
    run(repo, "printf %s " + zbShellQuote(script) + " >" + zbShellQuote(fake),
        "write temporary corrupt backend");
    run(repo, "chmod +x " + zbShellQuote(fake), "enable corrupt backend");
    var destination = evidence + "/atomic.img";
    run(repo, "printf SENTINEL >" + zbShellQuote(destination),
        "write atomic sentinel");
    var wrapper = "build/NoctLang/build-static/noct --path=tools/build " +
        "tools/build/make-bios-hdd-image.noct --backend " + fake +
        " --checker platform/amd64/tools/check-amd64-gpt-image.noct" +
        " --checker-runner build/NoctLang/build-static/noct " +
        checkerArgs(build, evidence, "uefi", destination);
    expectFailure(repo, evidence + "/reject-atomic.log", wrapper,
        "atomic malformed-image publication");
    run(repo, "test \"$(cat " + zbShellQuote(destination) +
        ")\" = SENTINEL && test ! -e " + zbShellQuote(destination + ".unchecked") +
        " && test ! -e " + zbShellQuote(destination + ".unchecked.tmp"),
        "atomic destination retention");

    print("MAC-T010/MAC-T011 image layouts: PASS (3 fixed layouts, " +
          "negative and atomic gates; " + evidence + ")");
}
