+/* Test only: which sleepers kept an idle CPU at the busy rate. */
+struct sched_diag_near {
+	uint64_t key;
+	const char *queue;
+	uint64_t count;
+	uintptr_t entry;
+	uint64_t shortest;
+	uint64_t longest;
+};
+struct sched_diag_near sched_diag_near_table[48];
+
+static void
+sched_diag_near_note(
+	struct thread *thread)
+{
+	uint64_t key;
+	const char *queue;
+	uint64_t span;
+	unsigned i;
+
+	key = ((thread->proc != NULL ? (uint64_t)thread->proc->pid : 0U) << 32) | (uint64_t)(uint32_t)thread->tid;
+	queue = thread->wait_token.queue != NULL ? thread->wait_token.queue->name : NULL;
+	for (i = 0; i < 48U; i++) {
+		if (sched_diag_near_table[i].count == 0U || sched_diag_near_table[i].key == key) {
+			span = thread->sched.wakeup_tick - thread->sched.queued_tick;
+			if (sched_diag_near_table[i].count == 0U || span < sched_diag_near_table[i].shortest)
+				sched_diag_near_table[i].shortest = span;
+			if (sched_diag_near_table[i].count == 0U || span > sched_diag_near_table[i].longest)
+				sched_diag_near_table[i].longest = span;
+			sched_diag_near_table[i].key = key;
+			sched_diag_near_table[i].queue = queue;
+			sched_diag_near_table[i].entry = (uintptr_t)thread->kernel_entry;
+			sched_diag_near_table[i].count++;
+			break;
+		}
+	}
+}
+
+void
+sched_diag_near_dump(void)
+{
+	unsigned i;
+
+	for (i = 0; i < 48U; i++) {
+		if (sched_diag_near_table[i].count == 0U)
+			continue;
+		kern_logf("neardiag: count %llu pid %u tid %u entry %llx span %llu-%llu queue %s\n",
+		    (unsigned long long)sched_diag_near_table[i].count,
+		    (unsigned)(sched_diag_near_table[i].key >> 32), (unsigned)(uint32_t)sched_diag_near_table[i].key,
+		    (unsigned long long)sched_diag_near_table[i].entry,
+		    (unsigned long long)sched_diag_near_table[i].shortest,
+		    (unsigned long long)sched_diag_near_table[i].longest,
+		    sched_diag_near_table[i].queue != NULL ? sched_diag_near_table[i].queue : "-");
+		sched_diag_near_table[i].count = 0U;
+		sched_diag_near_table[i].key = 0U;
+	}
+}
