+
+static struct poll_diag *
+poll_diag_slot(
+	struct thread *thread)
+{
+	uint64_t key;
+	unsigned i;
+
+	key = ((thread->proc != NULL ? (uint64_t)thread->proc->pid : 0U) << 32) | (uint64_t)(uint32_t)thread->tid;
+	for (i = 0; i < 64U; i++) {
+		if (poll_diag_table[i].key == key && poll_diag_table[i].calls + poll_diag_table[i].rescans != 0U)
+			return &poll_diag_table[i];
+		if (poll_diag_table[i].calls + poll_diag_table[i].rescans == 0U) {
+			kern_memset(&poll_diag_table[i], 0, sizeof(poll_diag_table[i]));
+			poll_diag_table[i].key = key;
+			return &poll_diag_table[i];
+		}
+	}
+	return NULL;
+}
+
+/* Test only: notes one poll of the current thread. */
+void
+poll_diag_note(
+	nfds_t count,
+	uint64_t span,
+	int immediate,
+	int timed_out,
+	const uintptr_t ret[4])
+{
+	struct poll_diag *slot;
+	struct thread *thread;
+	unsigned long irq;
+
+	thread = thread_current();
+	if (thread == NULL || atomic_load_acquire(&channel_ready) == 0)
+		return;
+	irq = spin_lock_irqsave(&poll_diag_lock);
+	slot = poll_diag_slot(thread);
+	if (slot != NULL) {
+		if (slot->calls == 0U || span < slot->shortest)
+			slot->shortest = span;
+		if (slot->calls == 0U || span > slot->longest)
+			slot->longest = span;
+		slot->calls++;
+		if (immediate)
+			slot->immediates++;
+		if (timed_out)
+			slot->timeouts++;
+		slot->nfds = (uint32_t)count;
+		kern_memcpy(slot->ret, ret, sizeof(slot->ret));
+	}
+	spin_unlock_irqrestore(&poll_diag_lock, irq);
+}
+
+/* Test only: notes a wake of a poll that found nothing (every: it followed every change). */
+static void
+poll_diag_rescan(
+	unsigned every)
+{
+	struct poll_diag *slot;
+	struct thread *thread;
+	unsigned long irq;
+
+	thread = thread_current();
+	if (thread == NULL)
+		return;
+	irq = spin_lock_irqsave(&poll_diag_lock);
+	slot = poll_diag_slot(thread);
+	if (slot != NULL) {
+		slot->rescans++;
+		if (every)
+			slot->every++;
+	}
+	spin_unlock_irqrestore(&poll_diag_lock, irq);
+}
+
+/* Test only: logs and clears the table (the timer's 10 s report). */
+void
+poll_diag_dump(void)
+{
+	unsigned long irq;
+	uint32_t notifies;
+	uint32_t named;
+	uint32_t woken;
+	unsigned i;
+
+	if (atomic_load_acquire(&channel_ready) == 0)
+		return;
+	irq = spin_lock_irqsave(&poll_diag_lock);
+	kern_memcpy(poll_diag_copy, poll_diag_table, sizeof(poll_diag_copy));
+	kern_memset(poll_diag_table, 0, sizeof(poll_diag_table));
+	notifies = poll_diag_notifies;
+	named = poll_diag_named;
+	woken = poll_diag_woken;
+	poll_diag_notifies = 0U;
+	poll_diag_named = 0U;
+	poll_diag_woken = 0U;
+	spin_unlock_irqrestore(&poll_diag_lock, irq);
+	kern_logf("polldiag: notifies %u named %u woken %u\n", (unsigned)notifies, (unsigned)named, (unsigned)woken);
+	for (i = 0; i < 64U; i++) {
+		if (poll_diag_copy[i].calls + poll_diag_copy[i].rescans == 0U)
+			continue;
+		kern_logf("polldiag: pid %u tid %u calls %u timeouts %u immediate %u rescans %u nfds %u wait %llu-%llu every %u ret %llx %llx\n",
+		    (unsigned)(poll_diag_copy[i].key >> 32), (unsigned)(uint32_t)poll_diag_copy[i].key,
+		    (unsigned)poll_diag_copy[i].calls, (unsigned)poll_diag_copy[i].timeouts,
+		    (unsigned)poll_diag_copy[i].immediates, (unsigned)poll_diag_copy[i].rescans,
+		    (unsigned)poll_diag_copy[i].nfds,
+		    (unsigned long long)poll_diag_copy[i].shortest, (unsigned long long)poll_diag_copy[i].longest,
+		    (unsigned)poll_diag_copy[i].every,
+		    (unsigned long long)poll_diag_copy[i].ret[0], (unsigned long long)poll_diag_copy[i].ret[1]);
+	}
+}
