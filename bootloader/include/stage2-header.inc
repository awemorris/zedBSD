/* ZBL2 header at the first byte of the raw Stage 2 image. */
.set ZBL2_MAGIC,          0x324c425a
.set ZBL2_VERSION,        1
.set ZBL2_HEADER_SIZE,    32
.set ZBL2_MACHINE_PCAT,   1
.set ZBL2_MACHINE_PC98,   2
.set ZBL2_IMAGE_SIZE,     8
.set ZBL2_SECTOR_COUNT,   12
.set ZBL2_MACHINE,        14
.set ZBL2_ENTRY_OFFSET,   16
.set ZBL2_CHECKSUM,       20

