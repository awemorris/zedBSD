echo zedBSD-POSIX-PHASE7-QEMU-START
compress -c /etc/phase7-input | zcat > /tmp/phase7-output
cmp /etc/phase7-input /tmp/phase7-output && echo zedBSD-POSIX-PHASE7-STREAM-PASS
cp /etc/phase7-input /tmp/phase7-file
compress -f /tmp/phase7-file
stat /tmp/phase7-file.Z > /tmp/phase7-stat && echo zedBSD-POSIX-PHASE7-COMPRESS-PASS
uncompress -f /tmp/phase7-file.Z
cmp /etc/phase7-input /tmp/phase7-file && echo zedBSD-POSIX-PHASE7-UNCOMPRESS-PASS
echo corrupt > /tmp/phase7-bad.Z
uncompress -c /tmp/phase7-bad.Z > /tmp/phase7-bad || echo zedBSD-POSIX-PHASE7-CORRUPT-PASS
echo zedBSD-POSIX-PHASE7-QEMU-PASS
halt
