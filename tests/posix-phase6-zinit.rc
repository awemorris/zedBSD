echo zedBSD-POSIX-PHASE6-QEMU-START
ar -rc /tmp/phase6.a /etc/phase6-cflow.c /etc/phase6-object.o
ar -t /tmp/phase6.a > /tmp/phase6-ar-list
grep -q phase6-cflow.c /tmp/phase6-ar-list && grep -q phase6-object.o /tmp/phase6-ar-list && echo zedBSD-POSIX-PHASE6-AR-PASS
nm -P /etc/phase6-object.o > /tmp/phase6-nm
grep -q '^main ' /tmp/phase6-nm && echo zedBSD-POSIX-PHASE6-NM-PASS
nm -A /tmp/phase6.a > /tmp/phase6-nm-ar
grep -q 'phase6.a(phase6-object.o).* main' /tmp/phase6-nm-ar && echo zedBSD-POSIX-PHASE6-NM-ARCHIVE-PASS
cflow /etc/phase6-cflow.c > /tmp/phase6-cflow
grep -q '^main ' /tmp/phase6-cflow && grep -q '    helper ' /tmp/phase6-cflow && echo zedBSD-POSIX-PHASE6-CFLOW-PASS
cxref /etc/phase6-cflow.c > /tmp/phase6-cxref
grep -q '^main ' /tmp/phase6-cxref && grep -q '^helper ' /tmp/phase6-cxref && echo zedBSD-POSIX-PHASE6-CXREF-PASS
echo zedBSD-POSIX-PHASE6-QEMU-PASS
halt
