echo zedBSD-POSIX-PHASE4-QEMU-START
test "$(echo '99999999999999999999*99999999999999999999' | bc -q)" = 9999999999999999999800000000000000000001 && echo zedBSD-POSIX-PHASE4-BC-PASS
ed -s < /etc/phase4.ed && test "$(head -n 1 /tmp/phase4-ed-output)" = AlphA && echo zedBSD-POSIX-PHASE4-ED-PASS
mkdir -p /tmp/phase4-find/sub
touch /tmp/phase4-find/sub/needle
test "$(find /tmp/phase4-find -name needle -print)" = /tmp/phase4-find/sub/needle && echo zedBSD-POSIX-PHASE4-FIND-PASS
m4 /etc/phase4.m4 > /tmp/phase4-m4-output
cmp /tmp/phase4-m4-output /etc/phase4-m4.expected && echo zedBSD-POSIX-PHASE4-M4-PASS
cd /tmp
mkdir -p phase4-pax/source phase4-pax/extract
echo payload > phase4-pax/source/file
pax -w -f phase4-pax/archive phase4-pax/source
cd phase4-pax/extract
pax -r -f ../archive
cmp phase4-pax/source/file ../source/file && echo zedBSD-POSIX-PHASE4-PAX-PASS
echo zedBSD-POSIX-PHASE4-QEMU-PASS
halt
